{{define "page_project_settings"}}
<!doctype html><html lang="en"><head><title>{{if .Data.Creating}}Create project{{else}}Project settings{{end}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-project-settings"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span>{{with .Data.Project}}<a href="/projects/{{.Key}}">{{.Name}}</a><span aria-hidden="true">/</span>{{end}}<span aria-current="page">{{if .Data.Creating}}Create project{{else}}Project settings{{end}}</span></nav>
<header class="page-header"><div><h1>{{if .Data.Creating}}Create project{{else}}Project settings{{end}}</h1><p>{{if .Data.Creating}}Give your team a place to plan and track work.{{else}}Manage the details and ownership of {{.Data.Project.Name}}.{{end}}</p></div></header>
{{if .Data.Saved}}<p class="form-success" role="status">Project details saved.</p>{{end}}
{{if .Data.Errors}}<div class="form-error" role="alert"><strong>Check the project details</strong><ul>{{range $field,$message:=.Data.Errors}}<li><a href="#project-{{$field}}">{{$message}}</a></li>{{end}}</ul></div>{{end}}
<div class="project-overview-grid"><form class="surface-card project-details-form" method="post" action="{{if .Data.Creating}}/projects/new{{else}}/projects/{{.Data.Project.Key}}/settings{{end}}">
<h2>{{if .Data.Creating}}Project details{{else}}Details{{end}}</h2>
<label for="project-name">Name</label><input id="project-name" name="name" value="{{.Data.Values.Name}}" maxlength="80" required {{if index .Data.Errors "name"}}aria-invalid="true"{{end}}>
{{if .Data.Creating}}<label for="project-key">Key</label><input id="project-key" name="key" value="{{.Data.Values.Key}}" maxlength="10" pattern="[A-Z][A-Z0-9_]{1,9}" required aria-describedby="project-key-help" {{if index .Data.Errors "key"}}aria-invalid="true"{{end}}><small id="project-key-help">2–10 uppercase letters, numbers or underscores. Work items use this key, for example TEAM-1.</small>
<label for="project-projectTemplateKey">Template</label><select id="project-projectTemplateKey" name="projectTemplateKey"><option value="com.pyxis.greenhopper.jira:gh-simplified-scrum-classic" {{if eq .Data.Values.ProjectTemplateKey "com.pyxis.greenhopper.jira:gh-simplified-scrum-classic"}}selected{{end}}>Scrum — plan work in sprints</option><option value="com.pyxis.greenhopper.jira:gh-simplified-kanban-classic" {{if eq .Data.Values.ProjectTemplateKey "com.pyxis.greenhopper.jira:gh-simplified-kanban-classic"}}selected{{end}}>Kanban — track continuous delivery</option><option value="com.atlassian.jira-core-project-templates:jira-core-simplified-project-management" {{if eq .Data.Values.ProjectTemplateKey "com.atlassian.jira-core-project-templates:jira-core-simplified-project-management"}}selected{{end}}>Business — coordinate team work</option><option value="com.atlassian.servicedesk:simplified-it-service-management" {{if eq .Data.Values.ProjectTemplateKey "com.atlassian.servicedesk:simplified-it-service-management"}}selected{{end}}>Service management — requests and incidents</option></select>
{{else}}<dl><dt>Project key</dt><dd>{{.Data.Project.Key}}</dd></dl>{{end}}
<label for="project-description">Description</label><textarea id="project-description" name="description" rows="5">{{.Data.Values.Description}}</textarea>
<label for="project-url">Project URL</label><input id="project-url" name="url" type="url" value="{{.Data.Values.URL}}" maxlength="2048" {{if index .Data.Errors "url"}}aria-invalid="true"{{end}}>
<label for="project-leadAccountId">Project lead</label><select id="project-leadAccountId" name="leadAccountId" required><option value="">Choose a member</option>{{range .Data.Members}}<option value="{{.ID}}" {{if eq .ID $.Data.Values.LeadAccountID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select>
<label for="project-assigneeType">Default assignee</label><select id="project-assigneeType" name="assigneeType"><option value="UNASSIGNED" {{if eq .Data.Values.AssigneeType "UNASSIGNED"}}selected{{end}}>Unassigned</option><option value="PROJECT_LEAD" {{if eq .Data.Values.AssigneeType "PROJECT_LEAD"}}selected{{end}}>Project lead</option></select>
<label for="project-categoryId">Category</label><select id="project-categoryId" name="categoryId"><option value="">No category</option>{{range .Data.Categories}}<option value="{{.ID}}" {{if eq .ID $.Data.SelectedCategoryID}}selected{{end}}>{{.Name}}</option>{{end}}</select>
<div class="project-form-actions"><button class="btn btn-primary" type="submit">{{if .Data.Creating}}Create project{{else}}Save changes{{end}}</button><a class="btn" href="{{if .Data.Creating}}/projects{{else}}/projects/{{.Data.Project.Key}}{{end}}">Cancel</a></div>
</form>{{with .Data.Project}}<aside class="project-side-stack"><section class="surface-card"><h2>Workflow</h2><p>Review transitions and project assignments.</p><a href="/settings/workflows/{{.WorkflowID}}">Manage workflow</a></section><section class="surface-card"><h2>Boards</h2>{{range $.Data.Boards}}<a class="board-directory-link" href="/board/{{.ID}}/settings"><strong>{{.Name}}</strong><span>Configure columns and cards</span></a>{{else}}<p>No boards in this project.</p>{{end}}</section></aside>{{end}}</div>
{{with .Data.Project}}<section class="surface-card project-governance-admin" id="project-governance" aria-labelledby="project-governance-heading"><header><div><h2 id="project-governance-heading">Features and integration data</h2><p>Control the project feature surface, notification sender, and JSON properties used by apps.</p></div><span class="lozenge">Project {{.ID}}</span></header>
{{if $.Data.GovernanceNotice}}<p class="form-success" role="status">{{$.Data.GovernanceNotice}}</p>{{end}}{{if $.Data.GovernanceError}}<p class="form-error" role="alert">{{$.Data.GovernanceError}}</p>{{end}}
<div class="project-governance-grid"><div><form class="project-details-form project-governance-email" method="post" action="/projects/{{.Key}}/settings/governance"><input type="hidden" name="action" value="email"><h3>Notification sender</h3><label for="project-email-address">Sender email</label><input id="project-email-address" name="emailAddress" type="email" maxlength="254" value="{{.SenderEmail}}" placeholder="Use the site default"><small>Leave blank to restore the site default sender.</small><button class="btn" type="submit">Save sender</button></form>
{{if $.Data.Features}}<section class="project-feature-list" aria-labelledby="project-feature-heading"><h3 id="project-feature-heading">Software features</h3>{{range $.Data.Features}}<form method="post" action="/projects/{{$.Data.Project.Key}}/settings/governance"><input type="hidden" name="action" value="feature"><input type="hidden" name="featureKey" value="{{.Key}}"><input type="hidden" name="state" value="{{if eq .State "ENABLED"}}DISABLED{{else}}ENABLED{{end}}"><span><strong>{{.Name}}</strong><small>{{.Description}}</small></span><span class="lozenge {{if eq .State "ENABLED"}}lozenge-success{{else}}lozenge-default{{end}}">{{.State}}</span><button class="btn" type="submit">{{if eq .State "ENABLED"}}Disable{{else}}Enable{{end}}</button></form>{{end}}</section>{{end}}</div>
<section class="project-properties" aria-labelledby="project-properties-heading"><h3 id="project-properties-heading">App properties</h3><p>Store JSON data against this project through the Jira entity-property contract.</p>{{range $.Data.Properties}}<details><summary><code>{{.Key}}</code><span>Edit</span></summary><form class="project-details-form" method="post" action="/projects/{{$.Data.Project.Key}}/settings/governance"><input type="hidden" name="action" value="property"><input type="hidden" name="propertyKey" value="{{.Key}}"><label for="project-property-{{.Key}}">JSON value</label><textarea id="project-property-{{.Key}}" name="value" rows="5" maxlength="32768" spellcheck="false" required>{{.Value}}</textarea><button class="btn" type="submit">Save property</button></form><form class="project-property-delete" method="post" action="/projects/{{$.Data.Project.Key}}/settings/governance"><input type="hidden" name="action" value="delete-property"><input type="hidden" name="propertyKey" value="{{.Key}}"><button class="btn btn-danger" type="submit">Delete property</button></form></details>{{else}}<p class="empty-state">No app properties yet.</p>{{end}}<form class="project-details-form project-property-create" method="post" action="/projects/{{.Key}}/settings/governance"><input type="hidden" name="action" value="property"><h4>Add property</h4><label for="project-property-key-new">Property key</label><input id="project-property-key-new" name="propertyKey" maxlength="255" required placeholder="app.integration"><label for="project-property-value-new">JSON value</label><textarea id="project-property-value-new" name="value" rows="5" maxlength="32768" spellcheck="false" required>{}</textarea><button class="btn btn-primary" type="submit">Add property</button></form></section></div></section>{{end}}
{{with .Data.Project}}<section class="surface-card project-components-admin" aria-labelledby="project-components-heading"><header><div><h2 id="project-components-heading">Components</h2><p>Group work by architecture or ownership and choose its default assignee.</p></div><span class="lozenge">{{len $.Data.Components}} configured</span></header>
{{if $.Data.ComponentNotice}}<p class="form-success" role="status">Component {{$.Data.ComponentNotice}}.</p>{{end}}{{if $.Data.ComponentError}}<p class="form-error" role="alert">{{$.Data.ComponentError}}</p>{{end}}
<div class="project-components-layout"><div class="project-component-list">{{range $.Data.Components}}{{$component := .}}<details><summary><span><strong>{{.Name}}</strong><small>{{.IssueCount}} work items · {{if .LeadAccountID}}component lead assigned{{else}}{{.RealAssigneeType}}{{end}}</small></span><span>Edit</span></summary><form class="project-details-form" method="post" action="/projects/{{$.Data.Project.Key}}/components/{{.ID}}"><input type="hidden" name="action" value="update"><label for="component-name-{{.ID}}">Name</label><input id="component-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="255" required><label for="component-description-{{.ID}}">Description</label><textarea id="component-description-{{.ID}}" name="description" rows="2" maxlength="1000">{{.Description}}</textarea><label for="component-lead-{{.ID}}">Lead</label><select id="component-lead-{{.ID}}" name="leadAccountId"><option value="">No component lead</option>{{range $.Data.Members}}<option value="{{.ID}}" {{if eq .ID $component.LeadAccountID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select><label for="component-assignee-{{.ID}}">Default assignee</label><select id="component-assignee-{{.ID}}" name="assigneeType"><option value="PROJECT_DEFAULT" {{if eq .AssigneeType "PROJECT_DEFAULT"}}selected{{end}}>Project default</option><option value="PROJECT_LEAD" {{if eq .AssigneeType "PROJECT_LEAD"}}selected{{end}}>Project lead</option><option value="COMPONENT_LEAD" {{if eq .AssigneeType "COMPONENT_LEAD"}}selected{{end}}>Component lead</option><option value="UNASSIGNED" {{if eq .AssigneeType "UNASSIGNED"}}selected{{end}}>Unassigned</option></select><button class="btn" type="submit">Save component</button></form><form class="project-component-delete" method="post" action="/projects/{{$.Data.Project.Key}}/components/{{.ID}}"><input type="hidden" name="action" value="delete"><label for="component-move-{{.ID}}">Move work to</label><select id="component-move-{{.ID}}" name="moveIssuesTo"><option value="">Remove component from work</option>{{range $.Data.Components}}{{if ne .ID $component.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select><button class="btn btn-danger" type="submit">Delete component</button></form></details>{{else}}<div class="empty-state"><strong>No components yet</strong><small>Create one to give a subsystem an owner and reusable work-item value.</small></div>{{end}}</div>
<form class="project-details-form project-component-create" method="post" action="/projects/{{.Key}}/components"><input type="hidden" name="action" value="create"><h3>Create component</h3><label for="component-name-new">Name</label><input id="component-name-new" name="name" maxlength="255" required><label for="component-description-new">Description</label><textarea id="component-description-new" name="description" rows="3" maxlength="1000"></textarea><label for="component-lead-new">Lead</label><select id="component-lead-new" name="leadAccountId"><option value="">No component lead</option>{{range $.Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><label for="component-assignee-new">Default assignee</label><select id="component-assignee-new" name="assigneeType"><option value="PROJECT_DEFAULT">Project default</option><option value="PROJECT_LEAD">Project lead</option><option value="COMPONENT_LEAD">Component lead</option><option value="UNASSIGNED">Unassigned</option></select><button class="btn btn-primary" type="submit">Create component</button></form></div></section>{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
