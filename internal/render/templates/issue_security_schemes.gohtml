{{define "page_issue_security_schemes"}}
<!doctype html><html lang="en"><head><title>Issue security schemes · ZZIRA</title>{{template "head" .}}</head>
<body class="page-issue-security"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Issue security schemes</span></nav>
<header class="page-header security-page-header"><div><span class="eyebrow">Jira settings</span><h1>Issue security schemes</h1><p>Control who can discover sensitive work after they enter a project.</p></div><a class="btn" href="/rest/api/3/issuesecurityschemes">View scheme API</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card security-scheme-create" aria-labelledby="security-create-heading"><div class="security-shield" aria-hidden="true"><span></span></div><div><h2 id="security-create-heading">Create an access boundary</h2><p>A scheme groups reusable visibility levels. Add rules before assigning it to a project.</p></div><form class="project-details-form" method="post" action="/settings/issue-security-schemes"><label for="security-scheme-name-new">Scheme name</label><input id="security-scheme-name-new" name="name" maxlength="60" required><label for="security-scheme-description-new">Description</label><textarea id="security-scheme-description-new" name="description" rows="2" maxlength="255"></textarea><button class="btn btn-primary" type="submit">Create scheme</button></form></section>
<div class="security-scheme-list">{{range .Data.Schemes}}{{$card := .}}<article class="surface-card security-scheme-card" data-scheme-id="{{.Scheme.ID}}"><header><div><span class="security-scheme-mark" aria-hidden="true">{{len .Levels}}</span><div><h2>{{.Scheme.Name}}</h2><p>{{len .Projects}} assigned projects · {{len .Levels}} visibility levels</p></div></div><span class="lozenge">ID {{.Scheme.ID}}</span></header>
<div class="security-scheme-summary"><form class="project-details-form" method="post" action="/settings/issue-security-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="update"><label for="security-name-{{.Scheme.ID}}">Name</label><input id="security-name-{{.Scheme.ID}}" name="name" value="{{.Scheme.Name}}" maxlength="60" required><label for="security-description-{{.Scheme.ID}}">Description</label><textarea id="security-description-{{.Scheme.ID}}" name="description" rows="2" maxlength="255">{{.Scheme.Description}}</textarea><button class="btn" type="submit">Save details</button></form><section><h3>Projects inside this boundary</h3><ul class="permission-project-list">{{range .Projects}}<li><a href="/projects/{{.Key}}/settings/issue-security">{{.Name}}</a><span>{{.Key}}</span></li>{{else}}<li class="empty-state">No projects use this scheme.</li>{{end}}</ul>{{if $.Data.Projects}}<form class="permission-project-assign" method="post" action="/settings/issue-security-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="assign-project"><label for="security-project-{{.Scheme.ID}}">Assign a project</label><select id="security-project-{{.Scheme.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign scheme</button></form>{{end}}</section></div>
<section class="security-levels" aria-labelledby="security-levels-{{.Scheme.ID}}"><div class="permission-section-heading"><div><h3 id="security-levels-{{.Scheme.ID}}">Visibility levels</h3><p>Each rule grants access. Jira administrators can always inspect restricted work.</p></div></div>
<div class="security-level-list">{{range .Levels}}{{$level := .}}<article class="security-level-card" data-level-id="{{.Level.ID}}"><header><div><h4>{{.Level.Name}}</h4><p>{{.Level.Description}}</p></div>{{if .Level.IsDefault}}<span class="lozenge lozenge-current">Default for new work</span>{{else}}<form method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="set-default"><input type="hidden" name="levelId" value="{{.Level.ID}}"><button class="btn btn-subtle" type="submit">Make default</button></form>{{end}}</header>
<div class="security-rule-ledger" role="table" aria-label="Who can see {{.Level.Name}}"><div class="security-rule-heading" role="row"><span role="columnheader">Visible to</span><span role="columnheader">Rule</span><span role="columnheader">Action</span></div>{{range .Members}}<div class="security-rule-row" role="row"><span role="cell"><strong>{{.Label}}</strong></span><span role="cell"><small>{{.Member.HolderType}}</small></span><form role="cell" method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-member"><input type="hidden" name="levelId" value="{{$level.Level.ID}}"><input type="hidden" name="memberId" value="{{.Member.ID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.Label}}</span></button></form></div>{{else}}<div class="empty-state"><strong>No visibility rules</strong><small>Only Jira administrators can see work at this level.</small></div>{{end}}</div>
<div class="security-rule-create"><form method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="add-member"><input type="hidden" name="levelId" value="{{.Level.ID}}"><label for="security-context-{{$card.Scheme.ID}}-{{.Level.ID}}">Add a contextual rule</label><select id="security-context-{{$card.Scheme.ID}}-{{.Level.ID}}" name="holderType"><option value="reporter">Reporter</option><option value="assignee">Current assignee</option><option value="projectLead">Project lead</option></select><button class="btn" type="submit">Add rule</button></form>
{{if $.Data.Members}}<form method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="add-member"><input type="hidden" name="levelId" value="{{.Level.ID}}"><input type="hidden" name="holderType" value="user"><label for="security-user-{{$card.Scheme.ID}}-{{.Level.ID}}">Add a person</label><select id="security-user-{{$card.Scheme.ID}}-{{.Level.ID}}" name="userValue">{{range $.Data.Members}}{{if .Active}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{end}}</select><button class="btn" type="submit">Add person</button></form>{{end}}
{{if $.Data.Groups}}<form method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="add-member"><input type="hidden" name="levelId" value="{{.Level.ID}}"><input type="hidden" name="holderType" value="group"><label for="security-group-{{$card.Scheme.ID}}-{{.Level.ID}}">Add a group</label><select id="security-group-{{$card.Scheme.ID}}-{{.Level.ID}}" name="groupValue">{{range $.Data.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add group</button></form>{{end}}
{{if $.Data.Roles}}<form method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="add-member"><input type="hidden" name="levelId" value="{{.Level.ID}}"><input type="hidden" name="holderType" value="projectRole"><label for="security-role-{{$card.Scheme.ID}}-{{.Level.ID}}">Add a project role</label><select id="security-role-{{$card.Scheme.ID}}-{{.Level.ID}}" name="roleValue">{{range $.Data.Roles}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add role</button></form>{{end}}</div>
<details class="security-level-edit"><summary>Edit or remove level</summary><div><form class="project-details-form" method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="update-level"><input type="hidden" name="levelId" value="{{.Level.ID}}"><label for="security-level-name-{{.Level.ID}}">Level name</label><input id="security-level-name-{{.Level.ID}}" name="name" value="{{.Level.Name}}" maxlength="60" required><label for="security-level-description-{{.Level.ID}}">Description</label><textarea id="security-level-description-{{.Level.ID}}" name="description" rows="2" maxlength="255">{{.Level.Description}}</textarea><button class="btn" type="submit">Save level</button></form><form class="project-details-form" method="post" action="/settings/issue-security-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-level"><input type="hidden" name="levelId" value="{{.Level.ID}}"><label for="security-replacement-{{.Level.ID}}">Move existing work to</label><select id="security-replacement-{{.Level.ID}}" name="replaceWith"><option value="">No security level</option>{{range $card.Levels}}{{if ne .Level.ID $level.Level.ID}}<option value="{{.Level.ID}}">{{.Level.Name}}</option>{{end}}{{end}}</select><button class="btn btn-danger" type="submit">Remove level</button></form></div></details></article>{{else}}<div class="empty-state"><strong>No visibility levels</strong><small>Add a level before assigning this scheme to a project.</small></div>{{end}}</div>
<form class="security-level-create project-details-form" method="post" action="/settings/issue-security-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-level"><h4>Add a visibility level</h4><label for="security-level-new-{{.Scheme.ID}}">Level name</label><input id="security-level-new-{{.Scheme.ID}}" name="name" maxlength="255" required><label for="security-level-description-new-{{.Scheme.ID}}">Description</label><textarea id="security-level-description-new-{{.Scheme.ID}}" name="description" rows="2" maxlength="4000"></textarea><label><input type="checkbox" name="default" value="true"> Use by default for new work</label><button class="btn btn-primary" type="submit">Add level</button></form></section>
<details class="permission-scheme-delete"><summary class="quiet-action">Delete scheme</summary><form method="post" action="/settings/issue-security-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete"><p>Reassign every project first. Restricted work remains protected during migration.</p><button class="btn btn-danger" type="submit">Delete scheme</button></form></details></article>{{else}}<section class="surface-card empty-state"><strong>No issue security schemes</strong><small>Create one to add visibility levels for sensitive work.</small></section>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_issue_security"}}
<!doctype html><html lang="en"><head><title>Issue security · {{.Data.Project.Name}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-issue-security"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Issue security</span></nav>
<header class="page-header"><div><span class="eyebrow">Project settings</span><h1>Issue security</h1><p>Review who can discover restricted work in {{.Data.Project.Name}}.</p></div><a class="btn" href="/rest/api/3/project/{{.Data.Project.Key}}/issuesecuritylevelscheme">View project API</a></header>
{{with .Data.Scheme}}<section class="surface-card project-security-overview"><header><div><span class="security-scheme-mark" aria-hidden="true">{{len .Levels}}</span><div><h2>{{.Scheme.Name}}</h2><p>{{.Scheme.Description}}</p></div></div><span class="lozenge">{{len .Levels}} levels</span></header><div class="project-security-levels">{{range .Levels}}<article><header><h3>{{.Level.Name}}</h3>{{if .Level.IsDefault}}<span class="lozenge lozenge-current">Default</span>{{end}}</header><p>{{.Level.Description}}</p><ul>{{range .Members}}<li><strong>{{.Label}}</strong><small>{{.Member.HolderType}}</small></li>{{else}}<li><strong>Jira administrators only</strong><small>No additional rules</small></li>{{end}}</ul></article>{{end}}</div></section>{{else}}<section class="surface-card empty-state"><strong>No issue security scheme assigned</strong><small>Work in this project has no issue-level visibility restriction.</small></section>{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
