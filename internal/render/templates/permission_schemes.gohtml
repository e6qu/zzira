{{define "permission_select"}}<select name="permission" required>{{range .}}<option value="{{.Key}}">{{.Name}}</option>{{end}}</select>{{end}}

{{define "page_permission_schemes"}}
<!doctype html><html lang="en"><head><title>Permission schemes · ZZIRA</title>{{template "head" .}}</head>
<body class="page-permission-schemes"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Permission schemes</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Permission schemes</h1><p>Control who can see, administer, and work in projects through reusable grants.</p></div><a class="btn" href="/rest/api/3/permissionscheme?expand=permissions">View scheme API</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card permission-scheme-create" aria-labelledby="permission-scheme-create-heading"><div><h2 id="permission-scheme-create-heading">Create a scheme</h2><p>Start with an empty scheme, add explicit grants, then assign projects.</p></div><form class="project-details-form" method="post" action="/settings/permission-schemes"><label for="permission-scheme-name-new">Scheme name</label><input id="permission-scheme-name-new" name="name" maxlength="255" required><label for="permission-scheme-description-new">Description</label><textarea id="permission-scheme-description-new" name="description" rows="2" maxlength="2000"></textarea><button class="btn btn-primary" type="submit">Create scheme</button></form></section>
<div class="permission-scheme-list">{{range .Data.Schemes}}{{$card := .}}<article class="surface-card permission-scheme-card" data-scheme-id="{{.Scheme.ID}}"><header><div><span class="permission-scheme-mark" aria-hidden="true">{{if .Scheme.Default}}D{{else}}P{{end}}</span><div><h2>{{.Scheme.Name}}</h2><p>ID {{.Scheme.ID}} · {{.Scheme.ProjectCount}} assigned project{{if ne .Scheme.ProjectCount 1}}s{{end}}</p></div></div>{{if .Scheme.Default}}<span class="lozenge lozenge-current">Default</span>{{else}}<span class="lozenge">Custom</span>{{end}}</header>
<div class="permission-scheme-summary"><section><h3>Scheme details</h3><form class="project-details-form" method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="update"><label for="permission-scheme-name-{{.Scheme.ID}}">Name</label><input id="permission-scheme-name-{{.Scheme.ID}}" name="name" value="{{.Scheme.Name}}" maxlength="255" required><label for="permission-scheme-description-{{.Scheme.ID}}">Description</label><textarea id="permission-scheme-description-{{.Scheme.ID}}" name="description" rows="3" maxlength="2000">{{.Scheme.Description}}</textarea><button class="btn" type="submit">Save details</button></form></section>
<section><h3>Assigned projects</h3><ul class="permission-project-list">{{range .Projects}}<li><a href="/projects/{{.Key}}/settings/permissions">{{.Name}}</a><span>{{.Key}}</span></li>{{else}}<li class="empty-state">No projects use this scheme.</li>{{end}}</ul>{{if $.Data.Projects}}<form class="permission-project-assign" method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="assign-project"><label for="permission-project-{{.Scheme.ID}}">Assign a project</label><select id="permission-project-{{.Scheme.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign</button></form>{{end}}</section></div>
<section class="permission-grants" aria-labelledby="permission-grants-{{.Scheme.ID}}"><div class="permission-section-heading"><div><h3 id="permission-grants-{{.Scheme.ID}}">Permission grants</h3><p>Every matching grant allows the action; issue-level holders are evaluated against the current work item.</p></div><span class="lozenge">{{len .Grants}} grants</span></div>
<div class="permission-grant-table" role="table" aria-label="Permission grants for {{.Scheme.Name}}"><div class="permission-grant-header" role="row"><span role="columnheader">Permission</span><span role="columnheader">Granted to</span><span role="columnheader">Action</span></div>{{range .Grants}}<div class="permission-grant-row" role="row"><span role="cell"><strong>{{.PermissionName}}</strong><small>{{.Grant.Permission}}</small></span><span role="cell"><strong>{{.HolderLabel}}</strong><small>{{.Grant.HolderType}}</small></span><form role="cell" method="post" action="/settings/permission-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-grant"><input type="hidden" name="grantId" value="{{.Grant.ID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.PermissionName}} grant for {{.HolderLabel}}</span></button></form></div>{{else}}<div class="empty-state">No permissions are granted. Only Jira administrators can access this project.</div>{{end}}</div>
<div class="permission-grant-create"><form method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-grant"><input type="hidden" name="holderType" value="projectRole"><label>Grant permission{{template "permission_select" $.Data.Permissions}}</label><label for="permission-role-{{.Scheme.ID}}">To project role</label><select id="permission-role-{{.Scheme.ID}}" name="roleValue">{{range $.Data.Roles}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Grant to role</button></form>
<form method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-grant"><input type="hidden" name="holderType" value="user"><label>Grant permission{{template "permission_select" $.Data.Permissions}}</label><label for="permission-user-{{.Scheme.ID}}">To person</label><select id="permission-user-{{.Scheme.ID}}" name="userValue">{{range $.Data.Members}}{{if .Active}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{end}}</select><button class="btn" type="submit">Grant to person</button></form>
<form method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-grant"><input type="hidden" name="holderType" value="group"><label>Grant permission{{template "permission_select" $.Data.Permissions}}</label><label for="permission-group-{{.Scheme.ID}}">To group</label><select id="permission-group-{{.Scheme.ID}}" name="groupValue">{{range $.Data.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Grant to group</button></form>
<form method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-grant"><label>Grant permission{{template "permission_select" $.Data.Permissions}}</label><label for="permission-context-{{.Scheme.ID}}">To context</label><select id="permission-context-{{.Scheme.ID}}" name="holderType"><option value="anyone">Anyone</option><option value="projectLead">Project lead</option><option value="assignee">Current assignee</option><option value="reporter">Work item reporter</option><option value="sd.customer.portal.only">Service customers (portal)</option></select><button class="btn" type="submit">Grant to context</button></form></div></section>
{{if not .Scheme.Default}}<details class="permission-scheme-delete"><summary class="quiet-action">Delete scheme</summary><form method="post" action="/settings/permission-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete"><p>Reassign every project before deleting this scheme.</p><button class="btn btn-danger" type="submit">Delete scheme</button></form></details>{{end}}</article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_permissions"}}
<!doctype html><html lang="en"><head><title>Permissions · {{.Data.Project.Name}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-permission-schemes"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Permissions</span></nav>
<header class="page-header"><div><span class="eyebrow">Project settings</span><h1>Permissions</h1><p>{{.Data.Scheme.Scheme.Name}} controls access to {{.Data.Project.Name}}.</p></div><a class="btn" href="/rest/api/3/project/{{.Data.Project.Key}}/permissionscheme?expand=permissions">View project API</a></header>
<section class="surface-card project-permission-overview"><header><div><span class="permission-scheme-mark" aria-hidden="true">{{if .Data.Scheme.Scheme.Default}}D{{else}}P{{end}}</span><div><h2>{{.Data.Scheme.Scheme.Name}}</h2><p>{{.Data.Scheme.Scheme.Description}}</p></div></div><span class="lozenge">{{len .Data.Scheme.Grants}} grants</span></header>
<div class="permission-grant-table" role="table" aria-label="Project permission grants"><div class="permission-grant-header" role="row"><span role="columnheader">Permission</span><span role="columnheader">Granted to</span></div>{{range .Data.Scheme.Grants}}<div class="permission-grant-row project-permission-row" role="row"><span role="cell"><strong>{{.PermissionName}}</strong><small>{{.Grant.Permission}}</small></span><span role="cell"><strong>{{.HolderLabel}}</strong><small>{{.Grant.HolderType}}</small></span></div>{{else}}<div class="empty-state">No project permissions are granted.</div>{{end}}</div></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
