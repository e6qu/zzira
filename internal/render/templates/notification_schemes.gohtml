{{define "notification_event_options"}}{{range .}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}

{{define "page_notification_schemes"}}
<!doctype html><html lang="en"><head><title>Notification schemes · ZZIRA</title>{{template "head" .}}</head>
<body class="page-notification-schemes"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Notification schemes</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Notification schemes</h1><p>Choose who receives inbox and email updates for each work item event.</p></div><a class="btn" href="/rest/api/3/notificationscheme?expand=all">View scheme API</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card permission-scheme-create" aria-labelledby="notification-scheme-create-heading"><div><h2 id="notification-scheme-create-heading">Create a scheme</h2><p>Create a reusable event policy, add recipients, then assign projects.</p></div><form class="project-details-form" method="post" action="/settings/notification-schemes"><label for="notification-scheme-name-new">Scheme name</label><input id="notification-scheme-name-new" name="name" maxlength="255" required><label for="notification-scheme-description-new">Description</label><textarea id="notification-scheme-description-new" name="description" rows="2" maxlength="4000"></textarea><button class="btn btn-primary" type="submit">Create scheme</button></form></section>
<div class="permission-scheme-list">{{range .Data.Schemes}}{{$card := .}}<article class="surface-card permission-scheme-card" data-scheme-id="{{.Scheme.ID}}"><header><div><span class="permission-scheme-mark notification-scheme-mark" aria-hidden="true">{{if .Scheme.Default}}D{{else}}N{{end}}</span><div><h2>{{.Scheme.Name}}</h2><p>ID {{.Scheme.ID}} · {{.Scheme.ProjectCount}} assigned project{{if ne .Scheme.ProjectCount 1}}s{{end}}</p></div></div>{{if .Scheme.Default}}<span class="lozenge lozenge-current">Default</span>{{else}}<span class="lozenge">Custom</span>{{end}}</header>
<div class="permission-scheme-summary"><section><h3>Scheme details</h3><form class="project-details-form" method="post" action="/settings/notification-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="update"><label for="notification-scheme-name-{{.Scheme.ID}}">Name</label><input id="notification-scheme-name-{{.Scheme.ID}}" name="name" value="{{.Scheme.Name}}" maxlength="255" required><label for="notification-scheme-description-{{.Scheme.ID}}">Description</label><textarea id="notification-scheme-description-{{.Scheme.ID}}" name="description" rows="3" maxlength="4000">{{.Scheme.Description}}</textarea><button class="btn" type="submit">Save details</button></form></section>
<section><h3>Assigned projects</h3><ul class="permission-project-list">{{range .Projects}}<li><a href="/projects/{{.Key}}/settings/notifications">{{.Name}}</a><span>{{.Key}}</span></li>{{else}}<li class="empty-state">No projects use this scheme.</li>{{end}}</ul>{{if $.Data.Projects}}<form class="permission-project-assign" method="post" action="/settings/notification-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="assign-project"><label for="notification-project-{{.Scheme.ID}}">Assign a project</label><select id="notification-project-{{.Scheme.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign</button></form>{{end}}</section></div>
<section class="permission-grants" aria-labelledby="notification-rules-{{.Scheme.ID}}"><div class="permission-section-heading"><div><h3 id="notification-rules-{{.Scheme.ID}}">Event recipients</h3><p>A person matched more than once receives one inbox update and one email.</p></div><span class="lozenge">{{len .Entries}} rules</span></div>
<div class="permission-grant-table notification-rule-table" role="table" aria-label="Event recipients for {{.Scheme.Name}}"><div class="permission-grant-header" role="row"><span role="columnheader">Event</span><span role="columnheader">Recipient</span><span role="columnheader">Action</span></div>{{range .Entries}}<div class="permission-grant-row" role="row"><span role="cell"><strong>{{.EventName}}</strong><small>Event {{.Entry.EventID}}</small></span><span role="cell"><strong>{{.RecipientLabel}}</strong><small>{{.Entry.NotificationType}}</small></span><form role="cell" method="post" action="/settings/notification-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-notification"><input type="hidden" name="notificationId" value="{{.Entry.ID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.EventName}} recipient {{.RecipientLabel}}</span></button></form></div>{{else}}<div class="empty-state">No event recipients. Work item events do not send notifications through this scheme.</div>{{end}}</div>
<form class="notification-rule-create" method="post" action="/settings/notification-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="add-notification"><label for="notification-event-{{.Scheme.ID}}">Work item event</label><select id="notification-event-{{.Scheme.ID}}" name="eventId" required>{{template "notification_event_options" $.Data.Events}}</select><label for="notification-recipient-type-{{.Scheme.ID}}">Recipient</label><select id="notification-recipient-type-{{.Scheme.ID}}" name="notificationType" required><option value="CurrentAssignee">Current assignee</option><option value="Reporter">Reporter</option><option value="CurrentUser">Person who triggered event</option><option value="ProjectLead">Project lead</option><option value="ComponentLead">Component leads</option><option value="AllWatchers">All watchers</option><option value="User">Specific person</option><option value="Group">Group</option><option value="ProjectRole">Project role</option><option value="EmailAddress">Email address</option><option value="UserCustomField">User custom field</option><option value="GroupCustomField">Group custom field</option></select><label for="notification-parameter-{{.Scheme.ID}}">Recipient value <span class="muted">(only for a specific recipient)</span></label><input id="notification-parameter-{{.Scheme.ID}}" name="parameter" list="notification-recipient-values" maxlength="320" autocomplete="off" placeholder="Account ID, group, role ID, field ID, or email"><button class="btn" type="submit">Add recipient</button></form></section>
{{if not .Scheme.Default}}<details class="permission-scheme-delete"><summary class="quiet-action">Delete scheme</summary><form method="post" action="/settings/notification-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete"><p>Reassign every project before deleting this scheme.</p><button class="btn btn-danger" type="submit">Delete scheme</button></form></details>{{end}}</article>{{end}}</div>
<datalist id="notification-recipient-values">{{range .Data.Members}}{{if .Active}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{end}}{{range .Data.Groups}}<option value="{{.Name}}">Group · {{.Name}}</option>{{end}}{{range .Data.Roles}}<option value="{{.ID}}">Role · {{.Name}}</option>{{end}}{{range .Data.Fields}}<option value="{{.ID}}">Field · {{.Name}}</option>{{end}}</datalist>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_notifications"}}
<!doctype html><html lang="en"><head><title>Notifications · {{.Data.Project.Name}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-notification-schemes"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Notifications</span></nav>
<header class="page-header"><div><span class="eyebrow">Project settings</span><h1>Notifications</h1><p>{{.Data.Scheme.Scheme.Name}} controls work item notifications for {{.Data.Project.Name}}.</p></div><a class="btn" href="/rest/api/3/project/{{.Data.Project.Key}}/notificationscheme?expand=all">View project API</a></header>
<section class="surface-card project-permission-overview"><header><div><span class="permission-scheme-mark notification-scheme-mark" aria-hidden="true">{{if .Data.Scheme.Scheme.Default}}D{{else}}N{{end}}</span><div><h2>{{.Data.Scheme.Scheme.Name}}</h2><p>{{.Data.Scheme.Scheme.Description}}</p></div></div><span class="lozenge">{{len .Data.Scheme.Entries}} rules</span></header>
<div class="permission-grant-table notification-rule-table" role="table" aria-label="Project notification recipients"><div class="permission-grant-header" role="row"><span role="columnheader">Event</span><span role="columnheader">Recipient</span></div>{{range .Data.Scheme.Entries}}<div class="permission-grant-row project-permission-row" role="row"><span role="cell"><strong>{{.EventName}}</strong><small>Event {{.Entry.EventID}}</small></span><span role="cell"><strong>{{.RecipientLabel}}</strong><small>{{.Entry.NotificationType}}</small></span></div>{{else}}<div class="empty-state">This scheme has no event recipients.</div>{{end}}</div></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
