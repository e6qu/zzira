{{define "head"}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>ZZIRA</title>
<script>
  (function () {
    var saved = localStorage.getItem('zzira-theme');
    var theme = saved === 'light' || saved === 'dark'
      ? saved
      : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  }());
</script>
<link rel="stylesheet" href="/static/css/tokens.css?v=2">
<link rel="preload" href="/static/zzira-worker.wasm" as="fetch" crossorigin>
<link rel="preload" href="/static/sqlite/sqlite3.wasm" as="fetch" crossorigin>
<script src="/static/htmx/htmx.min.js" defer></script>
<script src="/static/wasm/wasm_exec.js" defer></script>
<script src="/static/app.js?v=9" defer></script>
{{end}}

{{define "avatar"}}
<span class="avatar" role="img" aria-label="{{.DisplayName}}"><span aria-hidden="true">{{initials .DisplayName}}</span></span>
{{end}}

{{define "header"}}
<header class="global-header">
  <a class="logo" href="/">ZZIRA</a>
  <form class="global-search" method="get" action="/issues/ZZ" role="search">
    <label class="sr-only" for="global-jql-query">Search issues with JQL</label>
    <input id="global-jql-query" name="jql" placeholder="Search issues" autocomplete="off">
  </form>
  <button type="button" class="btn btn-primary header-create" hx-get="/issues/new" hx-target="#modal-root"
          hx-swap="innerHTML" onclick="zzira.openModal(this)">Create</button>
  {{if .User}}
  <details class="user-menu">
    <summary aria-label="Open account menu">{{template "avatar" .User}}</summary>
    <form method="post" action="/logout">
      <button type="submit">Log out</button>
    </form>
  </details>
  {{end}}
  <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
    <span aria-hidden="true">☀️</span>
  </button>
</header>
{{end}}

{{define "workspace_nav"}}
<aside class="workspace-nav" aria-label="Workspace navigation">
  <nav>
    <a href="/dashboard">Your work</a>
    <a href="/issues/ZZ">Projects</a>
    <a href="/board/brd_default">Boards</a>
  </nav>
</aside>
{{end}}

{{define "create_dialog"}}
<div class="modal-backdrop" data-modal-backdrop aria-hidden="true"></div>
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-issue-title" tabindex="-1">
  <h2 id="create-issue-title">Create issue</h2>
  <form method="post" action="/issues" hx-post="/issues" hx-target="#modal-root" hx-swap="innerHTML">
    <label for="create-project">Project</label>
    <input id="create-project" name="project" value="{{.Project.Key}}" readonly>
    <label for="create-issuetype">Issue type</label>
      <select id="create-issuetype" name="issuetype">
        <option value="{{.IssueType.ID}}">{{.IssueType.Name}}</option>
      </select>
    <label for="create-summary">Summary</label>
    <input id="create-summary" name="summary" required autofocus maxlength="255" placeholder="What needs to be done?">
    <label for="create-description">Description</label>
    <textarea id="create-description" name="description" rows="6" placeholder="Describe the task…"></textarea>
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <div class="modal-actions">
      <button type="button" class="btn" onclick="zzira.closeModal()">Cancel</button>
      <button type="submit" class="btn btn-primary">Create</button>
    </div>
  </form>
</div>
{{end}}

{{define "issue_view"}}
<div class="issue-view" id="issue-root" data-issue-id="{{.Issue.ID}}" data-issue-key="{{.Issue.Key}}" data-seq="{{.Issue.UpdatedSeq}}">
  <div class="issue-breadcrumbs">
    <a href="/issues/{{.ProjectKey}}">{{.ProjectKey}}</a> / {{.Issue.Key}}
  </div>
  <div class="issue-transitions">
    {{range .Transitions}}
    <form method="post" action="/issues/{{$.Issue.Key}}/transition" hx-post="/issues/{{$.Issue.Key}}/transition" hx-target="#issue-root" hx-swap="outerHTML">
      <input type="hidden" name="transition" value="{{.ID}}">
      <button type="submit" class="btn btn-transition">{{.Name}}</button>
    </form>
    {{end}}
    {{if .CanEdit}}
    <button type="button" class="btn" onclick="zzira.openEdit('{{.Issue.Key}}')">Edit</button>
    <button type="button" class="btn btn-danger" hx-delete="/issues/{{.Issue.Key}}"
            hx-confirm="Delete {{.Issue.Key}}?" hx-redirect="/issues/{{.ProjectKey}}">Delete</button>
    {{end}}
  </div>
  <div class="issue-main">
    <div class="issue-primary">
      <h1 class="issue-summary" data-field="summary">{{.Issue.Summary}}</h1>
      <section class="issue-description" data-field="description">
        {{adfHTML .Issue.Description}}
      </section>

      <section class="issue-comments">
        <h2>Comments</h2>
        <div id="comments-list">
          {{range .Comments}}
          <div class="comment" id="{{.ID}}">
            <div class="comment-head">
              {{if .AuthorName}}<span class="avatar" role="img" aria-label="{{.AuthorName}}"><span aria-hidden="true">{{initials .AuthorName}}</span></span>{{end}}
              <strong>{{if .AuthorName}}{{.AuthorName}}{{else}}Unknown{{end}}</strong>
              <span class="muted">{{.Created}}</span>
            </div>
            <div class="comment-body">{{adfHTML .Body}}</div>
          </div>
          {{else}}
          <p class="muted">No comments yet.</p>
          {{end}}
        </div>
        {{if .CanEdit}}
        <form class="comment-form" method="post" action="/issues/{{.Issue.Key}}/comments" hx-post="/issues/{{.Issue.Key}}/comments" hx-target="#issue-root" hx-swap="outerHTML">
          <div class="editor-toolbar" role="toolbar" aria-label="Comment formatting" data-editor-toolbar>
            <button type="button" data-cmd="bold" aria-label="Bold"><strong aria-hidden="true">B</strong></button>
            <button type="button" data-cmd="italic" aria-label="Italic"><em aria-hidden="true">I</em></button>
            <button type="button" data-cmd="insertUnorderedList" aria-label="Bullet list"><span aria-hidden="true">&bull;&equiv;</span></button>
            <button type="button" data-cmd="code" aria-label="Code"><span aria-hidden="true">&lt;/&gt;</span></button>
          </div>
          <span id="comment-editor-label" class="sr-only">Add a comment</span>
          <div id="comment-editor" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="comment-editor-label" data-rich-editor data-target-name="adf"
               data-placeholder="Add a comment…"></div>
          <input type="hidden" name="adf">
          <button type="submit" class="btn btn-primary">Comment</button>
        </form>
        {{end}}
      </section>

      <section class="issue-attachments">
        <h2>Attachments</h2>
        <div id="attachments-list">
          {{range .Attachments}}
          <div class="attachment">
            <span class="attachment-icon">&#128206;</span>
            <a href="/rest/api/3/attachment/content/{{.ID}}">{{.Filename}}</a>
            <span class="muted">{{humanSize .Size}}</span>
          </div>
          {{else}}
          <p class="muted">No attachments.</p>
          {{end}}
        </div>
        {{if .CanEdit}}
        <form class="upload-form" method="post" action="/issues/{{.Issue.Key}}/attachments" enctype="multipart/form-data">
          <label class="sr-only" for="attachment-file">Choose attachment</label>
          <input id="attachment-file" type="file" name="file" required>
          <button type="submit" class="btn">Upload</button>
        </form>
        {{end}}
      </section>

      <section class="issue-worklogs">
        <h2>Worklog</h2>
        <div id="worklogs-list">
          {{range .Worklogs}}
          <div class="worklog">
            <div class="comment-head">
              {{if .AuthorName}}<span class="avatar" role="img" aria-label="{{.AuthorName}}"><span aria-hidden="true">{{initials .AuthorName}}</span></span>{{end}}
              <strong>{{if .AuthorName}}{{.AuthorName}}{{end}}</strong>
              <span class="lozenge">{{timeSpent .TimeSpentSeconds}}</span>
              <span class="muted">{{.Created}}</span>
            </div>
            {{if .Comment}}<div class="comment-body">{{adfHTML .Comment}}</div>{{end}}
          </div>
          {{else}}
          <p class="muted">No time logged.</p>
          {{end}}
        </div>
        {{if .CanEdit}}
        <form class="worklog-form" method="post" action="/issues/{{.Issue.Key}}/worklogs" hx-post="/issues/{{.Issue.Key}}/worklogs" hx-target="#issue-root" hx-swap="outerHTML">
          <label class="sr-only" for="worklog-seconds">Time spent in seconds</label>
          <input id="worklog-seconds" name="seconds" type="number" min="1" placeholder="Seconds" required class="worklog-seconds">
          <label class="sr-only" for="worklog-comment">Work description</label>
          <input id="worklog-comment" name="comment" placeholder="What did you work on? (optional)" class="worklog-comment">
          <button type="submit" class="btn btn-primary">Log work</button>
        </form>
        {{end}}
      </section>

      <section class="issue-history">
        <h2>History</h2>
        {{range .History}}
        <div class="history-entry">
          <div class="comment-head">
            {{if .Author}}<span class="avatar" role="img" aria-label="{{.Author.DisplayName}}"><span aria-hidden="true">{{initials .Author.DisplayName}}</span></span>{{end}}
            <strong>{{if .Author}}{{.Author.DisplayName}}{{end}}</strong>
            <span class="muted">{{.Created}}</span>
          </div>
          <ul>
            {{range .Items}}<li><strong>{{.Field}}</strong> changed{{if .FromString}} from “{{.FromString}}”{{end}}{{if .ToString}} to “{{.ToString}}”{{end}}</li>{{end}}
          </ul>
        </div>
        {{else}}
        <p class="muted">No changes recorded.</p>
        {{end}}
      </section>
    </div>
    <aside class="issue-details">
      <dl>
        <dt>Status</dt>
        <dd><span class="lozenge {{statusClass .Issue.Status.Category}}">{{.Issue.Status.Name}}</span></dd>
        <dt>Type</dt>
        <dd>{{.Issue.IssueType.Name}}</dd>
        {{if .Issue.Priority}}<dt>Priority</dt><dd>{{.Issue.Priority.Name}}</dd>{{end}}
        <dt>Assignee</dt>
        <dd>{{if .Issue.Assignee}}{{template "avatar" .Issue.Assignee}}{{else}}Unassigned{{end}}</dd>
        <dt>Reporter</dt>
        <dd>{{if .Issue.Reporter}}{{template "avatar" .Issue.Reporter}}{{end}}</dd>
      </dl>
    </aside>
  </div>
</div>
{{end}}

{{define "edit_dialog"}}
<div class="modal-backdrop" data-modal-backdrop aria-hidden="true"></div>
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="edit-issue-title" tabindex="-1">
  <h2 id="edit-issue-title">Edit {{.Issue.Key}}</h2>
  <form method="post" action="/issues/{{.Issue.Key}}/edit" hx-post="/issues/{{.Issue.Key}}/edit" hx-target="#issue-root" hx-swap="outerHTML">
    <label for="edit-summary">Summary</label>
    <input id="edit-summary" name="summary" value="{{.Issue.Summary}}" required maxlength="255">
    <label for="edit-description">Description</label>
    <textarea id="edit-description" name="description" rows="6">{{adfToText .Issue.Description}}</textarea>
    <label for="edit-assignee">Assignee</label>
      <select id="edit-assignee" name="assignee">
        <option value="">Unassigned</option>
        {{$cur := ""}}{{if .Issue.Assignee}}{{$cur = .Issue.Assignee.ID}}{{end}}
        {{range .Members}}
        <option value="{{.ID}}" {{if eq .ID $cur}}selected{{end}}>{{.DisplayName}}</option>
        {{end}}
      </select>
    {{if .SecurityLevels}}
    <label for="edit-security">Security</label>
      <select id="edit-security" name="security">
        <option value="">Public</option>
        {{$curSec := .Issue.SecurityLevelID}}
        {{range .SecurityLevels}}
        <option value="{{.ID}}" {{if eq .ID $curSec}}selected{{end}}>{{.Name}}</option>
        {{end}}
      </select>
    {{end}}
    {{range .CustomFields}}
    <label for="field-{{.ID}}">{{.Name}}</label>
      <input id="field-{{.ID}}" name="{{.ID}}" value="{{customFieldValue $.Issue .ID}}">
    {{end}}
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <div class="modal-actions">
      <button type="button" class="btn" onclick="zzira.closeModal()">Cancel</button>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>
</div>
{{end}}

{{define "page_home"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page">
    <h1>Welcome to ZZIRA</h1>
    <p>Local-first, delta-synced issue tracking. Create an issue to see it sync.</p>

    <section class="home-links">
      <a class="btn" href="/issues/ZZ">Issue navigator</a>
      <a class="btn" href="/board/brd_default">Board</a>
    </section>

    <section class="dashboard-cards">
      {{$data := .Data}}
      {{range $data.StatusCounts}}
      <div class="dash-card">
        <span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span>
        <div class="dash-count">{{.Count}}</div>
      </div>
      {{end}}
      <div class="dash-card">
        <span class="muted">My open</span>
        <div class="dash-count">{{$data.MyOpenIssues}}</div>
      </div>
    </section>

    <section class="home-notifications">
      <h2>Notifications</h2>
      {{with .Data}}
      {{range .Recent}}
      <div class="notification">
        <strong>{{if .ActorName}}{{.ActorName}}{{end}}</strong>
        <span class="muted">{{.Created}}</span>
      </div>
      {{else}}
      <p class="muted">Nothing yet.</p>
      {{end}}
      {{end}}
    </section>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_issue"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body data-current-issue="{{.Data.Issue.ID}}">
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page page-narrow" id="issue-page">
    {{template "issue_view" .Data}}
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "issue_list_row"}}
<tr>
  <td><a href="/browse/{{.Key}}">{{.Key}}</a></td>
  <td>{{.Summary}}</td>
  <td><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span></td>
  <td>{{if .Assignee}}{{template "avatar" .Assignee}}{{end}}</td>
</tr>
{{end}}

{{define "page_project"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page">
    <h1>{{.Data.Project.Name}} <span class="project-key">({{.Data.Project.Key}})</span></h1>
    <form class="jql-bar" method="get" action="/issues/{{.Data.Project.Key}}">
      <label class="sr-only" for="jql-query">Search issues with JQL</label>
      <input id="jql-query" name="jql" value="{{.Data.JQL}}" placeholder='Search with JQL: status = "In Progress" ORDER BY updated DESC' autocomplete="off">
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
    {{if .Data.JQL}}
    <p class="muted jql-meta">
      {{if .Data.JQLError}}<span class="error">{{.Data.JQLError}}</span>
      {{else}}{{.Data.Total}} result{{if ne .Data.Total 1}}s{{end}} for <code>{{.Data.JQL}}</code>{{end}}
    </p>
    {{end}}
    <table class="issue-list">
      <caption class="sr-only">Issues in {{.Data.Project.Name}}</caption>
      <thead><tr><th scope="col">Key</th><th scope="col">Summary</th><th scope="col">Status</th><th scope="col">Assignee</th></tr></thead>
      <tbody>
        {{range .Data.Issues}}{{template "issue_list_row" .}}{{else}}
        <tr><td colspan="4" class="empty">{{if .Data.JQL}}No issues match this query.{{else}}No issues yet — hit <strong>Create</strong>.{{end}}</td></tr>
        {{end}}
      </tbody>
    </table>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "board_card"}}
<div class="board-card" data-issue="{{.ID}}" data-key="{{.Key}}" tabindex="0" role="button"
     aria-label="Issue {{.Key}}: {{.Summary}}. Press Space to pick up, then arrow keys to move it.">
  <div class="board-card-top">
    <a href="/browse/{{.Key}}">{{.Key}}</a>
    <span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span>
  </div>
  <div class="board-card-summary">{{.Summary}}</div>
  {{if .Assignee}}<div class="board-card-assignee">{{template "avatar" .Assignee}}</div>{{end}}
</div>
{{end}}

{{define "board_fragment"}}
<div class="board" id="board" aria-label="{{.Board.Name}} board" data-board-ready="">
  {{$board := .Board.ID}}
  {{range .Columns}}
    <section class="board-column" data-status="{{.StatusID}}" aria-label="{{.Name}}">
    <div class="board-column-head">
      <span class="lozenge {{statusClass .Category}}">{{.Name}}</span>
      <span class="muted">{{len .Issues}}</span>
    </div>
    <div class="board-column-body" data-column>
      {{range .Issues}}{{template "board_card" .}}{{end}}
    </div>
  </section>
  {{end}}
</div>
{{end}}

{{define "page_board"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}
<script src="/static/sortable.min.js" defer></script>
</head>
<body data-board="{{.Data.Board.ID}}">
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page page-wide">
    <h1>{{.Data.Board.Name}} <span class="project-key">board</span></h1>
    <div class="board" id="board" aria-label="{{.Data.Board.Name}} board">
      {{$board := .Data.Board.ID}}
      {{range .Data.Columns}}
      <section class="board-column" data-status="{{.StatusID}}" aria-label="{{.Name}}">
        <div class="board-column-head">
          <span class="lozenge {{statusClass .Category}}">{{.Name}}</span>
          <span class="muted">{{len .Issues}}</span>
        </div>
        <div class="board-column-body" data-column>
          {{range .Issues}}{{template "board_card" .}}{{end}}
        </div>
      </section>
      {{end}}
    </div>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_dashboard"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page">
    <h1>Dashboard</h1>
    <section class="dashboard-cards">
      {{$data := .Data}}
      {{range $data.StatusCounts}}
      <div class="dash-card">
        <span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span>
        <div class="dash-count">{{.Count}}</div>
      </div>
      {{end}}
      <div class="dash-card">
        <span class="muted">My open</span>
        <div class="dash-count">{{$data.MyOpenIssues}}</div>
      </div>
    </section>

    <section class="issue-history">
      <h2>Recent activity</h2>
      {{range .Data.Recent}}
      <div class="history-entry">
        <strong><a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a></strong>
        {{if eq .Op "upsert"}}updated{{else}}deleted{{end}} — {{.Summary}}
        <span class="muted">{{if .ActorName}}{{.ActorName}} · {{end}}{{.Created}}</span>
      </div>
      {{else}}
      <p class="muted">No activity yet.</p>
      {{end}}
    </section>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_login"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body class="login-body">
  <main class="login-card">
    <h1>ZZIRA</h1>
    <form method="post" action="/login">
      <label for="login-email">Email</label>
      <input id="login-email" type="email" name="email" required autofocus>
      <label for="login-password">Password</label>
      <input id="login-password" type="password" name="password" required>
      {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>
  </main>
</body>
</html>
{{end}}

{{define "page_signed_out"}}
<!doctype html>
<html lang="en">
<head>{{template "head" .}}</head>
<body class="login-body">
  <main class="login-card">
    <h1>Signed out</h1>
    <p>You have been signed out of ZZIRA.</p>
    <a class="btn btn-primary btn-block" href="/login">Log in</a>
  </main>
</body>
</html>
{{end}}
