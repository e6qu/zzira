{{define "head"}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<script>
  (function () {
    var saved = localStorage.getItem('zzira-theme');
    var theme = saved === 'light' || saved === 'dark'
      ? saved
      : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  }());
</script>
<link rel="stylesheet" href="/static/css/tokens.css?v=4">
<link rel="stylesheet" href="/static/css/workspace.css?v=3">
<link rel="preload" href="/static/zzira-worker.wasm?v=2" as="fetch" crossorigin>
<link rel="preload" href="/static/sqlite/sqlite3.wasm" as="fetch" crossorigin>
<script src="/static/htmx/htmx.min.js" defer></script>
<script src="/static/wasm/wasm_exec.js" defer></script>
<script src="/static/app.js?v=16" defer></script>
{{end}}

{{define "avatar"}}
<span class="avatar" aria-hidden="true"><span>{{initials .DisplayName}}</span></span>
{{end}}

{{define "avatar_labeled"}}
<span class="avatar" role="img" aria-label="Assigned to {{.DisplayName}}"><span aria-hidden="true">{{initials .DisplayName}}</span></span>
{{end}}

{{define "header"}}
<header class="global-header">
  <button class="icon-button nav-toggle" type="button" data-nav-toggle aria-label="Collapse sidebar" aria-expanded="true" aria-controls="workspace-navigation">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
  </button>
  <a class="logo" href="/" aria-label="ZZIRA home"><span class="logo-mark" aria-hidden="true">Z</span><span>ZZIRA</span></a>
  <form class="global-search" method="get" action="/issues/ZZ" role="search">
    <label class="sr-only" for="global-jql-query">Search issues with JQL</label>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
    <input id="global-jql-query" name="jql" placeholder="Search work" autocomplete="off">
    <kbd aria-hidden="true">/</kbd>
  </form>
  <button type="button" class="btn btn-primary header-create" id="global-create-issue" hx-get="/issues/new" hx-target="#modal-root"
          hx-swap="innerHTML" onclick="zzira.openModal(this)"><span aria-hidden="true">+</span> Create</button>
  {{if .User}}
  <details class="user-menu">
    <summary aria-label="Account menu for {{.User.DisplayName}}" data-shauth-user="{{.User.Username}}">{{template "avatar" .User}}</summary>
    <div class="user-popover">
      <div class="user-popover-head">{{template "avatar" .User}}<span><strong>{{.User.DisplayName}}</strong><small>{{.User.Email}}</small></span></div>
      <form method="post" action="/logout"><button type="submit" data-shauth-sign-out>Log out</button></form>
    </div>
  </details>
  {{end}}
  <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
    <span aria-hidden="true">☀</span>
  </button>
</header>
{{end}}

{{define "workspace_nav"}}
<aside class="workspace-nav" id="workspace-navigation" aria-label="Workspace navigation">
  <div class="workspace-identity">
    <span class="workspace-avatar" aria-hidden="true">ZZ</span>
    <span class="workspace-copy"><strong>ZZIRA Software</strong><small>Software project</small></span>
  </div>
  <nav aria-label="Primary">
    <a class="nav-dashboard" href="/dashboard" {{if eq .Active "dashboard"}}aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6v7H4zM14 4h6v16h-6zM4 4h6v5H4z"/></svg><span>Your work</span></a>
    <div class="nav-label">Plan</div>
    <a class="nav-board" href="/board/brd_default" {{if eq .Active "board"}}aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="5" height="14" rx="1"/><rect x="9.5" y="5" width="5" height="9" rx="1"/><rect x="15.5" y="5" width="5" height="11" rx="1"/></svg><span>Board</span></a>
    <div class="nav-label">Work</div>
    <a class="nav-issues" href="/issues/ZZ" {{if eq .Active "issues"}}aria-current="page"{{end}}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 6h13M7 12h13M7 18h13"/><circle cx="4" cy="6" r=".8"/><circle cx="4" cy="12" r=".8"/><circle cx="4" cy="18" r=".8"/></svg><span>All work</span></a>
  </nav>
  <div class="sync-rail" id="sync-rail" data-state="online">
    <span class="sync-dot" aria-hidden="true"></span>
    <span><strong data-sync-label>Ready</strong><small data-sync-detail>Local replica</small></span>
  </div>
</aside>
{{end}}

{{define "create_dialog"}}
<div class="modal-backdrop" data-modal-backdrop aria-hidden="true"></div>
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-issue-title" tabindex="-1">
  <div class="modal-header"><div><span class="eyebrow">New work item</span><h2 id="create-issue-title">Create issue</h2></div><button type="button" class="icon-button modal-close" onclick="zzira.closeModal()" aria-label="Close dialog">×</button></div>
  <form method="post" action="/issues" hx-post="/issues" hx-target="#modal-root" hx-swap="innerHTML">
    <div class="form-grid">
    <div>
    <label for="create-project">Project</label>
    <input id="create-project" name="project" value="{{.Project.Key}}" readonly>
    </div><div>
    <label for="create-issuetype">Issue type</label>
      <select id="create-issuetype" name="issuetype">
        <option value="{{.IssueType.ID}}">{{.IssueType.Name}}</option>
      </select>
    </div></div>
    <label for="create-summary">Summary</label>
    <input id="create-summary" name="summary" required autofocus maxlength="255" placeholder="What needs to be done?">
    <label for="create-description">Description</label>
    <textarea id="create-description" name="description" rows="7" placeholder="Add context, acceptance criteria, or links…"></textarea>
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <div class="modal-actions">
      <button type="button" class="btn" onclick="zzira.closeModal()">Cancel</button>
      <button type="submit" class="btn btn-primary">Create issue</button>
    </div>
  </form>
</div>
{{end}}

{{define "issue_view"}}
<div class="issue-view" id="issue-root" data-issue-id="{{.Issue.ID}}" data-issue-key="{{.Issue.Key}}" data-seq="{{.Issue.UpdatedSeq}}">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb">
    <a href="/issues/{{.ProjectKey}}">Projects</a><span aria-hidden="true">/</span><a href="/issues/{{.ProjectKey}}">{{.ProjectKey}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Issue.Key}}</span>
  </nav>
  <header class="issue-header">
    <div class="issue-heading">
      <span class="issue-type-glyph" aria-hidden="true">✓</span>
      <div class="issue-title-block"><span class="eyebrow">{{.Issue.Key}} · {{.Issue.IssueType.Name}}</span>
{{if .CanTriage}}
      <div class="summary-line"><h1 class="issue-summary" data-field="summary">{{.Issue.Summary}}</h1><details class="inline-summary-editor"><summary aria-label="Edit summary">✎</summary><form method="post" action="/issues/{{.Issue.Key}}/fields" hx-post="/issues/{{.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="summary"><label for="issue-summary-input">Summary</label><input id="issue-summary-input" class="issue-summary-input" name="value" value="{{.Issue.Summary}}" maxlength="255" required><button type="submit" class="btn btn-primary">Save</button></form></details></div>
{{else}}<h1 class="issue-summary" data-field="summary">{{.Issue.Summary}}</h1>{{end}}
      </div>
    </div>
    <div class="issue-transitions" role="group" aria-label="Issue actions">
{{range .Transitions}}
      <form method="post" action="/issues/{{$.Issue.Key}}/transition" hx-post="/issues/{{$.Issue.Key}}/transition" hx-target="#issue-root" hx-swap="outerHTML">
        <input type="hidden" name="transition" value="{{.ID}}">
        <button type="submit" class="btn btn-transition">{{.Name}}</button>
      </form>
{{end}}
{{if .CanEdit}}
{{if .CanTriage}}
      <form method="post" action="/issues/{{.Issue.Key}}/watch" hx-post="/issues/{{.Issue.Key}}/watch" hx-target="#issue-root" hx-swap="outerHTML">
        <input type="hidden" name="watching" value="{{if .IsWatching}}false{{else}}true{{end}}">
        <button type="submit" class="btn watch-button" aria-pressed="{{.IsWatching}}" aria-keyshortcuts="W"><span aria-hidden="true">◉</span>{{if .IsWatching}}Watching{{else}}Watch{{end}} <span class="action-count">{{len .Watchers}}</span></button>
      </form>
{{end}}
      <button type="button" class="btn" id="edit-issue-button" onclick="zzira.openEdit('{{.Issue.Key}}', this)">Edit</button>
      <details class="more-menu"><summary class="btn" aria-label="More issue actions">•••</summary><div><button type="button" class="menu-danger" hx-delete="/issues/{{.Issue.Key}}" hx-confirm="Delete {{.Issue.Key}}?" hx-redirect="/issues/{{.ProjectKey}}">Delete issue</button></div></details>
{{end}}
    </div>
  </header>
  <div class="issue-main">
    <div class="issue-primary">
      <section class="issue-section issue-description" data-field="description">
        <div class="section-heading"><h2>Description</h2></div>
        <div class="description-text">{{adfHTML .Issue.Description}}</div>
      </section>

      <section class="issue-section linked-work" aria-labelledby="linked-work-title">
        <div class="section-heading"><h2 id="linked-work-title">Linked work <span class="section-count">{{len .Links}}</span></h2>
        {{if .CanTriage}}<details class="link-create"><summary class="quiet-action">Link work item</summary>
          <form method="post" action="/issues/{{.Issue.Key}}/links" hx-post="/issues/{{.Issue.Key}}/links" hx-target="#issue-root" hx-swap="outerHTML">
            <label for="link-type">Relationship</label><select id="link-type" name="type" required>{{range .LinkTypes}}<option value="{{.ID}}">{{.Outward}}</option>{{end}}</select>
            <label for="link-issue">Work item key</label><input id="link-issue" name="issue" placeholder="{{.ProjectKey}}-123" autocomplete="off" required>
            <button type="submit" class="btn btn-primary">Link</button>
          </form>
        </details>{{end}}</div>
        {{if .Links}}<ul class="linked-work-list">{{range .Links}}
          <li><span class="link-relationship">{{.Relationship}}</span><a href="/browse/{{.IssueKey}}"><strong>{{.IssueKey}}</strong> {{.Summary}}</a><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span>
          {{if $.CanTriage}}<form method="post" action="/issues/{{$.Issue.Key}}/links/{{.ID}}/delete" hx-delete="/issues/{{$.Issue.Key}}/links/{{.ID}}" hx-target="#issue-root" hx-swap="outerHTML" hx-confirm="Remove the link to {{.IssueKey}}?"><button type="submit" class="icon-danger" aria-label="Remove link to {{.IssueKey}}">×</button></form>{{end}}</li>
        {{end}}</ul>{{else}}<p class="muted">No linked work items.</p>{{end}}
      </section>

      <section class="issue-section issue-attachments" aria-labelledby="attachments-title">
        <div class="section-heading"><h2 id="attachments-title">Attachments <span class="section-count">{{len .Attachments}}</span></h2></div>
        {{if .Attachments}}<ul id="attachments-list" class="attachment-list">
          {{range .Attachments}}<li class="attachment"><span class="attachment-icon" aria-hidden="true">&#128206;</span><span class="attachment-copy"><a href="/rest/api/3/attachment/content/{{.ID}}">{{.Filename}}</a><small>{{humanSize .Size}}{{if .AuthorName}} · added by {{.AuthorName}}{{end}}</small></span>
          {{if and $.CanTriage (eq .AuthorID $.CurrentUserID)}}<form method="post" action="/issues/{{$.Issue.Key}}/attachments/{{.ID}}/delete" hx-delete="/issues/{{$.Issue.Key}}/attachments/{{.ID}}" hx-target="#issue-root" hx-swap="outerHTML" hx-confirm="Delete attachment {{.Filename}}?"><button type="submit" class="icon-danger" aria-label="Delete attachment {{.Filename}}">×</button></form>{{end}}</li>{{end}}
        </ul>{{else}}<p class="muted">No attachments added.</p>{{end}}
        {{if .CanTriage}}<form class="upload-form" method="post" action="/issues/{{.Issue.Key}}/attachments" enctype="multipart/form-data"><label for="attachment-file">Add attachment</label><input id="attachment-file" type="file" name="file" required><button type="submit" class="btn">Attach file</button></form>{{end}}
      </section>

      <div class="activity-heading"><div><span class="eyebrow">One chronological record</span><h2 id="activity-title">Activity</h2></div>
        <div class="activity-tools"><div class="activity-filters" role="group" aria-label="Filter activity">
          <button type="button" data-activity-filter="all" aria-pressed="true">All <span>{{len .Activity}}</span></button>
          <button type="button" data-activity-filter="comment" aria-pressed="false">Comments <span>{{len .Comments}}</span></button>
          <button type="button" data-activity-filter="worklog" aria-pressed="false">Work log <span>{{len .Worklogs}}</span></button>
          <button type="button" data-activity-filter="history" aria-pressed="false">History <span>{{len .History}}</span></button>
        </div><button type="button" class="activity-sort" data-activity-sort aria-label="Sort activity oldest first" aria-pressed="false">Newest first ↓</button></div>
      </div>

      <section class="issue-section issue-activity" aria-labelledby="activity-title">
        {{if .CanEdit}}<details class="activity-composer" open><summary>Add an update</summary>
        <form class="comment-form" method="post" action="/issues/{{.Issue.Key}}/comments" hx-post="/issues/{{.Issue.Key}}/comments" hx-target="#issue-root" hx-swap="outerHTML">
          <div class="editor-toolbar" role="group" aria-label="Comment formatting" data-editor-toolbar>
            <button type="button" data-cmd="bold" aria-label="Bold"><strong aria-hidden="true">B</strong></button>
            <button type="button" data-cmd="italic" aria-label="Italic"><em aria-hidden="true">I</em></button>
            <button type="button" data-cmd="insertUnorderedList" aria-label="Bullet list"><span aria-hidden="true">&bull;&equiv;</span></button>
            <button type="button" data-cmd="code" aria-label="Code"><span aria-hidden="true">&lt;/&gt;</span></button>
          </div>
          <span id="comment-editor-label" class="sr-only">Add a comment</span>
          <div id="comment-editor" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="comment-editor-label" data-rich-editor data-target-name="adf"
               data-placeholder="Add a comment…"></div>
          <input type="hidden" name="adf">
          <div class="form-actions"><small class="muted">Use the toolbar to format your update.</small><button type="submit" class="btn btn-primary">Add comment</button></div>
        </form>
        {{if .CanTriage}}<form class="worklog-form" method="post" action="/issues/{{.Issue.Key}}/worklogs" hx-post="/issues/{{.Issue.Key}}/worklogs" hx-target="#issue-root" hx-swap="outerHTML">
          <fieldset><legend>Or log work</legend><label for="worklog-seconds">Time in seconds</label>
          <input id="worklog-seconds" name="seconds" type="number" min="1" placeholder="3600" required class="worklog-seconds">
          <label for="worklog-comment">Work description <span class="muted">optional</span></label><input id="worklog-comment" name="comment" placeholder="What did you work on?" class="worklog-comment"><button type="submit" class="btn">Log time</button></fieldset>
        </form>{{end}}</details>{{end}}
        <div class="activity-ledger" data-activity-ledger>
        {{range .Activity}}<article class="activity-entry activity-{{.Kind}}{{if eq .Kind "worklog"}} worklog{{end}}" data-activity-kind="{{.Kind}}" data-created="{{.Created}}" id="activity-{{.Kind}}-{{.ID}}">
          <div class="activity-marker" aria-hidden="true">{{if eq .Kind "comment"}}C{{else if eq .Kind "worklog"}}T{{else}}H{{end}}</div>
          <div class="activity-content"><header><span class="avatar" aria-hidden="true"><span>{{initials .AuthorName}}</span></span><strong>{{.AuthorName}}</strong><span class="activity-verb">{{if eq .Kind "comment"}}commented{{else if eq .Kind "worklog"}}logged <span class="lozenge">{{timeSpent .TimeSpentSeconds}}</span>{{else}}changed this work item{{end}}</span><time datetime="{{.Created}}">{{.Created}}</time>
          {{if and $.CanTriage (and (eq .Kind "worklog") .CanDelete)}}<form method="post" action="/issues/{{$.Issue.Key}}/worklogs/{{.ID}}/delete" hx-delete="/issues/{{$.Issue.Key}}/worklogs/{{.ID}}" hx-target="#issue-root" hx-swap="outerHTML" hx-confirm="Delete this work log?"><button type="submit" class="icon-danger" aria-label="Delete work log from {{.Created}}">×</button></form>{{end}}</header>
          {{if eq .Kind "history"}}<ul class="change-list">{{range .Items}}<li><strong>{{.Field}}</strong> changed{{if .FromString}} from “{{.FromString}}”{{end}}{{if .ToString}} to “{{.ToString}}”{{end}}</li>{{end}}</ul>{{else if .Body}}<div class="comment-body">{{adfHTML .Body}}</div>{{end}}</div>
        </article>{{else}}<div class="empty-state" data-activity-empty><strong>No activity yet</strong><small>Comments, work logs, and field changes will appear here.</small></div>{{end}}
        <div class="empty-state" data-activity-filter-empty hidden><strong>No matching activity</strong><small>Choose another activity filter.</small></div>
        </div>
      </section>
    </div>
    <aside class="issue-details" aria-label="Issue details">
      <div class="details-heading"><h2>Details</h2><span class="lozenge {{statusClass .Issue.Status.Category}}">{{.Issue.Status.Name}}</span></div>
      <dl>
        <dt>Type</dt>
        <dd><span class="field-value"><span class="issue-type-mini" aria-hidden="true">✓</span>{{.Issue.IssueType.Name}}</span></dd>
        <dt>{{if .CanTriage}}<label for="field-priority">Priority</label>{{else}}Priority{{end}}</dt><dd>{{if .CanTriage}}<form class="inline-field" method="post" action="/issues/{{.Issue.Key}}/fields" hx-post="/issues/{{.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="priority"><select id="field-priority" name="value"><option value="">None</option>{{$priority := ""}}{{if .Issue.Priority}}{{$priority = .Issue.Priority.ID}}{{end}}{{range .Priorities}}<option value="{{.ID}}" {{if eq .ID $priority}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="field-save" type="submit">Save priority</button></form>{{else}}{{if .Issue.Priority}}{{.Issue.Priority.Name}}{{else}}None{{end}}{{end}}</dd>
        <dt>{{if .CanTriage}}<label for="field-assignee">Assignee</label>{{else}}Assignee{{end}}</dt><dd>{{if .CanTriage}}<form class="inline-field" method="post" action="/issues/{{.Issue.Key}}/fields" hx-post="/issues/{{.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="assignee"><select id="field-assignee" name="value"><option value="">Unassigned</option>{{$assignee := ""}}{{if .Issue.Assignee}}{{$assignee = .Issue.Assignee.ID}}{{end}}{{range .Members}}<option value="{{.ID}}" {{if eq .ID $assignee}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select><button class="field-save" type="submit">Save assignee</button></form>{{else}}{{if .Issue.Assignee}}{{.Issue.Assignee.DisplayName}}{{else}}Unassigned{{end}}{{end}}</dd>
        <dt>Reporter</dt>
        <dd>{{if .Issue.Reporter}}<span class="person-value">{{template "avatar" .Issue.Reporter}}<span>{{.Issue.Reporter.DisplayName}}</span></span>{{end}}</dd>
        <dt>{{if .CanTriage}}<label for="field-labels">Labels</label>{{else}}Labels{{end}}</dt><dd>{{if .CanTriage}}<form class="inline-field" method="post" action="/issues/{{.Issue.Key}}/fields" hx-post="/issues/{{.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="labels"><input id="field-labels" name="value" value="{{join .Issue.Labels ", "}}" placeholder="None" aria-describedby="labels-help"><small id="labels-help" class="sr-only">Comma-separated labels; spaces are not allowed within a label.</small><button class="field-save" type="submit">Save labels</button></form>{{else}}{{if .Issue.Labels}}{{join .Issue.Labels ", "}}{{else}}None{{end}}{{end}}</dd>
{{if .SecurityLevels}}        <dt><label for="field-security">Security</label></dt><dd><form class="inline-field" method="post" action="/issues/{{.Issue.Key}}/fields" hx-post="/issues/{{.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="security"><select id="field-security" name="value"><option value="">Public</option>{{$security := .Issue.SecurityLevelID}}{{range .SecurityLevels}}<option value="{{.ID}}" {{if eq .ID $security}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="field-save" type="submit">Save security</button></form></dd>{{end}}
      </dl>
{{if .CustomFields}}      <details class="more-fields"><summary>More fields <span>{{len .CustomFields}}</span></summary><dl>{{range .CustomFields}}<dt><label for="detail-field-{{.ID}}">{{.Name}}</label></dt><dd><form class="inline-field" method="post" action="/issues/{{$.Issue.Key}}/fields" hx-post="/issues/{{$.Issue.Key}}/fields" hx-target="#issue-root" hx-swap="outerHTML"><input type="hidden" name="field" value="custom:{{.ID}}"><input id="detail-field-{{.ID}}" name="value" value="{{.Value}}" placeholder="None"><button class="field-save" type="submit">Save {{.Name}}</button></form></dd>{{end}}</dl></details>{{end}}
      <section class="watcher-summary" aria-labelledby="watchers-title"><h3 id="watchers-title">Watchers <span>{{len .Watchers}}</span></h3>{{if .Watchers}}<ul>{{range .Watchers}}<li>{{template "avatar" .}}<span>{{.DisplayName}}</span></li>{{end}}</ul>{{else}}<p>No one is watching yet.</p>{{end}}</section>
      <div class="details-meta"><span>Updated</span><time datetime="{{.Issue.UpdatedAt}}">{{.Issue.UpdatedAt}}</time></div>
    </aside>
  </div>
</div>
{{end}}

{{define "edit_dialog"}}
<div class="modal-backdrop" data-modal-backdrop aria-hidden="true"></div>
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="edit-issue-title" tabindex="-1">
  <div class="modal-header"><div><span class="eyebrow">{{.Issue.Key}}</span><h2 id="edit-issue-title">Edit issue</h2></div><button type="button" class="icon-button modal-close" onclick="zzira.closeModal()" aria-label="Close dialog">×</button></div>
  <form method="post" action="/issues/{{.Issue.Key}}/edit" hx-post="/issues/{{.Issue.Key}}/edit" hx-target="#issue-root" hx-swap="outerHTML">
    <label for="edit-summary">Summary</label>
    <input id="edit-summary" name="summary" value="{{.Issue.Summary}}" required autofocus maxlength="255">
    <label for="edit-description">Description</label>
    <textarea id="edit-description" name="description" rows="6">{{adfToText .Issue.Description}}</textarea>
    <label for="edit-assignee">Assignee</label>
      <select id="edit-assignee" name="assignee">
        <option value="">Unassigned</option>
        {{$cur := ""}}{{if .Issue.Assignee}}{{$cur = .Issue.Assignee.ID}}{{end}}
        {{range .Members}}
        <option value="{{.ID}}" {{if eq .ID $cur}}selected{{end}}>{{.DisplayName}}</option>
        {{end}}
      </select>
    {{if .SecurityLevels}}
    <label for="edit-security">Security</label>
      <select id="edit-security" name="security">
        <option value="">Public</option>
        {{$curSec := .Issue.SecurityLevelID}}
        {{range .SecurityLevels}}
        <option value="{{.ID}}" {{if eq .ID $curSec}}selected{{end}}>{{.Name}}</option>
        {{end}}
      </select>
    {{end}}
    {{range .CustomFields}}
    <label for="field-{{.ID}}">{{.Name}}</label>
      <input id="field-{{.ID}}" name="{{.ID}}" value="{{customFieldValue $.Issue .ID}}">
    {{end}}
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <div class="modal-actions">
      <button type="button" class="btn" onclick="zzira.closeModal()">Cancel</button>
      <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
  </form>
</div>
{{end}}

{{define "page_home"}}
<!doctype html>
<html lang="en">
<head><title>Your work · ZZIRA</title>{{template "head" .}}</head>
<body class="page-home">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page" id="main-content" tabindex="-1">
    <section class="welcome-panel">
      <div><span class="eyebrow">Your work</span><h1>Welcome back{{if .User}}, {{.User.DisplayName}}{{end}}</h1><p>See what is moving, find the next priority, or create new work.</p></div>
      <div class="welcome-actions"><a class="btn" href="/issues/ZZ">View all work</a><button type="button" class="btn btn-primary" id="home-create-issue" hx-get="/issues/new" hx-target="#modal-root" hx-swap="innerHTML" onclick="zzira.openModal(this)">Create issue</button></div>
    </section>
    <div class="dashboard-layout"><section class="dashboard-main"><div class="section-heading"><div><span class="eyebrow">Overview</span><h2>Work by status</h2></div><a href="/board/brd_default">Open board →</a></div><div class="dashboard-cards">
      {{$data := .Data}}
      {{range $data.StatusCounts}}
      <div class="dash-card">
        <div><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span><span class="dash-count">{{.Count}}</span></div><div class="stat-line" aria-hidden="true"><span style="width: {{.Count}}0%"></span></div>
      </div>
      {{end}}
      <div class="dash-card">
        <div><span class="muted">Assigned to me</span><span class="dash-count">{{$data.MyOpenIssues}}</span></div><div class="stat-line stat-line-accent" aria-hidden="true"><span style="width: {{$data.MyOpenIssues}}0%"></span></div>
      </div>
    </div></section>
    <section class="activity-card home-notifications">
      <div class="section-heading"><div><span class="eyebrow">Updates</span><h2>Recent activity</h2></div></div>
      {{with .Data}}
      {{range .Recent}}
      <div class="notification">
        <span class="activity-mark" aria-hidden="true"></span><div><strong><a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a> · {{.Summary}}</strong><span class="muted">{{if .ActorName}}{{.ActorName}} · {{end}}<time datetime="{{.Created}}">{{.Created}}</time></span></div>
      </div>
      {{else}}
      <div class="empty-state"><strong>No activity yet</strong><small>Changes to your team’s work will appear here.</small></div>
      {{end}}
      {{end}}
    </section></div>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_issue"}}
<!doctype html>
<html lang="en">
<head><title>{{.Data.Issue.Key}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-issue" data-current-issue="{{.Data.Issue.ID}}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page page-issue-content" id="main-content" tabindex="-1">
    {{template "issue_view" .Data}}
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "issue_list_row"}}
<tr data-navigator-row data-key="{{.Key}}" data-preview-url="/browse/{{.Key}}/preview">
  <td class="type-cell" data-column="type"><span class="issue-type-mini" role="img" aria-label="{{.IssueType.Name}}">✓</span></td>
  <td class="key-cell"><a href="/browse/{{.Key}}">{{.Key}}</a></td>
  <td class="summary-cell"><a href="/browse/{{.Key}}" data-preview-link hx-get="/browse/{{.Key}}/preview" hx-target="#navigator-preview" hx-swap="innerHTML">{{.Summary}}</a></td>
  <td data-column="status"><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span></td>
  <td data-column="priority">{{if .Priority}}<span class="priority-value"><span aria-hidden="true">=</span>{{.Priority.Name}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
  <td data-column="assignee">{{if .Assignee}}<span class="person-value compact">{{template "avatar" .Assignee}}<span>{{.Assignee.DisplayName}}</span></span>{{else}}<span class="muted">Unassigned</span>{{end}}</td>
  <td data-column="updated"><time datetime="{{.UpdatedAt}}">{{.UpdatedAt}}</time></td>
</tr>
{{end}}

{{define "issue_preview"}}
<article class="issue-preview-card" data-preview-key="{{.Key}}" aria-labelledby="issue-preview-title">
  <header>
    <div><span class="eyebrow">{{.Key}} · {{.IssueType.Name}}</span><h2 id="issue-preview-title">{{.Summary}}</h2></div>
    <a class="btn" href="/browse/{{.Key}}">Open issue</a>
  </header>
  <div class="issue-preview-description">
    <h3>Description</h3>
    <div class="description-text">{{adfHTML .Description}}</div>
  </div>
  <dl>
    <dt>Status</dt><dd><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span></dd>
    <dt>Priority</dt><dd>{{if .Priority}}{{.Priority.Name}}{{else}}None{{end}}</dd>
    <dt>Assignee</dt><dd>{{if .Assignee}}<span class="person-value compact">{{template "avatar" .Assignee}}<span>{{.Assignee.DisplayName}}</span></span>{{else}}Unassigned{{end}}</dd>
    <dt>Reporter</dt><dd>{{if .Reporter}}{{.Reporter.DisplayName}}{{else}}Unknown{{end}}</dd>
    <dt>Updated</dt><dd><time datetime="{{.UpdatedAt}}">{{.UpdatedAt}}</time></dd>
  </dl>
</article>
{{end}}

{{define "page_project"}}
<!doctype html>
<html lang="en">
<head><title>All work · ZZIRA</title>{{template "head" .}}</head>
<body class="page-project">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page page-fluid" id="main-content" tabindex="-1">
    <header class="page-header"><div><span class="eyebrow">{{.Data.Project.Name}} · {{.Data.Project.Key}}</span><h1>All work</h1><p>Find and triage work without losing the issue context.</p></div><button type="button" class="btn btn-primary" hx-get="/issues/new" hx-target="#modal-root" hx-swap="innerHTML" onclick="zzira.openModal(this)">Create issue</button></header>
    <section class="navigator-search" aria-labelledby="navigator-search-title">
      <div class="navigator-search-heading"><h2 id="navigator-search-title">Search work</h2><div class="navigator-search-tools"><form class="saved-filter-picker" method="get" action="/issues/{{.Data.Project.Key}}"><label class="sr-only" for="saved-filter">Saved filter</label><select id="saved-filter" name="filter"><option value="">Saved filters</option>{{range .Data.Filters}}<option value="{{.ID}}" {{if eq .ID $.Data.ActiveFilter}}selected{{end}}>{{if .Favourite}}★ {{end}}{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Open</button></form><nav class="search-mode" aria-label="Search mode"><a href="{{.Data.BasicURL}}" {{if eq .Data.Mode "basic"}}aria-current="page"{{end}}>Basic</a><a href="{{.Data.AdvancedURL}}" {{if eq .Data.Mode "advanced"}}aria-current="page"{{end}}>JQL</a></nav></div></div>
      {{if eq .Data.Mode "advanced"}}
      <form class="jql-bar" method="get" action="/issues/{{.Data.Project.Key}}">
        <input type="hidden" name="mode" value="advanced">
        <label class="sr-only" for="jql-query">Search issues with JQL</label>
        <div class="jql-input"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><input id="jql-query" name="jql" value="{{.Data.JQL}}" placeholder='For example: status = "In Progress" ORDER BY updated DESC' autocomplete="off" spellcheck="false" aria-describedby="jql-scope-hint"></div>
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
      <p class="field-hint" id="jql-scope-hint">This search is always limited to {{.Data.Project.Key}}.</p>
      {{else}}
      <form class="basic-search" method="get" action="/issues/{{.Data.Project.Key}}">
        <input type="hidden" name="mode" value="basic"><input type="hidden" name="sort" value="{{.Data.Sort}}"><input type="hidden" name="direction" value="{{.Data.Direction}}">
        <label class="basic-search-text" for="navigator-text"><span>Contains text</span><input id="navigator-text" type="search" name="text" value="{{.Data.Text}}" placeholder="Search summary or description"></label>
        <label for="navigator-status"><span>Status</span><select id="navigator-status" name="status"><option value="">Any status</option>{{range .Data.Statuses}}<option value="{{.Name}}" {{if eq .Name $.Data.Status}}selected{{end}}>{{.Name}}</option>{{end}}</select></label>
        <label for="navigator-assignee"><span>Assignee</span><select id="navigator-assignee" name="assignee"><option value="">Anyone</option><option value="currentUser()" {{if eq .Data.Assignee "currentUser()"}}selected{{end}}>Current user</option><option value="unassigned" {{if eq .Data.Assignee "unassigned"}}selected{{end}}>Unassigned</option>{{range .Data.Members}}<option value="{{.ID}}" {{if eq .ID $.Data.Assignee}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select></label>
        <div class="basic-search-actions"><button type="submit" class="btn btn-primary">Search</button><a class="btn" href="{{.Data.BasicURL}}">Clear</a></div>
      </form>
      {{end}}
      {{if .Data.JQLError}}<p class="error navigator-error" role="alert">{{.Data.JQLError}}</p>{{end}}
      {{if or .Data.Chips (not .Data.JQLError)}}<div class="navigator-filter-footer">{{if .Data.Chips}}<div class="filter-chips" role="group" aria-label="Active filters">{{range .Data.Chips}}<a href="{{.URL}}" aria-label="Remove {{.Label}} filter"><span>{{.Label}}</span><span aria-hidden="true">×</span></a>{{end}}</div>{{end}}{{if not .Data.JQLError}}<details class="save-search"><summary class="btn">Save search</summary><form method="post" action="/issues/{{.Data.Project.Key}}/filters"><label for="save-filter-name">Filter name</label><input id="save-filter-name" name="name" maxlength="255" required placeholder="For example: Release blockers"><input type="hidden" name="jql" value="{{.Data.SaveJQL}}"><button type="submit" class="btn btn-primary">Save filter</button></form></details>{{end}}</div>{{end}}
    </section>
    <div class="list-toolbar"><div><strong>{{.Data.Total}} work item{{if ne .Data.Total 1}}s{{end}}</strong>{{if .Data.ResultStart}}<span class="muted">Showing {{.Data.ResultStart}}–{{.Data.ResultEnd}}</span>{{end}}</div><div class="navigator-view-tools"><span class="view-mode"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 6h13M7 12h13M7 18h13"/><circle cx="4" cy="6" r=".8"/><circle cx="4" cy="12" r=".8"/><circle cx="4" cy="18" r=".8"/></svg> List</span><details class="column-picker"><summary class="btn">Columns</summary><fieldset><legend>Visible columns</legend><label><input type="checkbox" value="type" data-navigator-column checked> Type</label><label><input type="checkbox" value="status" data-navigator-column checked> Status</label><label><input type="checkbox" value="priority" data-navigator-column checked> Priority</label><label><input type="checkbox" value="assignee" data-navigator-column checked> Assignee</label><label><input type="checkbox" value="updated" data-navigator-column checked> Updated</label></fieldset></details></div></div>
    <p class="sr-only" id="navigator-keyboard-help">Use J or Down Arrow for the next issue, K or Up Arrow for the previous issue, and O or Enter to open the selected issue.</p>
    <div class="navigator-workbench" data-navigator tabindex="0" aria-label="Issue search results and preview" aria-describedby="navigator-keyboard-help">
    <div class="issue-table-wrap"><table class="issue-list">
      <caption class="sr-only">Issues in {{.Data.Project.Name}}</caption>
      <thead><tr><th scope="col" data-column="type"><span class="sr-only">Type</span></th><th scope="col" {{if eq .Data.Sort "key"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "key"}}">Key</a></th><th scope="col" {{if eq .Data.Sort "summary"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "summary"}}">Summary</a></th><th scope="col" data-column="status" {{if eq .Data.Sort "status"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "status"}}">Status</a></th><th scope="col" data-column="priority" {{if eq .Data.Sort "priority"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "priority"}}">Priority</a></th><th scope="col" data-column="assignee" {{if eq .Data.Sort "assignee"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "assignee"}}">Assignee</a></th><th scope="col" data-column="updated" {{if eq .Data.Sort "updated"}}aria-sort="{{if eq .Data.Direction "asc"}}ascending{{else}}descending{{end}}"{{end}}><a href="{{index .Data.SortURLs "updated"}}">Updated</a></th></tr></thead>
      <tbody>
        {{range .Data.Issues}}{{template "issue_list_row" .}}{{else}}
        <tr><td colspan="7" class="empty"><div class="empty-state"><strong>{{if .Data.JQLError}}Search could not run{{else}}No work matches these filters{{end}}</strong><small>{{if .Data.JQLError}}Correct the search above and try again.{{else}}Clear a filter or broaden the query.{{end}}</small></div></td></tr>
        {{end}}
      </tbody>
    </table></div>
    <aside class="navigator-preview" id="navigator-preview" aria-label="Issue preview" aria-live="polite" aria-busy="false">{{if .Data.Selected}}{{template "issue_preview" .Data.Selected}}{{else}}<div class="empty-state"><strong>No issue selected</strong><small>Choose an issue to see its details here.</small></div>{{end}}</aside>
    </div>
    {{if gt .Data.PageCount 1}}<nav class="pagination" aria-label="Search results pages"><span>Page {{.Data.Page}} of {{.Data.PageCount}}</span><div>{{if .Data.PreviousURL}}<a class="btn" rel="prev" href="{{.Data.PreviousURL}}">Previous</a>{{else}}<span class="btn" aria-disabled="true">Previous</span>{{end}}{{if .Data.NextURL}}<a class="btn" rel="next" href="{{.Data.NextURL}}">Next</a>{{else}}<span class="btn" aria-disabled="true">Next</span>{{end}}</div></nav>{{end}}
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "board_card"}}
<article class="board-card" data-issue="{{.ID}}" data-key="{{.Key}}" aria-labelledby="board-card-title-{{.ID}}">
  <div class="board-card-summary" id="board-card-title-{{.ID}}">{{.Summary}}</div>
  <div class="board-card-footer">
    <span><button type="button" class="board-card-drag" data-card-drag aria-label="Pick up {{.Key}} to move" aria-describedby="board-keyboard-help" aria-pressed="false"><span aria-hidden="true">↕</span></button><span class="issue-type-mini" aria-hidden="true">✓</span><a href="/browse/{{.Key}}">{{.Key}}</a></span>
    <span class="board-card-people">{{if .Assignee}}{{template "avatar_labeled" .Assignee}}{{else}}<span class="avatar avatar-empty" role="img" aria-label="Unassigned"><span aria-hidden="true">?</span></span>{{end}}
      <details class="board-card-move"><summary aria-label="Move {{.Key}} without dragging">•••</summary><div><button type="button" data-card-move="up">Move up</button><button type="button" data-card-move="down">Move down</button><button type="button" data-card-move="left">Move to previous status</button><button type="button" data-card-move="right">Move to next status</button></div></details>
    </span>
  </div>
</article>
{{end}}

{{define "board_fragment"}}
<div class="board" id="board" role="region" aria-label="{{.Board.Name}} board" data-board-ready="">
  <p id="board-keyboard-help" class="sr-only">Press the move button to pick up a card, use the arrow keys to move it, then press the button again to drop it. The card menu also provides movement without dragging.</p>
  {{$board := .Board.ID}}
  {{range .Columns}}
    <section class="board-column" data-status="{{.StatusID}}" aria-labelledby="board-column-{{.StatusID}}">
    <div class="board-column-head">
      <h2 id="board-column-{{.StatusID}}"><span class="lozenge lozenge-column">{{.Name}}</span> <span class="column-count">{{len .Issues}}</span></h2>
      <span class="column-menu" aria-hidden="true">•••</span>
    </div>
    <div class="board-column-body" data-column>
      {{range .Issues}}{{template "board_card" .}}{{end}}
    </div>
  </section>
  {{end}}
</div>
{{end}}

{{define "page_board"}}
<!doctype html>
<html lang="en">
<head><title>{{.Data.Board.Name}} · ZZIRA</title>{{template "head" .}}
<script src="/static/sortable.min.js" defer></script>
</head>
<body class="page-board" data-board="{{.Data.Board.ID}}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page page-fluid board-page" id="main-content" tabindex="-1">
    <header class="page-header board-page-header"><div><span class="eyebrow">ZZIRA Software · {{.Data.Board.Type}} board</span><h1>{{.Data.Board.Name}}</h1></div><button type="button" class="btn btn-primary" hx-get="/issues/new" hx-target="#modal-root" hx-swap="innerHTML" onclick="zzira.openModal(this)">Create issue</button></header>
    <div class="board-toolbar"><label class="board-search"><span class="sr-only">Filter board</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><input type="search" placeholder="Filter this board" data-board-filter></label><span class="toolbar-divider"></span><span class="muted">Drag cards or use their move controls to update status</span><span class="sr-only" role="status" aria-live="polite" data-board-filter-status></span></div>
    <div class="board" id="board" role="region" aria-label="{{.Data.Board.Name}} board">
      <p id="board-keyboard-help" class="sr-only">Press the move button to pick up a card, use the arrow keys to move it, then press the button again to drop it. The card menu also provides movement without dragging.</p>
      {{$board := .Data.Board.ID}}
      {{range .Data.Columns}}
      <section class="board-column" data-status="{{.StatusID}}" aria-labelledby="board-column-{{.StatusID}}">
        <div class="board-column-head">
          <h2 id="board-column-{{.StatusID}}"><span class="lozenge lozenge-column">{{.Name}}</span> <span class="column-count">{{len .Issues}}</span></h2>
          <span class="column-menu" aria-hidden="true">•••</span>
        </div>
        <div class="board-column-body" data-column>
          {{range .Issues}}{{template "board_card" .}}{{end}}
        </div>
      </section>
      {{end}}
    </div>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_dashboard"}}
<!doctype html>
<html lang="en">
<head><title>Dashboard · ZZIRA</title>{{template "head" .}}</head>
<body class="page-dashboard">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {{template "header" .}}
  <div class="app-shell">
  {{template "workspace_nav" .}}
  <main class="page" id="main-content" tabindex="-1">
    <header class="page-header"><div><span class="eyebrow">Your work</span><h1>Dashboard</h1><p>A live view of delivery across ZZIRA Software.</p></div><a class="btn" href="/issues/ZZ">View all work</a></header>
    <section class="dashboard-main"><div class="section-heading"><div><span class="eyebrow">Snapshot</span><h2>Work by status</h2></div><a href="/board/brd_default">Open board →</a></div><div class="dashboard-cards">
      {{$data := .Data}}
      {{range $data.StatusCounts}}
      <div class="dash-card">
        <div><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span><span class="dash-count">{{.Count}}</span></div><div class="stat-line" aria-hidden="true"><span style="width: {{.Count}}0%"></span></div>
      </div>
      {{end}}
      <div class="dash-card">
        <div><span class="muted">Assigned to me</span><span class="dash-count">{{$data.MyOpenIssues}}</span></div><div class="stat-line stat-line-accent" aria-hidden="true"><span style="width: {{$data.MyOpenIssues}}0%"></span></div>
      </div>
    </div></section>

    <section class="activity-card dashboard-activity">
      <div class="section-heading"><div><span class="eyebrow">Timeline</span><h2>Recent activity</h2></div></div>
      {{range .Data.Recent}}
      <div class="notification">
        <span class="activity-mark" aria-hidden="true"></span><div><strong><a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a> · {{.Summary}}</strong><span class="muted">{{if .ActorName}}{{.ActorName}} {{if eq .Op "upsert"}}updated{{else}}deleted{{end}} this work item · {{end}}<time datetime="{{.Created}}">{{.Created}}</time></span></div>
      </div>
      {{else}}
      <div class="empty-state"><strong>No activity yet</strong><small>Changes across the project will appear here.</small></div>
      {{end}}
    </section>
  </main>
  </div>
  <div id="modal-root"></div>
  <div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div>
</body>
</html>
{{end}}

{{define "page_login"}}
<!doctype html>
<html lang="en">
<head><title>Log in · ZZIRA</title>{{template "head" .}}</head>
<body class="login-body">
  <main class="login-shell">
    <section class="login-story" aria-label="About ZZIRA"><a class="logo login-logo" href="/" aria-label="ZZIRA home"><span class="logo-mark" aria-hidden="true">Z</span><span>ZZIRA</span></a><div><span class="eyebrow">Local-first issue tracking</span><p class="login-display">Ship work,<br><em>not refreshes.</em></p><p>Your team’s work stays fast, available, and in sync—even when the network isn’t.</p></div><div class="login-proof"><span class="sync-dot" aria-hidden="true"></span><span><strong>Built for flow</strong><small>Jira-compatible API · Local replica</small></span></div></section>
    <section class="login-card">
    <span class="eyebrow">Welcome back</span><h1>Log in to your workspace</h1><p class="login-intro">Continue to ZZIRA Software.</p>
    <form method="post" action="/login">
      <label for="login-email">Email</label>
      <input id="login-email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com">
      <label for="login-password">Password</label>
      <input id="login-password" type="password" name="password" required autocomplete="current-password" placeholder="Your password">
      {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>
    </section>
  </main>
</body>
</html>
{{end}}

{{define "page_signed_out"}}
<!doctype html>
<html lang="en">
<head><title>Signed out · ZZIRA</title>{{template "head" .}}</head>
<body class="login-body">
  <main class="login-card">
    <span class="logo-mark" aria-hidden="true">Z</span><h1>Signed out</h1>
    <p>You have been signed out of ZZIRA.</p>
    {{if .OIDCEnabled}}
    <a class="btn btn-primary btn-block" href="/auth/shauth">Sign in with Shauth</a>
    {{else}}
    <a class="btn btn-primary btn-block" href="/login">Log in</a>
    {{end}}
  </main>
</body>
</html>
{{end}}

{{/* The Shauth SSO validator (and any other relying-party auth check) loads
     this page after login and asserts against the data-testid markers below.
     It carries no form action beyond signing out, so it needs no CSRF token. */}}
{{/* This page's CSP (set alongside the handler that serves it) is
     default-src 'none'; style-src 'unsafe-inline' -- deliberately locked down
     since it discloses a live session's identity. It must never pull in the
     shared "head" template's external stylesheets, WASM, and scripts; the
     browser blocks all of them under that policy, which used to leave
     data-testid="validation-username" populated in the DOM but the page
     visually and functionally broken for anything depending on those assets. */}}
{{define "page_validation"}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Authenticated · ZZIRA</title>
<style>
  body { font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
  dt { font-weight: 600; margin-top: .75rem; }
  dd { margin: 0; }
  button { margin-top: 1.5rem; font: inherit; padding: .5rem 1rem; }
</style>
</head>
<body>
  <main>
    <h1>ZZIRA is authenticated</h1>
    <p>Your ZZIRA browser session is active.</p>
    <dl>
      <dt>Username</dt><dd data-testid="validation-username">{{.Username}}</dd>
      <dt>Email</dt><dd data-testid="validation-email">{{.Email}}</dd>
    </dl>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </main>
</body>
</html>
{{end}}
