{{define "dashboard_details_fields"}}
<label for="dashboard-name">Dashboard name</label><input id="dashboard-name" name="name" maxlength="255" value="{{.Details.Name}}" required>
<label for="dashboard-description">Description</label><textarea id="dashboard-description" name="description" maxlength="16384" rows="3">{{.Details.Description}}</textarea>
<fieldset><legend>Who can view?</legend><p class="muted">Private unless you select viewers or editors.</p><label><input type="checkbox" name="viewers" value="loggedin" {{if .ShareSelected "view" "loggedin"}}checked{{end}}> Everyone in this workspace</label>{{range .Members}}<label><input type="checkbox" name="viewers" value="{{.ID}}" {{if $.ShareSelected "view" .ID}}checked{{end}}> {{.DisplayName}}</label>{{end}}</fieldset>
<fieldset><legend>Who can edit gadgets and layout?</legend><label><input type="checkbox" name="editors" value="loggedin" {{if .ShareSelected "edit" "loggedin"}}checked{{end}}> Everyone in this workspace</label>{{range .Members}}<label><input type="checkbox" name="editors" value="{{.ID}}" {{if $.ShareSelected "edit" .ID}}checked{{end}}> {{.DisplayName}}</label>{{end}}</fieldset>
{{end}}
{{define "page_custom_dashboards"}}
<!doctype html><html lang="en"><head><title>Dashboards · ZZIRA</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/dashboards.css?v=1"></head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<header class="page-header"><div><span class="eyebrow">Team insights</span><h1>Dashboards</h1><p>Bring the work that matters into one view.</p></div><a class="btn btn-primary" href="#create-dashboard">Create dashboard</a></header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<form method="get" class="dashboard-toolbar"><label>Find a dashboard<input type="search" name="q" value="{{.Data.Query}}"></label><label>Show<select name="filter"><option value="">All visible dashboards</option><option value="my" {{if eq .Data.Filter "my"}}selected{{end}}>Owned by me</option><option value="favourite" {{if eq .Data.Filter "favourite"}}selected{{end}}>Favourites</option></select></label><button class="btn" type="submit">Filter</button></form>
<div class="dashboard-directory"><section class="surface-card" aria-label="Dashboards">{{range .Data.Dashboards}}<article class="dashboard-directory-row"><div><a href="/dashboards/{{.ID}}"><strong>{{.Name}}</strong></a>{{if .Favourite}} <span class="lozenge">Favourite</span>{{end}}<p>{{.Description}}</p><small>Owned by {{.OwnerName}} · {{if or .SharePermissions .EditPermissions}}Shared{{else}}Private{{end}}</small></div><a class="btn" href="/dashboards/{{.ID}}">Open<span class="sr-only"> {{.Name}}</span></a></article>{{else}}<div class="empty-state"><h2>No dashboards found</h2><p>Create a dashboard with issue lists and charts, or ask a teammate to share one.</p></div>{{end}}</section><form id="create-dashboard" method="post" class="surface-card project-details-form dashboard-form"><h2>Create dashboard</h2>{{template "dashboard_details_fields" .Data}}<button class="btn btn-primary" type="submit">Create dashboard</button></form></div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
{{define "custom_dashboard_grid"}}
<div id="dashboard-grid" class="dashboard-grid layout-{{.Dashboard.Layout}}" data-refresh="{{.Dashboard.RefreshMS}}" data-content-url="/dashboards/{{.Dashboard.ID}}/content">
{{range .Columns}}<div class="dashboard-column">{{range .}}<section class="surface-card dashboard-gadget color-{{.Gadget.Color}}" aria-labelledby="gadget-title-{{.Gadget.ID}}"><header><h2 id="gadget-title-{{.Gadget.ID}}">{{.Gadget.Title}}</h2>{{if $.Dashboard.Writable}}<a href="/dashboards/{{$.Dashboard.ID}}?gadget={{.Gadget.ID}}" aria-label="Configure {{.Gadget.Title}}">Configure</a>{{end}}</header>
{{if .Error}}<p class="form-error">{{.Error}}</p>{{else}}<p class="gadget-total"><strong>{{.Results.Total}}</strong> work items <span class="muted">visible to you</span></p>
{{if or (eq .Gadget.ModuleKey "com.zzira:filter-results") (eq .Gadget.ModuleKey "com.zzira:assigned-to-me")}}<ul class="gadget-issues">{{range .Results.Issues}}<li><a href="/browse/{{.Key}}"><strong>{{.Key}}</strong><span>{{.Summary}}</span></a><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span></li>{{else}}<li>No work items match this query.</li>{{end}}</ul><small>Showing up to {{.Results.Config.Limit}} results.</small>
{{else}}{{if .Results.Total}}{{if eq .Gadget.ModuleKey "com.zzira:pie-chart"}}<svg class="gadget-pie" viewBox="0 0 42 42" aria-hidden="true">{{range .Slices}}<circle cx="21" cy="21" r="15.9154943092" fill="none" stroke="{{.Color}}" stroke-width="9" stroke-dasharray="{{.Dash}}" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 21 21)"/>{{end}}</svg>{{end}}<table class="gadget-counts"><caption class="sr-only">Work items by {{.Results.Config.GroupBy}}</caption><thead><tr><th scope="col">{{.Results.Config.GroupBy}}</th><th scope="col">Count</th><th scope="col">Share</th></tr></thead><tbody>{{range .Slices}}<tr><th scope="row">{{.Name}}</th><td>{{.Count}}</td><td><progress max="100" value="{{.Percent}}" aria-label="{{.Name}} share">{{printf "%.0f" .Percent}}%</progress><span>{{printf "%.0f" .Percent}}%</span></td></tr>{{end}}</tbody></table>{{else}}<p>No work items match this query.</p>{{end}}{{end}}{{end}}
</section>{{end}}</div>{{end}}
</div>
{{end}}
{{define "page_custom_dashboard"}}
<!doctype html><html lang="en"><head><title>{{.Data.Dashboard.Name}} · Dashboards · ZZIRA</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/dashboards.css?v=1"><script src="/static/dashboards.js?v=1" defer></script></head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/dashboards">Dashboards</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Dashboard.Name}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{if or .Data.Dashboard.SharePermissions .Data.Dashboard.EditPermissions}}Shared dashboard{{else}}Private dashboard{{end}}</span><h1>{{.Data.Dashboard.Name}}</h1><p>{{.Data.Dashboard.Description}}</p><small>Owned by {{.Data.Dashboard.OwnerName}}</small></div><div class="dashboard-actions"><button class="btn" type="button" data-dashboard-refresh>Refresh</button><form method="post"><input type="hidden" name="action" value="favourite"><input type="hidden" name="favourite" value="{{if .Data.Dashboard.Favourite}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.Dashboard.Favourite}}Remove favourite{{else}}Add favourite{{end}}</button></form>{{if .Data.Dashboard.Writable}}<a class="btn" href="?edit=1">Edit dashboard</a><a class="btn btn-primary" href="?add=1">Add gadget</a>{{end}}</div></header>
<p class="muted">Charts and lists use your access to work items. <span id="dashboard-refresh-status" role="status">{{if .Data.Dashboard.RefreshMS}}Automatic refresh is on.{{else}}Refresh to see the latest work.{{end}}</span></p>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.Editing}}{{if .Data.Dashboard.Writable}}<div class="dashboard-edit-panels" data-dashboard-editing>{{if .Data.Owner}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Dashboard details and sharing</h2><input type="hidden" name="action" value="save">{{template "dashboard_details_fields" .Data}}<button class="btn btn-primary" type="submit">Save dashboard</button><a href="/dashboards/{{.Data.Dashboard.ID}}">Cancel</a></form>{{end}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Layout and refresh</h2><input type="hidden" name="action" value="presentation"><label for="dashboard-layout">Layout</label><select id="dashboard-layout" name="layout"><option value="A" {{if eq .Data.Dashboard.Layout "A"}}selected{{end}}>One column</option><option value="AA" {{if eq .Data.Dashboard.Layout "AA"}}selected{{end}}>Two equal columns</option><option value="AB" {{if eq .Data.Dashboard.Layout "AB"}}selected{{end}}>Wide left column</option><option value="BA" {{if eq .Data.Dashboard.Layout "BA"}}selected{{end}}>Wide right column</option><option value="AAA" {{if eq .Data.Dashboard.Layout "AAA"}}selected{{end}}>Three equal columns</option></select><label for="dashboard-refresh">Automatic refresh</label><select id="dashboard-refresh" name="refresh"><option value="0" {{if eq .Data.Dashboard.RefreshMS 0}}selected{{end}}>Off</option><option value="60000" {{if eq .Data.Dashboard.RefreshMS 60000}}selected{{end}}>Every minute</option><option value="300000" {{if eq .Data.Dashboard.RefreshMS 300000}}selected{{end}}>Every 5 minutes</option><option value="900000" {{if eq .Data.Dashboard.RefreshMS 900000}}selected{{end}}>Every 15 minutes</option></select><button class="btn btn-primary" type="submit">Save layout</button><a href="/dashboards/{{.Data.Dashboard.ID}}">Done editing</a></form></div>{{end}}{{end}}
{{if .Data.Adding}}{{if .Data.Dashboard.Writable}}<section class="surface-card gadget-catalog" data-dashboard-editing><header><h2>Add a gadget</h2><a href="/dashboards/{{.Data.Dashboard.ID}}">Close catalog</a></header><div>{{range .Data.Catalog}}<form method="post"><h3>{{.Title}}</h3><p>{{.Description}}</p><input type="hidden" name="action" value="add"><input type="hidden" name="moduleKey" value="{{.ModuleKey}}"><button class="btn" type="submit">Add {{.Title}}</button></form>{{end}}</div></section>{{end}}{{end}}
{{with .Data.Gadget}}<div class="dashboard-edit-panels" data-dashboard-editing><form method="post" class="surface-card project-details-form dashboard-form"><h2>Configure {{.Title}}</h2><input type="hidden" name="action" value="configure"><input type="hidden" name="gadget" value="{{.ID}}"><label for="gadget-jql">JQL query</label><textarea id="gadget-jql" name="jql" rows="3" maxlength="16000" placeholder="project = ZZ AND status != Done">{{$.Data.Config.JQL}}</textarea><label for="gadget-filter">Saved filter</label><select id="gadget-filter" name="filterId"><option value="">Use JQL above (blank means all work)</option>{{range $.Data.Filters}}<option value="{{.ID}}" {{if eq $.Data.Config.FilterID .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><small>Choose a saved filter or write JQL. Assigned to me always adds the viewer’s assignment.</small><label for="gadget-group">Group charts by</label><select id="gadget-group" name="groupBy"><option value="status" {{if eq $.Data.Config.GroupBy "status"}}selected{{end}}>Status</option><option value="priority" {{if eq $.Data.Config.GroupBy "priority"}}selected{{end}}>Priority</option><option value="issuetype" {{if eq $.Data.Config.GroupBy "issuetype"}}selected{{end}}>Work type</option><option value="assignee" {{if eq $.Data.Config.GroupBy "assignee"}}selected{{end}}>Assignee</option></select><label for="gadget-limit">Maximum list results</label><input id="gadget-limit" name="limit" type="number" min="1" max="50" value="{{$.Data.Config.Limit}}" required><button class="btn btn-primary" type="submit">Save gadget query</button><a href="/dashboards/{{$.Data.Dashboard.ID}}">Cancel</a></form>
<form method="post" class="surface-card project-details-form dashboard-form"><h2>Gadget appearance and position</h2><input type="hidden" name="action" value="position"><input type="hidden" name="gadget" value="{{.ID}}"><label for="gadget-title">Gadget title</label><input id="gadget-title" name="title" value="{{.Title}}" maxlength="255" required><label for="gadget-color">Accent colour</label><select id="gadget-color" name="color"><option value="blue" {{if eq .Color "blue"}}selected{{end}}>Blue</option><option value="red" {{if eq .Color "red"}}selected{{end}}>Red</option><option value="yellow" {{if eq .Color "yellow"}}selected{{end}}>Yellow</option><option value="green" {{if eq .Color "green"}}selected{{end}}>Green</option><option value="cyan" {{if eq .Color "cyan"}}selected{{end}}>Cyan</option><option value="purple" {{if eq .Color "purple"}}selected{{end}}>Purple</option><option value="gray" {{if eq .Color "gray"}}selected{{end}}>Gray</option><option value="white" {{if eq .Color "white"}}selected{{end}}>White</option></select><label for="gadget-column">Column (from 0)</label><select id="gadget-column" name="column">{{range $.Data.ColumnOptions}}<option value="{{.}}" {{if eq $.Data.Gadget.Position.Column .}}selected{{end}}>{{.}}</option>{{end}}</select><label for="gadget-row">Position (0 is first)</label><input id="gadget-row" name="row" type="number" min="0" max="20" value="{{.Position.Row}}" required><button class="btn btn-primary" type="submit">Save appearance and position</button></form></div><details class="surface-card dashboard-delete"><summary>Remove {{.Title}}</summary><p>This removes the gadget and its settings from this dashboard.</p><form method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="gadget" value="{{.ID}}"><button class="btn btn-danger" type="submit">Remove gadget</button></form></details>{{end}}
{{template "custom_dashboard_grid" .Data}}
{{if not .Data.Columns}}<p>Add a gadget to begin.</p>{{end}}
<div class="dashboard-footer"><details class="surface-card"><summary>Copy dashboard</summary><p>The copy is private and belongs to you.</p><form method="post" class="project-details-form"><input type="hidden" name="action" value="copy"><label for="dashboard-copy-name">Copy name</label><input id="dashboard-copy-name" name="name" value="Copy of {{.Data.Dashboard.Name}}" maxlength="255" required><button class="btn" type="submit">Create copy</button></form></details>{{if .Data.Owner}}<details class="surface-card dashboard-delete"><summary>Delete dashboard</summary><p>Delete this dashboard and its gadgets for everyone. Work items will remain.</p><form method="post"><input type="hidden" name="action" value="delete"><button class="btn btn-danger" type="submit">Delete dashboard permanently</button></form></details>{{end}}</div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
