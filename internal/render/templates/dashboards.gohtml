{{define "dashboard_details_fields"}}
<label for="dashboard-name">Dashboard name</label><input id="dashboard-name" name="name" maxlength="255" value="{{.Details.Name}}" required>
<label for="dashboard-description">Description</label><textarea id="dashboard-description" name="description" maxlength="16384" rows="3">{{.Details.Description}}</textarea>
<fieldset><legend>Who can view?</legend><p class="muted">Private unless you select viewers or editors.</p><label><input type="checkbox" name="viewers" value="loggedin" {{if .ShareSelected "view" "loggedin"}}checked{{end}}> Everyone in this workspace</label>{{range .Members}}<label><input type="checkbox" name="viewers" value="{{.ID}}" {{if $.ShareSelected "view" .ID}}checked{{end}}> {{.DisplayName}}</label>{{end}}{{range .Groups}}<label><input type="checkbox" name="viewers" value="group:{{.ID}}" {{if $.ShareSelected "view" (printf "group:%s" .ID)}}checked{{end}}> Members of {{.Name}}</label>{{end}}{{range $project := .Projects}}<label><input type="checkbox" name="viewers" value="project:{{$project.ID}}" {{if $.ShareSelected "view" (printf "project:%s" $project.ID)}}checked{{end}}> People who can browse {{$project.Name}}</label>{{range $role := $.Roles}}<label><input type="checkbox" name="viewers" value="projectRole:{{$project.ID}}:{{$role.ID}}" {{if $.ShareSelected "view" (printf "projectRole:%s:%d" $project.ID $role.ID)}}checked{{end}}> {{$role.Name}} in {{$project.Name}}</label>{{end}}{{end}}</fieldset>
<fieldset><legend>Who can edit gadgets and layout?</legend><label><input type="checkbox" name="editors" value="loggedin" {{if .ShareSelected "edit" "loggedin"}}checked{{end}}> Everyone in this workspace</label>{{range .Members}}<label><input type="checkbox" name="editors" value="{{.ID}}" {{if $.ShareSelected "edit" .ID}}checked{{end}}> {{.DisplayName}}</label>{{end}}{{range .Groups}}<label><input type="checkbox" name="editors" value="group:{{.ID}}" {{if $.ShareSelected "edit" (printf "group:%s" .ID)}}checked{{end}}> Members of {{.Name}}</label>{{end}}{{range $project := .Projects}}<label><input type="checkbox" name="editors" value="project:{{$project.ID}}" {{if $.ShareSelected "edit" (printf "project:%s" $project.ID)}}checked{{end}}> People who can browse {{$project.Name}}</label>{{range $role := $.Roles}}<label><input type="checkbox" name="editors" value="projectRole:{{$project.ID}}:{{$role.ID}}" {{if $.ShareSelected "edit" (printf "projectRole:%s:%d" $project.ID $role.ID)}}checked{{end}}> {{$role.Name}} in {{$project.Name}}</label>{{end}}{{end}}</fieldset>
{{end}}
{{define "page_custom_dashboards"}}
<!doctype html><html lang="en"><head><title>Dashboards · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/dashboards.css?v=4"></head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<header class="page-header"><div><span class="eyebrow">Team insights</span><h1>Dashboards</h1><p>Bring the work that matters into one view.</p></div><a class="btn btn-primary" href="#create-dashboard">Create dashboard</a></header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<form method="get" class="dashboard-toolbar"><label>Find a dashboard<input type="search" name="q" value="{{.Data.Query}}"></label><label>Show<select name="filter"><option value="">All visible dashboards</option><option value="my" {{if eq .Data.Filter "my"}}selected{{end}}>Owned by me</option><option value="favourite" {{if eq .Data.Filter "favourite"}}selected{{end}}>Favourites</option></select></label><button class="btn" type="submit">Filter</button></form>
<div class="dashboard-directory"><section class="surface-card" aria-label="Dashboards">{{range .Data.Dashboards}}<article class="dashboard-directory-row"><div><a href="/dashboards/{{.ID}}"><strong>{{.Name}}</strong></a>{{if .Favourite}} <span class="lozenge">Favourite</span>{{end}}<p>{{.Description}}</p><small>Owned by {{.OwnerName}} · {{if or .SharePermissions .EditPermissions}}Shared{{else}}Private{{end}}</small></div><a class="btn" href="/dashboards/{{.ID}}">Open<span class="sr-only"> {{.Name}}</span></a></article>{{else}}<div class="empty-state"><h2>No dashboards found</h2><p>Create a dashboard with issue lists and charts, or ask a teammate to share one.</p></div>{{end}}</section><form id="create-dashboard" method="post" class="surface-card project-details-form dashboard-form"><h2>Create dashboard</h2>{{template "dashboard_details_fields" .Data}}<button class="btn btn-primary" type="submit">Create dashboard</button></form></div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
{{define "custom_dashboard_grid"}}
<div id="dashboard-grid" class="dashboard-grid layout-{{.Dashboard.Layout}}" data-refresh="{{.Dashboard.RefreshMS}}" data-content-url="/dashboards/{{.Dashboard.ID}}/content">
{{range .Columns}}<div class="dashboard-column">{{range .}}<section class="surface-card dashboard-gadget color-{{.Gadget.Color}}" aria-labelledby="gadget-title-{{.Gadget.ID}}"><header><h2 id="gadget-title-{{.Gadget.ID}}">{{.Gadget.Title}}</h2><span class="gadget-actions">{{if and .Configurable $.Dashboard.Writable}}<button type="button" class="gadget-action" data-app-configure aria-label="Configure {{.Gadget.Title}}">Configure</button><a href="/dashboards/{{$.Dashboard.ID}}?gadget={{.Gadget.ID}}" aria-label="Edit {{.Gadget.Title}}">Edit</a>{{else if $.Dashboard.Writable}}<a href="/dashboards/{{$.Dashboard.ID}}?gadget={{.Gadget.ID}}" aria-label="Configure {{.Gadget.Title}}">Configure</a>{{end}}{{if .Refreshable}}<button type="button" class="gadget-action" data-app-refresh aria-label="Refresh {{.Gadget.Title}}">Refresh</button>{{end}}</span></header>
{{template "dashboard_gadget_body" .}}
</section>{{end}}</div>{{end}}
</div>
{{end}}

{{define "dashboard_gadget_body"}}{{if .Error}}<p class="form-error">{{.Error}}</p>{{else if .Report}}{{template "dashboard_report_gadget" .}}{{else if .AppModule}}<div class="app-dashboard-module"><span class="eyebrow">{{.AppModule.AppName}} app</span>{{if .AppModule.RemoteURL}}<iframe class="app-gadget-frame" data-app-module="{{.AppModule.ID}}" data-app-base="{{.AppModule.BaseURL}}" data-dashboard-id="{{.DashboardID}}" data-dashboard-item-id="{{.Gadget.ID}}" data-dashboard-item-key="{{.AppModule.Key}}" data-editable="{{and .Configurable .Writable}}" src="/app-modules/{{.AppModule.ID}}/frame?dashboardId={{.DashboardID}}&amp;dashboardItemId={{.Gadget.ID}}&amp;dashboardItemKey={{.AppModule.Key}}&amp;dashboardItemViewType=default" title="{{.AppModule.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe>{{else}}<p>{{.AppModule.Body}}</p>{{end}}</div>{{else if eq .Gadget.ModuleKey "com.zzira:activity-stream"}}{{with .Activity}}<ol class="gadget-activity">{{range .}}<li><p><strong>{{.Actor}}</strong> {{if eq .Kind "created"}}created{{else if eq .Kind "commented"}}commented on{{else}}updated{{end}} <a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a> {{.Summary}}</p>{{if .Changes}}<ul class="change-list">{{range .Changes}}<li><strong>{{.Field}}</strong> changed{{if .FromString}} from “{{.FromString}}”{{end}}{{if .ToString}} to “{{.ToString}}”{{end}}</li>{{end}}</ul>{{end}}{{if .Comment}}<p class="gadget-activity-comment">{{adfToText .Comment}}</p>{{end}}<time datetime="{{.When}}">{{.WhenLabel}}</time></li>{{end}}</ol>{{else}}<p>No recent activity on this work.</p>{{end}}
{{else if .Bubbles}}{{with .Bubbles}}{{if .Points}}<svg class="gadget-report-chart gadget-bubbles" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="{{len .Points}} work items by days since last update and {{.VerticalName}}, sized by {{.SizeName}}"><line x1="{{.Left}}" y1="{{.Bottom}}" x2="{{.Right}}" y2="{{.Bottom}}" class="chart-axis"/><line x1="{{.Left}}" y1="{{.Top}}" x2="{{.Left}}" y2="{{.Bottom}}" class="chart-axis"/>{{range .Points}}<circle cx="{{.X}}" cy="{{.Y}}" r="{{.R}}" class="bubble-{{.Shade}}"><title>{{.Key}}: updated {{.UpdatedDays}} days ago, {{.Participants}} participants, {{.Votes}} votes</title></circle>{{end}}</svg><p class="chart-legend"><span>Across: days since last update, up to {{.MaxDays}}</span><span>Up: {{.VerticalName}}, up to {{.MaxVertical}}</span><span>Size: {{.SizeName}}; darker is more recent</span></p><details class="chart-data"><summary>View work items</summary><div class="table-scroll" tabindex="0" aria-label="{{$.Gadget.Title}} work items"><table><caption class="sr-only">{{$.Gadget.Title}} work items</caption><thead><tr><th scope="col">Work item</th><th scope="col">Updated (days ago)</th><th scope="col">Participants</th><th scope="col">Votes</th></tr></thead><tbody>{{range .Points}}<tr><th scope="row"><a href="/browse/{{.Key}}">{{.Key}}</a> {{.Summary}}</th><td>{{.UpdatedDays}}</td><td>{{.Participants}}</td><td>{{.Votes}}</td></tr>{{end}}</tbody></table></div></details>{{else}}<p>No work items match this query.</p>{{end}}{{end}}
{{else if .Calendar}}{{with .Calendar}}<div class="gadget-calendar-scroll" role="region" tabindex="0" aria-label="{{$.Gadget.Title}}, {{.Title}}"><table class="gadget-calendar"><caption>{{.Title}}</caption><thead><tr>{{range .Weekdays}}<th scope="col"><abbr title="{{.Name}}">{{.Short}}</abbr></th>{{end}}</tr></thead><tbody>{{range .Weeks}}<tr>{{range .}}{{if .}}<td{{if .Today}} class="today" aria-current="date"{{end}}><span class="gadget-calendar-day">{{.Day}}</span>{{if or .Issues .Versions}}<ul>{{range .Versions}}<li class="gadget-calendar-version">{{.ProjectKey}} {{.VersionName}}{{if .Released}} (released){{else}} release{{end}}</li>{{end}}{{range .Issues}}<li><a href="/browse/{{.IssueKey}}">{{.IssueKey}}<span class="sr-only"> {{.Summary}}</span></a></li>{{end}}</ul>{{end}}</td>{{else}}<td></td>{{end}}{{end}}</tr>{{end}}</tbody></table></div>{{if .More}}<small>{{.More}} more due this month are not shown.</small>{{end}}{{if .Empty}}<p class="muted">Nothing is due this month.</p>{{end}}{{end}}
{{else}}<p class="gadget-total"><strong>{{.Results.Total}}</strong> work items <span class="muted">visible to you</span></p>
{{if .Gadget.ListGadget}}<ul class="gadget-issues">{{range .Results.Issues}}<li><a href="/browse/{{.Key}}"><strong>{{.Key}}</strong><span>{{.Summary}}</span></a><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span></li>{{else}}<li>No work items match this query.</li>{{end}}</ul><small>Showing up to {{.Results.Config.Limit}} results.</small>
{{else if not .Results.Total}}<p>No work items match this query.</p>
{{else if .Results.Grid}}<div class="gadget-grid-scroll" role="region" tabindex="0" aria-label="{{.Gadget.Title}} table"><table class="gadget-grid"><caption class="sr-only">Work items by {{.Results.Config.YGroupLabel}} and {{.Results.Config.GroupLabel}}</caption><thead><tr><th scope="col">{{.Results.Config.YGroupLabel}}</th>{{range .Results.Grid.Columns}}<th scope="col">{{.}}</th>{{end}}<th scope="col">Total</th></tr></thead><tbody>{{range .Results.Grid.Rows}}<tr><th scope="row">{{.Name}}</th>{{range .Counts}}<td>{{.}}</td>{{end}}<td>{{.Total}}</td></tr>{{end}}</tbody><tfoot><tr><th scope="row">Total</th>{{range .Results.Grid.ColumnTotals}}<td>{{.}}</td>{{end}}<td>{{.Results.Grid.Total}}</td></tr></tfoot></table></div>{{if .Results.Grid.HiddenRows}}<small>Showing the {{len .Results.Grid.Rows}} largest rows; {{.Results.Grid.HiddenRows}} more are not shown.</small>{{end}}
{{else if eq .Gadget.ModuleKey "com.zzira:heat-map"}}<ul class="gadget-heat-map" aria-label="Work items by {{.Results.Config.GroupLabel}}">{{range .Slices}}<li class="heat-{{.Weight}}"><span>{{.Name}}</span> <small>{{.Count}} · {{printf "%.0f" .Percent}}%</small></li>{{end}}</ul>
{{else}}{{if eq .Gadget.ModuleKey "com.zzira:pie-chart"}}<svg class="gadget-pie" viewBox="0 0 42 42" aria-hidden="true">{{range .Slices}}<circle cx="21" cy="21" r="15.9154943092" fill="none" stroke="{{.Color}}" stroke-width="9" stroke-dasharray="{{.Dash}}" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 21 21)"/>{{end}}</svg>{{end}}<table class="gadget-counts"><caption class="sr-only">Work items by {{.Results.Config.GroupLabel}}</caption><thead><tr><th scope="col">{{.Results.Config.GroupLabel}}</th><th scope="col">Count</th><th scope="col">Share</th></tr></thead><tbody>{{range .Slices}}<tr><th scope="row">{{.Name}}</th><td>{{.Count}}</td><td><progress max="100" value="{{.Percent}}" aria-label="{{.Name}} share">{{printf "%.0f" .Percent}}%</progress><span>{{printf "%.0f" .Percent}}%</span></td></tr>{{end}}</tbody></table>{{end}}{{end}}{{end}}
{{define "page_custom_dashboard"}}
<!doctype html><html lang="en"><head><title>{{.Data.Dashboard.Name}} · Dashboards · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/dashboards.css?v=4"><script src="/static/dashboards.js?v=1" defer></script><script src="/static/connect-host.js?v=1" defer></script></head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/dashboards">Dashboards</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Dashboard.Name}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{if or .Data.Dashboard.SharePermissions .Data.Dashboard.EditPermissions}}Shared dashboard{{else}}Private dashboard{{end}}</span><h1>{{.Data.Dashboard.Name}}</h1><p>{{.Data.Dashboard.Description}}</p><small>Owned by {{.Data.Dashboard.OwnerName}}</small></div><div class="dashboard-actions"><button class="btn" type="button" data-dashboard-refresh>Refresh</button><a class="btn" href="/dashboards/{{.Data.Dashboard.ID}}/wallboard">View as wallboard</a>{{if .Data.Slideshow.DashboardIDs}}<a class="btn" href="/dashboards/slideshow">View wallboard slide show</a>{{end}}<details class="dashboard-subscribe"><summary class="btn">Email this dashboard</summary><div class="surface-card dashboard-subscribe-panel">{{range .Data.Subscriptions}}<form method="post"><input type="hidden" name="action" value="unsubscribe"><input type="hidden" name="subscriptionId" value="{{.ID}}"><span><strong>{{if eq .CronExpression "0 8 * * *"}}Every day{{else}}Every Monday{{end}} at 08:00 UTC</strong>{{if .NextRunAt}}<small>Next <time datetime="{{.NextRunAt}}">{{.NextRunAt}}</time></small>{{end}}{{if .LastError}}<small class="form-error">{{.LastError}}</small>{{end}}</span><button class="btn" type="submit">Remove email</button></form>{{end}}<form method="post" class="project-details-form"><input type="hidden" name="action" value="subscribe"><label for="dashboard-schedule">Delivery</label><select id="dashboard-schedule" name="schedule"><option value="0 8 * * *">Every day at 08:00 UTC</option><option value="0 8 * * 1">Every Monday at 08:00 UTC</option></select><fieldset><legend>Recipients</legend>{{range .Data.Members}}<label><input type="checkbox" name="recipient" value="{{.ID}}" {{if eq .ID $.Data.CurrentUserID}}checked{{end}}> {{.DisplayName}}</label>{{end}}</fieldset><p class="form-hint">Each recipient receives the dashboard as they see it, and must be able to view it.</p><button class="btn btn-primary" type="submit">Schedule email</button></form></div></details><form method="post"><input type="hidden" name="action" value="favourite"><input type="hidden" name="favourite" value="{{if .Data.Dashboard.Favourite}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.Dashboard.Favourite}}Remove favourite{{else}}Add favourite{{end}}</button></form>{{if .Data.Dashboard.Writable}}<a class="btn" href="?edit=1">Edit dashboard</a><a class="btn btn-primary" href="?add=1">Add gadget</a>{{end}}</div></header>
<p class="muted">Charts and lists use your access to work items. <span id="dashboard-refresh-status" role="status">{{if .Data.Dashboard.RefreshMS}}Automatic refresh is on.{{else}}Refresh to see the latest work.{{end}}</span></p>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.Editing}}{{if .Data.Dashboard.Writable}}<div class="dashboard-edit-panels" data-dashboard-editing>{{if .Data.Owner}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Dashboard details and sharing</h2><input type="hidden" name="action" value="save">{{template "dashboard_details_fields" .Data}}<button class="btn btn-primary" type="submit">Save dashboard</button><a href="/dashboards/{{.Data.Dashboard.ID}}">Cancel</a></form>{{end}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Layout and refresh</h2><input type="hidden" name="action" value="presentation"><label for="dashboard-layout">Layout</label><select id="dashboard-layout" name="layout"><option value="A" {{if eq .Data.Dashboard.Layout "A"}}selected{{end}}>One column</option><option value="AA" {{if eq .Data.Dashboard.Layout "AA"}}selected{{end}}>Two equal columns</option><option value="AB" {{if eq .Data.Dashboard.Layout "AB"}}selected{{end}}>Wide left column</option><option value="BA" {{if eq .Data.Dashboard.Layout "BA"}}selected{{end}}>Wide right column</option><option value="AAA" {{if eq .Data.Dashboard.Layout "AAA"}}selected{{end}}>Three equal columns</option></select><label for="dashboard-refresh">Automatic refresh</label><select id="dashboard-refresh" name="refresh"><option value="0" {{if eq .Data.Dashboard.RefreshMS 0}}selected{{end}}>Off</option><option value="60000" {{if eq .Data.Dashboard.RefreshMS 60000}}selected{{end}}>Every minute</option><option value="300000" {{if eq .Data.Dashboard.RefreshMS 300000}}selected{{end}}>Every 5 minutes</option><option value="900000" {{if eq .Data.Dashboard.RefreshMS 900000}}selected{{end}}>Every 15 minutes</option></select><button class="btn btn-primary" type="submit">Save layout</button><a href="/dashboards/{{.Data.Dashboard.ID}}">Done editing</a></form></div>{{end}}{{end}}
{{if .Data.Adding}}{{if .Data.Dashboard.Writable}}<section class="surface-card gadget-catalog" data-dashboard-editing><header><h2>Add a gadget</h2><a href="/dashboards/{{.Data.Dashboard.ID}}">Close catalog</a></header><div>{{range .Data.Catalog}}<form method="post">{{if .Thumbnail}}<img class="app-module-thumbnail" src="{{.Thumbnail}}" alt="" referrerpolicy="no-referrer">{{end}}<h3>{{.Title}}</h3><p>{{.Description}}</p><input type="hidden" name="action" value="add"><input type="hidden" name="moduleKey" value="{{.ModuleKey}}"><button class="btn" type="submit">Add {{.Title}}</button></form>{{end}}</div></section>{{end}}{{end}}
{{with .Data.Gadget}}<div class="dashboard-edit-panels" data-dashboard-editing>{{if not $.Data.AppGadget}}{{if .ReportGadget}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Configure {{.Title}}</h2><input type="hidden" name="action" value="configure"><input type="hidden" name="gadget" value="{{.ID}}">{{if .ProjectReportGadget}}<label for="gadget-project">Project</label><select id="gadget-project" name="projectKey" required><option value="">Choose a project</option>{{range $.Data.Projects}}<option value="{{.Key}}" {{if eq $.Data.Config.ProjectKey .Key}}selected{{end}}>{{.Name}} ({{.Key}})</option>{{end}}</select><label for="gadget-days">Time window</label><select id="gadget-days" name="days">{{range $.Data.ReportWindows}}<option value="{{.}}" {{if eq . $.Data.Config.Days}}selected{{end}}>Last {{.}} days</option>{{end}}</select>{{if eq .ModuleKey "com.zzira:created-vs-resolved"}}<label class="report-toggle"><input type="checkbox" name="cumulative" value="true" {{if $.Data.Config.Cumulative}}checked{{end}}> Running totals</label>{{end}}{{if eq .ModuleKey "com.zzira:time-since"}}<label for="gadget-date-field">Date field</label><select id="gadget-date-field" name="dateField">{{range $.Data.TimeSinceFields}}<option value="{{.Key}}" {{if eq $.Data.Config.DateField .Key}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{end}}{{else}}<label for="gadget-board">Scrum board</label><select id="gadget-board" name="boardId" required><option value="">Choose a scrum board</option>{{range $.Data.Boards}}<option value="{{.ID}}" {{if eq $.Data.Config.BoardID .ID}}selected{{end}}>{{.Name}} ({{.ProjectKey}})</option>{{end}}</select>{{end}}<button class="btn btn-primary" type="submit">Save gadget report</button><a href="/dashboards/{{$.Data.Dashboard.ID}}">Cancel</a></form>{{else}}<form method="post" class="surface-card project-details-form dashboard-form"><h2>Configure {{.Title}}</h2><input type="hidden" name="action" value="configure"><input type="hidden" name="gadget" value="{{.ID}}"><label for="gadget-jql">JQL query</label><textarea id="gadget-jql" name="jql" rows="3" maxlength="16000" placeholder="project = ZZ AND status != Done">{{$.Data.Config.JQL}}</textarea><label for="gadget-filter">Saved filter</label><select id="gadget-filter" name="filterId"><option value="">Use JQL above (blank means all work)</option>{{range $.Data.Filters}}<option value="{{.ID}}" {{if eq $.Data.Config.FilterID .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><small>Choose a saved filter or write JQL. Assigned to me always adds the viewer’s assignment.</small>{{if .ChartGadget}}<label for="gadget-group">{{if eq .ModuleKey "com.zzira:two-dimensional-statistics"}}Columns{{else}}Group charts by{{end}}</label><select id="gadget-group" name="groupBy">{{range $.Data.Groupings}}<option value="{{.Key}}" {{if eq $.Data.Config.GroupBy .Key}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{if eq .ModuleKey "com.zzira:two-dimensional-statistics"}}<label for="gadget-y-group">Rows</label><select id="gadget-y-group" name="yGroupBy">{{range $.Data.Groupings}}<option value="{{.Key}}" {{if eq $.Data.Config.YGroupBy .Key}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{end}}{{end}}{{if eq .ModuleKey "com.zzira:bubble-chart"}}<label for="gadget-bubble-axis">Vertical axis</label><select id="gadget-bubble-axis" name="bubbleAxis"><option value="participants" {{if eq $.Data.Config.BubbleAxis "participants"}}selected{{end}}>Participants, sized by votes</option><option value="votes" {{if eq $.Data.Config.BubbleAxis "votes"}}selected{{end}}>Votes, sized by participants</option></select>{{end}}<label for="gadget-limit">{{if eq .ModuleKey "com.zzira:activity-stream"}}Maximum events{{else}}Maximum list results{{end}}</label><input id="gadget-limit" name="limit" type="number" min="1" max="50" value="{{$.Data.Config.Limit}}" required><button class="btn btn-primary" type="submit">Save gadget query</button><a href="/dashboards/{{$.Data.Dashboard.ID}}">Cancel</a></form>{{end}}{{end}}
<form method="post" class="surface-card project-details-form dashboard-form"><h2>Gadget appearance and position</h2><input type="hidden" name="action" value="position"><input type="hidden" name="gadget" value="{{.ID}}"><label for="gadget-title">Gadget title</label><input id="gadget-title" name="title" value="{{.Title}}" maxlength="255" required><label for="gadget-color">Accent colour</label><select id="gadget-color" name="color"><option value="blue" {{if eq .Color "blue"}}selected{{end}}>Blue</option><option value="red" {{if eq .Color "red"}}selected{{end}}>Red</option><option value="yellow" {{if eq .Color "yellow"}}selected{{end}}>Yellow</option><option value="green" {{if eq .Color "green"}}selected{{end}}>Green</option><option value="cyan" {{if eq .Color "cyan"}}selected{{end}}>Cyan</option><option value="purple" {{if eq .Color "purple"}}selected{{end}}>Purple</option><option value="gray" {{if eq .Color "gray"}}selected{{end}}>Gray</option><option value="white" {{if eq .Color "white"}}selected{{end}}>White</option></select><label for="gadget-column">Column (from 0)</label><select id="gadget-column" name="column">{{range $.Data.ColumnOptions}}<option value="{{.}}" {{if eq $.Data.Gadget.Position.Column .}}selected{{end}}>{{.}}</option>{{end}}</select><label for="gadget-row">Position (0 is first)</label><input id="gadget-row" name="row" type="number" min="0" max="20" value="{{.Position.Row}}" required><button class="btn btn-primary" type="submit">Save appearance and position</button></form></div><details class="surface-card dashboard-delete"><summary>Remove {{.Title}}</summary><p>This removes the gadget and its settings from this dashboard.</p><form method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="gadget" value="{{.ID}}"><button class="btn btn-danger" type="submit">Remove gadget</button></form></details>{{end}}
{{template "custom_dashboard_grid" .Data}}
{{if not .Data.Columns}}<p>Add a gadget to begin.</p>{{end}}
<div class="dashboard-footer">{{if .Data.Dashboard.Writable}}<details class="surface-card"{{if .Data.SlideshowOpen}} open{{end}}><summary>Configure wallboard slide show</summary><p>The slide show is shared by everyone on this site. Each viewer sees only the chosen dashboards they can view.</p><form method="post" class="project-details-form dashboard-form"><input type="hidden" name="action" value="slideshow"><fieldset><legend>Dashboards in the slide show</legend>{{range .Data.Dashboards}}<label><input type="checkbox" name="slideshowDashboard" value="{{.ID}}"{{if $.Data.InSlideshow .ID}} checked{{end}}> {{.Name}}</label>{{end}}</fieldset><label for="slideshow-interval">Seconds per dashboard</label><input id="slideshow-interval" name="interval" type="number" min="5" max="3600" value="{{.Data.Slideshow.IntervalSeconds}}" required><label><input type="checkbox" name="randomOrder" value="true"{{if .Data.Slideshow.RandomOrder}} checked{{end}}> Show dashboards in random order</label><button class="btn btn-primary" type="submit">Save slide show</button></form></details>{{end}}<details class="surface-card"><summary>Copy dashboard</summary><p>The copy is private and belongs to you.</p><form method="post" class="project-details-form"><input type="hidden" name="action" value="copy"><label for="dashboard-copy-name">Copy name</label><input id="dashboard-copy-name" name="name" value="Copy of {{.Data.Dashboard.Name}}" maxlength="255" required><button class="btn" type="submit">Create copy</button></form></details>{{if .Data.Owner}}<details class="surface-card dashboard-delete"><summary>Delete dashboard</summary><p>Delete this dashboard and its gadgets for everyone. Work items will remain.</p><form method="post"><input type="hidden" name="action" value="delete"><button class="btn btn-danger" type="submit">Delete dashboard permanently</button></form></details>{{end}}</div>
</main></div><div id="modal-root"></div></body></html>
{{end}}

{{define "dashboard_report_gadget"}}{{with .Report}}
{{with .CreatedResolved}}<p class="gadget-total"><strong>{{.CreatedTotal}}</strong> created · <strong>{{.ResolvedTotal}}</strong> resolved <span class="muted">in {{$.Report.Project.Key}}, last {{$.Report.Days}} days{{if .Cumulative}}, running totals{{end}}</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="Work created and resolved in {{$.Report.Project.Key}}"><polyline points="{{.Created}}" class="chart-remaining"/><polyline points="{{.Resolved}}" class="chart-completed-line"/></svg><div class="chart-legend"><span><i class="legend-remaining"></i>Created</span><span><i class="legend-success"></i>Resolved</span></div><details class="chart-data"><summary>View daily counts</summary><div class="table-scroll" tabindex="0" aria-label="Created and resolved by day in {{$.Report.Project.Key}}"><table><caption class="sr-only">Created and resolved by day in {{$.Report.Project.Key}}</caption><thead><tr><th scope="col">Date</th><th scope="col">Created</th><th scope="col">Resolved</th></tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th><td>{{.Created}}</td><td>{{.Resolved}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
{{with .Resolution}}<p class="gadget-total"><strong>{{if .Average}}{{.Average}}{{else}}-{{end}}</strong> average resolution time <span class="muted">for {{.Resolved}} resolved in {{$.Report.Project.Key}}, last {{$.Report.Days}} days</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="Average resolution time by day in {{$.Report.Project.Key}}">{{range .Bars}}{{if .Resolved}}<rect x="{{.X}}" y="{{.Y}}" width="{{$.Report.Resolution.BarWidth}}" height="{{.Height}}" class="chart-completed"/>{{end}}{{end}}</svg><details class="chart-data"><summary>View daily resolution time</summary><div class="table-scroll" tabindex="0" aria-label="Resolution time by day in {{$.Report.Project.Key}}"><table><caption class="sr-only">Resolution time by day in {{$.Report.Project.Key}}</caption><thead><tr><th scope="col">Date</th><th scope="col">Resolved</th><th scope="col">Average</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Date}}</th><td>{{.Resolved}}</td><td>{{if .Average}}{{.Average}}{{else}}-{{end}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
{{with .Velocity}}{{if .Sprints}}<p class="gadget-total"><strong>{{.AverageCompleted}}</strong> completed per sprint <span class="muted">on {{$.Report.Board.Name}}, {{.Statistic}}</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="Commitment and completed work per sprint on {{$.Report.Board.Name}}">{{range .Bars}}<rect x="{{.X}}" y="{{.CommitmentY}}" width="28" height="{{.CommitmentHeight}}" class="chart-commitment"/><rect x="{{.CompletedX}}" y="{{.CompletedY}}" width="28" height="{{.CompletedHeight}}" class="chart-completed"/>{{end}}</svg><div class="chart-legend"><span><i class="legend-commitment"></i>Commitment</span><span><i class="legend-success"></i>Completed</span></div><details class="chart-data"><summary>View sprint data</summary><div class="table-scroll" tabindex="0" aria-label="Velocity on {{$.Report.Board.Name}}"><table><caption class="sr-only">Velocity on {{$.Report.Board.Name}}</caption><thead><tr><th scope="col">Sprint</th><th scope="col">Commitment</th><th scope="col">Completed</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Name}}</th><td>{{.Commitment}}</td><td>{{.Completed}}</td></tr>{{end}}</tbody></table></div></details>{{else}}<p>No completed sprints on {{$.Report.Board.Name}} yet.</p>{{end}}{{end}}
{{if eq $.Gadget.ModuleKey "com.zzira:sprint-burndown"}}{{with .Burndown}}<p class="gadget-total"><strong>{{with $.Report.Sprint}}{{.Name}}{{end}}</strong> <span class="muted">on {{$.Report.Board.Name}} · {{.Statistic}}</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-label="Remaining work in the active sprint on {{$.Report.Board.Name}}">{{if .Chart.Guideline}}<line x1="{{.Chart.GuideX1}}" y1="{{.Chart.GuideY1}}" x2="{{.Chart.GuideX2}}" y2="{{.Chart.GuideY2}}" class="chart-guideline"/>{{end}}<polyline points="{{.Chart.Remaining}}" class="chart-remaining"/></svg><details class="chart-data"><summary>View burndown changes</summary><div class="table-scroll" tabindex="0" aria-label="Burndown changes on {{$.Report.Board.Name}}"><table><caption class="sr-only">Burndown changes on {{$.Report.Board.Name}}</caption><thead><tr><th scope="col">Date</th><th scope="col">Event</th><th scope="col">Remaining</th></tr></thead><tbody>{{range .Events}}<tr><th scope="row">{{.When}}</th><td>{{if .IssueKey}}{{.IssueKey}} {{end}}{{.Label}}</td><td>{{.RemainingText}}</td></tr>{{end}}</tbody></table></div></details>{{else}}<p>No active sprint on {{$.Report.Board.Name}}.</p>{{end}}{{end}}
{{with .RecentlyCreated}}<p class="gadget-total"><strong>{{.Created}}</strong> created · <strong>{{.Resolved}}</strong> since resolved <span class="muted">in {{$.Report.Project.Key}}, last {{$.Report.Days}} days</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-label="Work created each day in {{$.Report.Project.Key}}, by whether it is resolved">{{range .Chart.Bars}}{{if .LowerHeight}}<rect x="{{.X}}" y="{{.LowerY}}" width="{{.Width}}" height="{{.LowerHeight}}" class="chart-completed"/>{{end}}{{if .UpperHeight}}<rect x="{{.X}}" y="{{.UpperY}}" width="{{.Width}}" height="{{.UpperHeight}}" class="chart-commitment"/>{{end}}{{end}}</svg><div class="chart-legend"><span><i class="legend-success"></i>Resolved</span><span><i class="legend-commitment"></i>Unresolved</span></div><details class="chart-data"><summary>View daily counts</summary><div class="table-scroll" tabindex="0" aria-label="Recently created work by day in {{$.Report.Project.Key}}"><table><caption class="sr-only">Recently created work by day in {{$.Report.Project.Key}}</caption><thead><tr><th scope="col">Date</th><th scope="col">Resolved</th><th scope="col">Unresolved</th></tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th><td>{{.Resolved}}</td><td>{{.Unresolved}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
{{with .AverageAge}}<p class="gadget-total"><strong>{{.Average}}</strong> average age <span class="muted">of {{.Unresolved}} unresolved in {{$.Report.Project.Key}} today</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-label="Average age of unresolved work by day in {{$.Report.Project.Key}}">{{range .Chart.Bars}}{{if .LowerHeight}}<rect x="{{.X}}" y="{{.LowerY}}" width="{{.Width}}" height="{{.LowerHeight}}" class="chart-commitment"/>{{end}}{{end}}</svg><details class="chart-data"><summary>View daily average age</summary><div class="table-scroll" tabindex="0" aria-label="Average age by day in {{$.Report.Project.Key}}"><table><caption class="sr-only">Average age by day in {{$.Report.Project.Key}}</caption><thead><tr><th scope="col">Date</th><th scope="col">Unresolved</th><th scope="col">Average age</th></tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th><td>{{.Unresolved}}</td><td>{{.Average}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
{{with .TimeSince}}<p class="gadget-total"><strong>{{.Total}}</strong> {{.Verb}} <span class="muted">in {{$.Report.Project.Key}}, last {{$.Report.Days}} days</span></p><svg class="gadget-report-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-label="Work {{.Verb}} each day in {{$.Report.Project.Key}}">{{range .Chart.Bars}}{{if .LowerHeight}}<rect x="{{.X}}" y="{{.LowerY}}" width="{{.Width}}" height="{{.LowerHeight}}" class="chart-completed"/>{{end}}{{end}}</svg><details class="chart-data"><summary>View daily counts</summary><div class="table-scroll" tabindex="0" aria-label="Work {{.Verb}} by day in {{$.Report.Project.Key}}"><table><caption class="sr-only">Work {{.Verb}} by day in {{$.Report.Project.Key}}</caption><thead><tr><th scope="col">Date</th><th scope="col">{{.FieldName}}</th></tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th><td>{{.Count}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
{{with .DaysRemaining}}{{if not .HasEnd}}<p class="gadget-total"><strong>{{$.Report.Sprint.Name}}</strong> <span class="muted">on {{$.Report.Board.Name}} has no end date</span></p>{{else if .Overdue}}<p class="gadget-total"><strong>{{.Days}}</strong> {{if eq .Days 1}}day{{else}}days{{end}} overdue <span class="muted">{{$.Report.Sprint.Name}} on {{$.Report.Board.Name}} was due to end {{.EndLabel}}</span></p>{{else}}<p class="gadget-total"><strong>{{.Days}}</strong> {{if eq .Days 1}}day{{else}}days{{end}} remaining <span class="muted">in {{$.Report.Sprint.Name}} on {{$.Report.Board.Name}}, ending {{.EndLabel}}</span></p>{{end}}{{end}}
{{with .SprintHealth}}<p class="gadget-total"><strong>{{$.Report.Sprint.Name}}</strong> <span class="muted">on {{$.Report.Board.Name}} · {{.Statistic}}</span></p><dl class="gadget-sprint-health"><div><dt>Time elapsed</dt><dd>{{if .HasEnd}}<progress max="100" value="{{.Elapsed}}" aria-label="Time elapsed"></progress><span>{{.Elapsed}}%</span>{{else}}No end date{{end}}</dd></div><div><dt>Work complete</dt><dd><progress max="100" value="{{.Complete}}" aria-label="Work complete"></progress><span>{{.Complete}}%</span></dd></div><div><dt>Scope change</dt><dd><span>{{.ScopeChange}}%</span><small class="muted">{{.Added}} added and {{.Removed}} removed after {{.Committed}} committed</small></dd></div></dl>{{end}}
{{if and .Board (not .Sprint)}}{{if or (eq $.Gadget.ModuleKey "com.zzira:days-remaining") (eq $.Gadget.ModuleKey "com.zzira:sprint-health")}}<p>No active sprint on {{.Board.Name}}.</p>{{end}}{{end}}
{{with .RoadMap}}{{if .Rows}}<ul class="gadget-road-map">{{range .Rows}}<li><p><strong>{{.Name}}</strong> <span class="muted">{{if .Overdue}}Overdue, due {{else}}Due {{end}}{{.ReleaseLabel}}</span></p><progress max="{{.Maximum}}" value="{{.Done}}" aria-label="{{.Name}} work done"></progress><small>{{.Done}} of {{.Total}} work items done</small></li>{{end}}</ul>{{else}}<p>No unreleased versions in {{$.Report.Project.Key}} are due in the next {{$.Report.Days}} days.</p>{{end}}{{end}}
{{end}}{{end}}

{{define "page_dashboard_wallboard"}}
<!doctype html><html lang="en"><head><title>{{.Data.Title}} · Wallboard · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/dashboards.css?v=4"><script src="/static/wallboard.js?v=1" defer></script><script src="/static/connect-host.js?v=1" defer></script></head><body class="wallboard">
<main id="main-content" class="wallboard-main" data-wallboard data-interval="{{.Data.IntervalSeconds}}" data-refresh="{{.Data.RefreshMS}}" data-slideshow="{{.Data.Slideshow}}">
<header class="wallboard-bar"><h1>{{.Data.Title}}</h1><span id="wallboard-status" class="sr-only" role="status"></span>{{if .Data.Rotates}}<button class="btn" type="button" data-wallboard-pause aria-pressed="false">Pause rotation</button>{{end}}<a class="btn" href="{{.Data.ExitURL}}">{{.Data.Exit}}</a></header>
{{range $index, $slide := .Data.Slides}}<section class="wallboard-slide" data-wallboard-slide aria-labelledby="wallboard-slide-{{.Dashboard.ID}}"{{if $index}} hidden{{end}}><h2 id="wallboard-slide-{{.Dashboard.ID}}" class="{{if not $.Data.Slideshow}}sr-only{{else}}wallboard-slide-title{{end}}">{{.Dashboard.Name}}</h2>
<div class="dashboard-grid wallboard-grid layout-{{.Dashboard.Layout}}">{{range .Columns}}<div class="dashboard-column">{{range .}}<div class="wallboard-group" data-wallboard-group>{{range .}}<section class="surface-card dashboard-gadget color-{{.Tile.Gadget.Color}}" data-wallboard-gadget aria-labelledby="wallboard-gadget-{{.Tile.Gadget.ID}}"{{if gt .Position 1}} hidden{{end}}><header><h3 id="wallboard-gadget-{{.Tile.Gadget.ID}}">{{.Tile.Gadget.Title}}</h3>{{if gt .Count 1}}<small class="wallboard-position">{{.Position}} of {{.Count}}</small>{{end}}</header>
{{template "dashboard_gadget_body" .Tile}}
</section>{{end}}</div>{{end}}</div>{{end}}</div>
{{if not .Columns}}<p>This dashboard has no gadgets.</p>{{end}}
</section>{{else}}<p class="wallboard-empty">{{if .Data.Slideshow}}No dashboards in the slide show are available to you. Someone who can edit a dashboard can configure the slide show from it.{{else}}This dashboard has no gadgets.{{end}}</p>{{end}}
</main><div id="modal-root"></div></body></html>
{{end}}
