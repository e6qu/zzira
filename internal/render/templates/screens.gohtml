{{define "page_screens"}}
<!doctype html><html lang="en"><head><title>Screens · ZZIRA</title>{{template "head" .}}</head>
<body class="page-screens"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Screens</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Screens</h1><p>Group the fields a work item form shows, and order them with tabs.</p></div><a class="btn" href="/rest/api/3/screens">View screen API</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card screen-create" aria-labelledby="screen-create-heading"><div class="screen-mark" aria-hidden="true"><span></span></div><div><h2 id="screen-create-heading">Create a screen</h2><p>A screen starts with one tab. Add tabs to group related fields.</p></div><form class="project-details-form" method="post" action="/settings/screens"><label for="screen-name-new">Screen name</label><input id="screen-name-new" name="name" maxlength="255" required><label for="screen-description-new">Description</label><textarea id="screen-description-new" name="description" rows="2" maxlength="255"></textarea><button class="btn btn-primary" type="submit">Create screen</button></form></section>
<div class="screen-list">{{range .Data.Screens}}{{$card := .}}<article class="surface-card screen-card" data-screen-id="{{.Screen.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Screen.Tabs}}</span><div><h2>{{.Screen.Name}}</h2><p>{{.Screen.Description}}</p></div></div><span class="lozenge">ID {{.Screen.ID}}</span></header>
<div class="screen-summary"><form class="project-details-form" method="post" action="/settings/screens/{{.Screen.ID}}"><input type="hidden" name="action" value="update"><label for="screen-name-{{.Screen.ID}}">Name</label><input id="screen-name-{{.Screen.ID}}" name="name" value="{{.Screen.Name}}" maxlength="255" required><label for="screen-description-{{.Screen.ID}}">Description</label><textarea id="screen-description-{{.Screen.ID}}" name="description" rows="2" maxlength="255">{{.Screen.Description}}</textarea><button class="btn" type="submit">Save details</button></form>
<form class="project-details-form screen-tab-create" method="post" action="/settings/screens/{{.Screen.ID}}"><input type="hidden" name="action" value="add-tab"><h3>Add a tab</h3><label for="screen-tab-new-{{.Screen.ID}}">Tab name</label><input id="screen-tab-new-{{.Screen.ID}}" name="name" maxlength="255" required><button class="btn" type="submit">Add tab</button></form></div>
<div class="screen-tab-list">{{range $index, $tab := .Screen.Tabs}}<article class="screen-tab-card" data-tab-id="{{$tab.ID}}"><header><div><h3>{{$tab.Name}}</h3><p>{{len $tab.Fields}} fields</p></div><div class="screen-tab-actions">{{if gt $index 0}}<form method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="move-tab"><input type="hidden" name="tabId" value="{{$tab.ID}}"><input type="hidden" name="position" value="{{dec $index}}"><button class="btn btn-subtle" type="submit">Move tab earlier<span class="sr-only"> {{$tab.Name}}</span></button></form>{{end}}</div></header>
<div class="screen-field-ledger" role="table" aria-label="Fields on {{$tab.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Field</span><span role="columnheader">ID</span><span role="columnheader">Order</span><span role="columnheader">Action</span></div>{{range $tab.Fields}}<div class="screen-field-row" role="row"><span role="cell"><strong>{{.Name}}</strong></span><span role="cell"><small>{{.ID}}</small></span><form role="cell" method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="move-field"><input type="hidden" name="tabId" value="{{$tab.ID}}"><input type="hidden" name="fieldId" value="{{.ID}}"><input type="hidden" name="position" value="Earlier"><button class="btn btn-subtle" type="submit">Move up<span class="sr-only"> {{.Name}}</span></button></form><form role="cell" method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="remove-field"><input type="hidden" name="tabId" value="{{$tab.ID}}"><input type="hidden" name="fieldId" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.Name}}</span></button></form></div>{{else}}<div class="empty-state"><strong>No fields yet</strong><small>Add a field so this tab renders something.</small></div>{{end}}</div>
<div class="screen-tab-controls">{{if $card.Available}}<form method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="add-field"><input type="hidden" name="tabId" value="{{$tab.ID}}"><label for="screen-field-{{$card.Screen.ID}}-{{$tab.ID}}">Add a field</label><select id="screen-field-{{$card.Screen.ID}}-{{$tab.ID}}" name="fieldId">{{range $card.Available}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add field</button></form>{{end}}
<details class="screen-tab-edit"><summary>Rename or remove tab</summary><div><form class="project-details-form" method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="rename-tab"><input type="hidden" name="tabId" value="{{$tab.ID}}"><label for="screen-tab-name-{{$tab.ID}}">Tab name</label><input id="screen-tab-name-{{$tab.ID}}" name="name" value="{{$tab.Name}}" maxlength="255" required><button class="btn" type="submit">Rename tab</button></form><form method="post" action="/settings/screens/{{$card.Screen.ID}}"><input type="hidden" name="action" value="delete-tab"><input type="hidden" name="tabId" value="{{$tab.ID}}"><p>Removing a tab removes its fields from this screen.</p><button class="btn btn-danger" type="submit">Remove tab</button></form></div></details></div></article>{{end}}</div>
<details class="screen-delete"><summary class="quiet-action">Delete screen</summary><form method="post" action="/settings/screens/{{.Screen.ID}}"><input type="hidden" name="action" value="delete"><p>The default screen cannot be deleted.</p><button class="btn btn-danger" type="submit">Delete screen</button></form></details></article>{{else}}<section class="surface-card empty-state"><strong>No screens</strong><small>Create a screen to group work item fields.</small></section>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
