{{define "page_screen_schemes"}}
<!doctype html><html lang="en"><head><title>Screen schemes · ZZIRA</title>{{template "head" .}}</head>
<body class="page-screens"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Screen schemes</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Screen schemes</h1><p>Choose which screen each work item form uses, then map work types to a project.</p></div><a class="btn" href="/settings/screens">Edit screens</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}

<section class="surface-card screen-create" aria-labelledby="screen-scheme-create-heading"><div class="screen-mark" aria-hidden="true"><span></span></div><div><h2 id="screen-scheme-create-heading">Create a screen scheme</h2><p>A screen scheme points each form operation at a screen. The default screen is used when create, edit, or view is unmapped.</p></div><form class="project-details-form" method="post" action="/settings/screen-schemes"><input type="hidden" name="kind" value="screen-scheme"><label for="screen-scheme-name-new">Scheme name</label><input id="screen-scheme-name-new" name="name" maxlength="255" required><label for="screen-scheme-description-new">Description</label><textarea id="screen-scheme-description-new" name="description" rows="2" maxlength="255"></textarea><label for="screen-scheme-default-new">Default screen</label><select id="screen-scheme-default-new" name="defaultScreenId">{{range .Data.Screens}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create screen scheme</button></form></section>

<div class="screen-list">{{range .Data.ScreenSchemes}}{{$card := .}}<article class="surface-card screen-card screen-scheme-card" data-screen-scheme-id="{{.Scheme.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Screens}}</span><div><h2>{{.Scheme.Name}}</h2><p>{{.Scheme.Description}}</p></div></div><span class="lozenge">ID {{.Scheme.ID}}</span></header>
<div class="screen-field-ledger" role="table" aria-label="Form operations for {{.Scheme.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Operation</span><span role="columnheader">Screen</span><span role="columnheader">Change</span></div>{{range $operation := $.Data.Operations}}<div class="screen-field-row screen-operation-row" role="row" data-operation="{{$operation}}"><span role="cell"><strong>{{$operation}}</strong></span><span role="cell"><small>{{with index $card.Screens $operation}}{{.}}{{else}}Falls back to default{{end}}</small></span><form role="cell" method="post" action="/settings/screen-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="set-screen"><input type="hidden" name="operation" value="{{$operation}}"><label class="sr-only" for="screen-op-{{$card.Scheme.ID}}-{{$operation}}">Screen for {{$operation}}</label><select id="screen-op-{{$card.Scheme.ID}}-{{$operation}}" name="screenId">{{if ne $operation "default"}}<option value="">Use the default screen</option>{{end}}{{range $.Data.Screens}}<option value="{{.ID}}" {{if eq (index $card.Scheme.Screens $operation) .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn btn-subtle" type="submit">Save</button></form></div>{{end}}</div>
<details class="screen-delete"><summary class="quiet-action">Delete screen scheme</summary><form method="post" action="/settings/screen-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete-screen-scheme"><p>Remove it from every work type mapping first. The default screen scheme cannot be deleted.</p><button class="btn btn-danger" type="submit">Delete screen scheme</button></form></details></article>{{end}}</div>

<section class="surface-card screen-create" aria-labelledby="issue-type-scheme-create-heading"><div class="screen-mark" aria-hidden="true"><span></span></div><div><h2 id="issue-type-scheme-create-heading">Create a work type screen scheme</h2><p>This is what a project is assigned. Map work types to screen schemes, and everything else follows the default.</p></div><form class="project-details-form" method="post" action="/settings/screen-schemes"><input type="hidden" name="kind" value="issue-type-scheme"><label for="issue-type-scheme-name-new">Scheme name</label><input id="issue-type-scheme-name-new" name="name" maxlength="255" required><label for="issue-type-scheme-description-new">Description</label><textarea id="issue-type-scheme-description-new" name="description" rows="2" maxlength="255"></textarea><label for="issue-type-scheme-default-new">Default screen scheme</label><select id="issue-type-scheme-default-new" name="screenSchemeId">{{range .Data.ScreenSchemes}}<option value="{{.Scheme.ID}}">{{.Scheme.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create work type screen scheme</button></form></section>

<div class="screen-list">{{range .Data.IssueTypeSchemes}}{{$card := .}}<article class="surface-card screen-card issue-type-scheme-card" data-issue-type-scheme-id="{{.Scheme.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Mappings}}</span><div><h2>{{.Scheme.Name}}</h2><p>{{len .Projects}} assigned projects · {{.Scheme.Description}}</p></div></div><span class="lozenge">ID {{.Scheme.ID}}</span></header>
<div class="screen-field-ledger" role="table" aria-label="Work type mappings for {{.Scheme.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Work type</span><span role="columnheader">Screen scheme</span><span role="columnheader">Action</span></div>{{range .Mappings}}<div class="screen-field-row issue-type-mapping-row" role="row" data-issue-type-id="{{.IssueTypeID}}"><span role="cell"><strong>{{.IssueTypeName}}</strong></span><span role="cell"><small>{{.ScreenSchemeName}}</small></span>{{if .IsDefault}}<span role="cell"><small>Always applies</small></span>{{else}}<form role="cell" method="post" action="/settings/screen-schemes/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-issue-type"><input type="hidden" name="issueTypeId" value="{{.IssueTypeID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.IssueTypeName}} mapping</span></button></form>{{end}}</div>{{end}}</div>
<div class="screen-tab-controls"><form method="post" action="/settings/screen-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="map-issue-type"><label for="issue-type-map-{{.Scheme.ID}}">Map a work type</label><select id="issue-type-map-{{.Scheme.ID}}" name="issueTypeId">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><label class="sr-only" for="issue-type-map-scheme-{{.Scheme.ID}}">Screen scheme</label><select id="issue-type-map-scheme-{{.Scheme.ID}}" name="screenSchemeId">{{range $.Data.ScreenSchemes}}<option value="{{.Scheme.ID}}">{{.Scheme.Name}}</option>{{end}}</select><button class="btn" type="submit">Map work type</button></form>
{{if $.Data.Projects}}<form method="post" action="/settings/screen-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="assign-project"><label for="issue-type-project-{{.Scheme.ID}}">Assign a project</label><select id="issue-type-project-{{.Scheme.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign project</button></form>{{end}}</div>
<section><h3>Projects using this scheme</h3><ul class="permission-project-list">{{range .Projects}}<li><a href="/projects/{{.Key}}">{{.Name}}</a><span>{{.Key}}</span></li>{{else}}<li class="empty-state">No projects use this scheme.</li>{{end}}</ul></section>
<details class="screen-delete"><summary class="quiet-action">Delete work type screen scheme</summary><form method="post" action="/settings/screen-schemes/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete-issue-type-scheme"><p>Reassign every project first. The default work type screen scheme cannot be deleted.</p><button class="btn btn-danger" type="submit">Delete work type screen scheme</button></form></details></article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
