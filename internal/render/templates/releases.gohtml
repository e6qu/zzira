{{define "release_fields"}}
<label for="release-name">Version name</label><input id="release-name" name="name" value="{{.Name}}" maxlength="255" required>
<label for="release-description">Description</label><textarea id="release-description" name="description" rows="3" maxlength="16384">{{.Description}}</textarea>
<label for="release-start">Start date</label><input id="release-start" name="startDate" type="date" value="{{.StartDate}}">
<label for="release-date">Release date</label><input id="release-date" name="releaseDate" type="date" value="{{.ReleaseDate}}">
{{end}}
{{define "release_progress"}}
<div class="release-progress"><progress max="100" value="{{.Percent}}" aria-label="Release completion">{{.Percent}}%</progress><span>{{.Done}} of {{.Total}} done · {{.Percent}}%</span></div>
{{end}}
{{define "page_releases"}}
<!doctype html><html lang="en"><head><title>Releases · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Releases</span></nav>
<header class="page-header"><div><h1>Releases</h1><p>Plan a version, track its scope, and share what shipped.</p></div></header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<form method="get" class="release-filters"><div><label for="release-query">Find a version</label><input id="release-query" name="q" value="{{.Data.Query}}" type="search"></div><div><label for="release-status">Status</label><select id="release-status" name="status"><option value="">All versions</option><option value="unreleased" {{if eq .Data.Status "unreleased"}}selected{{end}}>Unreleased</option><option value="released" {{if eq .Data.Status "released"}}selected{{end}}>Released</option><option value="archived" {{if eq .Data.Status "archived"}}selected{{end}}>Archived</option></select></div><button class="btn" type="submit">Filter</button></form>
<div class="release-layout"><section class="surface-card release-list" aria-label="Project releases">
{{range .Data.Rows}}<article class="release-row"><div><a class="release-name" href="/projects/{{$.Data.Project.Key}}/releases/{{.Version.ID}}">{{.Version.Name}}</a><span class="lozenge {{if .Version.Released}}lozenge-success{{else}}lozenge-default{{end}}">{{.Version.State}}</span><p>{{.Version.Description}}</p><small>{{if .Version.StartDate}}Started {{.Version.StartDate}} · {{end}}{{if .Version.ReleaseDate}}Release {{.Version.ReleaseDate}}{{else}}No release date{{end}}{{if .Overdue}} · <strong>Overdue</strong>{{end}}</small>{{if .ShipsWith}}<small class="release-ships-with-note">Ships with {{range $index, $name := .ShipsWith}}{{if $index}}, {{end}}{{$name}}{{end}}</small>{{end}}</div>{{template "release_progress" .Progress}}{{if and $.Data.Admin $.Data.Reorderable}}<form class="release-order" method="post" action="/projects/{{$.Data.Project.Key}}/releases"><input type="hidden" name="action" value="move"><input type="hidden" name="version" value="{{.Version.ID}}">{{if not .First}}<button class="btn" type="submit" name="position" value="Earlier" aria-label="Move {{.Version.Name}} earlier">Move up</button>{{end}}{{if not .Last}}<button class="btn" type="submit" name="position" value="Later" aria-label="Move {{.Version.Name}} later">Move down</button>{{end}}</form>{{end}}</article>{{else}}<div class="empty-state"><strong>No versions found</strong><p>{{if $.Data.Admin}}Create a version to group the work your team plans to ship.{{else}}An administrator can create a version for this project.{{end}}</p></div>{{end}}
</section>{{if .Data.Admin}}<form class="surface-card project-details-form" method="post" action="/projects/{{.Data.Project.Key}}/releases"><h2>Create version</h2>{{template "release_fields" .Data.Version}}<button class="btn btn-primary" type="submit">Create version</button></form>{{end}}</div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
{{define "page_release"}}
<!doctype html><html lang="en"><head><title>{{.Data.Version.Name}} · Releases · {{(site $).Title}}</title>{{template "head" .}}</head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/releases">Releases</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Version.Name}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Version.State}}</span><h1>{{.Data.Version.Name}}</h1><p>{{.Data.Version.Description}}</p></div>{{if .Data.Admin}}<a class="btn" href="?edit=1">Edit version</a>{{end}}</header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.Editing}}{{if .Data.Admin}}<form class="surface-card project-details-form release-edit" method="post"><h2>Edit version</h2><input type="hidden" name="action" value="save">{{template "release_fields" .Data.Version}}<div class="project-form-actions"><button class="btn btn-primary" type="submit">Save changes</button><a href="/projects/{{.Data.Project.Key}}/releases/{{.Data.Version.ID}}">Cancel</a></div></form>{{end}}{{end}}
<div class="release-layout"><div class="release-main"><section class="surface-card"><h2>Release progress</h2>{{template "release_progress" .Data.Progress}}<dl class="release-counts"><div><dt>To do</dt><dd>{{.Data.Progress.ToDo}}</dd></div><div><dt>In progress</dt><dd>{{.Data.Progress.InProgress}}</dd></div><div><dt>Done</dt><dd>{{.Data.Progress.Done}}</dd></div></dl></section>
<section class="surface-card"><header class="release-section-heading"><h2>Work items</h2><a href="/issues/{{.Data.Project.Key}}?mode=advanced&amp;jql=fixVersion%20%3D%20{{.Data.Version.ID}}">Open in search</a></header>
<form method="post" class="release-add"><input type="hidden" name="action" value="add"><label for="release-issue">Add work item by key</label><input id="release-issue" name="issue" placeholder="{{.Data.Project.Key}}-1" required><button class="btn" type="submit">Add to release</button></form>
<ul class="release-issues">{{range .Data.Issues}}<li><div><a href="/browse/{{.Key}}">{{.Key}}</a> <span>{{.Summary}}</span></div><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span><form method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="issue" value="{{.Key}}"><button class="btn" type="submit" aria-label="Remove {{.Key}} from release">Remove</button></form></li>{{else}}<li>No work items yet. Add a work item key above to plan this release.</li>{{end}}</ul>
</section>
{{if not .Data.DeploymentsDisabled}}<section class="surface-card"><header class="release-section-heading"><h2>Builds and deployments</h2><span class="muted">{{len .Data.Delivery}} linked events</span></header><ul class="delivery-evidence-list" id="release-delivery-list">{{range .Data.Delivery}}<li><div><span class="link-relationship">{{if eq .Kind "deployment"}}Deployment{{else}}Build{{end}}</span> {{if .URL}}<a href="{{.URL}}" rel="noreferrer">{{.DisplayName}}</a>{{else}}{{.DisplayName}}{{end}} <span class="muted">{{if .EnvironmentName}}{{.EnvironmentName}} · {{end}}{{.PipelineID}}</span></div><span class="lozenge {{if eq .State "successful"}}lozenge-success{{else if eq .State "failed"}}lozenge-danger{{else}}lozenge-default{{end}}">{{.State}}</span></li>{{else}}<li>No builds or deployments are associated with work in this release.</li>{{end}}</ul></section>{{end}}
<section class="surface-card release-notes" aria-labelledby="release-notes-heading"><h2 id="release-notes-heading">Release notes</h2>{{if .Data.Issues}}<form method="get" action="/projects/{{.Data.Project.Key}}/releases/{{.Data.Version.ID}}#release-notes-heading" class="release-notes-options"><fieldset><legend>Work types</legend>{{range .Data.Notes.Types}}<label><input type="checkbox" name="notesType" value="{{.ID}}" {{if .Included}}checked{{end}}> {{.Name}}</label>{{end}}</fieldset><fieldset><legend>Format</legend>{{range .Data.Notes.Formats}}<label><input type="radio" name="notesFormat" value="{{.Value}}" {{if eq $.Data.Notes.Format .Value}}checked{{end}}> {{.Name}}</label>{{end}}</fieldset><button class="btn" type="submit">Build release notes</button></form>
{{if .Data.Notes.Text}}<label for="release-notes-text">Release notes to copy</label><textarea id="release-notes-text" class="release-notes-text" rows="12" readonly>{{.Data.Notes.Text}}</textarea>{{else}}{{range .Data.Notes.Groups}}<h3>{{.Name}}</h3><ul class="release-notes-list">{{range .Issues}}<li><a href="/browse/{{.Key}}">{{.Key}}</a> {{.Summary}}</li>{{end}}</ul>{{else}}<p>No work of the chosen types is in this version.</p>{{end}}{{end}}{{else}}<p>Add work items to build release notes.</p>{{end}}</section></div>
<aside class="release-side">{{if .Data.ShipsWith}}<section class="surface-card release-ships-with" aria-labelledby="ships-with-heading"><h2 id="ships-with-heading">Ships with</h2><p>This version is part of a cross-project release, so it goes out with the versions below.</p>{{range .Data.ShipsWith}}<h3><a href="/plans/{{.PlanID}}">{{.Release.Name}}</a> <small>in {{.PlanName}}</small></h3>{{if .Release.DatesDiffer}}<p class="release-dates-differ"><span class="lozenge lozenge-warning">Dates differ</span> The versions in this release are not all due on the same day.</p>{{end}}<ul class="release-ships-with-list">{{range .Release.Members}}<li><a href="/projects/{{.ProjectKey}}/releases/{{.Version.ID}}">{{.ProjectKey}} · {{.Version.Name}}</a><small>{{if .Version.ReleaseDate}}Due {{.Version.ReleaseDate}}{{else}}No release date{{end}} · {{.Progress.Done}} done, {{.Progress.InProgress}} in progress, {{.Progress.ToDo}} to do</small>{{if .Version.Released}}<span class="lozenge lozenge-success">Released</span>{{else}}<span class="lozenge lozenge-default">Unreleased</span>{{end}}</li>{{end}}</ul>{{if .Release.Missing}}<p class="release-missing">{{len .Release.Missing}} version(s) in this release no longer exist.</p>{{end}}{{end}}</section>{{end}}
<section class="surface-card"><h2>Dates</h2><dl><dt>Start date</dt><dd>{{if .Data.Version.StartDate}}{{.Data.Version.StartDate}}{{else}}Not set{{end}}</dd><dt>Release date</dt><dd>{{if .Data.Version.ReleaseDate}}{{.Data.Version.ReleaseDate}}{{else}}Not set{{end}}</dd></dl></section>
<section class="surface-card release-people"><h2>People</h2><dl><dt>Driver</dt><dd>{{with .Data.Driver}}{{.DisplayName}}{{else}}No driver{{end}}</dd></dl>
{{if .Data.Admin}}<form class="project-details-form" method="post"><input type="hidden" name="action" value="driver"><label for="release-driver">Driver</label><select id="release-driver" name="driver"><option value="">No driver</option>{{range .Data.Members}}<option value="{{.ID}}" {{if eq .ID $.Data.Version.DriverID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select><button class="btn" type="submit">Set driver</button></form>{{end}}
<h3>Approvers</h3><ul class="release-approvers">{{range .Data.Approvers}}<li><div><strong>{{.Name}}</strong>{{if .Description}}<p>{{.Description}}</p>{{end}}{{if .DeclineReason}}<p>Declined because {{.DeclineReason}}</p>{{end}}</div><span class="lozenge {{if eq .Status "APPROVED"}}lozenge-success{{else if eq .Status "DECLINED"}}lozenge-danger{{else}}lozenge-default{{end}}">{{if eq .Status "APPROVED"}}Approved{{else if eq .Status "DECLINED"}}Declined{{else}}Pending{{end}}</span>{{if $.Data.Admin}}<form method="post"><input type="hidden" name="action" value="remove-approver"><input type="hidden" name="approver" value="{{.AccountID}}"><button class="btn" type="submit" aria-label="Remove {{.Name}} as an approver">Remove</button></form>{{end}}</li>{{else}}<li>No approvers yet.</li>{{end}}</ul>
{{with .Data.MyApproval}}<form method="post"><input type="hidden" name="action" value="approve"><button class="btn btn-primary" type="submit">Approve release</button></form><form class="project-details-form" method="post"><input type="hidden" name="action" value="decline"><label for="decline-reason">Reason for declining</label><textarea id="decline-reason" name="declineReason" maxlength="1000" rows="2"></textarea><button class="btn" type="submit">Decline release</button></form>{{end}}
{{if .Data.Admin}}<form class="project-details-form" method="post"><input type="hidden" name="action" value="add-approver"><label for="release-approver">Add an approver</label><select id="release-approver" name="approver" required>{{range .Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><label for="approval-description">What they approve</label><input id="approval-description" name="approvalDescription" maxlength="1000"><button class="btn" type="submit">Add approver</button></form>{{end}}</section>
{{if .Data.Admin}}<section class="surface-card"><h2>Manage version</h2>{{if .Data.Version.Released}}<form method="post"><input type="hidden" name="action" value="unrelease"><button class="btn" type="submit">Mark unreleased</button></form>{{else}}<form class="project-details-form" method="post"><input type="hidden" name="action" value="release"><label for="ship-date">Release date</label><input id="ship-date" type="date" name="releaseDate" value="{{.Data.Version.ReleaseDate}}"><p>{{.Data.Unresolved}} of {{.Data.Progress.Total}} work items are unresolved.</p><label for="move-unfixed">Unresolved work</label><select id="move-unfixed" name="moveUnfixedIssuesTo"><option value="">Leave it in this version</option>{{range .Data.OtherVersions}}<option value="{{.ID}}">Move it to {{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Release version</button></form>{{end}}
<form method="post" class="release-secondary-action"><input type="hidden" name="action" value="{{if .Data.Version.Archived}}unarchive{{else}}archive{{end}}"><button class="btn" type="submit">{{if .Data.Version.Archived}}Unarchive version{{else}}Archive version{{end}}</button></form>
<details class="release-delete"><summary>Delete version</summary><p>This permanently deletes the version and removes it from work items. The work items remain.</p><form method="post"><input type="hidden" name="action" value="delete"><button class="btn btn-danger" type="submit">Delete version permanently</button></form></details></section>{{end}}</aside></div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
