{{define "page_project_timeline"}}
<!doctype html><html lang="en"><head><title>Timeline · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Timeline</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Timeline</h1><p>Schedule epics and their work across the months ahead.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if not .Data.Rows}}<section class="surface-card empty-state"><strong>No epics yet</strong><small>Create an epic in {{.Data.Project.Name}} to plan its work on the timeline.</small></section>
{{else}}
<section class="surface-card timeline-card" aria-labelledby="timeline-title"><h2 class="sr-only" id="timeline-title">Scheduled work</h2>
<div class="table-scroll timeline-scroll" tabindex="0" aria-label="Scrollable timeline"><table class="timeline-table">
<caption class="sr-only">Epics and their work with start and due dates</caption>
<thead><tr><th scope="col">Work</th><th scope="col">Start</th><th scope="col">Due</th><th scope="col" class="timeline-months-cell"><span class="sr-only">Schedule</span><svg class="timeline-scale" viewBox="0 0 {{.Data.Width}} 24" width="{{.Data.Width}}" height="24" aria-hidden="true">{{range .Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="24" class="timeline-gridline"/><text x="{{.X}}" dx="6" y="16" class="chart-label">{{.Label}}</text>{{end}}</svg></th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
<tbody>{{range .Data.Rows}}<tr class="{{if .Child}}timeline-child{{else}}timeline-epic{{end}}">
<th scope="row"><span class="timeline-work"><a href="/browse/{{.Item.Issue.Key}}">{{.Item.Issue.Key}}</a><span>{{.Item.Issue.Summary}}</span><span class="lozenge {{statusClass .Item.Issue.Status.Category}}">{{.Item.Issue.Status.Name}}</span></span></th>
<td>{{if .StartLabel}}{{.StartLabel}}{{else}}<span class="muted">None</span>{{end}}</td><td>{{if .DueLabel}}{{.DueLabel}}{{else}}<span class="muted">None</span>{{end}}</td>
<td class="timeline-bar-cell"><svg viewBox="0 0 {{$.Data.Width}} 28" width="{{$.Data.Width}}" height="28" aria-hidden="true">{{range $.Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="28" class="timeline-gridline"/>{{end}}{{if $.Data.ShowToday}}<line x1="{{$.Data.TodayX}}" y1="0" x2="{{$.Data.TodayX}}" y2="28" class="timeline-today"/>{{end}}{{with .Bar}}<rect x="{{.X}}" y="6" width="{{.Width}}" height="16" rx="4" class="timeline-bar{{if .Open}} timeline-bar-open{{end}}"/>{{end}}</svg>{{if .Unscheduled}}<span class="sr-only">Not scheduled</span>{{end}}</td>
<td><details class="timeline-schedule"><summary class="btn">Schedule<span class="sr-only"> {{.Item.Issue.Key}}</span></summary><form method="post" action="/projects/{{$.Data.Project.Key}}/timeline"><input type="hidden" name="issue" value="{{.Item.Issue.Key}}"><label for="start-{{.Item.Issue.Key}}">Start date</label><input id="start-{{.Item.Issue.Key}}" name="startDate" type="date" value="{{.Item.StartDate}}" {{if not $.Data.StartFieldID}}disabled{{end}}><label for="due-{{.Item.Issue.Key}}">Due date</label><input id="due-{{.Item.Issue.Key}}" name="dueDate" type="date" value="{{.Item.DueDate}}"><button class="btn btn-primary" type="submit">Save dates</button></form></details></td>
</tr>{{end}}</tbody></table></div>
<div class="chart-legend timeline-legend"><span><i class="legend-scheduled"></i>Scheduled</span><span><i class="legend-open"></i>Missing a start or due date</span>{{if .Data.ShowToday}}<span><i class="legend-today"></i>Today</span>{{end}}</div>
</section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_plans"}}
<!doctype html><html lang="en"><head><title>Plans · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Plans</h1><p>Plan work across projects, boards and filters, with the teams that deliver it.</p></div></header>
{{if .Data.Plans}}<section class="surface-card" aria-labelledby="plans-heading"><h2 class="sr-only" id="plans-heading">Your plans</h2><div class="table-scroll" tabindex="0" aria-label="Plans"><table><caption class="sr-only">Plans you can view</caption><thead><tr><th scope="col">Plan</th><th scope="col">Sources</th><th scope="col">Access</th></tr></thead><tbody>{{range .Data.Plans}}<tr><th scope="row"><a href="/plans/{{.Plan.ID}}">{{.Plan.Name}}</a></th><td>{{len .Plan.IssueSources}}</td><td>{{if .Edit}}Can edit{{else}}Can view{{end}}</td></tr>{{end}}</tbody></table></div></section>
{{else}}<section class="surface-card empty-state"><strong>No plans to show</strong><small>Plans that you lead, or that share view or edit access with you or your groups, appear here.</small></section>{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_plan"}}
<!doctype html><html lang="en"><head><title>{{.Data.Plan.Name}} · Plans · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/plans">Plans</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Plan.Name}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan · {{if .Data.Edit}}Can edit{{else}}Can view{{end}}</span><h1>{{.Data.Plan.Name}}</h1><p>Scheduled by {{if .Data.Work.StartFieldName}}{{.Data.Work.StartFieldName}}{{else}}no start field{{end}} and {{if .Data.Work.EndFieldName}}{{.Data.Work.EndFieldName}}{{else}}no end field{{end}}.</p></div></header>
{{with .Data.Timeline}}{{if not .Rows}}<section class="surface-card empty-state"><strong>No work in this plan</strong><small>The plan's boards, projects and filters give no work you can view, or its exclusion rules leave it all out.</small></section>
{{else}}<section class="surface-card timeline-card" aria-labelledby="plan-work-title"><h2 class="sr-only" id="plan-work-title">Planned work</h2>
<div class="table-scroll timeline-scroll" tabindex="0" aria-label="Scrollable plan timeline"><table class="timeline-table">
<caption class="sr-only">Planned work with start and end dates</caption>
<thead><tr><th scope="col">Work</th><th scope="col">Start</th><th scope="col">End</th><th scope="col" class="timeline-months-cell"><span class="sr-only">Schedule</span><svg class="timeline-scale" viewBox="0 0 {{.Width}} 24" width="{{.Width}}" height="24" aria-hidden="true">{{range .Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="24" class="timeline-gridline"/><text x="{{.X}}" dx="6" y="16" class="chart-label">{{.Label}}</text>{{end}}</svg></th></tr></thead>
<tbody>{{range .Rows}}<tr class="{{if .Child}}timeline-child{{else}}timeline-epic{{end}}">
<th scope="row"><span class="timeline-work"><a href="/browse/{{.Item.Issue.Key}}">{{.Item.Issue.Key}}</a><span>{{.Item.Issue.Summary}}</span><span class="lozenge {{statusClass .Item.Issue.Status.Category}}">{{.Item.Issue.Status.Name}}</span></span></th>
<td>{{if .StartLabel}}{{.StartLabel}}{{else}}<span class="muted">None</span>{{end}}</td><td>{{if .DueLabel}}{{.DueLabel}}{{else}}<span class="muted">None</span>{{end}}</td>
<td class="timeline-bar-cell"><svg viewBox="0 0 {{$.Data.Timeline.Width}} 28" width="{{$.Data.Timeline.Width}}" height="28" aria-hidden="true">{{range $.Data.Timeline.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="28" class="timeline-gridline"/>{{end}}{{if $.Data.Timeline.ShowToday}}<line x1="{{$.Data.Timeline.TodayX}}" y1="0" x2="{{$.Data.Timeline.TodayX}}" y2="28" class="timeline-today"/>{{end}}{{with .Bar}}<rect x="{{.X}}" y="6" width="{{.Width}}" height="16" rx="4" class="timeline-bar{{if .Open}} timeline-bar-open{{end}}"/>{{end}}</svg>{{if .Unscheduled}}<span class="sr-only">Not scheduled</span>{{end}}</td>
</tr>{{end}}</tbody></table></div></section>{{end}}{{end}}
<section class="surface-card sprint-report-work" aria-labelledby="plan-teams-title"><h2 id="plan-teams-title">Teams</h2>{{if .Data.Work.Teams}}<div class="table-scroll" tabindex="0" aria-label="Plan teams"><table><caption class="sr-only">Plan teams</caption><thead><tr><th scope="col">Team</th><th scope="col">Planning style</th><th scope="col">Sprint length</th><th scope="col">Capacity</th><th scope="col">Members</th></tr></thead><tbody>{{range .Data.Work.Teams}}<tr><th scope="row">{{if .Name}}{{.Name}}{{else}}Atlassian team {{.AtlassianTeamID}}{{end}}</th><td>{{.PlanningStyle}}</td><td>{{with .SprintLength}}{{.}} weeks{{else}}-{{end}}</td><td>{{with .Capacity}}{{.}}{{else}}-{{end}}</td><td>{{len .MemberIDs}}</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No teams are assigned to this plan.</p>{{end}}</section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
