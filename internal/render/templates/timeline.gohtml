{{define "page_project_timeline"}}
<!doctype html><html lang="en"><head><title>Timeline · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Timeline</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Timeline</h1><p>Schedule epics and their work across the months ahead.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if not .Data.Rows}}<section class="surface-card empty-state"><strong>No epics yet</strong><small>Create an epic in {{.Data.Project.Name}} to plan its work on the timeline.</small></section>
{{else}}
<section class="surface-card timeline-card" aria-labelledby="timeline-title"><h2 class="sr-only" id="timeline-title">Scheduled work</h2>
<div class="table-scroll timeline-scroll" tabindex="0" aria-label="Scrollable timeline"><table class="timeline-table">
<caption class="sr-only">Epics and their work with start and due dates</caption>
<thead><tr><th scope="col">Work</th><th scope="col">Start</th><th scope="col">Due</th><th scope="col" class="timeline-months-cell"><span class="sr-only">Schedule</span><svg class="timeline-scale" viewBox="0 0 {{.Data.Width}} 24" width="{{.Data.Width}}" height="24" aria-hidden="true">{{range .Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="24" class="timeline-gridline"/><text x="{{.X}}" dx="6" y="16" class="chart-label">{{.Label}}</text>{{end}}</svg></th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
<tbody>{{range .Data.Rows}}<tr class="{{if .Child}}timeline-child{{else}}timeline-epic{{end}}">
<th scope="row"><span class="timeline-work"><a href="/browse/{{.Item.Issue.Key}}">{{.Item.Issue.Key}}</a><span>{{.Item.Issue.Summary}}</span><span class="lozenge {{statusClass .Item.Issue.Status.Category}}">{{.Item.Issue.Status.Name}}</span></span></th>
<td>{{if .StartLabel}}{{.StartLabel}}{{else}}<span class="muted">None</span>{{end}}</td><td>{{if .DueLabel}}{{.DueLabel}}{{else}}<span class="muted">None</span>{{end}}</td>
<td class="timeline-bar-cell"><svg viewBox="0 0 {{$.Data.Width}} 28" width="{{$.Data.Width}}" height="28" aria-hidden="true">{{range $.Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="28" class="timeline-gridline"/>{{end}}{{if $.Data.ShowToday}}<line x1="{{$.Data.TodayX}}" y1="0" x2="{{$.Data.TodayX}}" y2="28" class="timeline-today"/>{{end}}{{with .Bar}}<rect x="{{.X}}" y="6" width="{{.Width}}" height="16" rx="4" class="timeline-bar{{if .Open}} timeline-bar-open{{end}}"/>{{end}}</svg>{{if .Unscheduled}}<span class="sr-only">Not scheduled</span>{{end}}</td>
<td><details class="timeline-schedule"><summary class="btn">Schedule<span class="sr-only"> {{.Item.Issue.Key}}</span></summary><form method="post" action="/projects/{{$.Data.Project.Key}}/timeline"><input type="hidden" name="issue" value="{{.Item.Issue.Key}}"><label for="start-{{.Item.Issue.Key}}">Start date</label><input id="start-{{.Item.Issue.Key}}" name="startDate" type="date" value="{{.Item.StartDate}}" {{if not $.Data.StartFieldID}}disabled{{end}}><label for="due-{{.Item.Issue.Key}}">Due date</label><input id="due-{{.Item.Issue.Key}}" name="dueDate" type="date" value="{{.Item.DueDate}}"><button class="btn btn-primary" type="submit">Save dates</button></form></details></td>
</tr>{{end}}</tbody></table></div>
<div class="chart-legend timeline-legend"><span><i class="legend-scheduled"></i>Scheduled</span><span><i class="legend-open"></i>Missing a start or due date</span>{{if .Data.ShowToday}}<span><i class="legend-today"></i>Today</span>{{end}}</div>
</section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
