{{define "page_project_timeline"}}
<!doctype html><html lang="en"><head><title>Timeline · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Timeline</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Timeline</h1><p>Schedule epics and their work across the months ahead.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if not .Data.Rows}}<section class="surface-card empty-state"><strong>No epics yet</strong><small>Create an epic in {{.Data.Project.Name}} to plan its work on the timeline.</small></section>
{{else}}
<section class="surface-card timeline-card" aria-labelledby="timeline-title"><h2 class="sr-only" id="timeline-title">Scheduled work</h2>
<div class="table-scroll timeline-scroll" tabindex="0" aria-label="Scrollable timeline"><table class="timeline-table">
<caption class="sr-only">Epics and their work with start and due dates</caption>
<thead><tr><th scope="col">Work</th><th scope="col">Start</th><th scope="col">Due</th><th scope="col" class="timeline-months-cell"><span class="sr-only">Schedule</span><svg class="timeline-scale" viewBox="0 0 {{.Data.Width}} 24" width="{{.Data.Width}}" height="24" aria-hidden="true">{{range .Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="24" class="timeline-gridline"/><text x="{{.X}}" dx="6" y="16" class="chart-label">{{.Label}}</text>{{end}}</svg></th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
<tbody>{{range .Data.Rows}}<tr class="{{if .Child}}timeline-child{{else}}timeline-epic{{end}}">
<th scope="row"><span class="timeline-work"><a href="/browse/{{.Item.Issue.Key}}">{{.Item.Issue.Key}}</a><span>{{.Item.Issue.Summary}}</span><span class="lozenge {{statusClass .Item.Issue.Status.Category}}">{{.Item.Issue.Status.Name}}</span></span></th>
<td>{{if .StartLabel}}{{.StartLabel}}{{else}}<span class="muted">None</span>{{end}}</td><td>{{if .DueLabel}}{{.DueLabel}}{{else}}<span class="muted">None</span>{{end}}</td>
<td class="timeline-bar-cell"><svg viewBox="0 0 {{$.Data.Width}} 28" width="{{$.Data.Width}}" height="28" aria-hidden="true">{{range $.Data.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="28" class="timeline-gridline"/>{{end}}{{if $.Data.ShowToday}}<line x1="{{$.Data.TodayX}}" y1="0" x2="{{$.Data.TodayX}}" y2="28" class="timeline-today"/>{{end}}{{with .Bar}}<rect x="{{.X}}" y="6" width="{{.Width}}" height="16" rx="4" class="timeline-bar{{if .Open}} timeline-bar-open{{end}}"/>{{end}}</svg>{{if .Unscheduled}}<span class="sr-only">Not scheduled</span>{{end}}</td>
<td><details class="timeline-schedule"><summary class="btn">Schedule<span class="sr-only"> {{.Item.Issue.Key}}</span></summary><form method="post" action="/projects/{{$.Data.Project.Key}}/timeline"><input type="hidden" name="issue" value="{{.Item.Issue.Key}}"><label for="start-{{.Item.Issue.Key}}">Start date</label><input id="start-{{.Item.Issue.Key}}" name="startDate" type="date" value="{{.Item.StartDate}}" {{if not $.Data.StartFieldID}}disabled{{end}}><label for="due-{{.Item.Issue.Key}}">Due date</label><input id="due-{{.Item.Issue.Key}}" name="dueDate" type="date" value="{{.Item.DueDate}}"><button class="btn btn-primary" type="submit">Save dates</button></form></details></td>
</tr>{{end}}</tbody></table></div>
<div class="chart-legend timeline-legend"><span><i class="legend-scheduled"></i>Scheduled</span><span><i class="legend-open"></i>Missing a start or due date</span>{{if .Data.ShowToday}}<span><i class="legend-today"></i>Today</span>{{end}}</div>
</section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_plans"}}
<!doctype html><html lang="en"><head><title>Plans · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Plans</h1><p>Plan work across projects, boards and filters, with the teams that deliver it.</p></div></header>
{{if .Data.Plans}}<section class="surface-card" aria-labelledby="plans-heading"><h2 class="sr-only" id="plans-heading">Your plans</h2><div class="table-scroll" tabindex="0" aria-label="Plans"><table><caption class="sr-only">Plans you can view</caption><thead><tr><th scope="col">Plan</th><th scope="col">Sources</th><th scope="col">Access</th></tr></thead><tbody>{{range .Data.Plans}}<tr><th scope="row"><a href="/plans/{{.Plan.ID}}">{{.Plan.Name}}</a></th><td>{{len .Plan.IssueSources}}</td><td>{{if .Edit}}Can edit{{else}}Can view{{end}}</td></tr>{{end}}</tbody></table></div></section>
{{else}}<section class="surface-card empty-state"><strong>No plans to show</strong><small>Plans that you lead, or that share view or edit access with you or your groups, appear here.</small></section>{{end}}
{{if .Data.CanCreate}}<section class="surface-card plan-create" aria-labelledby="plan-create-heading"><h2 id="plan-create-heading">Create a plan</h2>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<p>A plan reads the work of the boards, projects and filters you give it. You lead the plan you create, and choose who else may see or change it.</p>
<form class="project-details-form" method="post" action="/plans">
<label for="plan-name">Plan name</label><input id="plan-name" name="name" maxlength="255" required placeholder="For example: Autumn delivery">
<fieldset><legend>What the plan reads</legend>{{range .Data.Sources}}<label><input type="checkbox" name="source" value="{{.Value}}"> {{.Group}}: {{.Label}}</label>{{end}}</fieldset>
<label for="plan-estimation">Estimate work in</label><select id="plan-estimation" name="estimation">{{range .Data.Estimations}}<option value="{{.}}">{{.}}</option>{{end}}</select>
<button class="btn btn-primary" type="submit">Create plan</button></form></section>{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_plan_settings"}}
<!doctype html><html lang="en"><head><title>Settings · {{.Data.Plan.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/plans">Plans</a><span aria-hidden="true">/</span><a href="/plans/{{.Data.Plan.ID}}">{{.Data.Plan.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Settings</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan</span><h1>Plan settings</h1><p>What {{.Data.Plan.Name}} reads, what it leaves out, and who may see it.</p></div><a class="btn" href="/plans/{{.Data.Plan.ID}}">Back to the plan</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card" aria-labelledby="plan-details-heading"><h2 id="plan-details-heading">Details</h2>
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="details">
<label for="plan-settings-name">Name</label><input id="plan-settings-name" name="name" value="{{.Data.Plan.Name}}" maxlength="255" required>
<label for="plan-settings-lead">Plan lead</label><select id="plan-settings-lead" name="lead">{{range .Data.Members}}<option value="{{.ID}}" {{if eq .ID $.Data.Plan.LeadAccountID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select>
<button class="btn btn-primary" type="submit">Save details</button></form></section>
<section class="surface-card" aria-labelledby="plan-scheduling-heading"><h2 id="plan-scheduling-heading">Scheduling</h2>
<p>What the plan counts estimates in, and where it reads each work item's dates.</p>
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="scheduling">
<label for="plan-settings-estimation">Estimate work in</label><select id="plan-settings-estimation" name="estimation">{{range .Data.Estimations}}<option value="{{.}}" {{if eq . $.Data.Plan.Scheduling.Estimation}}selected{{end}}>{{.}}</option>{{end}}</select>
<label for="plan-settings-start">Start date field</label><select id="plan-settings-start" name="startField">{{range .Data.DateFields}}<option value="{{.Value}}" {{if eq .Value $.Data.Plan.Scheduling.StartDate.Type}}selected{{end}}>{{.Label}}</option>{{end}}</select>
<label for="plan-settings-end">End date field</label><select id="plan-settings-end" name="endField">{{range .Data.DateFields}}<option value="{{.Value}}" {{if eq .Value $.Data.Plan.Scheduling.EndDate.Type}}selected{{end}}>{{.Label}}</option>{{end}}</select>
<button class="btn btn-primary" type="submit">Save scheduling</button></form></section>
<section class="surface-card" aria-labelledby="plan-sources-heading"><h2 id="plan-sources-heading">Issue sources</h2>
<p>The plan reads the work of everything ticked here.</p>
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="sources">
<fieldset><legend>Boards, projects and filters</legend>{{range .Data.Sources}}<label><input type="checkbox" name="source" value="{{.Value}}" {{if .Chosen}}checked{{end}}> {{.Group}}: {{.Label}}</label>{{end}}</fieldset>
<button class="btn btn-primary" type="submit">Save issue sources</button></form></section>
<section class="surface-card" aria-labelledby="plan-exclusions-heading"><h2 id="plan-exclusions-heading">Exclusion rules</h2>
<p>Work the plan leaves out, however its sources answer.</p>
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="exclusions">
<label for="plan-completed-days">Show completed work for</label><input id="plan-completed-days" name="completedDays" type="number" min="0" max="3650" value="{{.Data.Plan.ExclusionRules.NumberOfDaysToShowCompletedIssues}}" required><small>Days after it was completed. 0 leaves completed work out.</small>
<fieldset><legend>Work types to leave out</legend>{{$excluded := .Data.Excluded}}{{range .Data.IssueTypes}}<label><input type="checkbox" name="issueType" value="{{.JiraID}}" {{if index $excluded .JiraID}}checked{{end}}> {{.Name}}</label>{{end}}</fieldset>
<fieldset><legend>Statuses to leave out</legend>{{range .Data.Statuses}}<label><input type="checkbox" name="status" value="{{.JiraID}}" {{if index $excluded .JiraID}}checked{{end}}> {{.Name}}</label>{{end}}</fieldset>
<button class="btn btn-primary" type="submit">Save exclusion rules</button></form></section>
<section class="surface-card" aria-labelledby="plan-releases-heading"><h2 id="plan-releases-heading">Cross-project releases</h2>
<p>Group the versions that ship together across the projects this plan reads.</p>
{{range .Data.Releases}}<details class="plan-release-editor"><summary>{{.Name}} · {{len .Members}} release{{if ne (len .Members) 1}}s{{end}}{{if .DatesDiffer}} · dates differ{{end}}</summary>
<form class="project-details-form" method="post" action="/plans/{{$.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="release"><input type="hidden" name="index" value="{{.Index}}">
<label for="plan-release-name-{{.Index}}">Name</label><input id="plan-release-name-{{.Index}}" name="name" value="{{.Name}}" maxlength="255" required>
<fieldset><legend>Releases in {{.Name}}</legend>{{range .Versions}}<label><input type="checkbox" name="version" value="{{.ID}}" {{if .Chosen}}checked{{end}}> {{.Label}}{{if .Released}} · released{{end}}</label>{{else}}<p class="empty-state">The plan's projects have no releases yet.</p>{{end}}</fieldset>
<button class="btn btn-primary" type="submit">Save cross-project release</button></form>
<form method="post" action="/plans/{{$.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="delete-release"><input type="hidden" name="index" value="{{.Index}}"><button class="btn btn-danger" type="submit">Remove {{.Name}}</button></form></details>{{else}}<p class="empty-state">No cross-project releases yet.</p>{{end}}
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="release"><input type="hidden" name="index" value="-1"><h3>Create a cross-project release</h3>
<label for="plan-release-name-new">Name</label><input id="plan-release-name-new" name="name" maxlength="255" required placeholder="For example: Autumn release">
<fieldset><legend>Releases to group</legend>{{range .Data.Versions}}<label><input type="checkbox" name="version" value="{{.ID}}"> {{.Label}}{{if .Released}} · released{{end}}</label>{{else}}<p class="empty-state">Give the plan a project or board source to choose its releases.</p>{{end}}</fieldset>
<button class="btn btn-primary" type="submit">Create cross-project release</button></form></section>
<section class="surface-card" aria-labelledby="plan-access-heading"><h2 id="plan-access-heading">Access</h2>
<p>{{.Data.Lead}} leads this plan, and site administrators can always change it.</p>
<table class="report-table"><caption class="sr-only">Who else may see or change this plan</caption><thead><tr><th scope="col">Who</th><th scope="col">Holder</th><th scope="col">Access</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
<tbody>{{range .Data.Permissions}}<tr><th scope="row">{{.Name}}</th><td>{{if eq .Holder "Group"}}Group{{else}}Person{{end}}</td><td>{{.Type}}</td><td><form method="post" action="/plans/{{$.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="revoke"><input type="hidden" name="index" value="{{.Index}}"><button class="btn" type="submit">Remove<span class="sr-only"> {{.Type}} access for {{.Name}}</span></button></form></td></tr>{{else}}<tr><td colspan="4">Only the lead and site administrators can see this plan.</td></tr>{{end}}</tbody></table>
<form class="project-details-form" method="post" action="/plans/{{.Data.Plan.ID}}/settings"><input type="hidden" name="action" value="grant"><h3>Give access</h3>
<label for="plan-holder-type">Person or group</label><select id="plan-holder-type" name="holderType"><option value="AccountId">Person</option><option value="Group">Group</option></select>
<label for="plan-holder-person">Person</label><select id="plan-holder-person" name="holder">{{range .Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{range .Data.Groups}}<option value="{{.ID}}">Group: {{.Name}}</option>{{end}}</select>
<label for="plan-access">Access</label><select id="plan-access" name="access"><option value="View">Can view</option><option value="Edit">Can edit</option></select>
<button class="btn btn-primary" type="submit">Give access</button></form></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_plan"}}
<!doctype html><html lang="en"><head><title>{{.Data.Plan.Name}} · Plans · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/plans">Plans</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Plan.Name}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Plan · {{if .Data.Edit}}Can edit{{else}}Can view{{end}}</span><h1>{{.Data.Plan.Name}}</h1><p>Scheduled by {{if .Data.Work.StartFieldName}}{{.Data.Work.StartFieldName}}{{else}}no start field{{end}} and {{if .Data.Work.EndFieldName}}{{.Data.Work.EndFieldName}}{{else}}no end field{{end}}, estimated in {{.Data.Planning.Unit}}.</p></div>{{if .Data.Edit}}<a class="btn" href="/plans/{{.Data.Plan.ID}}/settings">Plan settings</a><a class="btn btn-primary" href="/plans/{{.Data.Plan.ID}}/review?scenario={{.Data.Scenario.ID}}">Review changes ({{.Data.Planning.Changes}})</a>{{end}}</header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card plan-scenarios" aria-labelledby="plan-scenario-title"><h2 id="plan-scenario-title">Scenario</h2>
<form method="get" class="plan-inline-form"><label for="plan-scenario">Scenario</label><select id="plan-scenario" name="scenario">{{range .Data.Scenarios}}<option value="{{.ID}}" {{if eq .ID $.Data.Scenario.ID}}selected{{end}}>{{.Name}}{{if .Default}} (default){{end}}, {{.Changes}} unsaved</option>{{end}}</select><button class="btn" type="submit">Show scenario</button></form>
<p class="plan-scenario-note"><span class="plan-flag plan-flag-{{.Data.Scenario.Color}}" aria-hidden="true"></span>Changes made in {{.Data.Scenario.Name}} are flagged in its color and stay in the plan until they are saved to Jira.</p>
{{if .Data.Edit}}<details class="plan-manage"><summary class="btn">Manage scenarios</summary><div class="plan-manage-forms">
<form method="post" action="/plans/{{.Data.Plan.ID}}/scenarios" class="project-details-form"><h3>Create scenario</h3><input type="hidden" name="action" value="create"><input type="hidden" name="scenario" value="{{.Data.Scenario.ID}}"><label for="new-scenario-name">Scenario name</label><input id="new-scenario-name" name="name" maxlength="255" required><label for="new-scenario-color">Scenario color</label><select id="new-scenario-color" name="color">{{range .Data.Colors}}<option value="{{.}}">{{.}}</option>{{end}}</select><label for="new-scenario-from">Start from</label><select id="new-scenario-from" name="copyFrom"><option value="0">Blank, from the values in Jira</option>{{range .Data.Scenarios}}<option value="{{.ID}}">A copy of {{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create scenario</button></form>
<form method="post" action="/plans/{{.Data.Plan.ID}}/scenarios" class="project-details-form"><h3>Edit {{.Data.Scenario.Name}}</h3><input type="hidden" name="action" value="update"><input type="hidden" name="scenario" value="{{.Data.Scenario.ID}}"><label for="edit-scenario-name">Scenario name</label><input id="edit-scenario-name" name="name" value="{{.Data.Scenario.Name}}" maxlength="255" required><label for="edit-scenario-color">Scenario color</label><select id="edit-scenario-color" name="color">{{range .Data.Colors}}<option value="{{.}}" {{if eq . $.Data.Scenario.Color}}selected{{end}}>{{.}}</option>{{end}}</select><button class="btn" type="submit">Save scenario</button></form>
{{if not .Data.Scenario.Default}}<form method="post" action="/plans/{{.Data.Plan.ID}}/scenarios"><input type="hidden" name="action" value="delete"><input type="hidden" name="scenario" value="{{.Data.Scenario.ID}}"><button class="btn btn-danger" type="submit">Delete {{.Data.Scenario.Name}}</button></form>{{end}}
</div></details>{{end}}
</section>
{{with .Data.Timeline}}{{if not .Rows}}<section class="surface-card empty-state"><strong>No work in this plan</strong><small>The plan's boards, projects and filters give no work you can view, or its exclusion rules leave it all out.</small></section>
{{else}}<section class="surface-card timeline-card" aria-labelledby="plan-work-title"><h2 class="sr-only" id="plan-work-title">Planned work</h2>
<div class="table-scroll timeline-scroll" tabindex="0" aria-label="Scrollable plan timeline"><table class="timeline-table plan-table">
<caption class="sr-only">Planned work with dates, teams, sprints and estimates</caption>
<thead><tr><th scope="col">Work</th><th scope="col">Start</th><th scope="col">End</th><th scope="col">Team</th><th scope="col">Sprint</th><th scope="col">Estimate</th><th scope="col">Dependencies</th><th scope="col" class="timeline-months-cell"><span class="sr-only">Schedule</span><svg class="timeline-scale" viewBox="0 0 {{.Width}} 24" width="{{.Width}}" height="24" aria-hidden="true">{{range .Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="24" class="timeline-gridline"/><text x="{{.X}}" dx="6" y="16" class="chart-label">{{.Label}}</text>{{end}}</svg></th>{{if $.Data.Edit}}<th scope="col"><span class="sr-only">Actions</span></th>{{end}}</tr></thead>
<tbody>{{range .Rows}}{{$item := index $.Data.Planning.Items .Item.Issue.ID}}<tr class="{{if .Child}}timeline-child{{else}}timeline-epic{{end}}">
<th scope="row"><span class="timeline-work"><a href="/browse/{{.Item.Issue.Key}}">{{.Item.Issue.Key}}</a><span>{{.Item.Issue.Summary}}</span>{{if index $item.Changed "summary"}}{{template "plan_changed" $.Data.Scenario}}{{end}}<span class="lozenge {{statusClass .Item.Issue.Status.Category}}">{{.Item.Issue.Status.Name}}</span></span></th>
<td>{{if .StartLabel}}{{.StartLabel}}{{else}}<span class="muted">None</span>{{end}}{{if index $item.Changed "startDate"}}{{template "plan_changed" $.Data.Scenario}}{{end}}</td><td>{{if .DueLabel}}{{.DueLabel}}{{else}}<span class="muted">None</span>{{end}}{{if index $item.Changed "endDate"}}{{template "plan_changed" $.Data.Scenario}}{{end}}</td>
<td>{{if $item.TeamName}}{{$item.TeamName}}{{else}}<span class="muted">None</span>{{end}}{{if index $item.Changed "team"}}{{template "plan_changed" $.Data.Scenario}}{{end}}</td>
<td>{{if $item.SprintName}}{{$item.SprintName}}{{else}}<span class="muted">None</span>{{end}}{{if index $item.Changed "sprint"}}{{template "plan_changed" $.Data.Scenario}}{{end}}</td>
<td>{{with $item.Estimate}}{{planNumber .}}{{else}}<span class="muted">None</span>{{end}}{{if index $item.Changed "estimate"}}{{template "plan_changed" $.Data.Scenario}}{{end}}</td>
<td>{{range index $.Data.Blocking .Item.Issue.ID}}<span class="lozenge {{if .OffTrack}}lozenge-danger{{else}}lozenge-default{{end}}">Blocks {{.Blocked.Issue.Key}}</span> {{end}}{{range index $.Data.BlockedBy .Item.Issue.ID}}<span class="lozenge {{if .OffTrack}}lozenge-danger{{else}}lozenge-default{{end}}">Blocked by {{.Blocker.Issue.Key}}</span> {{end}}</td>
<td class="timeline-bar-cell"><svg viewBox="0 0 {{$.Data.Timeline.Width}} 28" width="{{$.Data.Timeline.Width}}" height="28" aria-hidden="true">{{range $.Data.Timeline.Months}}<line x1="{{.X}}" y1="0" x2="{{.X}}" y2="28" class="timeline-gridline"/>{{end}}{{if $.Data.Timeline.ShowToday}}<line x1="{{$.Data.Timeline.TodayX}}" y1="0" x2="{{$.Data.Timeline.TodayX}}" y2="28" class="timeline-today"/>{{end}}{{with .Bar}}<rect x="{{.X}}" y="6" width="{{.Width}}" height="16" rx="4" class="timeline-bar{{if .Open}} timeline-bar-open{{end}}"/>{{end}}</svg>{{if .Unscheduled}}<span class="sr-only">Not scheduled</span>{{end}}</td>
{{if $.Data.Edit}}<td><details class="timeline-schedule"><summary class="btn">Edit<span class="sr-only"> {{.Item.Issue.Key}} in the plan</span></summary><form method="post" action="/plans/{{$.Data.Plan.ID}}/work"><input type="hidden" name="scenario" value="{{$.Data.Scenario.ID}}"><input type="hidden" name="issue" value="{{.Item.Issue.ID}}"><label for="plan-summary-{{.Item.Issue.Key}}">Summary</label><input id="plan-summary-{{.Item.Issue.Key}}" name="summary" value="{{.Item.Issue.Summary}}" maxlength="255" required><label for="plan-start-{{.Item.Issue.Key}}">Start date</label><input id="plan-start-{{.Item.Issue.Key}}" name="startDate" type="date" value="{{.Item.StartDate}}"><label for="plan-end-{{.Item.Issue.Key}}">End date</label><input id="plan-end-{{.Item.Issue.Key}}" name="endDate" type="date" value="{{.Item.DueDate}}"><label for="plan-team-{{.Item.Issue.Key}}">Team</label><select id="plan-team-{{.Item.Issue.Key}}" name="team"><option value="">None</option>{{range $.Data.Teams}}<option value="{{.ID}}" {{if eq .ID $item.TeamID}}selected{{end}}>{{.Name}}</option>{{end}}</select><label for="plan-sprint-{{.Item.Issue.Key}}">Sprint</label><select id="plan-sprint-{{.Item.Issue.Key}}" name="sprint"><option value="">None</option>{{range $.Data.Planning.Sprints}}<option value="{{.ID}}" {{if eq .ID $item.SprintID}}selected{{end}}>{{.Name}}</option>{{end}}</select><label for="plan-estimate-{{.Item.Issue.Key}}">Estimate ({{$.Data.Planning.Unit}})</label><input id="plan-estimate-{{.Item.Issue.Key}}" name="estimate" type="number" min="0" step="any" value="{{with $item.Estimate}}{{planNumber .}}{{end}}"><button class="btn btn-primary" type="submit">Save in scenario</button></form></details></td>{{end}}
</tr>{{end}}</tbody></table></div>
<div class="chart-legend timeline-legend"><span><i class="legend-scheduled"></i>Scheduled</span><span><i class="legend-open"></i>Missing a start or end date</span>{{if .ShowToday}}<span><i class="legend-today"></i>Today</span>{{end}}<span><i class="plan-flag plan-flag-{{$.Data.Scenario.Color}}"></i>Changed in {{$.Data.Scenario.Name}}</span></div></section>{{end}}{{end}}
<section class="surface-card sprint-report-work" aria-labelledby="plan-dependencies-title"><h2 id="plan-dependencies-title">Dependencies</h2>{{if .Data.Planning.Dependencies}}<div class="table-scroll" tabindex="0" aria-label="Plan dependencies"><table><caption class="sr-only">Blocking work in the plan</caption><thead><tr><th scope="col">Blocking work</th><th scope="col">Blocked work</th><th scope="col">Status</th></tr></thead><tbody>{{range .Data.Planning.Dependencies}}<tr><th scope="row"><a href="/browse/{{.Blocker.Issue.Key}}">{{.Blocker.Issue.Key}}</a> {{.Blocker.Issue.Summary}}</th><td><a href="/browse/{{.Blocked.Issue.Key}}">{{.Blocked.Issue.Key}}</a> {{.Blocked.Issue.Summary}}</td><td>{{if .OffTrack}}<span class="lozenge lozenge-danger">Off track</span> {{.Reason}}{{else}}<span class="lozenge lozenge-success">On track</span>{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No work in this plan blocks other work in it.</p>{{end}}
{{if .Data.Edit}}<form method="post" action="/plans/{{.Data.Plan.ID}}/scheduling" class="plan-inline-form"><input type="hidden" name="scenario" value="{{.Data.Scenario.ID}}"><label class="report-toggle"><input type="checkbox" name="concurrent" value="true" {{if eq .Data.Plan.Scheduling.Dependencies "Concurrent"}}checked{{end}}> Dependent work items can be scheduled to the same iteration</label><button class="btn" type="submit">Save setting</button></form>{{end}}</section>
<section class="surface-card sprint-report-work" aria-labelledby="plan-capacity-title"><h2 id="plan-capacity-title">Capacity</h2>{{if not .Data.Planning.Capacity}}<p class="muted">Add teams to the plan to plan their capacity.</p>{{end}}{{range $team := .Data.Planning.Capacity}}<h3>{{$team.Name}} <small class="muted">{{$team.Team.PlanningStyle}}</small></h3>{{if $team.Note}}<p class="muted">{{$team.Note}}</p>{{else}}<div class="table-scroll" tabindex="0" aria-label="{{$team.Name}} capacity"><table><caption class="sr-only">{{$team.Name}} capacity by iteration in {{$.Data.Planning.Unit}}</caption><thead><tr><th scope="col">Iteration</th><th scope="col">Dates</th><th scope="col">Capacity</th><th scope="col">Planned</th><th scope="col">Completed</th><th scope="col">Unestimated work items</th><th scope="col">Status</th></tr></thead><tbody>{{range $team.Iterations}}<tr><th scope="row">{{.Name}}{{if .State}} <small class="muted">{{.State}}</small>{{end}}</th><td>{{if .Start}}{{.Start}} to {{.End}}{{else}}-{{end}}</td><td>{{if $.Data.Edit}}<form method="post" action="/plans/{{$.Data.Plan.ID}}/capacity" class="plan-capacity-form"><input type="hidden" name="scenario" value="{{$.Data.Scenario.ID}}"><input type="hidden" name="team" value="{{$team.Team.ID}}"><input type="hidden" name="iteration" value="{{.Key}}"><label class="sr-only" for="capacity-{{$team.Team.ID}}-{{.Key}}">{{.Name}} capacity for {{$team.Name}}</label><input id="capacity-{{$team.Team.ID}}-{{.Key}}" name="capacity" type="number" min="0" step="any" value="{{planNumber .Capacity}}"><button class="btn" type="submit">Set<span class="sr-only"> {{.Name}} capacity for {{$team.Name}}</span></button></form>{{else}}{{planNumber .Capacity}}{{end}}{{if .Overridden}} <small class="muted">set in scenario</small>{{end}}</td><td><meter min="0" max="{{planMax .Capacity .Planned}}" value="{{.Planned}}" aria-label="{{planNumber .Planned}} of {{planNumber .Capacity}} {{$.Data.Planning.Unit}} planned"></meter> {{planNumber .Planned}}</td><td>{{planNumber .Completed}}</td><td>{{.Unestimated}}</td><td>{{if .OverCapacity}}<span class="lozenge lozenge-danger">Over capacity</span>{{else}}<span class="lozenge lozenge-success">Within capacity</span>{{end}}</td></tr>{{end}}</tbody></table></div>{{end}}{{end}}</section>
{{if .Data.Releases}}<section class="surface-card sprint-report-work" aria-labelledby="plan-releases-title"><h2 id="plan-releases-title">Cross-project releases</h2><div class="table-scroll" tabindex="0" aria-label="Cross-project releases"><table class="report-table"><caption class="sr-only">Cross-project releases in this plan</caption><thead><tr><th scope="col">Release</th><th scope="col">Project</th><th scope="col">Version</th><th scope="col">Release date</th><th scope="col">Progress</th></tr></thead><tbody>{{range .Data.Releases}}{{$release := .}}{{range $index, $member := .Members}}<tr>{{if eq $index 0}}<th scope="row" rowspan="{{len $release.Members}}">{{$release.Name}}{{if $release.DatesDiffer}}<small>Its releases do not share a release date.</small>{{end}}{{if $release.Missing}}<small>{{len $release.Missing}} release{{if ne (len $release.Missing) 1}}s are{{else}} is{{end}} no longer there.</small>{{end}}</th>{{end}}<td>{{$member.ProjectKey}}</td><td><a href="/projects/{{$member.ProjectKey}}/releases/{{$member.Version.ID}}">{{$member.Version.Name}}</a>{{if $member.Version.Released}} · released{{end}}</td><td>{{if $member.Version.ReleaseDate}}{{$member.Version.ReleaseDate}}{{else}}No date{{end}}</td><td>{{$member.Progress.Done}} of {{$member.Progress.Total}} done</td></tr>{{else}}<tr>{{if $release.Missing}}<th scope="row">{{$release.Name}}<small>{{len $release.Missing}} release{{if ne (len $release.Missing) 1}}s are{{else}} is{{end}} no longer there.</small></th>{{else}}<th scope="row">{{$release.Name}}</th>{{end}}<td colspan="4">No releases grouped yet.</td></tr>{{end}}{{end}}</tbody></table></div></section>{{end}}
<section class="surface-card sprint-report-work" aria-labelledby="plan-teams-title"><h2 id="plan-teams-title">Teams</h2>{{if .Data.Work.Teams}}<div class="table-scroll" tabindex="0" aria-label="Plan teams"><table><caption class="sr-only">Plan teams</caption><thead><tr><th scope="col">Team</th><th scope="col">Planning style</th><th scope="col">Sprint length</th><th scope="col">Capacity</th><th scope="col">Members</th>{{if .Data.Edit}}<th scope="col"><span class="sr-only">Actions</span></th>{{end}}</tr></thead><tbody>{{range $capacity := .Data.Planning.Capacity}}{{$team := $capacity.Team}}<tr><th scope="row">{{if $capacity.Name}}{{$capacity.Name}}{{else}}Atlassian team {{$team.AtlassianTeamID}}{{end}}</th><td>{{$team.PlanningStyle}}</td><td>{{with $team.SprintLength}}{{.}} weeks{{else}}-{{end}}</td><td>{{with $team.Capacity}}{{.}}{{else}}-{{end}}</td><td>{{if $team.AtlassianTeamID}}Atlassian team{{else}}{{len $team.MemberIDs}}{{end}}</td>{{if $.Data.Edit}}<td><details class="timeline-schedule"><summary class="btn">Settings<span class="sr-only"> for {{$capacity.Name}}</span></summary><form method="post" action="/plans/{{$.Data.Plan.ID}}/teams"><input type="hidden" name="scenario" value="{{$.Data.Scenario.ID}}"><input type="hidden" name="team" value="{{$team.ID}}"><label for="team-style-{{$team.ID}}">Planning style</label><select id="team-style-{{$team.ID}}" name="planningStyle"><option value="Scrum" {{if eq $team.PlanningStyle "Scrum"}}selected{{end}}>Scrum</option><option value="Kanban" {{if eq $team.PlanningStyle "Kanban"}}selected{{end}}>Kanban</option></select><label for="team-source-{{$team.ID}}">Issue source</label><select id="team-source-{{$team.ID}}" name="issueSource"><option value="">None</option>{{range $.Data.Sources}}<option value="{{.ID}}" {{if $team.IssueSourceID}}{{if eq .ID (deref64 $team.IssueSourceID)}}selected{{end}}{{end}}>{{.Name}}</option>{{end}}</select><label for="team-capacity-{{$team.ID}}">Capacity</label><input id="team-capacity-{{$team.ID}}" name="capacity" type="number" min="0" step="any" value="{{with $team.Capacity}}{{planNumber .}}{{end}}"><label for="team-length-{{$team.ID}}">Sprint length in weeks</label><input id="team-length-{{$team.ID}}" name="sprintLength" type="number" min="1" step="1" value="{{with $team.SprintLength}}{{.}}{{end}}"><button class="btn btn-primary" type="submit">Save team settings</button></form></details></td>{{end}}</tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No teams are assigned to this plan.</p>{{end}}</section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "plan_changed"}}<span class="plan-flag plan-flag-{{.Color}}" title="Changed in {{.Name}}"><span class="sr-only">Changed in {{.Name}}</span></span>{{end}}

{{define "page_plan_review"}}
<!doctype html><html lang="en"><head><title>Review changes · {{.Data.Plan.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/plans">Plans</a><span aria-hidden="true">/</span><a href="/plans/{{.Data.Plan.ID}}?scenario={{.Data.Scenario.ID}}">{{.Data.Plan.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Review changes</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Scenario.Name}} scenario</span><h1>Review changes</h1><p>Changes stay in the plan until you save them to Jira. Choose the changes to save or discard.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{range .Data.Problems}}<p class="form-error" role="alert">{{.}}</p>{{end}}
{{if not .Data.Rows}}<section class="surface-card empty-state"><strong>No unsaved changes</strong><small>Changes made to work in the {{.Data.Scenario.Name}} scenario appear here.</small></section>
{{else}}<form method="post" action="/plans/{{.Data.Plan.ID}}/review" class="surface-card"><input type="hidden" name="scenario" value="{{.Data.Scenario.ID}}">
<div class="table-scroll" tabindex="0" aria-label="Unsaved changes"><table><caption class="sr-only">Unsaved changes in the {{.Data.Scenario.Name}} scenario</caption><thead><tr><th scope="col">Save or discard</th><th scope="col">Title</th><th scope="col">What changed</th><th scope="col">Last modified by</th></tr></thead><tbody>{{range .Data.Rows}}{{$row := .}}{{range $index, $change := .Changes}}<tr>
<td><input type="checkbox" id="change-{{$change.Ref}}" name="change" value="{{$change.Ref}}" checked aria-label="Select {{$change.Label}} of {{$row.Key}}"></td>
{{if eq $index 0}}<th scope="row" rowspan="{{len $row.Changes}}"><a href="/browse/{{$row.Key}}">{{$row.Key}}</a> {{$row.Summary}}</th>{{end}}
<td><label for="change-{{$change.Ref}}"><strong>{{$change.Label}}</strong>: {{$change.From}} → {{$change.To}}</label>{{if $change.Note}}<small class="muted plan-change-note">{{$change.Note}}</small>{{end}}</td>
<td>{{$change.By}}</td></tr>{{end}}{{end}}</tbody></table></div>
<label class="report-toggle"><input type="checkbox" name="notify" value="true" checked> Send update notifications</label>
<div class="plan-review-actions"><button class="btn btn-primary" type="submit" name="action" value="save">Save selected changes</button><button class="btn" type="submit" name="action" value="discard">Discard selected changes</button></div>
</form>{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
