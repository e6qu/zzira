{{define "edit_dialog_field"}}{{$field := .ID}}{{$view := .View}}{{with .View}}
{{if eq $field "summary"}}
    <label for="edit-summary">Summary</label>
    <input id="edit-summary" name="summary" value="{{.Issue.Summary}}" required autofocus maxlength="255">
{{else if eq $field "description"}}
    {{if .FieldOnEdit "description"}}<label for="edit-description">Description</label>
    <textarea id="edit-description" name="description" rows="6"{{if .FieldRequired "description"}} required{{end}}>{{adfToText .Issue.Description}}</textarea>{{end}}
{{else if eq $field "priority"}}
{{if .EditFields}}    {{if .FieldOnEdit "priority"}}<label for="edit-priority">Priority</label><select id="edit-priority" name="priority" {{if .FieldRequired "priority"}}required{{end}}><option value="">None</option>{{$priority := ""}}{{if .Issue.Priority}}{{$priority = .Issue.Priority.ID}}{{end}}{{range .Priorities}}<option value="{{.ID}}" {{if eq .ID $priority}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{end}}
{{end}}{{else if eq $field "labels"}}
{{if .EditFields}}    {{if .FieldOnEdit "labels"}}<label for="edit-labels">Labels</label><input id="edit-labels" name="labels" value="{{join .Issue.Labels ", "}}" placeholder="Separate labels with commas" {{if .FieldRequired "labels"}}required{{end}}>{{end}}
{{end}}{{else if eq $field "duedate"}}
{{if .EditFields}}    {{if and .CanSchedule (.FieldOnEdit "duedate")}}<label for="edit-duedate">Due date</label><input id="edit-duedate" name="duedate" type="date" value="{{.Issue.DueDate}}" {{if .FieldRequired "duedate"}}required{{end}}>{{end}}
{{end}}{{else if eq $field "parent"}}
{{if .EditFields}}    {{if .FieldOnEdit "parent"}}<label for="edit-parent">Parent</label><select id="edit-parent" name="parent"><option value="__keep_parent__">Keep current parent{{if .Issue.Parent}}: {{.Issue.Parent.Key}}{{end}}</option>{{if and (not .Issue.IssueType.Subtask) (not (.FieldRequired "parent"))}}<option value="">None</option>{{end}}{{range .ParentOptions}}<option value="{{.Key}}">{{.Name}}</option>{{end}}</select>{{end}}
{{end}}{{else if eq $field "resolution"}}
{{if .EditFields}}    {{if and .CanResolve (.FieldOnEdit "resolution")}}<label for="edit-resolution">Resolution</label><select id="edit-resolution" name="resolution" {{if .FieldRequired "resolution"}}required{{end}}><option value="">Unresolved</option>{{$resolution := ""}}{{if .Issue.Resolution}}{{$resolution = .Issue.Resolution.ID}}{{end}}{{range .Resolutions}}<option value="{{.ID}}" {{if eq .ID $resolution}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{end}}
{{end}}{{else if eq $field "timetracking"}}
{{if .EditFields}}    {{if and .TimeTrackingEnabled (.FieldOnEdit "timetracking")}}<label for="edit-original-estimate">Original estimate</label><input id="edit-original-estimate" name="originalEstimate" value="{{.TimeTracking.Original}}" placeholder="Not estimated" {{if .FieldRequired "timetracking"}}aria-describedby="edit-estimates-required"{{end}}><label for="edit-remaining-estimate">Remaining estimate</label><input id="edit-remaining-estimate" name="remainingEstimate" value="{{.TimeTracking.Remaining}}" placeholder="Not estimated" {{if .FieldRequired "timetracking"}}aria-describedby="edit-estimates-required"{{end}}>{{if .FieldRequired "timetracking"}}<small id="edit-estimates-required" class="muted">Enter an original or remaining estimate.</small>{{end}}{{end}}
{{end}}{{else if eq $field "environment"}}
    {{with .EnvironmentField}}<label for="edit-environment">Environment</label><textarea id="edit-environment" name="environment" rows="4" {{if .Required}}required{{end}} {{if .Description}}aria-describedby="edit-environment-help"{{end}}>{{adfToText (index $view.Issue.Fields "environment")}}</textarea>{{if .Description}}<small id="edit-environment-help" class="muted">{{.Description}}</small>{{end}}{{end}}
{{else if eq $field "assignee"}}
    {{if and .CanAssign (.FieldOnEdit "assignee")}}<label for="edit-assignee">Assignee</label>
      <select id="edit-assignee" name="assignee">
        <option value="">Unassigned</option>
        {{$cur := ""}}{{if .Issue.Assignee}}{{$cur = .Issue.Assignee.ID}}{{end}}
        {{range .Assignees}}
        <option value="{{.ID}}" {{if eq .ID $cur}}selected{{end}}>{{.DisplayName}}</option>
        {{end}}
      </select>
    {{end}}{{else if eq $field "reporter"}}
{{if .CanModifyReporter}}<label for="edit-reporter">Reporter</label>
      <select id="edit-reporter" name="reporter" {{if .ReporterRequired}}required{{end}}>
        {{if not .ReporterRequired}}<option value="">None</option>{{end}}
        {{$reporter := ""}}{{if .Issue.Reporter}}{{$reporter = .Issue.Reporter.ID}}{{end}}
        {{range .Reporters}}<option value="{{.ID}}" {{if eq .ID $reporter}}selected{{end}}>{{.DisplayName}}</option>{{end}}
      </select>
    {{end}}{{else if eq $field "security"}}
{{if and .CanSetSecurity .SecurityLevels (.FieldOnEdit "security")}}
    <label for="edit-security">Security</label>
      <select id="edit-security" name="security">
        <option value="">Public</option>
        {{$curSec := .Issue.SecurityLevelID}}
        {{range .SecurityLevels}}
        <option value="{{.ID}}" {{if eq .ID $curSec}}selected{{end}}>{{.Name}}</option>
        {{end}}
      </select>
    {{end}}
{{else}}
    {{range .ChoiceFields}}{{if eq .Field.ID $field}}
    <label for="edit-{{.Field.ID}}">{{.Field.Name}}</label><input type="hidden" name="{{.Field.ID}}" value=""><select id="edit-{{.Field.ID}}" name="{{.Field.ID}}" multiple size="3" {{if .Field.Required}}required{{end}} {{if .Field.Description}}aria-describedby="edit-help-{{.Field.ID}}"{{end}}>{{$value := .Value}}{{range .Field.Options}}<option value="{{.ID}}" {{if selectedVersion $value .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select>{{if .Field.Description}}<small id="edit-help-{{.Field.ID}}" class="muted">{{.Field.Description}}</small>{{end}}
    {{end}}{{end}}
    {{range .CustomFields}}{{if eq .ID $field}}
    <label for="field-{{.ID}}">{{.Name}}{{if .Required}} <span aria-hidden="true">*</span>{{end}}</label>
      {{template "custom_field_control" (customFieldControl . "field-" "")}}
      {{if .Description}}<small id="field-help-{{.ID}}" class="muted">{{.Description}}</small>{{end}}
    {{end}}{{end}}
{{end}}{{end}}{{end}}
