{{define "page_hierarchy"}}
<!doctype html><html lang="en"><head><title>Work type hierarchy · {{(site $).Title}}</title>{{template "head" .}}</head>
<body class="page-hierarchy"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Work type hierarchy</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Work type hierarchy</h1><p>Levels run from the top down. A work item's parent is a work item one level above it.</p></div><a class="btn" href="/settings/statuses">Statuses</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.CanEdit}}<section class="surface-card" aria-labelledby="hierarchy-add-heading"><div><h2 id="hierarchy-add-heading">Add level</h2><p>The new level goes above every existing level.</p></div><form class="project-details-form" method="post" action="/settings/hierarchy"><input type="hidden" name="action" value="add-level"><label for="hierarchy-name-new">Level name</label><input id="hierarchy-name-new" name="name" maxlength="255" required><button class="btn btn-primary" type="submit">Add level</button></form></section>{{end}}
<div class="hierarchy-level-list">{{$page := .}}{{range .Data.Levels}}<article class="surface-card hierarchy-level-card" data-level="{{.Level}}"><header><div><span class="screen-badge" aria-hidden="true">{{.Level}}</span><div><h2>{{.Name}}</h2><p>{{if eq .Level -1}}Sub-tasks{{else if eq .Level 0}}Base level work{{else}}Level {{.Level}}{{end}}</p></div></div><span class="lozenge">{{len .WorkTypes}} work type{{if ne (len .WorkTypes) 1}}s{{end}}</span></header>
<ul class="hierarchy-work-types">{{range .WorkTypes}}<li><span class="issue-type-mini" aria-hidden="true">✓</span><span><strong>{{.Name}}</strong><small>{{.Description}}</small></span></li>{{else}}<li class="empty-state"><strong>No work types</strong><small>Move a work type here to use this level.</small></li>{{end}}</ul>
{{if $page.Data.CanEdit}}<div class="hierarchy-level-actions">{{if ge .Level 1}}<form class="project-details-form" method="post" action="/settings/hierarchy"><input type="hidden" name="action" value="rename-level"><input type="hidden" name="level" value="{{.Level}}"><label for="hierarchy-name-{{.Level}}">Rename {{.Name}}</label><input id="hierarchy-name-{{.Level}}" name="name" value="{{.Name}}" maxlength="255" required><button class="btn" type="submit">Rename</button></form>{{end}}
{{if ne .Level -1}}<form class="project-details-form" method="post" action="/settings/hierarchy"><input type="hidden" name="action" value="move-work-type"><input type="hidden" name="level" value="{{.Level}}"><label for="hierarchy-move-{{.Level}}">Move a work type to {{.Name}}</label><select id="hierarchy-move-{{.Level}}" name="workType">{{range $page.Data.WorkTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Move here</button></form>{{end}}
{{if gt .Level 1}}<form method="post" action="/settings/hierarchy"><input type="hidden" name="action" value="remove-level"><input type="hidden" name="level" value="{{.Level}}"><button class="btn btn-danger" type="submit">Remove {{.Name}}</button></form>{{end}}</div>{{end}}</article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
