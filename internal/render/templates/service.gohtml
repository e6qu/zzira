{{define "service_start"}}
<!doctype html><html lang="en"><head><title>Service · ZZIRA</title>{{template "head" .}}</head><body class="page-service"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
{{end}}
{{define "service_end"}}</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>{{end}}

{{define "page_service_home"}}{{template "service_start" .}}
<header class="service-hero"><div><span class="eyebrow">Help center</span><h1>How can we help?</h1><p>Choose a service portal or follow requests you already raised.</p></div></header>
<section aria-labelledby="service-portals"><div class="section-heading"><h2 id="service-portals">Service portals</h2></div><div class="directory-grid">{{range .Data.Desks}}<article class="directory-card service-portal-card"><span class="workspace-avatar" aria-hidden="true">{{initials .PortalName}}</span><div><h3><a href="/service/portals/{{.ID}}">{{.PortalName}}</a></h3><p>{{.ProjectName}} · {{.ProjectKey}}</p></div></article>{{else}}<div class="empty-state"><strong>No service portals yet</strong><small>Ask an administrator to create a service project.</small></div>{{end}}</div></section>
<section aria-labelledby="my-service-requests"><div class="section-heading"><h2 id="my-service-requests">My requests</h2></div>{{template "service_request_list" .Data.Requests}}</section>
{{if .Data.Organizations}}<section aria-labelledby="my-service-organizations"><div class="section-heading"><div><span class="eyebrow">Shared support</span><h2 id="my-service-organizations">Your organizations</h2></div></div><div class="service-organization-summary">{{range .Data.Organizations}}<article class="surface-card"><span class="workspace-avatar" aria-hidden="true">{{initials .Name}}</span><span><strong>{{.Name}}</strong><small>Requests can be shared with members of this customer organization.</small></span></article>{{end}}</div></section>{{end}}
{{template "service_end" .}}{{end}}

{{define "page_service_portal"}}{{template "service_start" .}}
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/service">Help center</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Desk.PortalName}}</span></nav>
<header class="service-hero compact"><div><span class="eyebrow">{{.Data.Desk.ProjectKey}} service portal</span><h1>{{.Data.Desk.PortalName}}</h1><p>Tell the service team what you need and track the response here.</p></div></header>
<form class="service-search" role="search" method="get"><label for="request-type-search">What do you need help with?</label><div><input id="request-type-search" name="q" type="search" value="{{.Data.Query}}" placeholder="Search request types"><button class="btn" type="submit">Search</button></div></form>
{{if and .Data.Query .Data.KnowledgeArticles}}<section class="service-knowledge-suggestions" aria-labelledby="knowledge-suggestions-heading"><div class="section-heading"><div><span class="eyebrow">Knowledge base</span><h2 id="knowledge-suggestions-heading">Suggested articles</h2></div></div><div class="service-knowledge-grid">{{range .Data.KnowledgeArticles}}<a class="surface-card" href="/service/knowledge/{{.PageID}}"><span aria-hidden="true">▤</span><span><strong>{{.Title}}</strong><small>{{.Excerpt}}</small></span></a>{{end}}</div></section>{{end}}
<section class="service-type-grid" aria-label="Request types">{{range .Data.RequestTypes}}<a class="surface-card service-type-card" href="/service/portals/{{.ServiceDeskID}}/request/{{.ID}}"><span aria-hidden="true">↗</span><strong>{{.Name}}</strong><small>{{.Description}}</small></a>{{else}}<div class="empty-state"><strong>No request types found</strong><small>Try another search.</small></div>{{end}}</section>
<section aria-labelledby="portal-my-requests"><div class="section-heading"><h2 id="portal-my-requests">Requests in this portal</h2></div>{{template "service_request_list" .Data.Requests}}</section>
{{template "service_end" .}}{{end}}

{{define "page_service_knowledge"}}{{template "service_start" .}}{{range .Data.KnowledgeArticles}}<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/service">Help center</a><span aria-hidden="true">/</span><span>{{.SpaceKey}}</span><span aria-hidden="true">/</span><span aria-current="page">{{.Title}}</span></nav><article class="surface-card service-knowledge-article"><header><span class="eyebrow">Knowledge base article</span><h1>{{.Title}}</h1><p>{{.SpaceKey}} knowledge base</p></header><div class="wiki-content">{{wikiHTML .Body}}</div></article>{{end}}{{template "service_end" .}}{{end}}

{{define "page_service_request_form"}}{{template "service_start" .}}
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/service">Help center</a><span aria-hidden="true">/</span><a href="/service/portals/{{.Data.Desk.ID}}">{{.Data.Desk.PortalName}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.RequestType.Name}}</span></nav>
<div class="service-form-layout"><section><header class="page-header"><div><span class="eyebrow">New request</span><h1>{{.Data.RequestType.Name}}</h1><p>{{.Data.RequestType.Description}}</p></div></header>{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}<form class="surface-card project-details-form" method="post">{{range .Data.RequestTypeFields}}<label for="request-field-{{.ID}}">{{.Name}}{{if .Required}} <span aria-hidden="true">*</span>{{end}}</label>{{if eq .ID "description"}}<textarea id="request-field-{{.ID}}" name="field_{{.ID}}" rows="8" {{if .Required}}required{{end}}>{{index $.Data.FieldValues .ID}}</textarea>{{else}}<input id="request-field-{{.ID}}" name="field_{{.ID}}" {{if eq .Type "number"}}type="number" step="any"{{else if eq .Type "datetime"}}type="datetime-local"{{else}}type="text"{{end}} value="{{index $.Data.FieldValues .ID}}" {{if eq .ID "summary"}}maxlength="255"{{end}} {{if .Required}}required{{end}}>{{end}}{{if .HelpText}}<small class="field-hint">{{.HelpText}}</small>{{else if .Description}}<small class="field-hint">{{.Description}}</small>{{end}}{{end}}<div class="project-form-actions"><button class="btn btn-primary" type="submit">Send request</button><a class="btn" href="/service/portals/{{.Data.Desk.ID}}">Cancel</a></div></form></section><aside class="surface-card service-form-aside"><strong>What happens next?</strong><ol><li>The service team reviews your request.</li><li>You receive updates in the conversation.</li><li>You can follow status and respond here.</li></ol></aside></div>
{{template "service_end" .}}{{end}}

{{define "page_service_request"}}{{template "service_start" .}}
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/service">My requests</a><span aria-hidden="true">/</span><a href="/service/portals/{{.Data.Request.ServiceDesk.ID}}">{{.Data.Request.ServiceDesk.PortalName}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Request.Issue.Key}}</span></nav>
<header class="page-header service-request-header"><div><span class="eyebrow">{{.Data.Request.RequestType.Name}}</span><h1>{{.Data.Request.Issue.Summary}}</h1><p>{{.Data.Request.Issue.Key}} · Raised by {{.Data.Request.Customer.DisplayName}} through {{.Data.Request.Channel}}</p></div><span class="lozenge {{statusClass .Data.Request.Issue.Status.Category}}">{{.Data.Request.Issue.Status.Name}}</span></header>
{{template "service_request_followup" .}}
<div class="service-request-layout"><div><section class="surface-card service-description" aria-labelledby="request-description-heading"><h2 id="request-description-heading">Request details</h2><div class="description-text">{{adfHTML .Data.Request.Issue.Description}}</div>{{if .Data.RequestFieldValues}}<dl class="service-request-fields">{{range .Data.RequestFieldValues}}<dt>{{.Name}}</dt><dd>{{.Value}}</dd>{{end}}</dl>{{end}}</section>{{if and .Data.CanAgent .Data.OperationsProfile}}{{with .Data.OperationsProfile}}<section class="surface-card service-operations-control" id="operations-control" aria-labelledby="operations-control-heading"><header><span class="eyebrow">{{.Kind}} control</span><h2 id="operations-control-heading">Operations assessment</h2><p><strong>{{.RiskLevel}} risk</strong> · score {{.RiskScore}} of 16{{with .OnCallUser}} · On call: {{.DisplayName}}{{end}}</p></header><form class="project-details-form" method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/operations"><div class="service-risk-grid"><label for="operations-impact">Impact<select id="operations-impact" name="impact"><option value="1" {{if eq .Impact 1}}selected{{end}}>1 · Limited</option><option value="2" {{if eq .Impact 2}}selected{{end}}>2 · Moderate</option><option value="3" {{if eq .Impact 3}}selected{{end}}>3 · Major</option><option value="4" {{if eq .Impact 4}}selected{{end}}>4 · Severe</option></select></label><label for="operations-likelihood">Likelihood<select id="operations-likelihood" name="likelihood"><option value="1" {{if eq .Likelihood 1}}selected{{end}}>1 · Rare</option><option value="2" {{if eq .Likelihood 2}}selected{{end}}>2 · Possible</option><option value="3" {{if eq .Likelihood 3}}selected{{end}}>3 · Likely</option><option value="4" {{if eq .Likelihood 4}}selected{{end}}>4 · Expected</option></select></label></div><label for="operations-on-call">On-call owner</label><select id="operations-on-call" name="onCallUser"><option value="">Unassigned</option>{{range $.Data.Members}}<option value="{{.ID}}" {{if eq .ID $.Data.OperationsProfile.OnCallUserID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select>{{if eq .Kind "change"}}<label for="operations-change-type">Change type</label><select id="operations-change-type" name="changeType"><option value="standard" {{if eq .ChangeType "standard"}}selected{{end}}>Standard</option><option value="normal" {{if eq .ChangeType "normal"}}selected{{end}}>Normal</option><option value="emergency" {{if eq .ChangeType "emergency"}}selected{{end}}>Emergency</option></select><label for="operations-planned-start">Planned start (UTC)</label><input id="operations-planned-start" name="plannedStart" type="datetime-local" value="{{with .PlannedStart}}{{.Format "2006-01-02T15:04"}}{{end}}"><label for="operations-planned-end">Planned end (UTC)</label><input id="operations-planned-end" name="plannedEnd" type="datetime-local" value="{{with .PlannedEnd}}{{.Format "2006-01-02T15:04"}}{{end}}"><label for="operations-rollback">Rollback plan</label><textarea id="operations-rollback" name="rollbackPlan" rows="3" maxlength="10000">{{.RollbackPlan}}</textarea>{{else}}<input type="hidden" name="changeType" value="normal">{{end}}<label><input type="checkbox" name="reviewRequired" value="true" {{if .ReviewRequired}}checked{{end}}> Post-incident review required</label><label for="operations-review-due">Review due (UTC)</label><input id="operations-review-due" name="reviewDueAt" type="datetime-local" value="{{with .ReviewDueAt}}{{.Format "2006-01-02T15:04"}}{{end}}"><label for="operations-review-status">Review status</label><select id="operations-review-status" name="reviewStatus"><option value="not_required" {{if eq .ReviewStatus "not_required"}}selected{{end}}>Not required</option><option value="pending" {{if eq .ReviewStatus "pending"}}selected{{end}}>Pending</option><option value="in_progress" {{if eq .ReviewStatus "in_progress"}}selected{{end}}>In progress</option><option value="completed" {{if eq .ReviewStatus "completed"}}selected{{end}}>Completed</option></select><label for="operations-review-summary">Review findings</label><textarea id="operations-review-summary" name="reviewSummary" rows="3" maxlength="10000">{{.ReviewSummary}}</textarea><button class="btn btn-primary" type="submit">Save operations assessment</button></form></section>{{end}}{{end}}{{if .Data.CanAgent}}<section class="surface-card service-operations-links" id="operations-links" aria-labelledby="operations-links-heading"><div class="section-heading"><div><span class="eyebrow">Operations</span><h2 id="operations-links-heading">Related incidents, problems, and changes</h2></div></div><details class="link-create"><summary class="quiet-action">Link operations work</summary><form method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/links"><label for="service-link-type">Relationship</label><select id="service-link-type" name="type" required>{{range .Data.LinkTypes}}<option value="{{.ID}}">{{.Outward}}</option>{{end}}</select><label for="service-link-issue">Work item key</label><input id="service-link-issue" name="issue" placeholder="{{.Data.Request.Issue.Key}}" autocomplete="off" required><button class="btn btn-primary" type="submit">Link work item</button></form></details>{{if .Data.Links}}<ul class="linked-work-list">{{range .Data.Links}}<li><span class="link-relationship">{{.Relationship}}</span><a href="/browse/{{.IssueKey}}"><strong>{{.IssueKey}}</strong> {{.Summary}}</a><span class="lozenge {{statusClass .Status.Category}}">{{.Status.Name}}</span><form method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/links/{{.ID}}/delete"><button class="icon-danger" type="submit" aria-label="Remove link to {{.IssueKey}}">×</button></form></li>{{end}}</ul>{{else}}<p class="muted">No related operations work.</p>{{end}}</section>{{end}}<section class="service-conversation" id="conversation" aria-labelledby="conversation-heading"><div class="section-heading"><h2 id="conversation-heading">Conversation</h2></div><ol class="service-comments">{{range .Data.Comments}}<li class="surface-card"><header><span class="avatar" aria-hidden="true">{{initials .Comment.AuthorName}}</span><div><strong>{{.Comment.AuthorName}}</strong><small><time datetime="{{.Comment.Created}}">{{.Comment.Created}}</time>{{if not .Public}} · Internal note{{end}}</small></div></header><div class="description-text">{{adfHTML .Comment.Body}}</div>{{if .Attachments}}<ul class="service-attachments">{{range .Attachments}}<li><a href="/rest/servicedeskapi/request/{{$.Data.Request.Issue.Key}}/attachment/{{.ID}}">📎 {{.Filename}}</a><small>{{.Size}} bytes</small></li>{{end}}</ul>{{end}}</li>{{else}}<li class="empty-state"><strong>No replies yet</strong><small>Add context or ask the service team a question.</small></li>{{end}}</ol><form class="surface-card project-details-form" method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/comments" enctype="multipart/form-data"><label for="service-comment">Add to the conversation</label><textarea id="service-comment" name="body" rows="4" placeholder="Add a message or attach a file."></textarea><label for="service-attachment">Attachment</label><input id="service-attachment" name="file" type="file">{{if .Data.CanAgent}}<label><input type="checkbox" name="public" value="true" checked> Share with the customer</label>{{else}}<input type="hidden" name="public" value="true">{{end}}<button class="btn btn-primary" type="submit">Add comment</button></form></section></div><aside class="service-request-side"><section class="surface-card"><h2>Status</h2><strong class="service-current-status">{{.Data.Request.Issue.Status.Name}}</strong><p>Last updated <time datetime="{{.Data.Request.Issue.UpdatedAt}}">{{.Data.Request.Issue.UpdatedAt}}</time></p>{{if .Data.Transitions}}<div class="service-actions" aria-label="Available status actions">{{range .Data.Transitions}}<form method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/transition"><input type="hidden" name="transition" value="{{.ID}}"><button class="btn" type="submit">{{.Name}}<small>Move to {{.To}}</small></button></form>{{end}}</div>{{end}}</section><section class="surface-card service-sla-panel"><h2>Service goals</h2><ul>{{range .Data.SLAs}}<li><span><strong>{{.Name}}</strong>{{if .OngoingCycle}}<small>{{if .OngoingCycle.GoalName}}{{.OngoingCycle.GoalName}} · {{end}}{{if .OngoingCycle.Breached}}Breached by {{.OngoingCycle.ElapsedLabel}}{{else}}{{.OngoingCycle.RemainingLabel}} remaining{{if .OngoingCycle.Paused}} · Paused outside working hours{{end}}{{end}}</small>{{else}}<small>Completed</small>{{end}}</span>{{if .OngoingCycle}}<span class="lozenge {{if .OngoingCycle.Breached}}lozenge-danger{{else}}lozenge-success{{end}}">{{if .OngoingCycle.Breached}}Breached{{else}}On track{{end}}</span>{{else}}<span class="lozenge lozenge-success">Met</span>{{end}}</li>{{end}}</ul></section><section class="surface-card" id="approvals"><h2>Approvals</h2><ul class="service-approvals">{{range .Data.Approvals}}{{$approval := .}}<li><span><strong>{{.Name}}</strong><small>{{.FinalDecision}}</small></span>{{range .Approvers}}{{if and (eq .User.ID $.Data.CurrentUserID) (eq .Decision "pending")}}<form method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/approvals/{{$approval.ID}}"><button class="btn btn-primary" name="decision" value="approve" type="submit">Approve</button><button class="btn" name="decision" value="decline" type="submit">Decline</button></form>{{else}}<small>{{.User.DisplayName}} · {{.Decision}}</small>{{end}}{{end}}</li>{{else}}<li><small>No approvals requested</small></li>{{end}}</ul>{{if .Data.CanAgent}}<form class="service-approval-form" method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/approvals"><label for="approval-name">Request approval</label><input id="approval-name" name="name" maxlength="255" placeholder="Manager approval" required><label for="approval-user">Approver</label><select id="approval-user" name="approver" required>{{range .Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><button class="btn" type="submit">Request approval</button></form>{{end}}</section>{{if .Data.Attachments}}<section class="surface-card"><h2>Attachments</h2><ul class="service-attachments">{{range .Data.Attachments}}<li><a href="/rest/servicedeskapi/request/{{$.Data.Request.Issue.Key}}/attachment/{{.Attachment.ID}}">{{.Attachment.Filename}}</a><small>{{if .Public}}Customer visible{{else}}Internal{{end}}</small></li>{{end}}</ul></section>{{end}}<section class="surface-card"><h2>Request information</h2><dl><dt>Portal</dt><dd>{{.Data.Request.ServiceDesk.PortalName}}</dd><dt>Request type</dt><dd>{{.Data.Request.RequestType.Name}}</dd><dt>Channel</dt><dd>{{.Data.Request.Channel}}</dd></dl></section><section class="surface-card" id="participants"><h2>Request participants</h2><ul class="service-participants">{{range .Data.Participants}}<li><span class="avatar" aria-hidden="true"><span>{{initials .DisplayName}}</span></span><span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span>{{if $.Data.CanManageParticipants}}<form method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/participants"><input type="hidden" name="participant" value="{{.ID}}"><input type="hidden" name="action" value="remove"><button class="icon-button" type="submit" aria-label="Remove {{.DisplayName}}">×</button></form>{{end}}</li>{{else}}<li><small>No participants</small></li>{{end}}</ul>{{if .Data.CanManageParticipants}}<form class="service-participant-form" method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/participants"><label for="service-participant">Add by account ID or email</label><div><input id="service-participant" name="participant" required><button class="btn" type="submit">Add</button></div></form>{{end}}</section></aside></div>
{{template "service_end" .}}{{end}}

{{define "service_request_list"}}<div class="surface-card service-request-list">{{range .}}<a href="/service/requests/{{.Issue.Key}}"><span><strong>{{.Issue.Summary}}</strong><small>{{.Issue.Key}} · {{.RequestType.Name}}</small></span><span class="lozenge {{statusClass .Issue.Status.Category}}">{{.Issue.Status.Name}}</span></a>{{else}}<div class="empty-state"><strong>No requests yet</strong><small>Requests you raise will appear here.</small></div>{{end}}</div>{{end}}

{{define "page_service_agent"}}{{template "service_start" .}}
<header class="page-header"><div><span class="eyebrow">Service workspace</span><h1>Queues</h1><p>Prioritize incoming customer requests and take ownership of the next item.</p></div>{{if .Data.Desk}}<div class="page-header-actions"><a class="btn" href="/service/agent/{{.Data.Desk.ID}}/reports">Service reports</a><a class="btn" href="/service/portals/{{.Data.Desk.ID}}">Open customer portal</a></div>{{end}}</header>
{{if .Data.Desks}}<nav class="project-tabs" aria-label="Service desks">{{range .Data.Desks}}<a href="/service/agent/{{.ID}}" {{if $.Data.Desk}}{{if eq .ID $.Data.Desk.ID}}aria-current="page"{{end}}{{end}}>{{.ProjectName}}</a>{{end}}</nav>{{end}}
{{if .Data.Desk}}<div class="service-agent-layout"><aside class="surface-card service-queue-nav"><h2>{{.Data.Desk.PortalName}}</h2><nav aria-label="Queues">{{range .Data.Queues}}<a href="/service/agent/{{$.Data.Desk.ID}}?queue={{.ID}}" {{if $.Data.Queue}}{{if eq .ID $.Data.Queue.ID}}aria-current="page"{{end}}{{end}}><span>{{.Name}}</span></a>{{end}}</nav></aside><section aria-labelledby="queue-heading">{{if .Data.Queue}}<div class="section-heading"><div><span class="eyebrow">Agent queue</span><h2 id="queue-heading">{{.Data.Queue.Name}}</h2></div><strong>{{.Data.Queue.IssueCount}} requests</strong></div><div class="surface-card service-agent-table" role="region" aria-label="{{.Data.Queue.Name}} requests" tabindex="0"><table><thead><tr><th scope="col">Key</th><th scope="col">Summary</th><th scope="col">Customer</th><th scope="col">Status</th><th scope="col">Assignee</th><th scope="col">Action</th></tr></thead><tbody>{{range .Data.Requests}}<tr><td><a href="/service/requests/{{.Issue.Key}}">{{.Issue.Key}}</a></td><td>{{.Issue.Summary}}{{range .SLAs}}<small class="service-queue-sla {{if .OngoingCycle.Breached}}is-breached{{end}}">{{.Name}} · {{if .OngoingCycle.Breached}}breached{{else}}{{.OngoingCycle.RemainingLabel}} left{{end}}</small>{{end}}</td><td>{{.Customer.DisplayName}}</td><td><span class="lozenge {{statusClass .Issue.Status.Category}}">{{.Issue.Status.Name}}</span></td><td>{{with .Issue.Assignee}}{{.DisplayName}}{{else}}Unassigned{{end}}</td><td><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/requests/{{.Issue.Key}}/assign"><input type="hidden" name="queue" value="{{$.Data.Queue.ID}}">{{if .Issue.Assignee}}<input type="hidden" name="assignment" value="unassigned"><button class="btn" type="submit">Unassign</button>{{else}}<button class="btn btn-primary" type="submit">Assign to me</button>{{end}}</form></td></tr>{{else}}<tr><td colspan="6"><div class="empty-state"><strong>Queue cleared</strong><small>No requests currently match this queue.</small></div></td></tr>{{end}}</tbody></table></div>{{end}}</section></div>{{else}}<div class="empty-state"><strong>No service desks yet</strong><small>Create a service-management project to start receiving requests.</small></div>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-queue-settings" id="queue-settings" aria-labelledby="queue-settings-heading"><header><div><span class="eyebrow">Work intake</span><h2 id="queue-settings-heading">Custom queues</h2><p>Create focused agent views with the same JQL fields and ordering used by Jira search.</p></div></header><form class="service-queue-create" method="post" action="/service/agent/{{.Data.Desk.ID}}/queues"><input type="hidden" name="action" value="create"><label for="queue-name">Queue name</label><input id="queue-name" name="name" maxlength="255" required><label for="queue-jql">JQL</label><textarea id="queue-jql" name="jql" maxlength="2000" rows="3" required>status != Done ORDER BY created ASC</textarea><button class="btn btn-primary" type="submit">Create queue</button></form><div class="service-custom-queues">{{range .Data.Queues}}{{if eq .Kind "custom"}}<article><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/queues"><input type="hidden" name="action" value="update"><input type="hidden" name="queueId" value="{{.ID}}"><label for="queue-name-{{.ID}}">Queue name</label><input id="queue-name-{{.ID}}" name="name" maxlength="255" value="{{.Name}}" required><label for="queue-jql-{{.ID}}">JQL</label><textarea id="queue-jql-{{.ID}}" name="jql" maxlength="2000" rows="3" required>{{.JQL}}</textarea><button class="btn" type="submit">Save queue</button></form><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/queues"><input type="hidden" name="action" value="delete"><input type="hidden" name="queueId" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Delete queue <span class="sr-only">{{.Name}}</span></button></form></article>{{end}}{{end}}</div></section>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-request-form-settings" id="request-forms" aria-labelledby="request-forms-heading"><header><span class="eyebrow">Customer forms</span><h2 id="request-forms-heading">Request type forms</h2><p>Choose the Jira fields each customer sees and which answers are required.</p></header><div class="service-request-type-forms">{{range .Data.RequestTypeForms}}<form method="post" action="/service/agent/{{$.Data.Desk.ID}}/request-types/{{.RequestType.ID}}/fields"><h3>{{.RequestType.Name}}</h3>{{range .Fields}}<fieldset><legend>{{.Name}}</legend><label><input type="checkbox" name="fieldId" value="{{.ID}}" {{if .Enabled}}checked{{end}} {{if eq .ID "summary"}}disabled{{end}}> Show on portal</label>{{if eq .ID "summary"}}<input type="hidden" name="fieldId" value="summary">{{end}}<label><input type="checkbox" name="requiredFieldId" value="{{.ID}}" {{if .Required}}checked{{end}} {{if eq .ID "summary"}}disabled{{end}}> Required</label>{{if eq .ID "summary"}}<input type="hidden" name="requiredFieldId" value="summary">{{end}}<label for="request-field-help-{{.RequestTypeID}}-{{.ID}}">Help text</label><input id="request-field-help-{{.RequestTypeID}}-{{.ID}}" name="help_{{.ID}}" value="{{.HelpText}}" maxlength="1000"></fieldset>{{end}}<button class="btn" type="submit">Save {{.RequestType.Name}} form</button></form>{{end}}</div></section>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-agent-settings" id="agents" aria-labelledby="agents-heading"><header><div><span class="eyebrow">Service access</span><h2 id="agents-heading">Agents</h2><p>Assign workspace members who can work this desk's queues, internal notes, participants, and customer requests.</p></div></header><ul>{{range .Data.Members}}<li><span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/agents"><input type="hidden" name="accountId" value="{{.ID}}">{{if index $.Data.Agents .ID}}<input type="hidden" name="enabled" value="false"><button class="btn" type="submit">Remove agent<span class="sr-only"> {{.DisplayName}}</span></button>{{else}}<input type="hidden" name="enabled" value="true"><button class="btn" type="submit">Add agent<span class="sr-only"> {{.DisplayName}}</span></button>{{end}}</form></li>{{else}}<li><span><strong>No eligible members</strong><small>Invite a workspace member before assigning service access.</small></span></li>{{end}}</ul></section>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-customer-settings" id="customers" aria-labelledby="customers-heading"><header><div><span class="eyebrow">Portal access</span><h2 id="customers-heading">Customers</h2><p>Choose whether anyone with site access can raise a request, or limit this portal to customers and linked organizations.</p></div><form method="post" action="/service/agent/{{.Data.Desk.ID}}/customers"><input type="hidden" name="action" value="access"><input type="hidden" name="open" value="{{if .Data.Desk.CustomerAccessOpen}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.Desk.CustomerAccessOpen}}Close portal access{{else}}Open portal access{{end}}</button></form></header><div class="service-management-forms"><form method="post" action="/service/agent/{{.Data.Desk.ID}}/customers"><input type="hidden" name="action" value="invite"><label for="customer-display-name">Display name</label><input id="customer-display-name" name="displayName" maxlength="255" required><label for="customer-email">Email</label><input id="customer-email" name="email" type="email" required><button class="btn btn-primary" type="submit">Invite customer</button></form><form method="post" action="/service/agent/{{.Data.Desk.ID}}/customers"><input type="hidden" name="action" value="add"><label for="existing-customer">Existing customer email or account ID</label><input id="existing-customer" name="customer" required><button class="btn" type="submit">Add to portal</button></form></div><ul class="service-management-list">{{range .Data.Customers}}<li><span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span>{{if not $.Data.Desk.CustomerAccessOpen}}<form method="post" action="/service/agent/{{$.Data.Desk.ID}}/customers"><input type="hidden" name="action" value="remove"><input type="hidden" name="customer" value="{{.ID}}"><button class="btn" type="submit">Remove</button></form>{{end}}</li>{{else}}<li><span><strong>No associated customers</strong><small>Open portals associate customers when they submit their first request.</small></span></li>{{end}}</ul></section>{{end}}
{{if .Data.Desk}}<section class="surface-card service-organization-settings" id="organizations" aria-labelledby="organizations-heading"><header><div><span class="eyebrow">Customer directory</span><h2 id="organizations-heading">Organizations</h2><p>Group customers and connect the groups whose members may use this portal.</p></div><form class="service-create-organization" method="post" action="/service/agent/{{.Data.Desk.ID}}/organizations"><input type="hidden" name="action" value="create"><label class="sr-only" for="organization-name">Organization name</label><input id="organization-name" name="name" maxlength="255" placeholder="Organization name" required><button class="btn btn-primary" type="submit">Create organization</button></form></header><div class="service-organization-grid">{{range .Data.Organizations}}{{$organization := .}}<article><div class="service-organization-title"><span class="workspace-avatar" aria-hidden="true">{{initials .Name}}</span><span><strong>{{.Name}}</strong><small>{{len (index $.Data.OrganizationUsers .ID)}} customers</small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/organizations"><input type="hidden" name="organizationId" value="{{.ID}}">{{if index $.Data.DeskOrganizations .ID}}<input type="hidden" name="action" value="unlink"><button class="btn" type="submit">Unlink portal</button>{{else}}<input type="hidden" name="action" value="link"><button class="btn" type="submit">Link portal</button>{{end}}</form></div><ul>{{range index $.Data.OrganizationUsers .ID}}<li><span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/organizations"><input type="hidden" name="action" value="remove-member"><input type="hidden" name="organizationId" value="{{$organization.ID}}"><input type="hidden" name="accountId" value="{{.ID}}"><button class="icon-button" type="submit" aria-label="Remove {{.DisplayName}} from {{$organization.Name}}">×</button></form></li>{{else}}<li><small>No customers in this organization.</small></li>{{end}}</ul><form class="service-add-organization-member" method="post" action="/service/agent/{{$.Data.Desk.ID}}/organizations"><input type="hidden" name="action" value="add-member"><input type="hidden" name="organizationId" value="{{.ID}}"><label class="sr-only" for="organization-customer-{{.ID}}">Customer email or account ID</label><input id="organization-customer-{{.ID}}" name="customer" placeholder="Customer email or account ID" required><button class="btn" type="submit">Add customer</button></form><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/organizations"><input type="hidden" name="action" value="delete"><input type="hidden" name="organizationId" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Delete organization</button></form></article>{{else}}<div class="empty-state"><strong>No customer organizations</strong><small>Create one to manage shared portal access.</small></div>{{end}}</div></section>{{end}}
{{if and .Data.CanAdmin .Data.OperationsSettings}}<section class="surface-card service-operations-settings" id="operations-settings" aria-labelledby="operations-settings-heading"><header><span class="eyebrow">Operations governance</span><h2 id="operations-settings-heading">Risk, CAB, on-call, and reviews</h2><p>Apply one control policy to incidents, problems, and changes in this service desk.</p></header><form class="project-details-form" method="post" action="/service/agent/{{.Data.Desk.ID}}/operations"><label for="cab-risk-threshold">CAB approval threshold</label><input id="cab-risk-threshold" name="cabRiskThreshold" type="number" min="1" max="16" value="{{.Data.OperationsSettings.CABRiskThreshold}}" required><small>Risk is impact × likelihood. Changes at or above this score request CAB approval automatically.</small><label for="review-due-days">Incident review due in days</label><input id="review-due-days" name="reviewDueDays" type="number" min="1" max="90" value="{{.Data.OperationsSettings.ReviewDueDays}}" required><fieldset><legend>Change advisory board</legend>{{range .Data.Members}}{{$memberID := .ID}}<label><input type="checkbox" name="cabMember" value="{{.ID}}" {{range $.Data.OperationsSettings.CABMembers}}{{if eq .ID $memberID}}checked{{end}}{{end}}> {{.DisplayName}}</label>{{end}}</fieldset><button class="btn btn-primary" type="submit">Save operations policy</button></form><section class="service-on-call" aria-labelledby="on-call-heading"><h3 id="on-call-heading">On-call schedule</h3><form class="project-details-form" method="post" action="/service/agent/{{.Data.Desk.ID}}/on-call"><label for="on-call-label">Rotation label</label><input id="on-call-label" name="label" maxlength="255" placeholder="Primary operations" required><label for="on-call-owner">On-call owner</label><select id="on-call-owner" name="accountId" required>{{range .Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><label for="on-call-start">Starts (UTC)</label><input id="on-call-start" name="startsAt" type="datetime-local" required><label for="on-call-end">Ends (UTC)</label><input id="on-call-end" name="endsAt" type="datetime-local" required><button class="btn" type="submit">Add on-call shift</button></form><ul>{{range .Data.OperationsSettings.OnCallShifts}}<li><span><strong>{{.Label}}</strong><small>{{.UserName}} · {{.StartsAt.Format "2006-01-02 15:04"}} to {{.EndsAt.Format "2006-01-02 15:04"}} UTC</small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/on-call"><input type="hidden" name="action" value="delete"><input type="hidden" name="shiftId" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Remove shift <span class="sr-only">{{.Label}}</span></button></form></li>{{else}}<li><small>No on-call shifts configured.</small></li>{{end}}</ul></section></section>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-agent-settings service-knowledge-settings" id="knowledge-base" aria-labelledby="knowledge-base-heading"><header><div><span class="eyebrow">Self service</span><h2 id="knowledge-base-heading">Knowledge base</h2><p>Link Confluence spaces whose published pages should appear as portal suggestions.</p></div></header><ul>{{range .Data.KnowledgeSpaces}}<li><span><strong>{{.Name}}</strong><small>{{.Key}} · {{if .Private}}Private space{{else}}Public space{{end}}</small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/knowledge"><input type="hidden" name="spaceId" value="{{.ID}}">{{if index $.Data.KnowledgeSpaceLinks .ID}}<input type="hidden" name="linked" value="false"><button class="btn" type="submit">Unlink knowledge base<span class="sr-only"> {{.Name}}</span></button>{{else}}<input type="hidden" name="linked" value="true"><button class="btn" type="submit">Link knowledge base<span class="sr-only"> {{.Name}}</span></button>{{end}}</form></li>{{else}}<li><span><strong>No knowledge spaces</strong><small>Create a Confluence space before linking portal articles.</small></span></li>{{end}}</ul></section>{{end}}
{{if and .Data.CanAdmin .Data.Desk}}<section class="surface-card service-sla-settings" id="sla-settings" aria-labelledby="sla-settings-heading"><header><span class="eyebrow">Service targets</span><h2 id="sla-settings-heading">Calendar and SLA goals</h2><p>Elapsed time counts only inside the configured working window and skips holidays.</p></header>{{with .Data.Calendar}}<form class="service-calendar-form" method="post" action="/service/agent/{{$.Data.Desk.ID}}/calendar"><label>Name<input name="name" value="{{.Name}}" maxlength="255" required></label><label>Time zone<input name="timeZone" value="{{.TimeZone}}" required></label><label>Starts<input name="start" type="time" value="{{clockMinute .StartMinute}}" required></label><label>Ends<input name="end" type="time" value="{{clockMinute .EndMinute}}" required></label><fieldset><legend>Working days</legend><label><input type="checkbox" name="weekday" value="1" {{if workingDay .Weekdays 1}}checked{{end}}> Mon</label><label><input type="checkbox" name="weekday" value="2" {{if workingDay .Weekdays 2}}checked{{end}}> Tue</label><label><input type="checkbox" name="weekday" value="3" {{if workingDay .Weekdays 3}}checked{{end}}> Wed</label><label><input type="checkbox" name="weekday" value="4" {{if workingDay .Weekdays 4}}checked{{end}}> Thu</label><label><input type="checkbox" name="weekday" value="5" {{if workingDay .Weekdays 5}}checked{{end}}> Fri</label><label><input type="checkbox" name="weekday" value="6" {{if workingDay .Weekdays 6}}checked{{end}}> Sat</label><label><input type="checkbox" name="weekday" value="7" {{if workingDay .Weekdays 7}}checked{{end}}> Sun</label></fieldset><button class="btn" type="submit">Save calendar</button></form>{{end}}<section class="service-calendar-holidays" aria-labelledby="calendar-holidays-heading"><h3 id="calendar-holidays-heading">Holidays</h3><form method="post" action="/service/agent/{{.Data.Desk.ID}}/calendar/holidays"><label for="calendar-holiday-day">Holiday date</label><input id="calendar-holiday-day" name="day" type="date" required><label for="calendar-holiday-name">Holiday name</label><input id="calendar-holiday-name" name="name" maxlength="255" required><button class="btn" type="submit">Add holiday</button></form><ul>{{range .Data.CalendarHolidays}}<li><span><strong>{{.Name}}</strong><small><time datetime="{{.Day}}">{{.Day}}</time></small></span><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/calendar/holidays"><input type="hidden" name="action" value="delete"><input type="hidden" name="day" value="{{.Day}}"><button class="btn btn-subtle" type="submit">Remove holiday <span class="sr-only">{{.Name}}</span></button></form></li>{{else}}<li><small>No calendar holidays configured.</small></li>{{end}}</ul></section><div class="service-sla-goals">{{range .Data.SLAMetrics}}<form method="post" action="/service/agent/{{$.Data.Desk.ID}}/sla/{{.ID}}"><label for="sla-goal-{{.ID}}"><strong>{{.Name}}</strong><small>{{if eq .Kind "first_response"}}Stops at the first public agent reply.{{else}}Stops when the request reaches Done.{{end}}</small></label><div><input id="sla-goal-{{.ID}}" name="goalMinutes" type="number" min="1" max="525600" value="{{slaMinutes .GoalMillis}}" required><span>minutes</span><button class="btn" type="submit">Save default goal</button></div></form>{{end}}</div><div class="service-conditional-goals">{{range .Data.SLAMetrics}}{{$metric := .}}<section aria-labelledby="conditional-goals-{{.ID}}"><h3 id="conditional-goals-{{.ID}}">{{.Name}} conditions</h3><p>Rules are evaluated in order; the first matching JQL goal wins.</p><form class="service-conditional-goal-create" method="post" action="/service/agent/{{$.Data.Desk.ID}}/sla/{{.ID}}/goals"><label for="sla-goal-name-{{.ID}}">Goal name</label><input id="sla-goal-name-{{.ID}}" name="name" maxlength="255" required><label for="sla-goal-jql-{{.ID}}">JQL condition</label><textarea id="sla-goal-jql-{{.ID}}" name="jql" rows="2" maxlength="2000" required></textarea><label for="sla-goal-minutes-{{.ID}}">Minutes</label><input id="sla-goal-minutes-{{.ID}}" name="goalMinutes" type="number" min="1" max="525600" required><button class="btn" type="submit">Add conditional goal</button></form><div class="service-conditional-goal-list">{{range index $.Data.SLAGoals .ID}}{{if .JQL}}<article><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/sla/{{$metric.ID}}/goals"><input type="hidden" name="action" value="update"><input type="hidden" name="goalId" value="{{.ID}}"><label for="conditional-goal-name-{{.ID}}">Goal name</label><input id="conditional-goal-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="255" required><label for="conditional-goal-jql-{{.ID}}">JQL condition</label><textarea id="conditional-goal-jql-{{.ID}}" name="jql" rows="2" maxlength="2000" required>{{.JQL}}</textarea><label for="conditional-goal-minutes-{{.ID}}">Minutes</label><input id="conditional-goal-minutes-{{.ID}}" name="goalMinutes" type="number" min="1" max="525600" value="{{slaMinutes .GoalMillis}}" required><button class="btn" type="submit">Save conditional goal</button></form><form method="post" action="/service/agent/{{$.Data.Desk.ID}}/sla/{{$metric.ID}}/goals"><input type="hidden" name="action" value="delete"><input type="hidden" name="goalId" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Delete conditional goal <span class="sr-only">{{.Name}}</span></button></form></article>{{end}}{{end}}</div></section>{{end}}</div></section>{{end}}
{{template "service_end" .}}{{end}}

{{define "page_service_reports"}}{{template "service_start" .}}
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/service/agent/{{.Data.Desk.ID}}">Queues</a><span aria-hidden="true">/</span><span aria-current="page">Reports</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Desk.ProjectKey}} service management</span><h1>Service reports</h1><p>Request demand, delivery health, SLA outcomes, and customer satisfaction.</p></div><a class="btn" href="/service/agent/{{.Data.Desk.ID}}">Back to queues</a></header>
<nav class="project-tabs" aria-label="Report window"><a href="?days=7&amp;requestType={{urlquery .Data.ReportFilter.RequestTypeID}}&amp;channel={{urlquery .Data.ReportFilter.Channel}}&amp;status={{urlquery .Data.ReportFilter.Status}}" {{if eq .Data.Report.WindowDays 7}}aria-current="page"{{end}}>7 days</a><a href="?days=30&amp;requestType={{urlquery .Data.ReportFilter.RequestTypeID}}&amp;channel={{urlquery .Data.ReportFilter.Channel}}&amp;status={{urlquery .Data.ReportFilter.Status}}" {{if eq .Data.Report.WindowDays 30}}aria-current="page"{{end}}>30 days</a><a href="?days=90&amp;requestType={{urlquery .Data.ReportFilter.RequestTypeID}}&amp;channel={{urlquery .Data.ReportFilter.Channel}}&amp;status={{urlquery .Data.ReportFilter.Status}}" {{if eq .Data.Report.WindowDays 90}}aria-current="page"{{end}}>90 days</a></nav>
<form class="surface-card service-report-filters" method="get"><input type="hidden" name="days" value="{{.Data.Report.WindowDays}}"><label for="report-request-type">Request type<select id="report-request-type" name="requestType"><option value="">All request types</option>{{range .Data.RequestTypes}}<option value="{{.ID}}" {{if eq .ID $.Data.ReportFilter.RequestTypeID}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label for="report-channel">Channel<select id="report-channel" name="channel"><option value="">All channels</option>{{range .Data.ReportChannels}}<option value="{{.}}" {{if eq . $.Data.ReportFilter.Channel}}selected{{end}}>{{.}}</option>{{end}}</select></label><label for="report-status">Status<select id="report-status" name="status"><option value="">All statuses</option><option value="open" {{if eq .Data.ReportFilter.Status "open"}}selected{{end}}>Open</option><option value="resolved" {{if eq .Data.ReportFilter.Status "resolved"}}selected{{end}}>Resolved</option></select></label><button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-subtle" href="?days={{.Data.Report.WindowDays}}">Clear filters</a></form>
<section class="service-report-metrics" aria-label="Service report summary"><article class="surface-card"><span>Total requests</span><strong>{{.Data.Report.TotalRequests}}</strong></article><article class="surface-card"><span>Open requests</span><strong>{{.Data.Report.OpenRequests}}</strong></article><article class="surface-card"><span>Resolved requests</span><strong>{{.Data.Report.ResolvedRequests}}</strong></article><article class="surface-card"><span>Requests with breached SLAs</span><strong>{{.Data.Report.BreachedRequests}}</strong></article><article class="surface-card"><span>Customer satisfaction</span><strong>{{printf "%.1f" .Data.Report.AverageSatisfaction}} / 5</strong><small>{{.Data.Report.SatisfactionResponses}} responses</small></article></section>
<section class="service-report-segments" aria-label="Request breakdowns"><article class="surface-card"><h2>Request types</h2><table><thead><tr><th scope="col">Request type</th><th scope="col">Requests</th></tr></thead><tbody>{{range .Data.Report.RequestTypes}}<tr><td>{{.Name}}</td><td>{{.Count}}</td></tr>{{else}}<tr><td colspan="2">No matching requests</td></tr>{{end}}</tbody></table></article><article class="surface-card"><h2>Channels</h2><table><thead><tr><th scope="col">Channel</th><th scope="col">Requests</th></tr></thead><tbody>{{range .Data.Report.Channels}}<tr><td>{{.Name}}</td><td>{{.Count}}</td></tr>{{else}}<tr><td colspan="2">No matching requests</td></tr>{{end}}</tbody></table></article></section>
<section class="surface-card service-volume-report" aria-labelledby="service-volume-heading"><header><span class="eyebrow">Demand</span><h2 id="service-volume-heading">Requests created by day</h2></header><div class="service-volume-chart" style="--service-report-days:{{len .Data.ReportDays}}" role="img" aria-label="Daily request volume for the selected {{.Data.Report.WindowDays}} day period">{{range .Data.ReportDays}}<div class="service-volume-bar"><span style="--service-volume:{{.Width}}%"></span><small>{{.Day}}</small><strong>{{.Count}}</strong></div>{{end}}</div><div class="service-report-table" role="region" aria-label="Daily request volume data" tabindex="0"><table><thead><tr><th scope="col">Date</th><th scope="col">Requests created</th></tr></thead><tbody>{{range .Data.ReportDays}}<tr><td>{{.Day}}</td><td>{{.Count}}</td></tr>{{end}}</tbody></table></div></section>
{{template "service_end" .}}{{end}}

{{define "service_request_followup"}}<div class="service-request-followup"><section class="surface-card" id="notifications"><h2>Request notifications</h2><p>{{if .Data.Subscribed}}You receive updates for this request.{{else}}Updates for this request are muted.{{end}}</p><form method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/notification"><input type="hidden" name="subscribed" value="{{if .Data.Subscribed}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.Subscribed}}Stop notifications{{else}}Get notifications{{end}}</button></form></section><section class="surface-card" id="feedback"><h2>Satisfaction</h2>{{with .Data.Feedback}}<p><strong>{{.Rating}} out of 5</strong>{{if .Comment}} · {{.Comment}}{{end}}</p>{{if $.Data.CanLeaveFeedback}}<form class="service-feedback-form" method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/feedback"><label for="feedback-rating">Satisfaction rating</label><input id="feedback-rating" name="rating" type="number" min="1" max="5" value="{{.Rating}}" required><label for="feedback-comment">Feedback comment</label><textarea id="feedback-comment" name="comment" maxlength="4000" rows="3">{{.Comment}}</textarea><button class="btn" type="submit">Update feedback</button></form><form method="post" action="/service/requests/{{$.Data.Request.Issue.Key}}/feedback"><input type="hidden" name="action" value="delete"><button class="btn btn-subtle" type="submit">Delete feedback</button></form>{{end}}{{else}}{{if .Data.CanLeaveFeedback}}<p>How did the service team do?</p><form class="service-feedback-form" method="post" action="/service/requests/{{.Data.Request.Issue.Key}}/feedback"><label for="feedback-rating">Satisfaction rating</label><input id="feedback-rating" name="rating" type="number" min="1" max="5" value="5" required><label for="feedback-comment">Feedback comment</label><textarea id="feedback-comment" name="comment" maxlength="4000" rows="3" placeholder="Tell us what worked well or could improve."></textarea><button class="btn btn-primary" type="submit">Save feedback</button></form>{{else}}<small>Feedback is available to the reporter after the request is completed.</small>{{end}}{{end}}</section></div>{{end}}
