{{define "page_custom_fields"}}
<!doctype html><html lang="en"><head><title>Custom fields · {{(site $).Title}}</title>{{template "head" .}}</head>
<body class="page-screens"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Custom fields</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Custom fields</h1><p>A context decides where a custom field applies and what it starts as.</p></div><a class="btn" href="/settings/field-configurations">Field configurations</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card" aria-labelledby="custom-field-create-heading"><div><h2 id="custom-field-create-heading">Create custom field</h2><p>A new field starts with a context covering every project and work type.</p></div><form class="project-details-form" method="post" action="/settings/custom-fields"><input type="hidden" name="action" value="create"><label for="custom-field-name-new">Name</label><input id="custom-field-name-new" name="name" maxlength="255" required><label for="custom-field-type-new">Type</label><select id="custom-field-type-new" name="type">{{range .Data.FieldTypes}}<option value="{{.Type}}">{{.Name}}</option>{{end}}</select><label for="custom-field-description-new">Description</label><input id="custom-field-description-new" name="description" maxlength="4000"><button class="btn btn-primary" type="submit">Create custom field</button></form></section>
<div class="screen-list">{{range .Data.Fields}}{{$card := .}}<article class="surface-card screen-card custom-field-card" data-field-id="{{.Field.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Contexts}}</span><div><h2>{{.Field.Name}}</h2><p>{{.Field.ID}} · {{.Field.Type}}</p></div></div><span class="lozenge">{{len .Contexts}} contexts</span></header>
<form class="project-details-form custom-field-details" method="post" action="/settings/custom-fields"><input type="hidden" name="action" value="update"><input type="hidden" name="field" value="{{.Field.ID}}"><label for="custom-field-name-{{.Field.ID}}">Name</label><input id="custom-field-name-{{.Field.ID}}" name="name" value="{{.Field.Name}}" maxlength="255" required><label for="custom-field-description-{{.Field.ID}}">Description</label><input id="custom-field-description-{{.Field.ID}}" name="description" value="{{.Field.Description}}" maxlength="4000"><button class="btn" type="submit">Save field</button></form>{{if not .Field.AppKey}}<form method="post" action="/settings/custom-fields"><input type="hidden" name="action" value="trash"><input type="hidden" name="field" value="{{.Field.ID}}"><button class="btn btn-subtle" type="submit">Move to trash<span class="sr-only"> {{.Field.Name}}</span></button></form>{{end}}
<div class="screen-tab-list">{{range .Contexts}}{{$view := .}}<article class="screen-tab-card custom-field-context" data-context-id="{{.Context.ID}}"><header><div><h3>{{.Context.Name}}</h3><p>{{.Context.Description}}</p></div><span class="lozenge">{{if .Context.AllProjects}}All projects{{else}}{{len .Projects}} projects{{end}} · {{if .Context.AllIssueTypes}}All work types{{else}}{{len .Types}} work types{{end}}</span></header>
<div class="screen-field-ledger" role="table" aria-label="Scope of {{.Context.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Scope</span><span role="columnheader">Applies to</span><span role="columnheader">Action</span></div>
<div class="screen-field-row context-project-row" role="row"><span role="cell"><strong>Projects</strong></span><span role="cell"><small>{{if .Context.AllProjects}}Every project{{else}}{{range .Projects}}{{.Key}} {{end}}{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="add-project"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-project-{{.Context.ID}}">Add a project to {{.Context.Name}}</label><select id="context-project-{{.Context.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn btn-subtle" type="submit">Add project</button></form></div>
<div class="screen-field-row context-type-row" role="row"><span role="cell"><strong>Work types</strong></span><span role="cell"><small>{{if .Context.AllIssueTypes}}Every work type{{else}}{{range .Types}}{{.}} {{end}}{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="add-issue-type"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-type-{{.Context.ID}}">Add a work type to {{.Context.Name}}</label><select id="context-type-{{.Context.ID}}" name="issueType">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-subtle" type="submit">Add work type</button></form></div>
<div class="screen-field-row context-default-row" role="row"><span role="cell"><strong>Default value</strong></span><span role="cell"><small>{{if .Context.DefaultValue}}{{.Context.DefaultValue}}{{else}}None{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="set-default"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-default-{{.Context.ID}}">Default value for {{.Context.Name}}</label><input id="context-default-{{.Context.ID}}" name="defaultValue" maxlength="255"><button class="btn btn-subtle" type="submit">Save default</button></form></div>{{if eq $card.Field.Type "cmdb"}}<div class="screen-field-row context-assets-row" role="row"><span role="cell"><strong>Assets objects</strong></span><span role="cell"><small>{{if .Context.AssetsMultiple}}Several objects{{else}}One object{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="assets-multiple"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label for="context-assets-{{.Context.ID}}"><input id="context-assets-{{.Context.ID}}" type="checkbox" name="assetsMultiple" {{if .Context.AssetsMultiple}}checked{{end}}> Hold several objects</label><button class="btn btn-subtle" type="submit">Save Assets objects</button></form></div>{{end}}</div>
{{if .IsSelect}}<div class="screen-field-ledger context-option-ledger" role="table" aria-label="Options in {{.Context.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Option</span><span role="columnheader">State</span><span role="columnheader">Order</span><span role="columnheader">Action</span></div>{{range .Options}}<div class="screen-field-row context-option-row" role="row" data-option-id="{{.ID}}"><span role="cell"><strong>{{.Value}}</strong>{{if .ParentValue}}<small> under {{.ParentValue}}</small>{{end}}</span><span role="cell"><small>{{if .Disabled}}Disabled{{else}}Available{{end}}</small></span><span role="cell" class="context-option-order"><form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="move-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><input type="hidden" name="direction" value="up"><button class="btn btn-subtle" type="submit">Move up<span class="sr-only"> {{.Value}}</span></button></form><form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="move-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><input type="hidden" name="direction" value="down"><button class="btn btn-subtle" type="submit">Move down<span class="sr-only"> {{.Value}}</span></button></form><form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="move-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><input type="hidden" name="direction" value="first"><button class="btn btn-subtle" type="submit">Move first<span class="sr-only"> {{.Value}}</span></button></form><form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="move-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><input type="hidden" name="direction" value="last"><button class="btn btn-subtle" type="submit">Move last<span class="sr-only"> {{.Value}}</span></button></form></span><span role="cell" class="context-option-actions"><form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="disable-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><input type="hidden" name="value" value="{{.Value}}"><input type="hidden" name="disabled" value="{{if .Disabled}}false{{else}}true{{end}}"><button class="btn btn-subtle" type="submit">{{if .Disabled}}Enable{{else}}Disable{{end}}<span class="sr-only"> {{.Value}}</span></button></form><details><summary class="btn btn-subtle">Delete<span class="sr-only"> {{.Value}}</span></summary><form class="project-details-form" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="delete-option"><input type="hidden" name="contextId" value="{{$view.Context.ID}}"><input type="hidden" name="optionId" value="{{.ID}}"><p>An option work items still hold is removed only when they are given another one.</p><label for="context-option-replace-{{.ID}}">Replace it on work items with</label><select id="context-option-replace-{{.ID}}" name="replaceWith"><option value="">Nothing — refuse if the option is in use</option>{{$current := .ID}}{{range $view.Options}}{{if ne .ID $current}}<option value="{{.ID}}">{{.Value}}{{if .ParentValue}} (under {{.ParentValue}}){{end}}</option>{{end}}{{end}}</select><button class="btn" type="submit">Delete option</button></form></details></span></div>{{else}}<div class="empty-state"><strong>No options</strong><small>Add one so the field can be filled in.</small></div>{{end}}</div>
<form class="context-option-create project-details-form" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="add-option"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label for="context-option-{{.Context.ID}}">Add an option</label><input id="context-option-{{.Context.ID}}" name="value" maxlength="255" required>{{if .Cascading}}<label for="context-option-parent-{{.Context.ID}}">Under</label><select id="context-option-parent-{{.Context.ID}}" name="parentId"><option value="">No parent — a first-level option</option>{{range .Parents}}<option value="{{.ID}}">{{.Value}}</option>{{end}}</select>{{end}}<button class="btn" type="submit">Add option</button></form>{{end}}
<details class="screen-tab-edit"><summary>Narrow or remove this context</summary><div>{{if not .Context.AllProjects}}<form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="remove-project"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label for="context-remove-project-{{.Context.ID}}">Remove a project</label><select id="context-remove-project-{{.Context.ID}}" name="project">{{range .Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Remove project</button></form>{{end}}
<form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="contextId" value="{{.Context.ID}}"><p>A custom field keeps at least one context.</p><button class="btn btn-danger" type="submit">Delete context</button></form></div></details></article>{{end}}</div>
<form class="screen-level-create project-details-form" method="post" action="/settings/custom-fields/{{.Field.ID}}"><input type="hidden" name="action" value="create"><h4>Add a context</h4><label for="context-name-{{.Field.ID}}">Context name</label><input id="context-name-{{.Field.ID}}" name="name" maxlength="255" required><label for="context-description-{{.Field.ID}}">Description</label><textarea id="context-description-{{.Field.ID}}" name="description" rows="2" maxlength="255"></textarea><label for="context-new-project-{{.Field.ID}}">Projects</label><select id="context-new-project-{{.Field.ID}}" name="project" multiple size="3">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><label for="context-new-type-{{.Field.ID}}">Work types</label><select id="context-new-type-{{.Field.ID}}" name="issueType" multiple size="3">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Add context</button></form></article>{{else}}<section class="surface-card empty-state"><strong>No custom fields</strong><small>Create one through the field API to give it a context.</small></section>{{end}}</div>
<section class="surface-card" aria-labelledby="custom-field-trash-heading"><div><h2 id="custom-field-trash-heading">Trash</h2><p>A trashed field keeps its values and stays off every form until it is restored. Deleting it removes its values for good.</p></div><ul class="metadata-scheme-summary">{{range .Data.Trashed}}<li data-trashed-field-id="{{.ID}}"><strong>{{.Name}}</strong><small>{{.ID}} · {{.Type}}</small><div class="metadata-card-actions"><form method="post" action="/settings/custom-fields"><input type="hidden" name="action" value="restore"><input type="hidden" name="field" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Restore<span class="sr-only"> {{.Name}}</span></button></form><form method="post" action="/settings/custom-fields"><input type="hidden" name="action" value="delete"><input type="hidden" name="field" value="{{.ID}}"><button class="btn btn-danger" type="submit">Delete<span class="sr-only"> {{.Name}}</span></button></form></div></li>{{else}}<li class="empty-state"><strong>Trash is empty</strong><small>No custom field is waiting to be restored or deleted.</small></li>{{end}}</ul></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
