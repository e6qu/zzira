{{define "page_custom_fields"}}
<!doctype html><html lang="en"><head><title>Custom fields · ZZIRA</title>{{template "head" .}}</head>
<body class="page-screens"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Custom fields</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Custom fields</h1><p>A context decides where a custom field applies and what it starts as.</p></div><a class="btn" href="/settings/field-configurations">Field configurations</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<div class="screen-list">{{range .Data.Fields}}{{$card := .}}<article class="surface-card screen-card custom-field-card" data-field-id="{{.Field.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Contexts}}</span><div><h2>{{.Field.Name}}</h2><p>{{.Field.ID}} · {{.Field.Type}}</p></div></div><span class="lozenge">{{len .Contexts}} contexts</span></header>
<div class="screen-tab-list">{{range .Contexts}}{{$view := .}}<article class="screen-tab-card custom-field-context" data-context-id="{{.Context.ID}}"><header><div><h3>{{.Context.Name}}</h3><p>{{.Context.Description}}</p></div><span class="lozenge">{{if .Context.AllProjects}}All projects{{else}}{{len .Projects}} projects{{end}} · {{if .Context.AllIssueTypes}}All work types{{else}}{{len .Types}} work types{{end}}</span></header>
<div class="screen-field-ledger" role="table" aria-label="Scope of {{.Context.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Scope</span><span role="columnheader">Applies to</span><span role="columnheader">Action</span></div>
<div class="screen-field-row context-project-row" role="row"><span role="cell"><strong>Projects</strong></span><span role="cell"><small>{{if .Context.AllProjects}}Every project{{else}}{{range .Projects}}{{.Key}} {{end}}{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="add-project"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-project-{{.Context.ID}}">Add a project to {{.Context.Name}}</label><select id="context-project-{{.Context.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn btn-subtle" type="submit">Add project</button></form></div>
<div class="screen-field-row context-type-row" role="row"><span role="cell"><strong>Work types</strong></span><span role="cell"><small>{{if .Context.AllIssueTypes}}Every work type{{else}}{{range .Types}}{{.}} {{end}}{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="add-issue-type"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-type-{{.Context.ID}}">Add a work type to {{.Context.Name}}</label><select id="context-type-{{.Context.ID}}" name="issueType">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-subtle" type="submit">Add work type</button></form></div>
<div class="screen-field-row context-default-row" role="row"><span role="cell"><strong>Default value</strong></span><span role="cell"><small>{{if .Context.DefaultValue}}{{.Context.DefaultValue}}{{else}}None{{end}}</small></span><form role="cell" method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="set-default"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label class="sr-only" for="context-default-{{.Context.ID}}">Default value for {{.Context.Name}}</label><input id="context-default-{{.Context.ID}}" name="defaultValue" maxlength="255"><button class="btn btn-subtle" type="submit">Save default</button></form></div></div>
<details class="screen-tab-edit"><summary>Narrow or remove this context</summary><div>{{if not .Context.AllProjects}}<form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="remove-project"><input type="hidden" name="contextId" value="{{.Context.ID}}"><label for="context-remove-project-{{.Context.ID}}">Remove a project</label><select id="context-remove-project-{{.Context.ID}}" name="project">{{range .Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Remove project</button></form>{{end}}
<form method="post" action="/settings/custom-fields/{{$card.Field.ID}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="contextId" value="{{.Context.ID}}"><p>A custom field keeps at least one context.</p><button class="btn btn-danger" type="submit">Delete context</button></form></div></details></article>{{end}}</div>
<form class="screen-level-create project-details-form" method="post" action="/settings/custom-fields/{{.Field.ID}}"><input type="hidden" name="action" value="create"><h4>Add a context</h4><label for="context-name-{{.Field.ID}}">Context name</label><input id="context-name-{{.Field.ID}}" name="name" maxlength="255" required><label for="context-description-{{.Field.ID}}">Description</label><textarea id="context-description-{{.Field.ID}}" name="description" rows="2" maxlength="255"></textarea><label for="context-new-project-{{.Field.ID}}">Projects</label><select id="context-new-project-{{.Field.ID}}" name="project" multiple size="3">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><label for="context-new-type-{{.Field.ID}}">Work types</label><select id="context-new-type-{{.Field.ID}}" name="issueType" multiple size="3">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Add context</button></form></article>{{else}}<section class="surface-card empty-state"><strong>No custom fields</strong><small>Create one through the field API to give it a context.</small></section>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
