{{define "page_wiki_smart_link"}}{{template "wiki_start" .}}
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/wiki">Wiki</a><span aria-hidden="true">/</span><a href="/wiki/spaces/{{.Data.Space.ID}}">{{.Data.Space.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Link.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Smart Link</span><h1>{{.Data.Link.Title}}</h1><p>{{if .Data.Host}}{{.Data.Host}}{{else}}No destination{{end}}{{if .Data.ParentTitle}} · Inside {{.Data.Link.ParentTypeName}} {{.Data.ParentTitle}}{{end}}</p></div><div class="page-header-actions">{{if and .Data.Link.EmbedURL (eq .Data.Link.Status "current")}}<a class="btn btn-primary" href="{{.Data.Link.EmbedURL}}" target="_blank" rel="noopener noreferrer">Open link</a>{{end}}</div></header>
{{if eq .Data.Link.Status "archived"}}<section class="surface-card wiki-archived-notice" role="status" aria-label="Archived Smart Link"><strong>This Smart Link is archived.</strong><span>It no longer appears in the space's content tree.</span>{{if .Data.CanRestore}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/content/{{.Data.Link.ID}}/restore"><button class="btn" type="submit">Restore Smart Link</button></form>{{end}}</section>{{end}}
<section class="surface-card wiki-smart-link-card" aria-labelledby="wiki-smart-link-heading"><header><div><span class="eyebrow">Destination</span><h2 id="wiki-smart-link-heading">Link details</h2></div></header>
<dl class="wiki-smart-link-details"><div><dt>Address</dt><dd>{{if .Data.Link.EmbedURL}}<code>{{.Data.Link.EmbedURL}}</code>{{else}}None{{end}}</dd></div><div><dt>Created</dt><dd><time datetime="{{.Data.Link.CreatedAt}}">{{.Data.Link.CreatedAt}}</time></dd></div><div><dt>Version</dt><dd>{{.Data.Link.Version.Number}}</dd></div></dl>
{{if .Data.Previewable}}<iframe class="wiki-smart-link-preview" src="{{.Data.Link.EmbedURL}}" title="Preview of {{.Data.Link.Title}}" sandbox="allow-scripts allow-same-origin allow-popups" referrerpolicy="no-referrer" loading="lazy"></iframe><small>Some sites refuse to be shown inside other pages. Use Open link if the preview stays empty.</small>{{else if .Data.Link.EmbedURL}}<small>Only HTTPS destinations are previewed.</small>{{end}}</section>
{{template "wiki_end" .}}{{end}}
