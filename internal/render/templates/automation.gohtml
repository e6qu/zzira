{{define "page_automation_rules"}}
<!doctype html><html lang="en"><head><title>Automation · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/automation.css?v=3"></head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}
<main class="page page-fluid automation-directory" id="main-content" tabindex="-1">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb"><span>Settings</span><span aria-hidden="true">/</span><span aria-current="page">Automation</span></nav>
  <header class="page-header"><div><span class="eyebrow">Workspace automation</span><h1>Automation rules</h1><p>Run repeatable work on a schedule or when work changes, and inspect every execution.</p></div><div class="automation-header-actions"><a class="btn" href="/settings/automation/templates">Browse templates</a><a class="btn btn-primary" href="/settings/automation/new">Create rule</a></div></header>
  <div class="automation-summary-strip"><span><strong>{{len .Data.Rules}}</strong> rules</span><span>Cloud ID <code>{{.Data.CloudID}}</code></span><a href="https://developer.atlassian.com/cloud/automation/rest/">Automation API reference</a></div>
  <section class="surface-card automation-rule-list" aria-label="Automation rules">
    {{range .Data.Rules}}<article class="automation-rule-row">
      <span class="automation-rule-mark state-{{.Rule.State}}" aria-hidden="true"></span>
      <div><h2><a href="/settings/automation/{{.Rule.UUID}}">{{.Rule.Name}}</a></h2><p>{{if .Rule.Description}}{{.Rule.Description}}{{else}}No description{{end}}</p><small>{{.Trigger}}{{if .Schedule}} · {{.Schedule}}{{end}}{{if .NextRun}} · Next run {{.NextRun}}{{end}}</small></div>
      <span class="lozenge automation-state state-{{.Rule.State}}">{{.Rule.State}}</span><a class="btn" href="/settings/automation/{{.Rule.UUID}}">Open<span class="sr-only"> {{.Rule.Name}}</span></a>
    </article>{{else}}<div class="empty-state"><h2>No automation rules</h2><p>Create a rule to update work items on a schedule or when they change.</p><a class="btn btn-primary" href="/settings/automation/new">Create your first rule</a></div>{{end}}
  </section>
</main></div><div id="modal-root"></div></body></html>
{{end}}

{{define "page_automation_rule"}}
<!doctype html><html lang="en"><head><title>{{if .Data.IsNew}}Create automation rule{{else}}{{.Data.Rule.Name}}{{end}} · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/automation.css?v=3"></head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}
<main class="page page-fluid automation-editor" id="main-content" tabindex="-1">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/settings/automation">Automation</a><span aria-hidden="true">/</span><span aria-current="page">{{if .Data.IsNew}}Create rule{{else}}{{.Data.Rule.Name}}{{end}}</span></nav>
  <header class="automation-editor-header"><div><span class="eyebrow">{{if .Data.IsNew}}New rule{{else}}Rule editor{{end}}</span><h1>{{if .Data.IsNew}}Create automation rule{{else}}{{.Data.Rule.Name}}{{end}}</h1><p>Review the trigger, scope, and actions as one flow before you enable it.</p></div>
  {{if not .Data.IsNew}}<div class="automation-header-actions"><form method="post" action="{{.Data.FormAction}}"><input type="hidden" name="operation" value="run"><button class="btn" type="submit" {{if ne .Data.Rule.State "ENABLED"}}disabled{{end}}>Run now</button></form><form method="post" action="{{.Data.FormAction}}">{{if eq .Data.Rule.State "ENABLED"}}<input type="hidden" name="operation" value="disable"><button class="btn" type="submit">Disable</button>{{else}}<input type="hidden" name="operation" value="enable"><button class="btn btn-primary" type="submit">Enable</button>{{end}}</form></div>{{end}}</header>
  {{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
  <form class="automation-rule-form" method="post" action="{{.Data.FormAction}}">
    <input type="hidden" name="operation" value="save">
    <section class="surface-card automation-rule-details"><div class="section-heading"><div><span class="eyebrow">Rule details</span><h2>Name and owner</h2></div>{{if not .Data.IsNew}}<span class="lozenge automation-state state-{{.Data.Rule.State}}">{{.Data.Rule.State}}</span>{{end}}</div>
      <div class="automation-detail-grid"><label>Rule name<input name="name" value="{{.Data.Rule.Name}}" maxlength="255" required></label><label>Rule actor<select name="actor_id" required>{{range .Data.Members}}<option value="{{.ID}}" {{if eq $.Data.Rule.ActorID .ID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select></label></div>
      <label>Description<textarea name="description" rows="2" maxlength="16000">{{.Data.Rule.Description}}</textarea></label>
      <input type="hidden" name="state" value="{{.Data.Rule.State}}">
    </section>
    <div class="automation-flow" aria-label="Automation rule flow">
      <section class="surface-card automation-flow-node"><header><span class="automation-step">1</span><div><span class="eyebrow">When</span><h2>Trigger</h2></div></header>
        <label>Trigger<select name="trigger_type">{{range .Data.Triggers}}<option value="{{.Value}}" {{if eq $.Data.Trigger.Type .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label>
        <fieldset class="automation-trigger-options"><legend>Scheduled</legend><div class="automation-node-fields"><label>Run every<input type="number" name="interval_minutes" min="1" max="43200" value="{{with .Data.Rule.IntervalMinutes}}{{.}}{{end}}"><small>Minutes, from 1 to 43,200.</small></label><label>Timezone<input name="timezone" value="{{.Data.Rule.ScheduleTimezone}}" placeholder="UTC"><small>Use an IANA name such as Europe/Bucharest.</small></label><label>Cron expression<input name="cron_expression" value="{{.Data.Rule.CronExpression}}" placeholder="0 0 9 ? * MON-FRI"><small>Quartz syntax such as 0 0 9 ? * MON-FRI, in the rule&#39;s time zone. Leave blank to use the interval instead.</small></label></div></fieldset>
        <fieldset class="automation-trigger-options"><legend>Work item transitioned</legend><div class="automation-node-fields"><label>From status<select name="from_status"><option value="">Any status</option>{{range .Data.Statuses}}<option value="{{.ID}}" {{if eq $.Data.Trigger.FromStatus .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>To status<select name="to_status"><option value="">Any status</option>{{range .Data.Statuses}}<option value="{{.ID}}" {{if eq $.Data.Trigger.ToStatus .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select></label></div></fieldset>
        <fieldset class="automation-trigger-options"><legend>Field value changed</legend><label>Fields<input name="changed_fields" value="{{.Data.Trigger.Fields}}" placeholder="summary, priority"><small>Comma-separated, such as summary, priority, assignee, labels or duedate.</small></label></fieldset>
        <label class="automation-toggle"><input type="checkbox" name="allow_rule_trigger" value="true" {{if .Data.Trigger.AllowRules}}checked{{end}}> Allow other rules to trigger this rule</label>
      </section>
      <span class="automation-connector" aria-hidden="true">→</span>
      <section class="surface-card automation-flow-node"><header><span class="automation-step">2</span><div><span class="eyebrow">For</span><h2>Work item scope</h2></div></header><label>JQL query<textarea name="jql" rows="4" maxlength="16000" placeholder="project = ZZ AND status != Done">{{.Data.Rule.JQL}}</textarea><small>Scheduled rules run on the work it matches, at most 1,000 items at once; event rules run only for work it matches. Blank matches all work the rule actor can see.</small></label><details><summary>Rule scope ARIs</summary><textarea name="scope_aris" rows="3" placeholder="ari:cloud:jira:{{.Data.CloudID}}:project/10000">{{range .Data.Rule.RuleScopeARIs}}{{.}}
{{end}}</textarea></details></section>
      <span class="automation-connector" aria-hidden="true">→</span>
      <section class="surface-card automation-flow-node automation-actions"><header><span class="automation-step">3</span><div><span class="eyebrow">If</span><h2>Conditions</h2></div></header>
        {{range $condition := .Data.Conditions}}<div class="automation-action-row"><span class="automation-node-icon" aria-hidden="true">?</span><div><label>Condition field<select name="condition_field"><option value="">No condition</option>{{range $.Data.ConditionFields}}<option value="{{.Value}}" {{if eq $condition.Field .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Comparison<select name="condition_operator">{{range $.Data.ConditionOperators}}<option value="{{.Value}}" {{if eq $condition.Operator .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Compared with<input name="condition_value" value="{{$condition.Value}}" placeholder="Name, account ID or text"></label></div></div>{{end}}
        <small>The rule continues only for work items where every condition holds.</small>
      </section>
      <span class="automation-connector" aria-hidden="true">→</span>
      <section class="surface-card automation-flow-node automation-actions"><header><span class="automation-step">4</span><div><span class="eyebrow">Then</span><h2>Actions</h2></div></header>
        {{range $action := .Data.Actions}}<div class="automation-action-row"><span class="automation-node-icon" aria-hidden="true">↳</span><div><label>Action<select name="action_type"><option value="">No action</option>{{range $.Data.ActionTypes}}<option value="{{.Value}}" {{if eq $action.Type .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Value<input name="action_value" value="{{$action.Value}}" list="automation-values" placeholder="Label, account ID, status ID, comment or text"></label></div></div>{{end}}
        <div class="automation-action-row automation-action-empty"><span class="automation-node-icon" aria-hidden="true">+</span><div><label>Additional action<select name="action_type"><option value="">No additional action</option>{{range .Data.ActionTypes}}<option value="{{.Value}}">{{.Name}}</option>{{end}}</select></label><label>Value<input name="action_value" list="automation-values" placeholder="Label, account ID, status ID, comment or text"></label></div></div>
        <small>Assignment accepts an account ID, <code>ACTOR</code> or <code>UNASSIGNED</code>; transition accepts a status ID. Values can use smart values such as <code>{{"{{"}}issue.key{{"}}"}}</code>, <code>{{"{{"}}issue.summary{{"}}"}}</code>, <code>{{"{{"}}initiator.displayName{{"}}"}}</code> and <code>{{"{{"}}now.jiraDate{{"}}"}}</code>.</small>
      </section>
      <span class="automation-connector" aria-hidden="true">→</span>
      <section class="surface-card automation-flow-node automation-actions"><header><span class="automation-step">5</span><div><span class="eyebrow">Then, for related work</span><h2>Branch</h2></div></header>
        <div class="automation-node-fields"><label>Related work items<select name="branch_related"><option value="">No branch</option>{{range .Data.RelatedTypes}}<option value="{{.Value}}" {{if eq $.Data.Branch.RelatedType .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Link types<input name="branch_link_types" value="{{.Data.Branch.LinkTypes}}" placeholder="blocks, relates to"><small>For linked work: comma-separated, as the work item reads the link, or link type names. Blank follows every link.</small></label></div>
        {{range $condition := .Data.Branch.Conditions}}<div class="automation-action-row"><span class="automation-node-icon" aria-hidden="true">?</span><div><label>Branch condition field<select name="branch_condition_field"><option value="">No branch condition</option>{{range $.Data.ConditionFields}}<option value="{{.Value}}" {{if eq $condition.Field .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Branch comparison<select name="branch_condition_operator">{{range $.Data.ConditionOperators}}<option value="{{.Value}}" {{if eq $condition.Operator .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Branch compared with<input name="branch_condition_value" value="{{$condition.Value}}" placeholder="Name, account ID or text"></label></div></div>{{end}}
        {{range $action := .Data.Branch.Actions}}<div class="automation-action-row"><span class="automation-node-icon" aria-hidden="true">↳</span><div><label>Branch action<select name="branch_action_type"><option value="">No action</option>{{range $.Data.ActionTypes}}<option value="{{.Value}}" {{if eq $action.Type .Value}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>Branch value<input name="branch_action_value" value="{{$action.Value}}" list="automation-values" placeholder="Label, account ID, status ID, comment or text"></label></div></div>{{end}}
        <div class="automation-action-row automation-action-empty"><span class="automation-node-icon" aria-hidden="true">+</span><div><label>Additional branch action<select name="branch_action_type"><option value="">No additional action</option>{{range .Data.ActionTypes}}<option value="{{.Value}}">{{.Name}}</option>{{end}}</select></label><label>Branch value<input name="branch_action_value" list="automation-values" placeholder="Label, account ID, status ID, comment or text"></label></div></div>
        <small>Branch actions run for each related work item the rule actor can see and every branch condition holds for. <code>{{"{{"}}issue.key{{"}}"}}</code> is the related work item and <code>{{"{{"}}triggerIssue.key{{"}}"}}</code> the one the rule started from.</small>
      </section>
    </div>
    <datalist id="automation-values"><option value="ACTOR"><option value="UNASSIGNED">{{range .Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{range .Data.Statuses}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</datalist>
    {{if .Data.Unsupported}}<p class="form-hint" role="note">The editor does not show {{.Data.Unsupported}}, so saving here is turned off to keep them. Change this rule through the Automation API.</p>{{end}}
    <div class="automation-save-bar"><a href="/settings/automation">Cancel</a><button class="btn btn-primary" type="submit" {{if .Data.Unsupported}}disabled{{end}}>{{if .Data.IsNew}}Create rule{{else}}Save rule{{end}}</button></div>
  </form>
  {{if not .Data.IsNew}}<section class="surface-card automation-audit"><div class="section-heading"><div><span class="eyebrow">Audit log</span><h2>Recent runs</h2></div><span>Last 25</span></div><div class="automation-audit-table" role="region" aria-label="Automation audit log" tabindex="0"><table><thead><tr><th scope="col">Run</th><th scope="col">Status</th><th scope="col">Matched</th><th scope="col">Changed</th><th scope="col">Attempts</th><th scope="col">Duration</th></tr></thead><tbody>{{range .Data.Runs}}<tr><th scope="row">{{.When}}</th><td><span class="lozenge run-{{.Run.State}}">{{.Run.State}}</span>{{if .Run.Detail}}<details><summary>Error details</summary><code>{{.Run.Detail}}</code></details>{{end}}</td><td>{{.Run.MatchedCount}}</td><td>{{.Run.ChangedCount}}</td><td>{{.Run.Attempts}}</td><td>{{.Duration}}</td></tr>{{else}}<tr><td colspan="6">This rule has not run yet.</td></tr>{{end}}</tbody></table></div></section>
  <details class="surface-card automation-danger"><summary>Delete rule</summary><p>Disable this rule before deleting it. Its audit history will also be removed.</p><form method="post" action="{{.Data.FormAction}}"><input type="hidden" name="operation" value="delete"><button class="btn btn-danger" type="submit" {{if ne .Data.Rule.State "DISABLED"}}disabled{{end}}>Delete rule permanently</button></form></details>{{end}}
</main></div><div id="modal-root"></div></body></html>
{{end}}

{{define "page_automation_templates"}}
<!doctype html><html lang="en"><head><title>Rule templates · Automation · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/automation.css?v=3"></head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}
<main class="page page-fluid automation-directory" id="main-content" tabindex="-1">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/settings/automation">Automation</a><span aria-hidden="true">/</span><span aria-current="page">Templates</span></nav>
  <header class="page-header"><div><span class="eyebrow">Workspace automation</span><h1>Rule templates</h1><p>Start from a ready-made rule and fill in what it needs.</p></div><a class="btn" href="/settings/automation/new">Create rule from scratch</a></header>
  {{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
  <div class="automation-template-grid">
  {{range $template := .Data.Templates}}<section class="surface-card automation-template" aria-labelledby="template-{{.ID}}">
    <h2 id="template-{{.ID}}">{{.Name}}</h2><p>{{.Description}}</p>
    <ul class="automation-template-categories" aria-label="{{.Name}} categories">{{range .Categories}}<li class="lozenge">{{.}}</li>{{end}}</ul>
    <form method="post" action="/settings/automation/templates" class="automation-template-form">
      <input type="hidden" name="template_id" value="{{.ID}}">
      <label for="template-{{.ID}}-name">Rule name</label><input id="template-{{.ID}}-name" name="name" value="{{if and (eq $.Data.Selected .ID) $.Data.Name}}{{$.Data.Name}}{{else}}{{.Name}}{{end}}" maxlength="255" required>
      <label for="template-{{.ID}}-home">Rule home</label><select id="template-{{.ID}}-home" name="rule_home"><option value="">Whole site</option>{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select>
      {{range .Parameters}}<label for="template-{{$template.ID}}-{{.Key}}">{{.Label}}{{if not .Required}} (optional){{end}}</label>{{if eq .Kind "member"}}<select id="template-{{$template.ID}}-{{.Key}}" name="param_{{.Key}}"{{if .Required}} required{{end}}><option value="">Choose a person</option>{{range $.Data.Members}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select>{{else if eq .Kind "status"}}<select id="template-{{$template.ID}}-{{.Key}}" name="param_{{.Key}}"{{if .Required}} required{{end}}><option value="">Choose a status</option>{{range $.Data.Statuses}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select>{{else if eq .Kind "number"}}<input id="template-{{$template.ID}}-{{.Key}}" type="number" min="1" name="param_{{.Key}}"{{if .Required}} required{{end}}>{{else}}<input id="template-{{$template.ID}}-{{.Key}}" name="param_{{.Key}}" maxlength="5000"{{if .Required}} required{{end}}>{{end}}
      {{end}}<label for="template-{{.ID}}-state">State</label><select id="template-{{.ID}}-state" name="state"><option value="ENABLED">Enabled</option><option value="DISABLED">Disabled</option></select>
      <button class="btn btn-primary" type="submit">Create rule from {{.Name}}</button>
    </form>
  </section>{{end}}
  </div>
</main></div><div id="modal-root"></div></body></html>
{{end}}
