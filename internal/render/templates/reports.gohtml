{{define "page_project_reports"}}
<!doctype html><html lang="en"><head><title>Reports · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Reports</span></nav><header class="page-header"><div><span class="eyebrow">Analysis</span><h1>Reports</h1><p>Built-in and app-provided analysis for {{.Data.Project.Name}}.</p></div></header>
<section class="directory-grid" aria-label="Available reports"><article class="surface-card"><span class="eyebrow">Delivery</span><h2>DORA metrics</h2><p>Deployment frequency, lead time, change failure rate, and recovery time.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/dora">Open DORA metrics</a></article>{{if eq .Data.Project.ProjectTypeKey "software"}}<article class="surface-card"><span class="eyebrow">Agile</span><h2>Sprint report</h2><p>Work completed, left open, and removed during a sprint, with its burndown.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/sprint">Open Sprint report</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Velocity chart</h2><p>Commitment compared with completed work across recent sprints.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/velocity">Open Velocity chart</a></article>{{end}}{{range .Data.Reports}}<article class="surface-card app-report-card"><div class="app-report-heading">{{if .Thumbnail}}<img class="app-module-thumbnail" src="{{.Thumbnail}}" alt="" referrerpolicy="no-referrer">{{end}}<div><span class="eyebrow">{{.Category}} · {{.Module.AppName}}</span><h2>{{.Module.Title}}</h2></div></div><p>{{.Description}}</p><a class="btn" href="/projects/{{$.Data.Project.Key}}/reports/apps/{{.Module.ID}}">Open {{.Module.Title}}</a></article>{{end}}</section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_app_report"}}
<!doctype html><html lang="en"><head><title>{{.Data.Report.Module.Title}} · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Report.Module.Title}}</span></nav><header class="page-header"><div><span class="eyebrow">{{.Data.Report.Category}} · {{.Data.Report.Module.AppName}}</span><h1>{{.Data.Report.Module.Title}}</h1><p>{{.Data.Report.Description}}</p></div></header>
<section class="surface-card app-module-content" aria-labelledby="app-report-content"><h2 class="sr-only" id="app-report-content">Report content</h2><iframe class="app-module-frame" src="{{.Data.FrameURL}}" title="{{.Data.Report.Module.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_dora_report"}}
<!doctype html><html lang="en"><head><title>DORA metrics · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">DORA metrics</span></nav>
<header class="page-header"><div><span class="eyebrow">Delivery performance</span><h1>DORA metrics</h1><p>Production delivery signals for work visible in {{.Data.Project.Name}}.</p></div><form class="report-window" method="get"><label for="report-window">Time window</label><select id="report-window" name="window"><option value="7" {{if eq .Data.Report.WindowDays 7}}selected{{end}}>Last 7 days</option><option value="30" {{if eq .Data.Report.WindowDays 30}}selected{{end}}>Last 30 days</option><option value="90" {{if eq .Data.Report.WindowDays 90}}selected{{end}}>Last 90 days</option></select><button class="btn" type="submit">Update</button></form></header>

<section class="dora-metrics" aria-label="DORA summary">
  <article class="surface-card dora-metric"><span class="eyebrow">Deployment frequency</span><strong>{{.Data.Report.DeploymentFrequency}}</strong><p>successful production deployments</p><small>{{printf "%.1f" .Data.Report.DeploymentsPerWeek}} per week</small></article>
  <article class="surface-card dora-metric"><span class="eyebrow">Lead time for changes</span><strong>{{.Data.Report.LeadTimeDisplay}}</strong><p>median commit to production</p><small>{{.Data.Report.LeadTimeSamples}} linked commit samples</small></article>
  <article class="surface-card dora-metric"><span class="eyebrow">Change failure rate</span><strong>{{printf "%.1f" .Data.Report.ChangeFailureRate}}%</strong><p>failed or rolled-back production events</p><small>{{.Data.Report.FailedChanges}} of {{.Data.Report.TotalChanges}} terminal events</small></article>
  <article class="surface-card dora-metric"><span class="eyebrow">Time to restore service</span><strong>{{.Data.Report.MTTRDisplay}}</strong><p>median incident open to done</p><small>{{.Data.Report.RecoveredIncidents}} recovered incident samples</small></article>
</section>

<section class="surface-card dora-chart-card" aria-labelledby="delivery-trend-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Data.Report.Since}} to {{.Data.Report.Until}}</span><h2 id="delivery-trend-title">Production delivery trend</h2></div><div class="chart-legend"><span><i class="legend-success"></i>Successful</span><span><i class="legend-failure"></i>Failed or rolled back</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable delivery chart"><svg class="dora-chart" viewBox="0 0 {{.Data.Report.ChartWidth}} 140" role="img" aria-labelledby="dora-chart-title dora-chart-desc"><title id="dora-chart-title">Daily production delivery events</title><desc id="dora-chart-desc">Green bars show successful deployments. Red bars show failed or rolled-back deployment events. The exact daily values follow in a table.</desc><line x1="0" y1="120" x2="{{.Data.Report.ChartWidth}}" y2="120" class="chart-axis"/>{{range .Data.Report.Daily}}<rect x="{{.X}}" y="{{.DeploymentY}}" width="7" height="{{.DeploymentHeight}}" class="chart-success"><title>{{.Date}}: {{.Deployments}} successful</title></rect><rect x="{{.FailureX}}" y="{{.FailureY}}" width="7" height="{{.FailureHeight}}" class="chart-failure"><title>{{.Date}}: {{.Failures}} failed or rolled back</title></rect>{{end}}</svg></div>
<details class="chart-data"><summary>View daily data</summary><div class="table-scroll" tabindex="0" aria-label="Daily delivery data"><table><thead><tr><th scope="col">Date</th><th scope="col">Successful</th><th scope="col">Failed or rolled back</th></tr></thead><tbody>{{range .Data.Report.Daily}}<tr><th scope="row">{{.Date}}</th><td>{{.Deployments}}</td><td>{{.Failures}}</td></tr>{{end}}</tbody></table></div></details></section>

<div class="dora-detail-grid"><section class="surface-card"><h2>Recent production events</h2><ul class="delivery-evidence-list">{{range .Data.Report.Recent}}<li><div>{{if .URL}}<a href="{{.URL}}" rel="noreferrer"><strong>{{.DisplayName}}</strong></a>{{else}}<strong>{{.DisplayName}}</strong>{{end}}<small>{{.EnvironmentName}} · {{.PipelineID}} · {{.LastUpdated}}</small></div><span class="lozenge {{if eq .State "successful"}}lozenge-success{{else if or (eq .State "failed") (eq .State "rolled_back")}}lozenge-danger{{else}}lozenge-default{{end}}">{{.State}}</span></li>{{else}}<li><div><strong>No production events</strong><small>Submit linked deployment data to populate this report.</small></div></li>{{end}}</ul></section>
<aside class="surface-card dora-method"><h2>How these measures work</h2><dl><dt>Deployment frequency</dt><dd>Successful production deployment keys in the selected window.</dd><dt>Lead time</dt><dd>Median time from a linked commit timestamp to its first later successful production deployment.</dd><dt>Failure rate</dt><dd>Failed and rolled-back production events divided by successful, failed and rolled-back terminal events.</dd><dt>Restore time</dt><dd>Median time from creation to the first Done transition for visible work items labeled <code>incident</code>.</dd></dl><p class="muted">Only events associated with work items you can view contribute to this report.</p></aside></div>
</main></div><div id="modal-root"></div></body></html>
{{end}}

{{define "agile_report_board_form"}}{{if .Boards}}<form method="get"><label for="report-board">Board</label><select id="report-board" name="board">{{range .Boards}}<option value="{{.JiraID}}" {{if eq .ID $.Board.ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show board</button></form>{{end}}{{end}}

{{define "page_sprint_report"}}
<!doctype html><html lang="en"><head><title>Sprint report · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Sprint report</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Sprint report</h1><p>Understand the work completed or pushed back to the backlog in each sprint.</p></div></header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}{{if .Data.Sprints}}<form method="get"><input type="hidden" name="board" value="{{.Data.Board.JiraID}}"><label for="report-sprint">Sprint</label><select id="report-sprint" name="sprint">{{range .Data.Sprints}}<option value="{{.JiraID}}" {{if eq .ID $.Data.Sprint.ID}}selected{{end}}>{{.Name}}{{if eq .State "active"}} (active){{end}}</option>{{end}}</select><button class="btn" type="submit">Show sprint</button></form>{{end}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No scrum boards</strong><small>Sprint reports read the sprints of a project's scrum board.</small></section>
{{else if not .Data.Report}}<section class="surface-card empty-state"><strong>No started sprints</strong><small>Start a sprint on {{.Data.Board.Name}} to see its report.</small></section>
{{else}}{{with .Data.Report}}
<section class="surface-card sprint-report-work" aria-labelledby="sprint-heading"><header class="release-section-heading"><div><span class="eyebrow">{{if eq .Sprint.State "active"}}Active sprint{{else}}Completed sprint{{end}}</span><h2 id="sprint-heading">{{.Sprint.Name}}</h2></div><span class="lozenge {{if eq .Sprint.State "active"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Sprint.State}}</span></header><p>Started {{.StartDisplay}}{{if eq .Sprint.State "closed"}} · Completed {{.EndDisplay}}{{end}}{{if .PlannedEndDisplay}} · Planned end {{.PlannedEndDisplay}}{{end}}</p>{{if .Sprint.Goal}}<p><strong>Goal:</strong> {{.Sprint.Goal}}</p>{{end}}</section>
<section class="sprint-report-summary" aria-label="Sprint summary"><article class="surface-card"><span class="eyebrow">Completed</span><strong>{{.CompletedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Not completed</span><strong>{{.NotCompletedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Removed</span><strong>{{.RemovedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Added after start</span><strong>{{.AddedAfterStart}}</strong><p>work items</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="burndown-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="burndown-title">Burndown</h2></div><div class="chart-legend"><span><i class="legend-remaining"></i>Remaining work</span>{{if .Chart.Guideline}}<span><i class="legend-guideline"></i>Guideline</span>{{end}}</div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable burndown chart"><svg class="agile-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-labelledby="burndown-chart-title burndown-chart-desc"><title id="burndown-chart-title">Remaining {{.Statistic}} over the sprint</title><desc id="burndown-chart-desc">The red line steps down as work completes and up as work is added or re-estimated. The dashed guideline falls to zero at the planned end. Every change follows in a table.</desc>{{range .Chart.Ticks}}<line x1="{{$.Data.Report.Chart.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Chart.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.Chart.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{if .Chart.Guideline}}<line x1="{{.Chart.GuideX1}}" y1="{{.Chart.GuideY1}}" x2="{{.Chart.GuideX2}}" y2="{{.Chart.GuideY2}}" class="chart-guideline"/>{{end}}<polyline points="{{.Chart.Remaining}}" class="chart-remaining"/><text x="{{.Chart.Left}}" y="244" class="chart-label">{{.Chart.StartLabel}}</text><text x="{{.Chart.Right}}" y="244" class="chart-label" text-anchor="end">{{.Chart.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View burndown changes</summary><div class="table-scroll" tabindex="0" aria-label="Burndown changes"><table><caption class="sr-only">Burndown changes</caption><thead><tr><th scope="col">Date</th><th scope="col">Work item</th><th scope="col">Event</th><th scope="col">Change</th><th scope="col">Remaining</th></tr></thead><tbody>{{range .Events}}<tr><th scope="row">{{.When}}</th><td>{{if .IssueKey}}<a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a>{{end}}</td><td>{{.Label}}</td><td>{{.ChangeDisplay}}</td><td>{{.RemainingText}}</td></tr>{{end}}</tbody></table></div></details></section>
{{range .Sections}}{{template "sprint_report_work" .}}{{end}}
{{if .AddedAfterStart}}<p class="muted">* Added to the sprint after it started.</p>{{end}}
{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "sprint_report_work"}}<section class="surface-card sprint-report-work" aria-labelledby="{{.ID}}"><h2 id="{{.ID}}">{{.Title}}</h2>{{if .Issues}}<div class="table-scroll" tabindex="0" aria-label="{{.Title}}"><table><caption class="sr-only">{{.Title}}</caption><thead><tr><th scope="col">Key</th><th scope="col">Summary</th><th scope="col">Work type</th><th scope="col">Status</th><th scope="col">Estimate</th></tr></thead><tbody>{{range .Issues}}<tr><th scope="row"><a href="/browse/{{.Key}}">{{.Key}}</a>{{if .AddedAfterStart}}<span aria-label="added after the sprint started">*</span>{{end}}</th><td>{{.Summary}}</td><td>{{.IssueType}}</td><td>{{.Status}}</td><td class="estimate">{{if .EstimateChanged}}<span class="sr-only">changed from </span>{{if .EstimateStart}}{{.EstimateStart}}{{else}}-{{end}} <span aria-hidden="true">→</span><span class="sr-only"> to </span> {{end}}{{if .EstimateEnd}}{{.EstimateEnd}}{{else}}-{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">{{.Empty}}</p>{{end}}</section>{{end}}

{{define "page_velocity_report"}}
<!doctype html><html lang="en"><head><title>Velocity chart · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Velocity chart</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Velocity chart</h1><p>Track the work your team commits to and completes from sprint to sprint.</p></div></header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No scrum boards</strong><small>The velocity chart reads the completed sprints of a project's scrum board.</small></section>
{{else}}{{with .Data.Report}}{{if not .Sprints}}<section class="surface-card empty-state"><strong>No completed sprints</strong><small>Complete a sprint on {{$.Data.Board.Name}} to measure velocity.</small></section>{{else}}
<section class="sprint-report-summary" aria-label="Velocity summary"><article class="surface-card"><span class="eyebrow">Average completed</span><strong>{{.AverageCompleted}}</strong><p>{{.Statistic}} per sprint</p></article><article class="surface-card"><span class="eyebrow">Sprints measured</span><strong>{{len .Sprints}}</strong><p>most recent completed</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="velocity-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="velocity-title">Commitment and completed work</h2></div><div class="chart-legend"><span><i class="legend-commitment"></i>Commitment</span><span><i class="legend-success"></i>Completed</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable velocity chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="velocity-chart-title velocity-chart-desc"><title id="velocity-chart-title">{{.Statistic}} committed and completed per sprint</title><desc id="velocity-chart-desc">Grey bars show the work in each sprint when it started. Green bars show the work completed during it. The values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.Report.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{range .Bars}}<rect x="{{.X}}" y="{{.CommitmentY}}" width="28" height="{{.CommitmentHeight}}" class="chart-commitment"><title>{{.Name}}: {{.Commitment}} committed</title></rect><rect x="{{.CompletedX}}" y="{{.CompletedY}}" width="28" height="{{.CompletedHeight}}" class="chart-completed"><title>{{.Name}}: {{.Completed}} completed</title></rect><text x="{{.LabelX}}" y="244" class="chart-label" text-anchor="middle">{{.Label}}</text>{{end}}</svg></div>
<details class="chart-data" open><summary>View sprint data</summary><div class="table-scroll" tabindex="0" aria-label="Velocity data"><table><caption class="sr-only">Velocity data</caption><thead><tr><th scope="col">Sprint</th><th scope="col">Commitment</th><th scope="col">Completed</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Name}}</th><td>{{.Commitment}}</td><td>{{.Completed}}</td></tr>{{end}}</tbody></table></div></details></section>
{{end}}{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
