{{define "page_project_reports"}}
<!doctype html><html lang="en"><head><title>Reports · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">Reports</span></nav><header class="page-header"><div><span class="eyebrow">Analysis</span><h1>Reports</h1><p>Built-in and app-provided analysis for {{.Data.Project.Name}}.</p></div></header>
<section class="directory-grid" aria-label="Available reports"><article class="surface-card"><span class="eyebrow">Delivery</span><h2>DORA metrics</h2><p>Deployment frequency, lead time, change failure rate, and recovery time.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/dora">Open DORA metrics</a></article><article class="surface-card"><span class="eyebrow">Issue analysis</span><h2>Created vs. resolved</h2><p>Work created against work resolved each day, to see whether the backlog is growing.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/created-vs-resolved">Open Created vs. resolved</a></article><article class="surface-card"><span class="eyebrow">Issue analysis</span><h2>Resolution time</h2><p>How long work takes from creation to resolution, day by day.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/resolution-time">Open Resolution time</a></article><article class="surface-card"><span class="eyebrow">Issue analysis</span><h2>Work by field</h2><p>How the project's work divides by assignee, work type, status, priority, resolution or reporter.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/group-by">Open Work by field</a></article><article class="surface-card"><span class="eyebrow">Workload</span><h2>User workload</h2><p>Who holds the unresolved work, and how much time it is estimated to still take.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/user-workload">Open User workload</a></article><article class="surface-card"><span class="eyebrow">Workload</span><h2>Version workload</h2><p>The work left in a version, by the person holding it and by what kind of work it is.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/version-workload">Open Version workload</a></article><article class="surface-card"><span class="eyebrow">Workload</span><h2>Time tracking</h2><p>Estimates against time spent, for the work that is not finished.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/time-tracking">Open Time tracking</a></article>{{if eq .Data.Project.ProjectTypeKey "software"}}<article class="surface-card"><span class="eyebrow">Agile</span><h2>Sprint report</h2><p>Work completed, left open, and removed during a sprint, with its burndown.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/sprint">Open Sprint report</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Velocity chart</h2><p>Commitment compared with completed work across recent sprints.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/velocity">Open Velocity chart</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Cumulative flow diagram</h2><p>How work spreads across a board's columns each day, to spot bottlenecks.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/cumulative-flow">Open Cumulative flow diagram</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Control chart</h2><p>Cycle time of completed work, from starting it to finishing it.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/control-chart">Open Control chart</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Epic report</h2><p>Progress of the work in an epic: what is done, what remains, and how scope grew.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/epic">Open Epic report</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Version report</h2><p>Progress of the work fixed in a version toward its release.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/version">Open Version report</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Epic burndown</h2><p>An epic's work burning down sprint by sprint, with the scope that arrived in each.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/epic-burndown">Open Epic burndown</a></article><article class="surface-card"><span class="eyebrow">Agile</span><h2>Release burndown</h2><p>A version's work burning down sprint by sprint, toward its release.</p><a class="btn" href="/projects/{{.Data.Project.Key}}/reports/release-burndown">Open Release burndown</a></article>{{end}}{{range .Data.Reports}}<article class="surface-card app-report-card"><div class="app-report-heading">{{if .Thumbnail}}<img class="app-module-thumbnail" src="{{.Thumbnail}}" alt="" referrerpolicy="no-referrer">{{end}}<div><span class="eyebrow">{{.Category}} · {{.Module.AppName}}</span><h2>{{.Module.Title}}</h2></div></div><p>{{.Description}}</p><a class="btn" href="/projects/{{$.Data.Project.Key}}/reports/apps/{{.Module.ID}}">Open {{.Module.Title}}</a></article>{{end}}</section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_app_report"}}
<!doctype html><html lang="en"><head><title>{{.Data.Report.Module.Title}} · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Report.Module.Title}}</span></nav><header class="page-header"><div><span class="eyebrow">{{.Data.Report.Category}} · {{.Data.Report.Module.AppName}}</span><h1>{{.Data.Report.Module.Title}}</h1><p>{{.Data.Report.Description}}</p></div></header>
<section class="surface-card app-module-content" aria-labelledby="app-report-content"><h2 class="sr-only" id="app-report-content">Report content</h2><iframe class="app-module-frame" data-app-module="{{.Data.Report.Module.ID}}" data-app-base="{{.Data.Report.Module.BaseURL}}" src="{{.Data.FrameURL}}" title="{{.Data.Report.Module.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe><script src="/static/connect-host.js?v=1" defer></script></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_dora_report"}}
<!doctype html><html lang="en"><head><title>DORA metrics · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">DORA metrics</span></nav>
<header class="page-header"><div><span class="eyebrow">Delivery performance</span><h1>DORA metrics</h1><p>Production delivery signals for work visible in {{.Data.Project.Name}}.</p></div>{{template "report_actions" .Data.Actions}}<form class="report-window" method="get"><label for="report-window">Time window</label><select id="report-window" name="window"><option value="7" {{if eq .Data.Report.WindowDays 7}}selected{{end}}>Last 7 days</option><option value="30" {{if eq .Data.Report.WindowDays 30}}selected{{end}}>Last 30 days</option><option value="90" {{if eq .Data.Report.WindowDays 90}}selected{{end}}>Last 90 days</option></select><label class="report-toggle"><input type="checkbox" name="compare" value="previous" {{if .Data.Compare}}checked{{end}}> Compare with previous period</label><button class="btn" type="submit">Update</button></form></header>

<section class="dora-metrics" aria-label="DORA summary">
  <article class="surface-card dora-metric"><span class="eyebrow">Deployment frequency</span><strong>{{.Data.Report.DeploymentFrequency}}</strong><p>successful production deployments</p><small>{{printf "%.1f" .Data.Report.DeploymentsPerWeek}} per week</small>{{with index .Data.Comparison "deployments"}}<small class="report-change">{{.}}</small>{{end}}</article>
  <article class="surface-card dora-metric"><span class="eyebrow">Lead time for changes</span><strong>{{.Data.Report.LeadTimeDisplay}}</strong><p>median commit to production</p><small>{{.Data.Report.LeadTimeSamples}} linked commit samples</small>{{with index .Data.Comparison "leadTime"}}<small class="report-change">{{.}}</small>{{end}}</article>
  <article class="surface-card dora-metric"><span class="eyebrow">Change failure rate</span><strong>{{printf "%.1f" .Data.Report.ChangeFailureRate}}%</strong><p>failed or rolled-back production events</p><small>{{.Data.Report.FailedChanges}} of {{.Data.Report.TotalChanges}} terminal events</small>{{with index .Data.Comparison "failureRate"}}<small class="report-change">{{.}}</small>{{end}}</article>
  <article class="surface-card dora-metric"><span class="eyebrow">Time to restore service</span><strong>{{.Data.Report.MTTRDisplay}}</strong><p>median incident open to done</p><small>{{.Data.Report.RecoveredIncidents}} recovered incident samples</small>{{with index .Data.Comparison "restore"}}<small class="report-change">{{.}}</small>{{end}}</article>
</section>

<section class="surface-card dora-chart-card" aria-labelledby="delivery-trend-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Data.Report.Since}} to {{.Data.Report.Until}}</span><h2 id="delivery-trend-title">Production delivery trend</h2></div><div class="chart-legend"><span><i class="legend-success"></i>Successful</span><span><i class="legend-failure"></i>Failed or rolled back</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable delivery chart"><svg class="dora-chart" viewBox="0 0 {{.Data.Report.ChartWidth}} 140" role="img" aria-labelledby="dora-chart-title dora-chart-desc"><title id="dora-chart-title">Daily production delivery events</title><desc id="dora-chart-desc">Green bars show successful deployments. Red bars show failed or rolled-back deployment events. The exact daily values follow in a table.</desc><line x1="0" y1="120" x2="{{.Data.Report.ChartWidth}}" y2="120" class="chart-axis"/>{{range .Data.Report.Daily}}<rect x="{{.X}}" y="{{.DeploymentY}}" width="7" height="{{.DeploymentHeight}}" class="chart-success"><title>{{.Date}}: {{.Deployments}} successful</title></rect><rect x="{{.FailureX}}" y="{{.FailureY}}" width="7" height="{{.FailureHeight}}" class="chart-failure"><title>{{.Date}}: {{.Failures}} failed or rolled back</title></rect>{{end}}</svg></div>
<details class="chart-data"><summary>View daily data</summary><div class="table-scroll" tabindex="0" aria-label="Daily delivery data"><table><thead><tr><th scope="col">Date</th><th scope="col">Successful</th><th scope="col">Failed or rolled back</th></tr></thead><tbody>{{range .Data.Report.Daily}}<tr><th scope="row">{{.Date}}</th><td>{{.Deployments}}</td><td>{{.Failures}}</td></tr>{{end}}</tbody></table></div></details></section>

<div class="dora-detail-grid"><section class="surface-card"><h2>Recent production events</h2><ul class="delivery-evidence-list">{{range .Data.Report.Recent}}<li><div>{{if .URL}}<a href="{{.URL}}" rel="noreferrer"><strong>{{.DisplayName}}</strong></a>{{else}}<strong>{{.DisplayName}}</strong>{{end}}<small>{{.EnvironmentName}} · {{.PipelineID}} · {{.LastUpdated}}</small></div><span class="lozenge {{if eq .State "successful"}}lozenge-success{{else if or (eq .State "failed") (eq .State "rolled_back")}}lozenge-danger{{else}}lozenge-default{{end}}">{{.State}}</span></li>{{else}}<li><div><strong>No production events</strong><small>Submit linked deployment data to populate this report.</small></div></li>{{end}}</ul></section>
<aside class="surface-card dora-method"><h2>How these measures work</h2><dl><dt>Deployment frequency</dt><dd>Successful production deployment keys in the selected window.</dd><dt>Lead time</dt><dd>Median time from a linked commit timestamp to its first later successful production deployment.</dd><dt>Failure rate</dt><dd>Failed and rolled-back production events divided by successful, failed and rolled-back terminal events.</dd><dt>Restore time</dt><dd>Median time from creation to resolution for visible Jira Service Management incidents.</dd></dl><p class="muted">Only events associated with work items you can view contribute to this report.</p></aside></div>
</main></div><div id="modal-root"></div></body></html>
{{end}}

{{define "agile_report_board_form"}}{{if .Boards}}<form method="get"><label for="report-board">Board</label><select id="report-board" name="board">{{range .Boards}}<option value="{{.JiraID}}" {{if eq .ID $.Board.ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show board</button></form>{{end}}{{end}}

{{define "page_sprint_report"}}
<!doctype html><html lang="en"><head><title>Sprint report · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Sprint report</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Sprint report</h1><p>Understand the work completed or pushed back to the backlog in each sprint.</p></div>{{template "report_actions" .Data.Actions}}</header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}{{if .Data.Sprints}}<form method="get"><input type="hidden" name="board" value="{{.Data.Board.JiraID}}"><label for="report-sprint">Sprint</label><select id="report-sprint" name="sprint">{{range .Data.Sprints}}<option value="{{.JiraID}}" {{if eq .ID $.Data.Sprint.ID}}selected{{end}}>{{.Name}}{{if eq .State "active"}} (active){{end}}</option>{{end}}</select><button class="btn" type="submit">Show sprint</button></form>{{end}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No scrum boards</strong><small>Sprint reports read the sprints of a project's scrum board.</small></section>
{{else if not .Data.Report}}<section class="surface-card empty-state"><strong>No started sprints</strong><small>Start a sprint on {{.Data.Board.Name}} to see its report.</small></section>
{{else}}{{with .Data.Report}}
<section class="surface-card sprint-report-work" aria-labelledby="sprint-heading"><header class="release-section-heading"><div><span class="eyebrow">{{if eq .Sprint.State "active"}}Active sprint{{else}}Completed sprint{{end}}</span><h2 id="sprint-heading">{{.Sprint.Name}}</h2></div><span class="lozenge {{if eq .Sprint.State "active"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Sprint.State}}</span></header><p>Started {{.StartDisplay}}{{if eq .Sprint.State "closed"}} · Completed {{.EndDisplay}}{{end}}{{if .PlannedEndDisplay}} · Planned end {{.PlannedEndDisplay}}{{end}}</p>{{if .Sprint.Goal}}<p><strong>Goal:</strong> {{.Sprint.Goal}}</p>{{end}}</section>
<section class="sprint-report-summary" aria-label="Sprint summary"><article class="surface-card"><span class="eyebrow">Completed</span><strong>{{.CompletedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Not completed</span><strong>{{.NotCompletedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Removed</span><strong>{{.RemovedText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Added after start</span><strong>{{.AddedAfterStart}}</strong><p>work items</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="burndown-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="burndown-title">Burndown</h2></div><div class="chart-legend"><span><i class="legend-remaining"></i>Remaining work</span>{{if .Chart.Guideline}}<span><i class="legend-guideline"></i>Guideline</span>{{end}}</div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable burndown chart"><svg class="agile-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-labelledby="burndown-chart-title burndown-chart-desc"><title id="burndown-chart-title">Remaining {{.Statistic}} over the sprint</title><desc id="burndown-chart-desc">The red line steps down as work completes and up as work is added or re-estimated. The dashed guideline falls to zero at the planned end. Every change follows in a table.</desc>{{range .Chart.Ticks}}<line x1="{{$.Data.Report.Chart.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Chart.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.Chart.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{if .Chart.Guideline}}<line x1="{{.Chart.GuideX1}}" y1="{{.Chart.GuideY1}}" x2="{{.Chart.GuideX2}}" y2="{{.Chart.GuideY2}}" class="chart-guideline"/>{{end}}<polyline points="{{.Chart.Remaining}}" class="chart-remaining"/><text x="{{.Chart.Left}}" y="244" class="chart-label">{{.Chart.StartLabel}}</text><text x="{{.Chart.Right}}" y="244" class="chart-label" text-anchor="end">{{.Chart.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View burndown changes</summary><div class="table-scroll" tabindex="0" aria-label="Burndown changes"><table><caption class="sr-only">Burndown changes</caption><thead><tr><th scope="col">Date</th><th scope="col">Work item</th><th scope="col">Event</th><th scope="col">Change</th><th scope="col">Remaining</th></tr></thead><tbody>{{range .Events}}<tr><th scope="row">{{.When}}</th><td>{{if .IssueKey}}<a href="/browse/{{.IssueKey}}">{{.IssueKey}}</a>{{end}}</td><td>{{.Label}}</td><td>{{.ChangeDisplay}}</td><td>{{.RemainingText}}</td></tr>{{end}}</tbody></table></div></details></section>
<section class="surface-card dora-chart-card" aria-labelledby="burnup-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="burnup-title">Burnup</h2></div><div class="chart-legend"><span><i class="legend-commitment"></i>Scope</span><span><i class="legend-success"></i>Completed work</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable burnup chart"><svg class="agile-chart" viewBox="0 0 {{.Burnup.Width}} {{.Burnup.Height}}" role="img" aria-labelledby="burnup-chart-title burnup-chart-desc"><title id="burnup-chart-title">Scope and completed {{.Statistic}} over the sprint</title><desc id="burnup-chart-desc">The grey line is the sprint's scope and the green line the work completed; the gap between them is the work left. The burndown changes table lists every step.</desc>{{range .Burnup.Ticks}}<line x1="{{$.Data.Report.Burnup.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Burnup.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.Burnup.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}<polyline points="{{.Burnup.Scope}}" class="chart-scope"/><polyline points="{{.Burnup.Completed}}" class="chart-completed-line"/><text x="{{.Burnup.Left}}" y="244" class="chart-label">{{.Burnup.StartLabel}}</text><text x="{{.Burnup.Right}}" y="244" class="chart-label" text-anchor="end">{{.Burnup.EndLabel}}</text></svg></div></section>
{{range .Sections}}{{template "sprint_report_work" .}}{{end}}
{{if .AddedAfterStart}}<p class="muted">* Added to the sprint after it started.</p>{{end}}
{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "sprint_report_work"}}<section class="surface-card sprint-report-work" aria-labelledby="{{.ID}}"><h2 id="{{.ID}}">{{.Title}}</h2>{{if .Issues}}<div class="table-scroll" tabindex="0" aria-label="{{.Title}}"><table><caption class="sr-only">{{.Title}}</caption><thead><tr><th scope="col">Key</th><th scope="col">Summary</th><th scope="col">Work type</th><th scope="col">Status</th><th scope="col">Estimate</th></tr></thead><tbody>{{range .Issues}}<tr><th scope="row"><a href="/browse/{{.Key}}">{{.Key}}</a>{{if .AddedAfterStart}}<span aria-label="added after the sprint started">*</span>{{end}}</th><td>{{.Summary}}</td><td>{{.IssueType}}</td><td>{{.Status}}</td><td class="estimate">{{if .EstimateChanged}}<span class="sr-only">changed from </span>{{if .EstimateStart}}{{.EstimateStart}}{{else}}-{{end}} <span aria-hidden="true">→</span><span class="sr-only"> to </span> {{end}}{{if .EstimateEnd}}{{.EstimateEnd}}{{else}}-{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">{{.Empty}}</p>{{end}}</section>{{end}}

{{define "page_velocity_report"}}
<!doctype html><html lang="en"><head><title>Velocity chart · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Velocity chart</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Velocity chart</h1><p>Track the work your team commits to and completes from sprint to sprint.</p></div>{{template "report_actions" .Data.Actions}}</header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No scrum boards</strong><small>The velocity chart reads the completed sprints of a project's scrum board.</small></section>
{{else}}{{with .Data.Report}}{{if not .Sprints}}<section class="surface-card empty-state"><strong>No completed sprints</strong><small>Complete a sprint on {{$.Data.Board.Name}} to measure velocity.</small></section>{{else}}
<section class="sprint-report-summary" aria-label="Velocity summary"><article class="surface-card"><span class="eyebrow">Average completed</span><strong>{{.AverageCompleted}}</strong><p>{{.Statistic}} per sprint</p></article><article class="surface-card"><span class="eyebrow">Sprints measured</span><strong>{{len .Sprints}}</strong><p>most recent completed</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="velocity-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="velocity-title">Commitment and completed work</h2></div><div class="chart-legend"><span><i class="legend-commitment"></i>Commitment</span><span><i class="legend-success"></i>Completed</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable velocity chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="velocity-chart-title velocity-chart-desc"><title id="velocity-chart-title">{{.Statistic}} committed and completed per sprint</title><desc id="velocity-chart-desc">Grey bars show the work in each sprint when it started. Green bars show the work completed during it. The values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.Report.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{range .Bars}}<rect x="{{.X}}" y="{{.CommitmentY}}" width="28" height="{{.CommitmentHeight}}" class="chart-commitment"><title>{{.Name}}: {{.Commitment}} committed</title></rect><rect x="{{.CompletedX}}" y="{{.CompletedY}}" width="28" height="{{.CompletedHeight}}" class="chart-completed"><title>{{.Name}}: {{.Completed}} completed</title></rect><text x="{{.LabelX}}" y="244" class="chart-label" text-anchor="middle">{{.Label}}</text>{{end}}</svg></div>
<details class="chart-data" open><summary>View sprint data</summary><div class="table-scroll" tabindex="0" aria-label="Velocity data"><table><caption class="sr-only">Velocity data</caption><thead><tr><th scope="col">Sprint</th><th scope="col">Commitment</th><th scope="col">Completed</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Name}}</th><td>{{.Commitment}}</td><td>{{.Completed}}</td></tr>{{end}}</tbody></table></div></details></section>
{{end}}{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "flow_report_controls"}}<div class="agile-report-controls">{{template "agile_report_board_form" .}}{{if .Board}}<form method="get"><input type="hidden" name="board" value="{{.Board.JiraID}}"><label for="report-days">Time window</label><select id="report-days" name="days">{{range .Windows}}<option value="{{.}}" {{if eq . $.Days}}selected{{end}}>Last {{.}} days</option>{{end}}</select>{{if .Control}}<label class="report-toggle"><input type="checkbox" name="compare" value="previous" {{if .Compare}}checked{{end}}> Compare with previous period</label>{{end}}<button class="btn" type="submit">Show window</button></form>{{end}}</div>{{end}}

{{define "page_cumulative_flow_report"}}
<!doctype html><html lang="en"><head><title>Cumulative flow diagram · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Cumulative flow diagram</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Cumulative flow diagram</h1><p>See how work moves through each column, so a widening band shows where it waits.</p></div>{{template "report_actions" .Data.Actions}}</header>
{{template "flow_report_controls" .Data}}
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No boards</strong><small>The cumulative flow diagram reads the columns of a project's board.</small></section>
{{else}}{{with .Data.Flow}}
<section class="surface-card dora-chart-card" aria-labelledby="flow-title"><header class="release-section-heading"><div><span class="eyebrow">Last {{$.Data.Days}} days</span><h2 id="flow-title">Work in each column</h2></div><div class="chart-legend">{{range .Bands}}<span><i class="{{.Class}}"></i>{{.Name}}</span>{{end}}</div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable cumulative flow diagram"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="flow-chart-title flow-chart-desc"><title id="flow-chart-title">Work items in each board column per day</title><desc id="flow-chart-desc">Stacked bands show how many work items were in each column at the end of each day, with the first column on top. The daily counts follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.Flow.Left}}" y1="{{.Y}}" x2="{{$.Data.Flow.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Flow.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{range .Bands}}<polygon points="{{.Points}}" class="flow-band {{.Class}}"><title>{{.Name}}</title></polygon>{{end}}<text x="{{.Left}}" y="244" class="chart-label">{{.StartLabel}}</text><text x="{{.Right}}" y="244" class="chart-label" text-anchor="end">{{.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View daily counts</summary><div class="table-scroll" tabindex="0" aria-label="Daily column counts"><table><caption class="sr-only">Daily column counts</caption><thead><tr><th scope="col">Date</th>{{range .Columns}}<th scope="col">{{.Name}}</th>{{end}}</tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th>{{range .Counts}}<td>{{.}}</td>{{end}}</tr>{{end}}</tbody></table></div></details></section>
{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_control_chart_report"}}
<!doctype html><html lang="en"><head><title>Control chart · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Control chart</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>Control chart</h1><p>Measure how long work takes from starting it to finishing it.</p></div>{{template "report_actions" .Data.Actions}}</header>
{{template "flow_report_controls" .Data}}
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No boards</strong><small>The control chart reads the work on a project's board.</small></section>
{{else}}{{with .Data.Control}}
<section class="sprint-report-summary" aria-label="Cycle time summary"><article class="surface-card"><span class="eyebrow">Completed work</span><strong>{{len .Samples}}</strong><p>work items</p>{{with index $.Data.Comparison "completed"}}<small class="report-change">{{.}}</small>{{end}}</article><article class="surface-card"><span class="eyebrow">Average cycle time</span><strong>{{if .Average}}{{.Average}}{{else}}-{{end}}</strong><p>start to done</p>{{with index $.Data.Comparison "average"}}<small class="report-change">{{.}}</small>{{end}}</article><article class="surface-card"><span class="eyebrow">Median cycle time</span><strong>{{if .Median}}{{.Median}}{{else}}-{{end}}</strong><p>start to done</p>{{with index $.Data.Comparison "median"}}<small class="report-change">{{.}}</small>{{end}}</article></section>
<section class="surface-card dora-chart-card" aria-labelledby="control-title"><header class="release-section-heading"><div><span class="eyebrow">Last {{$.Data.Days}} days</span><h2 id="control-title">Cycle time</h2></div><div class="chart-legend"><span><i class="legend-remaining"></i>Completed work item</span><span><i class="legend-guideline"></i>Average</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable control chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="control-chart-title control-chart-desc"><title id="control-chart-title">Cycle time of each completed work item</title><desc id="control-chart-desc">Each dot is a work item placed by when it was completed and how long it took from starting to done; the dashed line is the average. The values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.Control.Left}}" y1="{{.Y}}" x2="{{$.Data.Control.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Control.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{if .Points}}<line x1="{{.Left}}" y1="{{.AverageY}}" x2="{{.Right}}" y2="{{.AverageY}}" class="chart-guideline"/>{{end}}{{range .Points}}<circle cx="{{.X}}" cy="{{.Y}}" r="5" class="control-point"><title>{{.Key}}: {{.CycleDuration}}</title></circle>{{end}}<text x="{{.Left}}" y="244" class="chart-label">{{.StartLabel}}</text><text x="{{.Right}}" y="244" class="chart-label" text-anchor="end">{{.EndLabel}}</text></svg></div>
<details class="chart-data" open><summary>View completed work</summary>{{if .Points}}<div class="table-scroll" tabindex="0" aria-label="Completed work cycle times"><table><caption class="sr-only">Completed work cycle times</caption><thead><tr><th scope="col">Work item</th><th scope="col">Summary</th><th scope="col">Completed</th><th scope="col">Cycle time</th></tr></thead><tbody>{{range .Points}}<tr><th scope="row"><a href="/browse/{{.Key}}">{{.Key}}</a></th><td>{{.Summary}}</td><td>{{.Completed}}</td><td>{{.CycleDuration}}</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No work was started and completed in this window.</p>{{end}}</details></section>
{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_progress_report"}}
<!doctype html><html lang="en"><head><title>{{.Data.Title}} · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>{{.Data.Title}}</h1><p>Follow the estimate of the work over time, and what is done and what remains.</p></div>{{template "report_actions" .Data.Actions}}</header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}{{if and .Data.Board .Data.Choices}}<form method="get"><input type="hidden" name="board" value="{{.Data.Board.JiraID}}"><label for="report-{{.Data.Kind}}">{{if eq .Data.Kind "epic"}}Epic{{else}}Version{{end}}</label><select id="report-{{.Data.Kind}}" name="{{.Data.Parameter}}">{{range .Data.Choices}}<option value="{{.Value}}" {{if eq .Value $.Data.Selected}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show {{.Data.Kind}}</button></form>{{end}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No boards</strong><small>The {{.Data.Kind}} report reads estimates through a project board.</small></section>
{{else if not .Data.Choices}}<section class="surface-card empty-state"><strong>Nothing to report on</strong><small>{{.Data.Empty}}</small></section>
{{else}}{{with .Data.Report}}
<section class="sprint-report-summary" aria-label="Progress summary"><article class="surface-card"><span class="eyebrow">Complete</span><strong>{{.Percent}}%</strong><p>{{.Progress.Done}} of {{.Progress.Total}} work items done</p></article><article class="surface-card"><span class="eyebrow">Total</span><strong>{{.TotalText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Remaining</span><strong>{{.RemainingText}}</strong><p>{{.Statistic}}</p></article><article class="surface-card"><span class="eyebrow">Unestimated</span><strong>{{.Unestimated}}</strong><p>work items</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="progress-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Statistic}}</span><h2 id="progress-title">Progress over time</h2></div><div class="chart-legend"><span><i class="legend-commitment"></i>Total</span><span><i class="legend-success"></i>Completed</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable progress chart"><svg class="agile-chart" viewBox="0 0 {{.Chart.Width}} {{.Chart.Height}}" role="img" aria-labelledby="progress-chart-title progress-chart-desc"><title id="progress-chart-title">Total and completed {{.Statistic}} by day</title><desc id="progress-chart-desc">The grey line is the estimate of all the work that existed each day and the green line the estimate of the work done; the gap is the work that remained. The daily values follow in a table.</desc>{{range .Chart.Ticks}}<line x1="{{$.Data.Report.Chart.Left}}" y1="{{.Y}}" x2="{{$.Data.Report.Chart.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Report.Chart.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}<polyline points="{{.Chart.Total}}" class="chart-scope"/><polyline points="{{.Chart.Completed}}" class="chart-completed-line"/><text x="{{.Chart.Left}}" y="244" class="chart-label">{{.Chart.StartLabel}}</text><text x="{{.Chart.Right}}" y="244" class="chart-label" text-anchor="end">{{.Chart.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View daily progress</summary><div class="table-scroll" tabindex="0" aria-label="Daily progress"><table><caption class="sr-only">Daily progress</caption><thead><tr><th scope="col">Date</th><th scope="col">Total</th><th scope="col">Completed</th></tr></thead><tbody>{{range .Points}}<tr><th scope="row">{{.Date}}</th><td>{{.Total}}</td><td>{{.Completed}}</td></tr>{{end}}</tbody></table></div></details></section>
{{range .Sections}}{{template "sprint_report_work" .}}{{end}}
{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "issue_analysis_window"}}<form class="report-window" method="get"><label for="report-days">Time window</label><select id="report-days" name="days">{{range .Windows}}<option value="{{.}}" {{if eq . $.Days}}selected{{end}}>Last {{.}} days</option>{{end}}</select>{{with .CreatedResolved}}<label class="report-toggle"><input type="checkbox" name="cumulative" value="true" {{if .Cumulative}}checked{{end}}> Running totals</label>{{end}}<label class="report-toggle"><input type="checkbox" name="compare" value="previous" {{if .Compare}}checked{{end}}> Compare with previous period</label><button class="btn" type="submit">Update</button></form>{{end}}

{{define "page_created_resolved_report"}}
<!doctype html><html lang="en"><head><title>Created vs. resolved · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Created vs. resolved</span></nav>
<header class="page-header"><div><span class="eyebrow">Issue analysis</span><h1>Created vs. resolved</h1><p>Compare the work created with the work resolved, to see whether the backlog is growing or shrinking.</p></div>{{template "report_actions" .Data.Actions}}{{template "issue_analysis_window" .Data}}</header>
{{with .Data.CreatedResolved}}
<section class="sprint-report-summary" aria-label="Created and resolved totals"><article class="surface-card"><span class="eyebrow">Created</span><strong>{{.CreatedTotal}}</strong><p>work items in {{$.Data.Days}} days</p>{{with index $.Data.Comparison "created"}}<small class="report-change">{{.}}</small>{{end}}</article><article class="surface-card"><span class="eyebrow">Resolved</span><strong>{{.ResolvedTotal}}</strong><p>work items in {{$.Data.Days}} days</p>{{with index $.Data.Comparison "resolved"}}<small class="report-change">{{.}}</small>{{end}}</article></section>
<section class="surface-card dora-chart-card" aria-labelledby="created-resolved-title"><header class="release-section-heading"><div><span class="eyebrow">{{if .Cumulative}}Running totals{{else}}Per day{{end}}</span><h2 id="created-resolved-title">Created and resolved work</h2></div><div class="chart-legend"><span><i class="legend-remaining"></i>Created</span><span><i class="legend-success"></i>Resolved</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable created and resolved chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="created-resolved-chart-title created-resolved-chart-desc"><title id="created-resolved-chart-title">Work created and resolved {{if .Cumulative}}as running totals{{else}}each day{{end}}</title><desc id="created-resolved-chart-desc">The red line counts created work and the green line resolved work; where red stays above green the backlog grows. The daily values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.CreatedResolved.Left}}" y1="{{.Y}}" x2="{{$.Data.CreatedResolved.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.CreatedResolved.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}<polyline points="{{.Created}}" class="chart-remaining"/><polyline points="{{.Resolved}}" class="chart-completed-line"/><text x="{{.Left}}" y="244" class="chart-label">{{.StartLabel}}</text><text x="{{.Right}}" y="244" class="chart-label" text-anchor="end">{{.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View daily counts</summary><div class="table-scroll" tabindex="0" aria-label="Created and resolved by day"><table><caption class="sr-only">Created and resolved by day</caption><thead><tr><th scope="col">Date</th><th scope="col">Created</th><th scope="col">Resolved</th><th scope="col">Created in total</th><th scope="col">Resolved in total</th></tr></thead><tbody>{{range .Rows}}<tr><th scope="row">{{.Date}}</th><td>{{.Created}}</td><td>{{.Resolved}}</td><td>{{.CreatedTotal}}</td><td>{{.ResolvedTotal}}</td></tr>{{end}}</tbody></table></div></details></section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_resolution_time_report"}}
<!doctype html><html lang="en"><head><title>Resolution time · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Resolution time</span></nav>
<header class="page-header"><div><span class="eyebrow">Issue analysis</span><h1>Resolution time</h1><p>See how long work takes from creation to resolution, for the work resolved each day.</p></div>{{template "report_actions" .Data.Actions}}{{template "issue_analysis_window" .Data}}</header>
{{with .Data.Resolution}}
<section class="sprint-report-summary" aria-label="Resolution summary"><article class="surface-card"><span class="eyebrow">Resolved</span><strong>{{.Resolved}}</strong><p>work items in {{$.Data.Days}} days</p>{{with index $.Data.Comparison "resolved"}}<small class="report-change">{{.}}</small>{{end}}</article><article class="surface-card"><span class="eyebrow">Average resolution time</span><strong>{{if .Average}}{{.Average}}{{else}}-{{end}}</strong><p>creation to resolution</p>{{with index $.Data.Comparison "average"}}<small class="report-change">{{.}}</small>{{end}}</article></section>
<section class="surface-card dora-chart-card" aria-labelledby="resolution-title"><header class="release-section-heading"><div><span class="eyebrow">Last {{$.Data.Days}} days</span><h2 id="resolution-title">Average resolution time by day</h2></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable resolution time chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="resolution-chart-title resolution-chart-desc"><title id="resolution-chart-title">Average resolution time of the work resolved each day</title><desc id="resolution-chart-desc">Each bar is the average time from creation to resolution of the work resolved that day; days without resolved work have no bar. The values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.Resolution.Left}}" y1="{{.Y}}" x2="{{$.Data.Resolution.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.Resolution.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{range .Bars}}{{if .Resolved}}<rect x="{{.X}}" y="{{.Y}}" width="{{$.Data.Resolution.BarWidth}}" height="{{.Height}}" class="chart-completed"><title>{{.Date}}: {{.Average}} over {{.Resolved}}</title></rect>{{end}}{{end}}<text x="{{.Left}}" y="244" class="chart-label">{{.StartLabel}}</text><text x="{{.Right}}" y="244" class="chart-label" text-anchor="end">{{.EndLabel}}</text></svg></div>
<details class="chart-data"><summary>View daily resolution time</summary><div class="table-scroll" tabindex="0" aria-label="Resolution time by day"><table><caption class="sr-only">Resolution time by day</caption><thead><tr><th scope="col">Date</th><th scope="col">Resolved</th><th scope="col">Average resolution time</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Date}}</th><td>{{.Resolved}}</td><td>{{if .Average}}{{.Average}}{{else}}-{{end}}</td></tr>{{end}}</tbody></table></div></details></section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
{{define "page_burndown_report"}}
<!doctype html><html lang="en"><head><title>{{.Data.Title}} · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Agile</span><h1>{{.Data.Title}}</h1><p>What each sprint finished, what arrived in it, and how much work was left when it ended.</p></div>{{template "report_actions" .Data.Actions}}</header>
<div class="agile-report-controls">{{template "agile_report_board_form" .Data}}{{if and .Data.Board .Data.Choices}}<form method="get"><input type="hidden" name="board" value="{{.Data.Board.JiraID}}"><label for="burndown-{{.Data.Parameter}}">{{if eq .Data.Parameter "epic"}}Epic{{else}}Version{{end}}</label><select id="burndown-{{.Data.Parameter}}" name="{{.Data.Parameter}}">{{range .Data.Choices}}<option value="{{.Value}}" {{if eq .Value $.Data.Selected}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show {{if eq .Data.Parameter "epic"}}epic{{else}}version{{end}}</button></form>{{end}}</div>
{{if not .Data.Board}}<section class="surface-card empty-state"><strong>No boards</strong><small>A burndown reads its sprints and estimates through a project board.</small></section>
{{else if not .Data.Choices}}<section class="surface-card empty-state"><strong>Nothing to report on</strong><small>{{.Data.Empty}}</small></section>
{{else}}{{with .Data.View}}
<section class="sprint-report-summary" aria-label="Burndown summary"><article class="surface-card"><span class="eyebrow">Remaining</span><strong>{{.RemainingText}}</strong><p>{{.Statistic}} left now</p></article><article class="surface-card"><span class="eyebrow">Sprints</span><strong>{{len .Sprints}}</strong><p>started sprints on this board</p></article><article class="surface-card"><span class="eyebrow">Unestimated</span><strong>{{.Unestimated}}</strong><p>work items carry no estimate</p></article></section>
{{if not .Sprints}}<section class="surface-card empty-state"><strong>No sprints yet</strong><small>A burndown is drawn sprint by sprint, so the board needs a started sprint.</small></section>
{{else}}
<section class="surface-card dora-chart-card" aria-labelledby="burndown-title"><header class="release-section-heading"><div><span class="eyebrow">Sprint by sprint</span><h2 id="burndown-title">{{$.Data.Title}}</h2></div><div class="chart-legend"><span><i class="legend-completed"></i>Completed</span><span><i class="legend-commitment"></i>Added</span><span><i class="legend-remaining"></i>Remaining</span></div></header>
<div class="chart-scroll" tabindex="0" aria-label="Scrollable burndown chart"><svg class="agile-chart" viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-labelledby="burndown-chart-title burndown-chart-desc"><title id="burndown-chart-title">{{$.Data.Title}} by sprint</title><desc id="burndown-chart-desc">Each sprint has a bar for the work it completed and the work that arrived in it, with a line for the work left when it ended. The values follow in a table.</desc>{{range .Ticks}}<line x1="{{$.Data.View.Left}}" y1="{{.Y}}" x2="{{$.Data.View.Right}}" y2="{{.Y}}" class="chart-axis"/><text x="{{$.Data.View.TickX}}" y="{{.Y}}" class="chart-label" text-anchor="end" dominant-baseline="middle">{{.Label}}</text>{{end}}{{range .Bars}}<rect x="{{.X}}" y="{{.CompletedY}}" width="{{$.Data.View.BarWidth}}" height="{{.CompletedHeight}}" class="chart-completed"><title>{{.Name}}: {{.CompletedText}} completed</title></rect><rect x="{{.X}}" y="{{.AddedY}}" width="{{$.Data.View.BarWidth}}" height="{{.AddedHeight}}" class="chart-commitment"><title>{{.Name}}: {{.AddedText}} added</title></rect>{{end}}<polyline class="chart-remaining" points="{{.Line}}"/>{{range .Bars}}<circle cx="{{.PointX}}" cy="{{.PointY}}" r="3" class="chart-remaining-point"><title>{{.Name}}: {{.RemainingText}} remaining</title></circle>{{end}}</svg></div>
<details class="chart-data"><summary>View sprint by sprint</summary><div class="table-scroll" tabindex="0" aria-label="Burndown by sprint"><table><caption class="sr-only">Work completed, added and remaining in each sprint</caption><thead><tr><th scope="col">Sprint</th><th scope="col">Completed</th><th scope="col">Added</th><th scope="col">Remaining</th></tr></thead><tbody>{{range .Bars}}<tr><th scope="row">{{.Name}}</th><td>{{.CompletedText}}</td><td>{{.AddedText}}</td><td>{{.RemainingText}}</td></tr>{{end}}</tbody></table></div></details></section>
{{end}}{{end}}{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_workload_report"}}
<!doctype html><html lang="en"><head><title>{{.Data.Title}} · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">Workload</span><h1>{{.Data.Title}}</h1><p>The work nobody has resolved yet, and the time it is estimated to still take.</p></div>{{template "report_actions" .Data.Actions}}</header>
{{if .Data.Choices}}<div class="agile-report-controls"><form method="get"><label for="workload-version">Version</label><select id="workload-version" name="version">{{range .Data.Choices}}<option value="{{.Value}}" {{if eq .Value $.Data.Selected}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show version</button></form></div>{{end}}
{{if and (eq .Data.Kind "version-workload") (not .Data.Choices)}}<section class="surface-card empty-state"><strong>Nothing to report on</strong><small>{{.Data.Empty}}</small></section>
{{else if not .Data.Rows}}<section class="surface-card empty-state"><strong>Nothing left to do</strong><small>{{.Data.Empty}}</small></section>
{{else}}
<section class="sprint-report-summary" aria-label="Workload summary"><article class="surface-card"><span class="eyebrow">Unresolved</span><strong>{{.Data.Issues}}</strong><p>work items</p></article><article class="surface-card"><span class="eyebrow">Remaining estimate</span><strong>{{if .Data.Remaining}}{{.Data.Remaining}}{{else}}0m{{end}}</strong><p>across the unresolved work</p></article><article class="surface-card"><span class="eyebrow">Estimated</span><strong>{{.Data.Estimated}}</strong><p>of {{.Data.Issues}} carry an estimate</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="workload-people-title"><header class="release-section-heading"><div><span class="eyebrow">By person</span><h2 id="workload-people-title">Who holds the work</h2></div></header>
<div class="table-scroll report-table" tabindex="0" aria-label="Workload by person"><table class="issue-list"><caption class="sr-only">Unresolved work by assignee</caption><thead><tr><th scope="col">Assignee</th><th scope="col">Work items</th><th scope="col">Remaining estimate</th></tr></thead><tbody>{{range .Data.Rows}}<tr><th scope="row">{{.Name}}</th><td>{{.Issues}}</td><td>{{.Remaining}}</td></tr>{{end}}</tbody><tfoot><tr><th scope="row">Total</th><td>{{.Data.Issues}}</td><td>{{if .Data.Remaining}}{{.Data.Remaining}}{{else}}0m{{end}}</td></tr></tfoot></table></div></section>
{{if .Data.Types}}<section class="surface-card dora-chart-card" aria-labelledby="workload-types-title"><header class="release-section-heading"><div><span class="eyebrow">By work type</span><h2 id="workload-types-title">What kind of work is left</h2></div></header>
<div class="table-scroll report-table" tabindex="0" aria-label="Workload by work type"><table class="issue-list"><caption class="sr-only">Unresolved work by work type</caption><thead><tr><th scope="col">Work type</th><th scope="col">Work items</th><th scope="col">Remaining estimate</th></tr></thead><tbody>{{range .Data.Types}}<tr><th scope="row">{{.Name}}</th><td>{{.Issues}}</td><td>{{.Remaining}}</td></tr>{{end}}</tbody></table></div></section>{{end}}
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_time_tracking_report"}}
<!doctype html><html lang="en"><head><title>Time tracking · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Time tracking</span></nav>
<header class="page-header"><div><span class="eyebrow">Workload</span><h1>Time tracking</h1><p>What the unresolved work was estimated to take, what it has cost so far, and what is left.</p></div>{{template "report_actions" .Data.Actions}}</header>
{{if .Data.Choices}}<div class="agile-report-controls"><form method="get"><label for="time-tracking-version">Version</label><select id="time-tracking-version" name="version"><option value="">Whole project</option>{{range .Data.Choices}}<option value="{{.Value}}" {{if eq .Value $.Data.Selected}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Show</button></form></div>{{end}}
{{if not .Data.Rows}}<section class="surface-card empty-state"><strong>Nothing left to do</strong><small>Unresolved work with estimates or logged time appears here.</small></section>
{{else}}
<section class="sprint-report-summary" aria-label="Time tracking summary"><article class="surface-card"><span class="eyebrow">Original estimate</span><strong>{{.Data.Original}}</strong><p>for the unresolved work</p></article><article class="surface-card"><span class="eyebrow">Time spent</span><strong>{{.Data.Spent}}</strong><p>logged so far</p></article><article class="surface-card"><span class="eyebrow">Remaining estimate</span><strong>{{.Data.Remaining}}</strong><p>still to do</p></article><article class="surface-card"><span class="eyebrow">Accuracy</span><strong>{{if .Data.Over}}−{{end}}{{.Data.Accuracy}}</strong><p>{{if .Data.Over}}over the original estimate{{else}}under the original estimate{{end}}</p></article></section>
<section class="surface-card dora-chart-card" aria-labelledby="time-tracking-title"><header class="release-section-heading"><div><span class="eyebrow">Work item by work item</span><h2 id="time-tracking-title">Estimates against time spent</h2></div></header>
<div class="table-scroll report-table" tabindex="0" aria-label="Time tracking by work item"><table class="issue-list"><caption class="sr-only">Estimates and time spent for each unresolved work item</caption><thead><tr><th scope="col">Key</th><th scope="col">Summary</th><th scope="col">Original estimate</th><th scope="col">Time spent</th><th scope="col">Remaining estimate</th><th scope="col">Accuracy</th></tr></thead><tbody>{{range .Data.Rows}}<tr><th scope="row"><a href="/browse/{{.Key}}">{{.Key}}</a></th><td>{{.Summary}}</td><td>{{.Original}}</td><td>{{.Spent}}</td><td>{{.Remaining}}</td><td>{{if .Over}}−{{end}}{{.Accuracy}}</td></tr>{{end}}</tbody><tfoot><tr><th scope="row">Total</th><td></td><td>{{.Data.Original}}</td><td>{{.Data.Spent}}</td><td>{{.Data.Remaining}}</td><td>{{if .Data.Over}}−{{end}}{{.Data.Accuracy}}</td></tr></tfoot></table></div></section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_group_by_report"}}
<!doctype html><html lang="en"><head><title>Work by field · {{.Data.Project.Name}} · {{(site $).Title}}</title>{{template "head" .}}</head><body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/reports">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Work by field</span></nav>
<header class="page-header"><div><span class="eyebrow">Issue analysis</span><h1>Work by field</h1><p>How the project's work divides by one field, with the share each group holds.</p></div>{{template "report_actions" .Data.Actions}}</header>
<div class="agile-report-controls"><form method="get"><label for="group-by-field">Group by</label><select id="group-by-field" name="field">{{range .Data.Fields}}<option value="{{.Value}}" {{if eq .Value $.Data.Field}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Group</button></form></div>
{{if not .Data.Report.Rows}}<section class="surface-card empty-state"><strong>No work yet</strong><small>Create work in this project to see how it divides.</small></section>
{{else}}
<section class="surface-card dora-chart-card" aria-labelledby="group-by-title"><header class="release-section-heading"><div><span class="eyebrow">{{.Data.Report.Issues}} work items</span><h2 id="group-by-title">Work by the chosen field</h2></div></header>
<div class="table-scroll report-table" tabindex="0" aria-label="Work by the chosen field"><table class="issue-list"><caption class="sr-only">Work items counted by the chosen field</caption><thead><tr><th scope="col">Group</th><th scope="col">Work items</th><th scope="col">Share</th></tr></thead><tbody>{{range .Data.Report.Rows}}<tr><th scope="row">{{.Name}}</th><td>{{.Issues}}</td><td><span class="group-by-share"><span class="group-by-bar" style="width: {{.Percent}}%"></span>{{.Percent}}%</span></td></tr>{{end}}</tbody><tfoot><tr><th scope="row">Total</th><td>{{.Data.Report.Issues}}</td><td>100%</td></tr></tfoot></table></div></section>
{{end}}
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "report_actions"}}<div class="dashboard-actions"><a class="btn" href="{{.CSVURL}}" download>Download CSV</a><details class="dashboard-subscribe report-subscribe"{{if .EmailError}} open{{end}}><summary class="btn">Email this report</summary><div class="surface-card dashboard-subscribe-panel">{{with .EmailError}}<p class="form-error" role="alert">{{.}}</p>{{end}}{{range .Subscriptions}}<form method="post" action="/reports/email"><input type="hidden" name="action" value="unsubscribe"><input type="hidden" name="report" value="{{$.Target}}"><input type="hidden" name="subscriptionId" value="{{.ID}}"><span><strong>{{if eq .CronExpression "0 8 * * *"}}Every day at 08:00{{else if eq .CronExpression "0 8 * * 1"}}Every Monday at 08:00{{else}}{{.CronExpression}}{{end}} in {{if .Timezone}}{{.Timezone}}{{else}}UTC{{end}}</strong>{{if .NextRunAt}}<small>Next <time datetime="{{.NextRunAt}}">{{.NextRunAt}}</time></small>{{end}}{{if .LastError}}<small class="form-error">{{.LastError}}</small>{{end}}</span><button class="btn" type="submit">Remove email</button></form>{{end}}<form method="post" action="/reports/email" class="project-details-form"><input type="hidden" name="action" value="subscribe"><input type="hidden" name="report" value="{{.Target}}"><label for="report-schedule">Delivery</label><select id="report-schedule" name="schedule"><option value="0 8 * * *">Every day at 08:00</option><option value="0 8 * * 1">Every Monday at 08:00</option></select><label for="report-cron">Or a cron expression</label><input id="report-cron" name="cron" placeholder="0 0 9 ? * MON-FRI"><label for="report-zone">Time zone</label><input id="report-zone" name="timezone" placeholder="UTC"><fieldset><legend>Recipients</legend>{{range .Members}}<label><input type="checkbox" name="recipient" value="{{.ID}}"{{if eq .ID $.CurrentUserID}} checked{{end}}> {{.DisplayName}}</label>{{end}}</fieldset><p class="form-hint">Each recipient receives this report's data with the choices on this page, as they see it, and must be able to open it.</p><button class="btn btn-primary" type="submit">Schedule email</button></form></div></details></div>{{end}}
