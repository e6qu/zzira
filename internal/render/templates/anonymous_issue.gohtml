{{define "page_anonymous_issue"}}
<!doctype html><html lang="en"><head><title>{{.Data.Issue.Key}} · {{.Data.Issue.Summary}} · {{(site $).Title}}</title><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"><script>(function(){var saved;try{saved=localStorage.getItem('zzira-theme');}catch(_){}document.documentElement.dataset.theme=saved==='light'||saved==='dark'?saved:window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';})();</script><link rel="stylesheet" href="/static/css/tokens.css?v=4"><link rel="stylesheet" href="/static/css/workspace.css?v=67"></head><body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="global-header"><a class="logo" href="/login" aria-label="{{(site $).Title}} login"><span class="logo-mark" aria-hidden="true">Z</span> {{(site $).Title}}</a><a class="btn" href="/login">Log in</a></header>
<main class="page anonymous-issue-page" id="main-content" tabindex="-1"><nav class="issue-breadcrumbs" aria-label="Work item"><a href="/projects">Public projects</a><span aria-hidden="true">/</span><a href="/issues/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Issue.Key}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Issue.IssueType.Name}}</span><h1>{{.Data.Issue.Summary}}</h1><p>This work item is publicly visible. <a href="/login">Log in</a> to access your projects and permitted actions.</p></div><span class="lozenge {{statusClass .Data.Issue.Status.Category}}">{{.Data.Issue.Status.Name}}</span></header>
<div class="anonymous-issue-grid"><div>
<section class="surface-card issue-description" aria-labelledby="public-description"><h2 id="public-description">Description</h2><div class="description-text">{{fieldHTML .Data.Issue.Description (index .Data.Issue.FieldRenderers "description")}}</div></section>
<section class="surface-card" aria-labelledby="public-comments"><h2 id="public-comments">Comments</h2>{{if .Data.Comments}}<ol class="anonymous-comment-list">{{range .Data.Comments}}<li><article><header><strong>{{.AuthorName}}</strong> <time datetime="{{.Created}}">{{.When}}</time></header><div class="description-text">{{fieldHTML .Body (index $.Data.Issue.FieldRenderers "comment")}}</div></article></li>{{end}}</ol>{{else}}<p class="muted">No public comments.</p>{{end}}</section>
<section class="surface-card" aria-labelledby="public-attachments"><h2 id="public-attachments">Attachments</h2>{{if .Data.Attachments}}<ul class="attachment-list">{{range .Data.Attachments}}<li><a href="/rest/api/3/attachment/content/{{.JiraID}}">{{.Filename}}</a><small> {{humanSize .Size}}</small></li>{{end}}</ul>{{else}}<p class="muted">No attachments.</p>{{end}}</section>
</div><aside class="surface-card" aria-labelledby="public-details"><h2 id="public-details">Details</h2><dl class="anonymous-issue-details"><dt>Work item</dt><dd>{{.Data.Issue.Key}}</dd><dt>Type</dt><dd>{{.Data.Issue.IssueType.Name}}</dd><dt>Priority</dt><dd>{{if .Data.Issue.Priority}}{{.Data.Issue.Priority.Name}}{{else}}None{{end}}</dd><dt>Assignee</dt><dd>{{if .Data.Issue.Assignee}}{{.Data.Issue.Assignee.DisplayName}}{{else}}Unassigned{{end}}</dd><dt>Reporter</dt><dd>{{if .Data.Issue.Reporter}}{{.Data.Issue.Reporter.DisplayName}}{{else}}None{{end}}</dd>{{if .Data.Issue.Parent}}<dt>Parent</dt><dd><a href="/browse/{{.Data.Issue.Parent.Key}}">{{.Data.Issue.Parent.Key}}</a></dd>{{end}}{{if .Data.Issue.DueDate}}<dt>Due date</dt><dd><time datetime="{{.Data.Issue.DueDate}}">{{.Data.DueDateLabel}}</time></dd>{{end}}</dl></aside></div>
</main></body></html>
{{end}}
