{{define "page_field_configurations"}}
<!doctype html><html lang="en"><head><title>Field configurations · ZZIRA</title>{{template "head" .}}</head>
<body class="page-screens"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Field configurations</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Field configurations</h1><p>Decide which fields are required or hidden, then map work types to a project.</p></div><a class="btn" href="/settings/screens">Edit screens</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}

<section class="surface-card screen-create" aria-labelledby="field-config-create-heading"><div class="screen-mark" aria-hidden="true"><span></span></div><div><h2 id="field-config-create-heading">Create a field configuration</h2><p>A field is optional and visible until you say otherwise. Summary always stays required.</p></div><form class="project-details-form" method="post" action="/settings/field-configurations"><input type="hidden" name="kind" value="configuration"><label for="field-config-name-new">Configuration name</label><input id="field-config-name-new" name="name" maxlength="255" required><label for="field-config-description-new">Description</label><textarea id="field-config-description-new" name="description" rows="2" maxlength="255"></textarea><button class="btn btn-primary" type="submit">Create field configuration</button></form></section>

<div class="screen-list">{{range .Data.Configurations}}{{$card := .}}<article class="surface-card screen-card field-config-card" data-field-config-id="{{.Configuration.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Items}}</span><div><h2>{{.Configuration.Name}}</h2><p>{{.Configuration.Description}}</p></div></div><span class="lozenge">ID {{.Configuration.ID}}</span></header>
<div class="screen-summary"><form class="project-details-form" method="post" action="/settings/field-configurations/{{.Configuration.ID}}"><input type="hidden" name="action" value="update"><label for="field-config-name-{{.Configuration.ID}}">Name</label><input id="field-config-name-{{.Configuration.ID}}" name="name" value="{{.Configuration.Name}}" maxlength="255" required><label for="field-config-description-{{.Configuration.ID}}">Description</label><textarea id="field-config-description-{{.Configuration.ID}}" name="description" rows="2" maxlength="255">{{.Configuration.Description}}</textarea><button class="btn" type="submit">Save details</button></form>
<form class="project-details-form" method="post" action="/settings/field-configurations/{{.Configuration.ID}}"><input type="hidden" name="action" value="set-field"><h3>Add a field rule</h3><label for="field-config-field-{{.Configuration.ID}}">Field</label><select id="field-config-field-{{.Configuration.ID}}" name="fieldId">{{range .Available}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><label for="field-config-behaviour-{{.Configuration.ID}}">Behaviour</label><select id="field-config-behaviour-{{.Configuration.ID}}" name="behaviour"><option value="required">Required</option><option value="hidden">Hidden</option><option value="optional">Optional and visible</option></select><label for="field-config-help-{{.Configuration.ID}}">Help text</label><input id="field-config-help-{{.Configuration.ID}}" name="description" maxlength="255"><button class="btn" type="submit">Save field rule</button></form></div>
<div class="screen-field-ledger" role="table" aria-label="Field rules in {{.Configuration.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Field</span><span role="columnheader">Behaviour</span><span role="columnheader">Help text</span><span role="columnheader">Change</span></div>{{range .Items}}<div class="screen-field-row field-config-row" role="row" data-field-id="{{.FieldID}}"><span role="cell"><strong>{{.Name}}</strong></span><span role="cell"><small>{{if .IsRequired}}Required{{else if .IsHidden}}Hidden{{else}}Optional{{end}}</small></span><span role="cell"><small>{{.Description}}</small></span>{{if eq .FieldID "summary"}}<span role="cell"><small>Always required</small></span>{{else}}<form role="cell" method="post" action="/settings/field-configurations/{{$card.Configuration.ID}}"><input type="hidden" name="action" value="set-field"><input type="hidden" name="fieldId" value="{{.FieldID}}"><input type="hidden" name="behaviour" value="optional"><button class="btn btn-subtle" type="submit">Make optional<span class="sr-only"> {{.Name}}</span></button></form>{{end}}</div>{{end}}</div>
<details class="screen-delete"><summary class="quiet-action">Delete field configuration</summary><form method="post" action="/settings/field-configurations/{{.Configuration.ID}}"><input type="hidden" name="action" value="delete"><p>Remove it from every work type mapping first. The default configuration cannot be deleted.</p><button class="btn btn-danger" type="submit">Delete field configuration</button></form></details></article>{{end}}</div>

<section class="surface-card screen-create" aria-labelledby="field-config-scheme-create-heading"><div class="screen-mark" aria-hidden="true"><span></span></div><div><h2 id="field-config-scheme-create-heading">Create a field configuration scheme</h2><p>This is what a project is assigned. A new scheme points every work type at the default configuration.</p></div><form class="project-details-form" method="post" action="/settings/field-configurations"><input type="hidden" name="kind" value="scheme"><label for="field-scheme-name-new">Scheme name</label><input id="field-scheme-name-new" name="name" maxlength="255" required><label for="field-scheme-description-new">Description</label><textarea id="field-scheme-description-new" name="description" rows="2" maxlength="255"></textarea><button class="btn btn-primary" type="submit">Create field configuration scheme</button></form></section>

<div class="screen-list">{{range .Data.Schemes}}{{$card := .}}<article class="surface-card screen-card field-scheme-card" data-field-scheme-id="{{.Scheme.ID}}"><header><div><span class="screen-badge" aria-hidden="true">{{len .Mappings}}</span><div><h2>{{.Scheme.Name}}</h2><p>{{len .Projects}} assigned projects · {{.Scheme.Description}}</p></div></div><span class="lozenge">ID {{.Scheme.ID}}</span></header>
<div class="screen-field-ledger" role="table" aria-label="Work type mappings for {{.Scheme.Name}}"><div class="screen-field-heading" role="row"><span role="columnheader">Work type</span><span role="columnheader">Field configuration</span><span role="columnheader">Action</span></div>{{range .Mappings}}<div class="screen-field-row field-scheme-mapping-row" role="row" data-issue-type-id="{{.IssueTypeID}}"><span role="cell"><strong>{{.IssueTypeName}}</strong></span><span role="cell"><small>{{.ConfigurationName}}</small></span>{{if .IsDefault}}<span role="cell"><small>Always applies</small></span>{{else}}<form role="cell" method="post" action="/settings/field-configurations/{{$card.Scheme.ID}}"><input type="hidden" name="action" value="remove-issue-type"><input type="hidden" name="issueTypeId" value="{{.IssueTypeID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.IssueTypeName}} mapping</span></button></form>{{end}}</div>{{end}}</div>
<div class="screen-tab-controls"><form method="post" action="/settings/field-configurations/{{.Scheme.ID}}"><input type="hidden" name="action" value="map-issue-type"><label for="field-scheme-type-{{.Scheme.ID}}">Map a work type</label><select id="field-scheme-type-{{.Scheme.ID}}" name="issueTypeId">{{range $.Data.IssueTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><label class="sr-only" for="field-scheme-config-{{.Scheme.ID}}">Field configuration</label><select id="field-scheme-config-{{.Scheme.ID}}" name="configurationId">{{range $.Data.Configurations}}<option value="{{.Configuration.ID}}">{{.Configuration.Name}}</option>{{end}}</select><button class="btn" type="submit">Map work type</button></form>
{{if $.Data.Projects}}<form method="post" action="/settings/field-configurations/{{.Scheme.ID}}"><input type="hidden" name="action" value="assign-project"><label for="field-scheme-project-{{.Scheme.ID}}">Assign a project</label><select id="field-scheme-project-{{.Scheme.ID}}" name="project">{{range $.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign project</button></form>{{end}}</div>
<section><h3>Projects using this scheme</h3><ul class="permission-project-list">{{range .Projects}}<li><a href="/projects/{{.Key}}">{{.Name}}</a><span>{{.Key}}</span></li>{{else}}<li class="empty-state">No projects use this scheme.</li>{{end}}</ul></section>
<details class="screen-delete"><summary class="quiet-action">Delete field configuration scheme</summary><form method="post" action="/settings/field-configurations/{{.Scheme.ID}}"><input type="hidden" name="action" value="delete-scheme"><p>Reassign every project first. The default scheme cannot be deleted.</p><button class="btn btn-danger" type="submit">Delete field configuration scheme</button></form></details></article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
