{{define "page_admin"}}
<!doctype html>
<html lang="en">
<head><title>Administration · ZZIRA</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/admin.css?v=2"></head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
{{template "header" .}}
<div class="app-shell">
{{template "workspace_nav" .}}
<main class="page page-fluid admin-page" id="main-content" tabindex="-1">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb"><span>Administration</span><span aria-hidden="true">/</span><span aria-current="page">Organization</span></nav>
  <header class="page-header">
    <div><span class="eyebrow">Organization administration</span><h1>{{.Data.Organization.Name}}</h1><p>Manage the site, product access, directory groups, and organization audit trail.</p></div>
    <code class="admin-object-id" title="Organization ID">{{.Data.Organization.ID}}</code>
  </header>
  {{if .Data.Saved}}<div class="alert success" role="status">{{.Data.Saved}}</div>{{end}}
  {{if .Data.Error}}<div class="alert error" role="alert">{{.Data.Error}}</div>{{end}}

  <section class="admin-overview" aria-label="Organization overview">
    <article class="surface-card"><span class="eyebrow">Site</span><h2>{{.Data.Site.Name}}</h2><dl><div><dt>Slug</dt><dd>{{.Data.Site.Slug}}</dd></div><div><dt>Cloud ID</dt><dd><code>{{.Data.Site.ID}}</code></dd></div></dl></article>
    <article class="surface-card"><span class="eyebrow">Directory</span>{{with .Data.Directory}}<h2>{{.Name}}</h2><dl><div><dt>Type</dt><dd>{{.Type}}</dd></div><div><dt>Accounts</dt><dd>{{len $.Data.Users}}</dd></div></dl>{{else}}<h2>No active directory</h2>{{end}}</article>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-identity-providers-title">
    <header><div><span class="eyebrow">Authentication</span><h2 id="admin-identity-providers-title">Identity providers</h2></div><p>Configured providers are available on the shared sign-in page. Stored client secrets are encrypted and are never displayed again.</p></header>
    {{if .Data.ProviderRegistrationConfigured}}<details class="admin-provider-registration"><summary>Add OpenID Connect provider</summary><form method="post" action="/admin/identity-providers"><label for="provider-key">Provider key</label><input id="provider-key" name="key" pattern="[a-z][a-z0-9-]{1,30}" maxlength="31" required placeholder="company-sso"><label for="provider-name">Display name</label><input id="provider-name" name="displayName" maxlength="80" required placeholder="Company SSO"><label for="provider-issuer">Issuer URL</label><input id="provider-issuer" name="issuer" type="url" maxlength="2048" required placeholder="https://login.example.com"><label for="provider-client-id">Client ID</label><input id="provider-client-id" name="clientId" maxlength="2048" autocomplete="off" required><label for="provider-client-secret">Client secret</label><input id="provider-client-secret" name="clientSecret" type="password" maxlength="8192" autocomplete="new-password" required><small>Discovery and endpoint validation run before the encrypted registration is saved.</small><button class="btn btn-primary" type="submit">Add provider</button></form></details>{{else}}<p class="admin-configuration-note">Set <code>ZZIRA_IDENTITY_ENCRYPTION_KEY</code> to a base64-encoded 32-byte key to manage encrypted provider credentials here.</p>{{end}}
    <div class="table-scroll" tabindex="0" aria-label="Configured identity providers"><table><thead><tr><th scope="col">Provider</th><th scope="col">Protocol</th><th scope="col">Issuer</th><th scope="col">Source</th><th scope="col">State</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Data.IdentityProviders}}<tr><th scope="row">{{.DisplayName}}</th><td>{{.Kind}}</td><td><code>{{.Issuer}}</code></td><td>{{if .Manageable}}Encrypted database{{else}}Deployment environment{{end}}</td><td><span class="lozenge {{if .Enabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</span></td><td><div class="admin-provider-actions"><form method="post" action="/admin/identity-providers/{{.Key}}">{{if .Enabled}}<button class="btn" name="action" value="disable" type="submit">Disable {{.DisplayName}}</button>{{else}}<button class="btn" name="action" value="enable" type="submit">Enable {{.DisplayName}}</button>{{end}}</form>{{if .Manageable}}<details><summary>Rotate secret</summary><form method="post" action="/admin/identity-providers/{{.Key}}"><label for="provider-secret-{{.Key}}">New client secret</label><input id="provider-secret-{{.Key}}" name="clientSecret" type="password" maxlength="8192" autocomplete="new-password" required><button class="btn" name="action" value="rotate" type="submit">Save new secret</button></form></details><form method="post" action="/admin/identity-providers/{{.Key}}"><button class="btn btn-danger" name="action" value="delete" type="submit">Delete {{.DisplayName}}</button></form>{{end}}</div></td></tr>{{else}}<tr><td colspan="6"><div class="empty-state"><strong>No external identity providers</strong><small>Add an OpenID Connect provider or configure a built-in provider in the deployment environment.</small></div></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" id="admin-apps" aria-labelledby="admin-apps-title">
    <header><div><span class="eyebrow">Extensibility</span><h2 id="admin-apps-title">Apps</h2></div><p>Install a validated descriptor, grant explicit scopes, and manage the signed app lifecycle. Shared secrets are encrypted and never displayed again.</p></header>
    {{if .Data.AppRegistrationConfigured}}<details class="admin-app-install"><summary>Install app</summary><form method="post" action="/admin/apps"><label for="app-descriptor">App descriptor</label><textarea id="app-descriptor" name="descriptor" rows="12" maxlength="262144" spellcheck="false" required>{
  "key": "example.operations",
  "name": "Operations companion",
  "baseUrl": "https://apps.example.com/operations",
  "version": "1.0.0",
  "scopes": ["read:jira-work", "read:app-storage", "write:app-storage", "manage:webhooks"],
  "modules": [{"key":"operations-page","type":"jira:globalPage","location":"jira.navigation","title":"Operations companion","body":"Incident context from the installed app."}],
  "lifecycle": {"installed":"/lifecycle/installed","uninstalled":"/lifecycle/uninstalled"},
  "webhooks": [{"key":"issue-events","url":"/webhooks/issues","events":["jira:issue_created","jira:issue_updated"]}],
  "scheduledTriggers": [{"key":"hourly-sync","url":"/scheduled/hourly","interval":"hour"}]
}</textarea><label for="app-shared-secret">Shared signing secret</label><input id="app-shared-secret" name="sharedSecret" type="password" minlength="16" maxlength="256" autocomplete="new-password" required><small>Signed requests use HMAC-SHA256, a five-minute timestamp window, and a unique request ID.</small><button class="btn btn-primary" type="submit">Install app</button></form></details>{{else}}<p class="admin-configuration-note">Set <code>ZZIRA_IDENTITY_ENCRYPTION_KEY</code> to install apps with encrypted signing credentials.</p>{{end}}
    <div class="admin-app-list">{{range .Data.Apps}}{{$app := .}}<article class="admin-app"><header><div><h3>{{.Name}}</h3><p><code>{{.Key}}</code> · {{.Format}} descriptor · version {{.Version}}</p></div><span class="lozenge {{if eq .Status "active"}}lozenge-success{{else if eq .Status "suspended"}}lozenge-current{{else}}lozenge-default{{end}}">{{.Status}}</span></header><dl><div><dt>Base URL</dt><dd><code>{{.BaseURL}}</code></dd></div><div><dt>Principal</dt><dd><code>{{.PrincipalID}}</code></dd></div><div><dt>Installed</dt><dd>{{.InstalledAt.Format "2006-01-02 15:04"}} UTC</dd></div></dl><div class="admin-app-capabilities"><div><strong>Scopes</strong><ul>{{range .Scopes}}<li><code>{{.}}</code></li>{{else}}<li>No scopes granted</li>{{end}}</ul></div><div><strong>Modules</strong><ul>{{range .Modules}}<li>{{if eq $app.Status "active"}}<a href="/apps/modules/{{.ID}}">{{.Title}}</a>{{else}}{{.Title}}{{end}} <small>{{.Type}} · {{.Location}}{{if .Dynamic}} · dynamic{{end}}{{if .RemoteURL}} · <code>{{.RemoteURL}}</code>{{end}}</small></li>{{else}}<li>No modules registered</li>{{end}}</ul></div><div><strong>Issue fields</strong><ul>{{range .IssueFields}}<li>{{.Name}} <small><code>{{.AppKey}}__{{.Key}}</code> · {{.Type}}{{if .Dynamic}} · dynamic{{end}}{{if ne $app.Status "active"}} · unavailable{{else if not .Active}} · inactive{{end}}</small></li>{{else}}<li>No issue fields registered</li>{{end}}</ul></div><div><strong>Lifecycle</strong><ul>{{range $event, $path := .Lifecycle}}<li><code>{{$event}}</code> <small>{{$path}}</small></li>{{else}}<li>No callbacks registered</li>{{end}}</ul></div><div><strong>Webhooks</strong><ul>{{range .Webhooks}}<li><code>{{.Key}}</code> <small>{{.Path}} · {{len .Events}} events{{if .Dynamic}} · dynamic{{end}}{{if .JQL}} · filtered{{end}}</small></li>{{else}}<li>No webhooks registered</li>{{end}}</ul></div><div><strong>Schedules</strong><ul>{{range .ScheduledTriggers}}<li><code>{{.Key}}</code> <small>{{.Interval}} · next {{.NextRunAt.Format "2006-01-02 15:04"}} UTC</small></li>{{else}}<li>No schedules registered</li>{{end}}</ul></div></div>{{if .OutboundDeliveries}}<details class="admin-app-deliveries"><summary>Recent deliveries</summary><div class="table-scroll" tabindex="0" aria-label="Recent deliveries for {{.Name}}"><table><thead><tr><th scope="col">Kind</th><th scope="col">Event</th><th scope="col">State</th><th scope="col">Attempts</th><th scope="col">Created</th></tr></thead><tbody>{{range .OutboundDeliveries}}<tr><td>{{.Kind}}</td><td><code>{{.Event}}</code></td><td><span class="lozenge {{if eq .State "delivered"}}lozenge-success{{else if eq .State "failed"}}lozenge-warning{{else}}lozenge-current{{end}}">{{.State}}</span>{{if .LastError}}<small class="admin-app-delivery-error">{{.LastError}}</small>{{end}}</td><td>{{.Attempts}}</td><td>{{.CreatedAt.Format "2006-01-02 15:04"}} UTC</td></tr>{{end}}</tbody></table></div></details>{{end}}{{if ne .Status "uninstalled"}}<form class="admin-app-actions" method="post" action="/admin/apps/{{.Key}}">{{if eq .Status "active"}}<button class="btn" name="action" value="suspend" type="submit">Suspend {{.Name}}</button>{{else}}<button class="btn" name="action" value="resume" type="submit">Resume {{.Name}}</button>{{end}}<button class="btn btn-danger" name="action" value="uninstall" type="submit">Uninstall {{.Name}}</button></form>{{else}}<small>Install the descriptor again with a new secret to restore this app.</small>{{end}}</article>{{else}}<div class="empty-state"><strong>No apps installed</strong><small>Install a descriptor to add scoped modules to ZZIRA.</small></div>{{end}}</div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-domains-title">
    <header><div><span class="eyebrow">Identity boundary</span><h2 id="admin-domains-title">Domains</h2></div><p>Claim an email domain with a DNS TXT record before applying organization-wide authentication policy.</p></header>
    <form class="admin-domain-create" method="post" action="/admin/domains"><label for="admin-domain-name">Domain name</label><input id="admin-domain-name" name="name" placeholder="example.com" required maxlength="253"><button class="btn btn-primary" type="submit">Add domain</button></form>
    <div class="table-scroll"><table><thead><tr><th scope="col">Domain</th><th scope="col">Claim</th><th scope="col">DNS verification</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Data.Domains}}<tr><th scope="row">{{.Name}}</th><td><span class="lozenge {{if eq .ClaimStatus "verified"}}lozenge-success{{else}}lozenge-default{{end}}">{{.ClaimStatus}}</span></td><td>{{if eq .ClaimStatus "verified"}}Verified{{else}}<code>_zzira-challenge.{{.Name}}</code><small class="admin-domain-token">TXT zzira-domain-verification={{.VerificationToken}}</small>{{end}}</td><td><form class="admin-domain-actions" method="post" action="/admin/domains/{{.ID}}">{{if ne .ClaimStatus "verified"}}<button class="btn" name="action" value="verify" type="submit">Verify DNS</button>{{end}}<button class="btn btn-danger" name="action" value="delete" type="submit">Remove</button></form></td></tr>{{else}}<tr><td colspan="4"><div class="empty-state"><strong>No claimed domains</strong><small>Add a domain to begin DNS verification.</small></div></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-policies-title">
    <header><div><span class="eyebrow">Access policy</span><h2 id="admin-policies-title">Policies</h2></div><p>Define the networks or residency locations allowed for selected products, then enable the policy when it is ready.</p></header>
    <form class="admin-policy-create" method="post" action="/admin/policies"><label for="admin-policy-name">Policy name</label><input id="admin-policy-name" name="name" required maxlength="255"><label for="admin-policy-type">Policy type</label><select id="admin-policy-type" name="type"><option value="ip-allowlist">IP allowlist</option><option value="data-residency">Data residency</option></select><label for="admin-policy-values">Rule values</label><textarea id="admin-policy-values" name="values" rows="2" required placeholder="192.0.2.0/24, 198.51.100.4"></textarea><fieldset><legend>Policy products</legend>{{range .Data.Products}}<label><input type="checkbox" name="resourceId" value="ari:cloud:{{.Key}}::site/{{.SiteID}}"> {{.Name}}</label>{{end}}</fieldset><label class="admin-policy-enabled"><input type="checkbox" name="enabled" value="true"> Enable immediately</label><button class="btn btn-primary" type="submit">Create policy</button></form>
    <div class="admin-policies">{{range .Data.Policies}}<article class="admin-policy"><header><div><h3>{{.Name}}</h3><p>{{.Type}} · {{len .Resources}} product{{if ne (len .Resources) 1}}s{{end}}</p></div><span class="lozenge {{if eq .Status "enabled"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Status}}</span></header><div class="admin-policy-rule"><strong>Allowed values</strong><ul>{{range index .Rule "in"}}<li><code>{{.}}</code></li>{{end}}</ul></div><div class="admin-policy-resources"><strong>Products</strong><ul>{{range .Resources}}<li><code>{{.ID}}</code><span>{{.ApplicationStatus}}</span></li>{{else}}<li>No products attached</li>{{end}}</ul></div><form class="admin-policy-actions" method="post" action="/admin/policies/{{.ID}}">{{if eq .Status "enabled"}}<button class="btn" name="action" value="disable" type="submit">Disable</button>{{else}}<button class="btn" name="action" value="enable" type="submit">Enable</button>{{end}}<button class="btn btn-danger" name="action" value="delete" type="submit">Delete policy</button></form></article>{{else}}<div class="empty-state"><strong>No access policies</strong><small>Create a disabled policy, review its product scope, then enable it.</small></div>{{end}}</div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-products-title">
    <header><div><span class="eyebrow">Access</span><h2 id="admin-products-title">Products</h2></div><p>Existing workspace memberships are mapped into explicit site and product roles.</p></header>
    <div class="table-scroll"><table><thead><tr><th scope="col">Product</th><th scope="col">Key</th><th scope="col">State</th></tr></thead><tbody>{{range .Data.Products}}<tr><th scope="row">{{.Name}}</th><td><code>{{.Key}}</code></td><td><span class="lozenge {{if .Enabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</span></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-users-title">
    <header><div><span class="eyebrow">Managed accounts</span><h2 id="admin-users-title">People</h2></div><p>Invitations provision an account for provider sign-in. Suspension removes access in this directory; credentials remain valid when another directory is active.</p></header>
    {{with .Data.Directory}}<form class="admin-user-invite" method="post" action="/admin/users/invite">
      <label for="admin-user-name">Display name</label><input id="admin-user-name" name="displayName" required maxlength="255">
      <label for="admin-user-email">Email</label><input id="admin-user-email" name="email" type="email" required maxlength="320">
      <button class="btn btn-primary" type="submit">Invite user</button>
      <div class="admin-invite-options">
        <fieldset><legend>Product access</legend>{{range $.Data.Products}}<label><input type="checkbox" name="productId" value="{{.ID}}"> {{.Name}}</label>{{end}}</fieldset>
        <fieldset><legend>Group membership</legend>{{range $.Data.Groups}}<label><input type="checkbox" name="groupId" value="{{.Group.ID}}"> {{.Group.Name}}</label>{{else}}<small>Create a group to assign it during invitation.</small>{{end}}</fieldset>
        <fieldset><legend>Invitation email</legend>{{if $.Data.InvitationNotificationsConfigured}}<label><input type="checkbox" name="sendNotification" value="true"> Send invitation email</label><label for="admin-invite-message">Personal message</label><textarea id="admin-invite-message" name="notificationText" maxlength="4000" rows="2"></textarea>{{else}}<small>Email delivery is unavailable until SMTP is configured.</small>{{end}}</fieldset>
      </div>
    </form>{{end}}
    <div class="table-scroll"><table><thead><tr><th scope="col">Person</th><th scope="col">Email</th><th scope="col">Profile</th><th scope="col">Status</th><th scope="col">Account actions</th></tr></thead><tbody>{{range .Data.Users}}<tr><th scope="row">{{.DisplayName}}{{if .Nickname}}<small>{{.Nickname}}</small>{{end}}</th><td>{{.Email}}</td><td><span>{{if .JobTitle}}{{.JobTitle}}{{else}}No job title{{end}}{{if .Department}} · {{.Department}}{{end}}</span><details class="admin-profile-editor"><summary>Edit profile</summary><form method="post" action="/admin/users/{{.ID}}/profile"><label for="profile-name-{{.ID}}">Display name</label><input id="profile-name-{{.ID}}" name="displayName" value="{{.DisplayName}}" maxlength="255" required><label for="profile-nickname-{{.ID}}">Nickname</label><input id="profile-nickname-{{.ID}}" name="nickname" value="{{.Nickname}}" maxlength="255"><label for="profile-title-{{.ID}}">Job title</label><input id="profile-title-{{.ID}}" name="jobTitle" value="{{.JobTitle}}" maxlength="255"><label for="profile-department-{{.ID}}">Department</label><input id="profile-department-{{.ID}}" name="department" value="{{.Department}}" maxlength="255"><label for="profile-organization-{{.ID}}">Organization</label><input id="profile-organization-{{.ID}}" name="organization" value="{{.OrganizationName}}" maxlength="255"><label for="profile-location-{{.ID}}">Location</label><input id="profile-location-{{.ID}}" name="location" value="{{.Location}}" maxlength="255"><label for="profile-timezone-{{.ID}}">Time zone</label><input id="profile-timezone-{{.ID}}" name="timeZone" value="{{.TimeZone}}" maxlength="100" required><button class="btn" type="submit">Save profile</button></form></details></td><td><span class="lozenge {{if .Active}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Active}}Active{{else}}Suspended{{end}}</span></td><td>{{if eq .ID $.Data.CurrentUserID}}Current administrator{{else}}<form class="admin-user-actions" method="post" action="/admin/users/{{.ID}}">{{if .Active}}<button class="btn" name="action" value="suspend" type="submit">Suspend</button>{{else}}<button class="btn" name="action" value="restore" type="submit">Restore</button>{{end}}<button class="btn" name="action" value="remove" type="submit">Remove</button></form>{{end}}</td></tr>{{end}}</tbody></table></div>
  </section>

  <div class="admin-directory-layout">
    <section class="surface-card admin-section" aria-labelledby="admin-groups-title">
      <header><div><span class="eyebrow">Directory</span><h2 id="admin-groups-title">Groups</h2></div><p>Groups can receive organization, site, product, project, or space roles.</p></header>
      {{with .Data.Directory}}
      <form class="admin-group-create" method="post" action="/admin/groups">
        <label for="admin-group-name">Group name</label><input id="admin-group-name" name="name" maxlength="255" required placeholder="For example: delivery-managers" value="{{$.Data.GroupName}}">
        <label for="admin-group-description">Description</label><textarea id="admin-group-description" name="description" maxlength="1000" rows="2">{{$.Data.GroupDescription}}</textarea>
        <button class="btn btn-primary" type="submit">Create group</button>
      </form>
      {{else}}<p>No active directory is available.</p>{{end}}
      <div class="admin-groups">
      {{$users := .Data.Users}}
      {{$products := .Data.Products}}
      {{range .Data.Groups}}{{$row := .}}<article class="admin-group">
        <header><div><h3>{{.Group.Name}}</h3><p>{{.Group.Description}}</p></div><div class="admin-group-summary"><span>{{.Group.MemberCount}} member{{if ne .Group.MemberCount 1}}s{{end}}</span><form method="post" action="/admin/groups/{{.Group.ID}}/delete"><button class="btn btn-danger" type="submit">Delete group</button></form></div></header>
        <div class="admin-product-access" aria-label="Product access for {{.Group.Name}}">
          {{range $products}}<div><span><strong>{{.Name}}</strong><small>{{if index $row.ProductAccess .ID}}Access granted{{else}}No group access{{end}}</small></span><form method="post" action="/admin/groups/{{$row.Group.ID}}/roles"><input type="hidden" name="productId" value="{{.ID}}">{{if index $row.ProductAccess .ID}}<input type="hidden" name="action" value="revoke"><button class="btn" type="submit">Revoke access</button>{{else}}<input type="hidden" name="action" value="assign"><button class="btn" type="submit">Grant access</button>{{end}}</form></div>{{end}}
        </div>
        <ul>{{range $users}}<li><span>{{template "avatar" .}}<span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span></span>{{if index $row.MemberIDs .ID}}<form method="post" action="/admin/groups/{{$row.Group.ID}}/members"><input type="hidden" name="accountId" value="{{.ID}}"><input type="hidden" name="action" value="remove"><button class="btn" type="submit">Remove</button></form>{{else}}<form method="post" action="/admin/groups/{{$row.Group.ID}}/members"><input type="hidden" name="accountId" value="{{.ID}}"><input type="hidden" name="action" value="add"><button class="btn" type="submit">Add</button></form>{{end}}</li>{{end}}</ul>
      </article>{{else}}<div class="empty-state"><strong>No groups yet</strong><p>Create a group to manage access for several people together.</p></div>{{end}}
      </div>
    </section>

    <section class="surface-card admin-section" aria-labelledby="admin-audit-title">
      <header><div><span class="eyebrow">Evidence</span><h2 id="admin-audit-title">Audit log</h2></div><p>Directory changes are recorded with their actor and target.</p></header>
      <form class="admin-audit-filters" method="get" action="/admin" role="search"><label for="admin-audit-query">Search audit log</label><input id="admin-audit-query" name="auditQuery" value="{{.Data.AuditQuery}}" placeholder="Actor, action, target, or detail"><label for="admin-audit-action">Action</label><select id="admin-audit-action" name="auditAction"><option value="">All actions</option>{{range .Data.AuditActions}}<option value="{{.Value}}" {{if eq .Value $.Data.AuditAction}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Filter events</button>{{if or .Data.AuditQuery .Data.AuditAction}}<a href="/admin">Clear filters</a>{{end}}</form>
      <ol class="admin-audit">{{range .Data.Audit}}<li><span class="admin-audit-mark" aria-hidden="true"></span><div><strong>{{.Action}}</strong><p>{{.TargetType}} · <code>{{.TargetID}}</code></p><small>{{.CreatedAt}} · {{if .ActorName}}{{.ActorName}}{{else}}actor {{.ActorID}}{{end}}</small></div></li>{{else}}<li class="empty-state"><strong>No administration changes match these filters</strong></li>{{end}}</ol>
    </section>
  </div>
</main>
</div>
<div id="modal-root"></div>
</body>
</html>
{{end}}
