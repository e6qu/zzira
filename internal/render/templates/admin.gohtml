{{define "page_admin"}}
<!doctype html>
<html lang="en">
<head><title>Administration · {{(site $).Title}}</title>{{template "head" .}}<link rel="stylesheet" href="/static/css/admin.css?v=10"></head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
{{template "header" .}}
<div class="app-shell">
{{template "workspace_nav" .}}
<main class="page page-fluid admin-page" id="main-content" tabindex="-1">
  <nav class="issue-breadcrumbs" aria-label="Breadcrumb"><span>Administration</span><span aria-hidden="true">/</span><span aria-current="page">Organization</span></nav>
  <header class="page-header">
    <div><span class="eyebrow">Organization administration</span><h1>{{.Data.Organization.Name}}</h1><p>Manage the site, product access, directory groups, and organization audit trail.</p></div>
    <code class="admin-object-id" title="Organization ID">{{.Data.Organization.ID}}</code>
  </header>
  {{if .Data.Saved}}<div class="alert success" role="status">{{.Data.Saved}}</div>{{end}}
  {{if .Data.Error}}<div class="alert error" role="alert">{{.Data.Error}}</div>{{end}}

  <section class="admin-overview" aria-label="Organization overview">
    <article class="surface-card"><span class="eyebrow">Site</span><h2>{{.Data.Site.Name}}</h2><dl><div><dt>Slug</dt><dd>{{.Data.Site.Slug}}</dd></div><div><dt>Cloud ID</dt><dd><code>{{.Data.Site.ID}}</code></dd></div></dl></article>
    <article class="surface-card"><span class="eyebrow">Directory</span>{{with .Data.Directory}}<h2>{{.Name}}</h2><dl><div><dt>Type</dt><dd>{{.Type}}</dd></div><div><dt>Accounts</dt><dd>{{len $.Data.Users}}</dd></div></dl>{{else}}<h2>No active directory</h2>{{end}}</article>
  </section>

  {{with .Data.JiraConfiguration}}
  <section class="surface-card admin-section admin-jira-configuration" id="admin-jira-configuration" aria-labelledby="admin-jira-configuration-title">
    <header><div><span class="eyebrow">Jira system</span><h2 id="admin-jira-configuration-title">Jira configuration</h2></div><p>Set site-wide work item behavior, announcements, time tracking, and the default issue navigator. These settings are shared with the Jira Cloud-compatible REST API.</p></header>
    <div class="admin-jira-settings-grid">
      <form method="post" action="/admin/jira-configuration/announcement"><header><h3>Announcement banner</h3><span class="lozenge {{if .Announcement.IsEnabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Announcement.IsEnabled}}Enabled{{else}}Disabled{{end}}</span></header><label for="jira-announcement-message">Message</label><textarea id="jira-announcement-message" name="message" rows="4" maxlength="65000" placeholder="Tell everyone about maintenance, policy, or a release.">{{.Announcement.Message}}</textarea><label for="jira-announcement-visibility">Visibility</label><select id="jira-announcement-visibility" name="visibility"><option value="public" {{if eq .Announcement.Visibility "public"}}selected{{end}}>Public</option><option value="private" {{if eq .Announcement.Visibility "private"}}selected{{end}}>Signed-in users</option></select><fieldset><legend>Behavior</legend><label><input type="checkbox" name="isEnabled" value="true" {{if .Announcement.IsEnabled}}checked{{end}}> Show banner</label><label><input type="checkbox" name="isDismissible" value="true" {{if .Announcement.IsDismissible}}checked{{end}}> People can dismiss it</label></fieldset><button class="btn btn-primary" type="submit">Save announcement</button></form>
      <form method="post" action="/admin/jira-configuration/features"><header><h3>Jira features</h3><span class="lozenge lozenge-default">Site-wide</span></header><fieldset class="admin-jira-feature-list"><legend>Available features</legend><label><input type="checkbox" name="attachmentsEnabled" value="true" {{if .AttachmentsEnabled}}checked{{end}}> Attachments</label><label><input type="checkbox" name="issueLinkingEnabled" value="true" {{if .IssueLinkingEnabled}}checked{{end}}> Work item linking</label><label><input type="checkbox" name="subTasksEnabled" value="true" {{if .SubTasksEnabled}}checked{{end}}> Subtasks</label><label><input type="checkbox" name="timeTrackingEnabled" value="true" {{if .TimeTrackingEnabled}}checked{{end}}> Time tracking</label><label><input type="checkbox" name="unassignedIssuesAllowed" value="true" {{if .UnassignedIssuesAllowed}}checked{{end}}> Unassigned work items</label><label><input type="checkbox" name="votingEnabled" value="true" {{if .VotingEnabled}}checked{{end}}> Voting</label><label><input type="checkbox" name="watchingEnabled" value="true" {{if .WatchingEnabled}}checked{{end}}> Watching</label><label><input type="checkbox" name="parallelSprintsEnabled" value="true" {{if .ParallelSprintsEnabled}}checked{{end}}> Parallel sprints</label></fieldset><label for="admin-attachment-upload-limit">Maximum attachment size (bytes)</label><input id="admin-attachment-upload-limit" type="number" name="attachmentUploadLimit" min="1" max="1073741824" value="{{.AttachmentUploadLimit}}" required><button class="btn btn-primary" type="submit">Save features</button></form>
      <form method="post" action="/admin/jira-configuration/timetracking"><header><h3>Time tracking</h3><span class="lozenge {{if .TimeTrackingEnabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .TimeTrackingEnabled}}Active{{else}}Inactive{{end}}</span></header><div class="admin-jira-form-grid"><label for="jira-time-tracking-provider">Provider</label><select id="jira-time-tracking-provider" name="timeTrackingProvider">{{range $.Data.TimeTrackingProviders}}<option value="{{.Key}}" {{if eq .Key $.Data.JiraConfiguration.TimeTrackingProvider}}selected{{end}}>{{.Name}}</option>{{end}}</select><label for="jira-working-hours">Hours per day</label><input id="jira-working-hours" name="workingHoursPerDay" type="number" min="0.1" max="24" step="0.1" value="{{.TimeTracking.WorkingHoursPerDay}}" required><label for="jira-working-days">Days per week</label><input id="jira-working-days" name="workingDaysPerWeek" type="number" min="0.1" max="7" step="0.1" value="{{.TimeTracking.WorkingDaysPerWeek}}" required><label for="jira-time-format">Display format</label><select id="jira-time-format" name="timeFormat"><option value="pretty" {{if eq .TimeTracking.TimeFormat "pretty"}}selected{{end}}>Pretty (1d 2h)</option><option value="days" {{if eq .TimeTracking.TimeFormat "days"}}selected{{end}}>Days</option><option value="hours" {{if eq .TimeTracking.TimeFormat "hours"}}selected{{end}}>Hours</option></select><label for="jira-default-unit">Default unit</label><select id="jira-default-unit" name="defaultUnit"><option value="minute" {{if eq .TimeTracking.DefaultUnit "minute"}}selected{{end}}>Minute</option><option value="hour" {{if eq .TimeTracking.DefaultUnit "hour"}}selected{{end}}>Hour</option><option value="day" {{if eq .TimeTracking.DefaultUnit "day"}}selected{{end}}>Day</option><option value="week" {{if eq .TimeTracking.DefaultUnit "week"}}selected{{end}}>Week</option></select></div><button class="btn btn-primary" type="submit">Save time tracking</button></form>
      <form method="post" action="/admin/jira-configuration/columns"><header><h3>Issue navigator</h3><span class="lozenge lozenge-default">{{len $.Data.JiraConfiguration.NavigatorColumns}} columns</span></header><fieldset class="admin-jira-feature-list"><legend>Default columns</legend>{{range $.Data.NavigatorColumns}}<label><input type="checkbox" name="columns" value="{{.Value}}" {{if .Selected}}checked{{end}}> {{.Label}} <small>{{.Value}}</small></label>{{end}}</fieldset><button class="btn btn-primary" type="submit">Save default columns</button></form>
    </div>
    <details class="admin-advanced-settings" id="admin-advanced-settings"><summary>Advanced application properties</summary><p>Change Jira Cloud-compatible application properties. Integrations can read the same values through <code>/rest/api/3/application-properties</code>.</p><div class="admin-property-list">{{range $.Data.ApplicationProperties}}<form method="post" action="/admin/jira-application-properties/{{.Key}}"><label for="jira-property-{{.Key}}"><strong>{{.Name}}</strong><code>{{.Key}}</code><small>{{.Description}}</small></label>{{if eq .Type "boolean"}}<select id="jira-property-{{.Key}}" name="value"><option value="true" {{if eq .Value "true"}}selected{{end}}>True</option><option value="false" {{if eq .Value "false"}}selected{{end}}>False</option></select>{{else}}<input id="jira-property-{{.Key}}" name="value" value="{{.Value}}" maxlength="8192" {{if eq .Type "number"}}inputmode="numeric"{{end}}>{{end}}<button class="btn" type="submit">Save</button></form>{{end}}</div></details>
  </section>
  {{end}}

  <section class="surface-card admin-section" id="admin-project-categories" aria-labelledby="admin-project-categories-title">
    <header><div><span class="eyebrow">Jira projects</span><h2 id="admin-project-categories-title">Project categories</h2></div><p>Organize the project directory with site-wide categories. Removing a category keeps its projects and clears their assignment.</p></header>
    <form class="admin-category-create" method="post" action="/admin/project-categories"><label for="admin-category-name">Category name</label><input id="admin-category-name" name="name" maxlength="255" required><label for="admin-category-description">Category description</label><input id="admin-category-description" name="description" maxlength="1000"><button class="btn btn-primary" type="submit">Create category</button></form>
    <div class="admin-category-list">{{range .Data.ProjectCategories}}<form method="post" action="/admin/project-categories/{{.ID}}"><label for="admin-category-name-{{.ID}}">Category name</label><input id="admin-category-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="255" required><label for="admin-category-description-{{.ID}}">Category description</label><input id="admin-category-description-{{.ID}}" name="description" value="{{.Description}}" maxlength="1000"><div><button class="btn" type="submit">Save</button><button class="btn btn-danger" type="submit" name="action" value="delete">Delete</button></div></form>{{else}}<div class="empty-state"><strong>No project categories</strong><small>Create a category to group related projects in the directory and REST API.</small></div>{{end}}</div>
  </section>
  <section class="surface-card admin-section" id="admin-global-permissions" aria-labelledby="admin-global-permissions-title">
    <header><div><span class="eyebrow">Jira system</span><h2 id="admin-global-permissions-title">Global permissions</h2></div><p>Grant site-wide abilities to groups or to everyone with product access. Administer Jira follows the organization and site administrator roles. <a href="/admin/permission-helper">Use the permission helper</a> to see why someone has a project permission.</p></header>
    <form class="admin-category-create" method="post" action="/admin/global-permissions"><label for="admin-global-permission">Permission</label><select id="admin-global-permission" name="permission" required>{{range .Data.GlobalPermissions}}<option value="{{.Key}}">{{.Name}}</option>{{end}}</select><label for="admin-global-permission-holder">Granted to</label><select id="admin-global-permission-holder" name="holder" required><option value="product:jira-software">Everyone with Jira access</option><option value="product:jira-service-management">Everyone with Jira Service Management access</option>{{range .Data.Groups}}<option value="group:{{.Group.ID}}">Group: {{.Group.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Grant permission</button></form>
    <div class="admin-category-list">{{range .Data.GlobalPermissions}}<div class="admin-global-permission"><div><strong>{{.Name}}</strong><small>{{.Description}}</small></div><ul>{{range .Grants}}<li><span>{{if .GroupName}}Group: {{.GroupName}}{{else if eq .ProductKey "jira-service-management"}}Everyone with Jira Service Management access{{else}}Everyone with Jira access{{end}}</span><form method="post" action="/admin/global-permissions/{{.ID}}/delete"><button class="btn btn-danger" type="submit" aria-label="Remove this {{.Permission}} grant">Remove</button></form></li>{{else}}<li><span class="muted">Not granted</span></li>{{end}}</ul></div>{{end}}</div>
  </section>
  <section class="surface-card admin-section" id="admin-issue-events" aria-labelledby="admin-issue-events-title">
    <header><div><span class="eyebrow">Jira system</span><h2 id="admin-issue-events-title">Events</h2></div><p>Events tell notification schemes whom to notify. Jira's built-in events are fixed; add custom events to fire from workflow transitions. An event a notification scheme or transition uses cannot be deleted. <a href="/admin/notification-helper">Use the notification helper</a> to see whether someone is notified of an event.</p></header>
    <form class="admin-category-create" method="post" action="/admin/issue-events"><label for="admin-event-name">Event name</label><input id="admin-event-name" name="name" maxlength="255" required><label for="admin-event-description">Event description</label><input id="admin-event-description" name="description" maxlength="1000"><button class="btn btn-primary" type="submit">Add event</button></form>
    <div class="admin-category-list">{{range .Data.IssueEvents}}{{if .Custom}}<form method="post" action="/admin/issue-events/{{.ID}}"><label for="admin-event-name-{{.ID}}">Event name</label><input id="admin-event-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="255" required><label for="admin-event-description-{{.ID}}">Event description</label><input id="admin-event-description-{{.ID}}" name="description" value="{{.Description}}" maxlength="1000"><div><button class="btn" type="submit">Save</button><button class="btn btn-danger" type="submit" name="action" value="delete">Delete</button></div></form>{{else}}<div class="admin-event-builtin"><strong>{{.Name}}</strong><small>{{.Description}} · Built-in event {{.ID}}</small></div>{{end}}{{end}}</div>
  </section>
  <section class="surface-card admin-section" id="admin-filter-subscriptions" aria-labelledby="admin-filter-subscriptions-title">
    <header><div><span class="eyebrow">Jira system</span><h2 id="admin-filter-subscriptions-title">Filter emails</h2></div><p>Every filter email this site sends, whoever scheduled it. Stopping one removes that person's schedule; their filter and its results stay.</p></header>
    <div class="admin-category-list">{{range .Data.FilterSubscriptions}}<div class="admin-global-permission"><div><strong>{{.FilterName}}</strong><small>{{if .OwnerName}}{{.OwnerName}}{{else}}{{.OwnerID}}{{end}} · {{.CronExpression}} in {{if .Timezone}}{{.Timezone}}{{else}}UTC{{end}}{{if .NextRunAt}} · next {{.NextRunAt}}{{end}}</small>{{if .LastError}}<small class="form-error">{{.LastError}}</small>{{end}}</div><form method="post" action="/admin/filter-subscriptions/{{.ID}}/delete"><button class="btn btn-danger" type="submit" aria-label="Stop the {{.FilterName}} email to {{if .OwnerName}}{{.OwnerName}}{{else}}{{.OwnerID}}{{end}}">Stop</button></form></div>{{else}}<div class="empty-state"><strong>No filter emails</strong><small>Nobody has scheduled a filter email on this site yet.</small></div>{{end}}</div>
  </section>
  <section class="surface-card admin-section" id="admin-classification-levels" aria-labelledby="admin-classification-levels-title">
    <header><div><span class="eyebrow">Data security</span><h2 id="admin-classification-levels-title">Data classification levels</h2></div><p>Define how information is handled across Jira projects and Confluence spaces. New levels start as drafts; publish a level to make it available, and archive it to stop it being chosen while content that carries it keeps it.</p></header>
    <details><summary class="btn">Create a level</summary><form class="project-details-form" method="post" action="/admin/classification-levels"><label for="admin-classification-name">New level name</label><input id="admin-classification-name" name="name" maxlength="255" required><label for="admin-classification-description">New level description</label><input id="admin-classification-description" name="description" maxlength="1000"><label for="admin-classification-guideline">New level handling guideline</label><textarea id="admin-classification-guideline" name="guideline" rows="3" maxlength="4000"></textarea><label for="admin-classification-color">New level color</label><select id="admin-classification-color" name="color">{{range .Data.ClassificationColors}}<option value="{{.}}">{{.}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create draft level</button></form></details>
    <ol class="admin-classification-list">{{range $index, $level := .Data.ClassificationLevels}}<li id="admin-classification-{{$level.ID}}"><form class="project-details-form" method="post" action="/admin/classification-levels/{{$level.ID}}"><div class="admin-classification-heading"><strong>{{$level.Name}}</strong><span class="lozenge {{if eq $level.Status "PUBLISHED"}}lozenge-success{{else if eq $level.Status "DRAFT"}}lozenge-current{{else}}lozenge-default{{end}}">{{$level.Status}}</span></div><label for="admin-classification-name-{{$level.ID}}">Name of {{$level.Name}}</label><input id="admin-classification-name-{{$level.ID}}" name="name" value="{{$level.Name}}" maxlength="255" required {{if eq $level.Status "ARCHIVED"}}disabled{{end}}><label for="admin-classification-description-{{$level.ID}}">Description of {{$level.Name}}</label><input id="admin-classification-description-{{$level.ID}}" name="description" value="{{$level.Description}}" maxlength="1000" {{if eq $level.Status "ARCHIVED"}}disabled{{end}}><label for="admin-classification-guideline-{{$level.ID}}">Handling guideline of {{$level.Name}}</label><textarea id="admin-classification-guideline-{{$level.ID}}" name="guideline" rows="2" maxlength="4000" {{if eq $level.Status "ARCHIVED"}}disabled{{end}}>{{$level.Guideline}}</textarea><label for="admin-classification-color-{{$level.ID}}">Color of {{$level.Name}}</label><select id="admin-classification-color-{{$level.ID}}" name="color" {{if eq $level.Status "ARCHIVED"}}disabled{{end}}>{{range $.Data.ClassificationColors}}<option value="{{.}}" {{if eq . $level.Color}}selected{{end}}>{{.}}</option>{{end}}</select><div class="project-form-actions">{{if ne $level.Status "ARCHIVED"}}<button class="btn" type="submit" name="action" value="save">Save {{$level.Name}}</button>{{end}}{{if eq $level.Status "DRAFT"}}<button class="btn btn-primary" type="submit" name="action" value="publish">Publish {{$level.Name}}</button>{{else if eq $level.Status "PUBLISHED"}}<button class="btn" type="submit" name="action" value="archive">Archive {{$level.Name}}</button>{{else}}<button class="btn" type="submit" name="action" value="restore">Restore {{$level.Name}}</button>{{end}}{{if gt $index 0}}<button class="btn btn-subtle" type="submit" name="action" value="up">Move {{$level.Name}} up</button>{{end}}{{if lt $index $.Data.LastClassificationIndex}}<button class="btn btn-subtle" type="submit" name="action" value="down">Move {{$level.Name}} down</button>{{end}}</div></form></li>{{end}}</ol>
  </section>


  <section class="surface-card admin-section" aria-labelledby="admin-identity-providers-title">
    <header><div><span class="eyebrow">Authentication</span><h2 id="admin-identity-providers-title">Identity providers</h2></div><p>Configured providers are available on the shared sign-in page. Stored client secrets are encrypted and are never displayed again.</p></header>
    {{if .Data.ProviderRegistrationConfigured}}<details class="admin-provider-registration"><summary>Add OpenID Connect provider</summary><form method="post" action="/admin/identity-providers"><label for="provider-key">Provider key</label><input id="provider-key" name="key" pattern="[a-z][a-z0-9-]{1,30}" maxlength="31" required placeholder="company-sso"><label for="provider-name">Display name</label><input id="provider-name" name="displayName" maxlength="80" required placeholder="Company SSO"><label for="provider-issuer">Issuer URL</label><input id="provider-issuer" name="issuer" type="url" maxlength="2048" required placeholder="https://login.example.com"><label for="provider-client-id">Client ID</label><input id="provider-client-id" name="clientId" maxlength="2048" autocomplete="off" required><label for="provider-client-secret">Client secret</label><input id="provider-client-secret" name="clientSecret" type="password" maxlength="8192" autocomplete="new-password" required><small>Discovery and endpoint validation run before the encrypted registration is saved.</small><button class="btn btn-primary" type="submit">Add provider</button></form></details>{{else}}<p class="admin-configuration-note">Set <code>ZZIRA_IDENTITY_ENCRYPTION_KEY</code> to a base64-encoded 32-byte key to manage encrypted provider credentials here.</p>{{end}}
    <div class="table-scroll" tabindex="0" aria-label="Configured identity providers"><table><thead><tr><th scope="col">Provider</th><th scope="col">Protocol</th><th scope="col">Issuer</th><th scope="col">Source</th><th scope="col">State</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Data.IdentityProviders}}<tr><th scope="row">{{.DisplayName}}</th><td>{{.Kind}}</td><td><code>{{.Issuer}}</code></td><td>{{if .Manageable}}Encrypted database{{else}}Deployment environment{{end}}</td><td><span class="lozenge {{if .Enabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</span></td><td><div class="admin-provider-actions"><form method="post" action="/admin/identity-providers/{{.Key}}">{{if .Enabled}}<button class="btn" name="action" value="disable" type="submit">Disable {{.DisplayName}}</button>{{else}}<button class="btn" name="action" value="enable" type="submit">Enable {{.DisplayName}}</button>{{end}}</form>{{if .Manageable}}<details><summary>Rotate secret</summary><form method="post" action="/admin/identity-providers/{{.Key}}"><label for="provider-secret-{{.Key}}">New client secret</label><input id="provider-secret-{{.Key}}" name="clientSecret" type="password" maxlength="8192" autocomplete="new-password" required><button class="btn" name="action" value="rotate" type="submit">Save new secret</button></form></details><form method="post" action="/admin/identity-providers/{{.Key}}"><button class="btn btn-danger" name="action" value="delete" type="submit">Delete {{.DisplayName}}</button></form>{{end}}</div></td></tr>{{else}}<tr><td colspan="6"><div class="empty-state"><strong>No external identity providers</strong><small>Add an OpenID Connect provider or configure a built-in provider in the deployment environment.</small></div></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" id="admin-apps" aria-labelledby="admin-apps-title">
    <header><div><span class="eyebrow">Extensibility</span><h2 id="admin-apps-title">Apps</h2></div><p>Install a validated descriptor, grant explicit scopes, and manage the signed app lifecycle. Shared secrets are encrypted and never displayed again.</p></header>
    {{if .Data.AppRegistrationConfigured}}<details class="admin-app-install"><summary>Install app</summary><form method="post" action="/admin/apps"><label for="app-descriptor">App descriptor</label><textarea id="app-descriptor" name="descriptor" rows="12" maxlength="262144" spellcheck="false" required>{
  "key": "example.operations",
  "name": "Operations companion",
  "baseUrl": "https://apps.example.com/operations",
  "version": "1.0.0",
  "scopes": ["read:jira-work", "read:app-storage", "write:app-storage", "manage:webhooks"],
  "modules": [{"key":"operations-page","type":"jira:globalPage","location":"jira.navigation","title":"Operations companion","body":"Incident context from the installed app."}],
  "lifecycle": {"installed":"/lifecycle/installed","uninstalled":"/lifecycle/uninstalled"},
  "webhooks": [{"key":"issue-events","url":"/webhooks/issues","events":["jira:issue_created","jira:issue_updated"]}],
  "scheduledTriggers": [{"key":"hourly-sync","url":"/scheduled/hourly","interval":"hour"}]
}</textarea><label for="app-shared-secret">Shared signing secret</label><input id="app-shared-secret" name="sharedSecret" type="password" minlength="16" maxlength="256" autocomplete="new-password" required><small>Signed requests use HMAC-SHA256, a five-minute timestamp window, and a unique request ID.</small><button class="btn btn-primary" type="submit">Install app</button></form></details>{{else}}<p class="admin-configuration-note">Set <code>ZZIRA_IDENTITY_ENCRYPTION_KEY</code> to install apps with encrypted signing credentials.</p>{{end}}
    <div class="admin-app-list">{{range .Data.Apps}}{{$app := .}}<article class="admin-app"><header><div><h3>{{.Name}}</h3><p><code>{{.Key}}</code> · {{.Format}} descriptor · version {{.Version}}</p></div><span class="lozenge {{if eq .Status "active"}}lozenge-success{{else if eq .Status "suspended"}}lozenge-current{{else}}lozenge-default{{end}}">{{.Status}}</span></header><dl><div><dt>Base URL</dt><dd><code>{{.BaseURL}}</code></dd></div><div><dt>Principal</dt><dd><code>{{.PrincipalID}}</code></dd></div><div><dt>Installed</dt><dd>{{.InstalledAt.Format "2006-01-02 15:04"}} UTC</dd></div></dl><div class="admin-app-capabilities"><div><strong>Scopes</strong><ul>{{range .Scopes}}<li><code>{{.}}</code></li>{{else}}<li>No scopes granted</li>{{end}}</ul></div><div><strong>Modules</strong><ul>{{range .Modules}}<li>{{if eq $app.Status "active"}}<a href="/apps/modules/{{.ID}}">{{.Title}}</a>{{else}}{{.Title}}{{end}} <small>{{.Type}} · {{.Location}}{{if .Dynamic}} · dynamic{{end}}{{if .RemoteURL}} · <code>{{.RemoteURL}}</code>{{end}}</small></li>{{else}}<li>No modules registered</li>{{end}}</ul></div><div><strong>Issue fields</strong><ul>{{range .IssueFields}}<li>{{.Name}} <small><code>{{.AppKey}}__{{.Key}}</code> · {{.Type}}{{if .Dynamic}} · dynamic{{end}}{{if ne $app.Status "active"}} · unavailable{{else if not .Active}} · inactive{{end}}</small></li>{{else}}<li>No issue fields registered</li>{{end}}</ul></div><div><strong>Lifecycle</strong><ul>{{range $event, $path := .Lifecycle}}<li><code>{{$event}}</code> <small>{{$path}}</small></li>{{else}}<li>No callbacks registered</li>{{end}}</ul></div><div><strong>Webhooks</strong><ul>{{range .Webhooks}}<li><code>{{.Key}}</code> <small>{{.Path}} · {{len .Events}} events{{if .Dynamic}} · dynamic{{end}}{{if .JQL}} · filtered{{end}}</small></li>{{else}}<li>No webhooks registered</li>{{end}}</ul></div><div><strong>Schedules</strong><ul>{{range .ScheduledTriggers}}<li><code>{{.Key}}</code> <small>{{.Interval}} · next {{.NextRunAt.Format "2006-01-02 15:04"}} UTC</small></li>{{else}}<li>No schedules registered</li>{{end}}</ul></div></div>{{if .OutboundDeliveries}}<details class="admin-app-deliveries"><summary>Recent deliveries</summary><div class="table-scroll" tabindex="0" aria-label="Recent deliveries for {{.Name}}"><table><thead><tr><th scope="col">Kind</th><th scope="col">Event</th><th scope="col">State</th><th scope="col">Attempts</th><th scope="col">Created</th></tr></thead><tbody>{{range .OutboundDeliveries}}<tr><td>{{.Kind}}</td><td><code>{{.Event}}</code></td><td><span class="lozenge {{if eq .State "delivered"}}lozenge-success{{else if eq .State "failed"}}lozenge-warning{{else}}lozenge-current{{end}}">{{.State}}</span>{{if .LastError}}<small class="admin-app-delivery-error">{{.LastError}}</small>{{end}}</td><td>{{.Attempts}}</td><td>{{.CreatedAt.Format "2006-01-02 15:04"}} UTC</td></tr>{{end}}</tbody></table></div></details>{{end}}{{if and (eq .Format "connect") (eq .Status "active")}}<details class="admin-app-transfers"><summary>Data migration</summary><p>Open a transfer to let {{.Name}} migrate its data into this site. The app sends the transfer ID in the <code>Atlassian-Transfer-Id</code> header.</p><ul>{{range index $.Data.Transfers .ID}}<li><code>{{.ID}}</code> <small>opened {{.CreatedAt}} UTC</small></li>{{else}}<li>No transfers opened</li>{{end}}</ul><form method="post" action="/admin/apps/{{.Key}}/transfers"><button class="btn" type="submit">Open data transfer for {{.Name}}</button></form></details>{{end}}{{if ne .Status "uninstalled"}}<form class="admin-app-actions" method="post" action="/admin/apps/{{.Key}}">{{if eq .Status "active"}}<button class="btn" name="action" value="suspend" type="submit">Suspend {{.Name}}</button>{{else}}<button class="btn" name="action" value="resume" type="submit">Resume {{.Name}}</button>{{end}}<button class="btn btn-danger" name="action" value="uninstall" type="submit">Uninstall {{.Name}}</button></form>{{else}}<small>Install the descriptor again with a new secret to restore this app.</small>{{end}}</article>{{else}}<div class="empty-state"><strong>No apps installed</strong><small>Install a descriptor to add scoped modules to ZZIRA.</small></div>{{end}}</div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-domains-title">
    <header><div><span class="eyebrow">Identity boundary</span><h2 id="admin-domains-title">Domains</h2></div><p>Claim an email domain with a DNS TXT record before applying organization-wide authentication policy.</p></header>
    <form class="admin-domain-create" method="post" action="/admin/domains"><label for="admin-domain-name">Domain name</label><input id="admin-domain-name" name="name" placeholder="example.com" required maxlength="253"><button class="btn btn-primary" type="submit">Add domain</button></form>
    <div class="table-scroll"><table><thead><tr><th scope="col">Domain</th><th scope="col">Claim</th><th scope="col">DNS verification</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Data.Domains}}<tr><th scope="row">{{.Name}}</th><td><span class="lozenge {{if eq .ClaimStatus "verified"}}lozenge-success{{else}}lozenge-default{{end}}">{{.ClaimStatus}}</span></td><td>{{if eq .ClaimStatus "verified"}}Verified{{else}}<code>_zzira-challenge.{{.Name}}</code><small class="admin-domain-token">TXT zzira-domain-verification={{.VerificationToken}}</small>{{end}}</td><td><form class="admin-domain-actions" method="post" action="/admin/domains/{{.ID}}">{{if ne .ClaimStatus "verified"}}<button class="btn" name="action" value="verify" type="submit">Verify DNS</button>{{end}}<button class="btn btn-danger" name="action" value="delete" type="submit">Remove</button></form></td></tr>{{else}}<tr><td colspan="4"><div class="empty-state"><strong>No claimed domains</strong><small>Add a domain to begin DNS verification.</small></div></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-policies-title">
    <header><div><span class="eyebrow">Access policy</span><h2 id="admin-policies-title">Policies</h2></div><p>Define the networks or residency locations allowed for selected products, then enable the policy when it is ready.</p></header>
    <form id="admin-access-policy-create" class="admin-policy-create" method="post" action="/admin/policies"><label for="admin-policy-name">Policy name</label><input id="admin-policy-name" name="name" required maxlength="255"><label for="admin-policy-type">Policy type</label><select id="admin-policy-type" name="type"><option value="ip-allowlist">IP allowlist</option><option value="data-residency">Data residency</option></select><label for="admin-policy-values">Rule values</label><textarea id="admin-policy-values" name="values" rows="2" required placeholder="192.0.2.0/24, 198.51.100.4"></textarea><fieldset><legend>Policy products</legend>{{range .Data.Products}}<label><input type="checkbox" name="resourceId" value="ari:cloud:{{.Key}}::site/{{.SiteID}}"> {{.Name}}</label>{{end}}</fieldset><label class="admin-policy-enabled"><input type="checkbox" name="enabled" value="true"> Enable immediately</label><button class="btn btn-primary" type="submit">Create policy</button></form>
    <div class="admin-policies">{{range .Data.Policies}}<article class="admin-policy"><header><div><h3>{{.Name}}</h3><p>{{.Type}} · {{len .Resources}} product{{if ne (len .Resources) 1}}s{{end}}</p></div><span class="lozenge {{if eq .Status "enabled"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Status}}</span></header><div class="admin-policy-rule"><strong>Allowed values</strong><ul>{{range index .Rule "in"}}<li><code>{{.}}</code></li>{{end}}</ul></div><div class="admin-policy-resources"><strong>Products</strong><ul>{{range .Resources}}<li><code>{{.ID}}</code><span>{{.ApplicationStatus}}</span></li>{{else}}<li>No products attached</li>{{end}}</ul></div><form class="admin-policy-actions" method="post" action="/admin/policies/{{.ID}}">{{if eq .Status "enabled"}}<button class="btn" name="action" value="disable" type="submit">Disable</button>{{else}}<button class="btn" name="action" value="enable" type="submit">Enable</button>{{end}}<button class="btn btn-danger" name="action" value="delete" type="submit">Delete policy</button></form></article>{{else}}<div class="empty-state"><strong>No access policies</strong><small>Create a disabled policy, review its product scope, then enable it.</small></div>{{end}}</div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-authentication-policies-title">
    <header><div><span class="eyebrow">Sign-in</span><h2 id="admin-authentication-policies-title">Authentication policies</h2></div><p>Say how the people a policy covers sign in: through the identity provider only, and how long a session lasts. Anyone in no policy of their own gets the one marked default; password rules and two-step verification are not enforced here.</p></header>
    <form id="admin-authentication-policy-create" class="admin-policy-create admin-authentication-policy-create" method="post" action="/admin/policies"><input type="hidden" name="type" value="authentication-policy"><label for="admin-authentication-policy-name">Policy name</label><input id="admin-authentication-policy-name" name="name" required maxlength="255"><label for="admin-authentication-policy-duration">Session duration in minutes</label><input id="admin-authentication-policy-duration" name="sessionDurationMinutes" type="number" min="5" max="43200" value="43200"><label for="admin-authentication-policy-password">Shortest password</label><input id="admin-authentication-policy-password" name="passwordMinimumLength" type="number" min="8" max="72" value="8"><fieldset><legend>Sign-in</legend><label><input type="checkbox" name="enforceSSO" value="true"> Single sign-on only</label><label><input type="checkbox" name="requireTwoStep" value="true"> Two-step verification required</label><label><input type="checkbox" name="default" value="true"> Covers everyone in no other policy</label></fieldset><label class="admin-policy-enabled"><input type="checkbox" name="enabled" value="true"> Enable immediately</label><button class="btn btn-primary" type="submit">Create authentication policy</button></form>
    <div class="admin-policies">{{range $policy := .Data.AuthenticationPolicies}}<article class="admin-policy admin-authentication-policy" data-policy-id="{{$policy.ID}}"><header><div><h3>{{$policy.Name}}</h3><p>{{if $policy.Default}}Default policy · {{end}}{{len $policy.Members}} member{{if ne (len $policy.Members) 1}}s{{end}}</p></div><span class="lozenge {{if eq $policy.Status "enabled"}}lozenge-success{{else}}lozenge-default{{end}}">{{$policy.Status}}</span></header><form class="admin-policy-settings" method="post" action="/admin/policies/{{$policy.ID}}"><input type="hidden" name="action" value="save"><label for="admin-authentication-policy-duration-{{$policy.ID}}">Session duration in minutes</label><input id="admin-authentication-policy-duration-{{$policy.ID}}" name="sessionDurationMinutes" type="number" min="5" max="43200" value="{{$policy.SessionDurationMinutes}}"><label for="admin-authentication-policy-password-{{$policy.ID}}">Shortest password</label><input id="admin-authentication-policy-password-{{$policy.ID}}" name="passwordMinimumLength" type="number" min="8" max="72" value="{{$policy.PasswordMinimum}}"><fieldset><legend>Sign-in</legend><label><input type="checkbox" name="enforceSSO" value="true" {{if $policy.EnforceSSO}}checked{{end}}> Single sign-on only</label><label><input type="checkbox" name="requireTwoStep" value="true" {{if $policy.RequireTwoStep}}checked{{end}}> Two-step verification required</label><label><input type="checkbox" name="default" value="true" {{if $policy.Default}}checked{{end}}> Covers everyone in no other policy</label></fieldset><button class="btn" type="submit">Save settings</button></form><div class="admin-policy-members"><strong>Members</strong><ul>{{range $member := $policy.Members}}<li><span>{{$member.DisplayName}}</span><form method="post" action="/admin/policies/{{$policy.ID}}/members"><input type="hidden" name="action" value="remove"><input type="hidden" name="accountId" value="{{$member.ID}}"><button class="btn btn-danger" type="submit">Remove {{$member.DisplayName}}</button></form></li>{{else}}<li>Nobody is covered yet</li>{{end}}</ul><form class="admin-policy-member-add" method="post" action="/admin/policies/{{$policy.ID}}/members"><input type="hidden" name="action" value="add"><label for="admin-authentication-policy-member-{{$policy.ID}}">Add a person</label><select id="admin-authentication-policy-member-{{$policy.ID}}" name="accountId">{{range $.Data.Users}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><button class="btn" type="submit">Add member</button></form></div><div class="admin-policy-groups"><strong>Groups</strong><ul>{{range $group := $policy.Groups}}<li><span>{{$group.Name}}</span><form method="post" action="/admin/policies/{{$policy.ID}}/members"><input type="hidden" name="action" value="remove"><input type="hidden" name="groupId" value="{{$group.ID}}"><button class="btn btn-danger" type="submit">Remove {{$group.Name}}</button></form></li>{{else}}<li>No group is covered yet</li>{{end}}</ul><form class="admin-policy-member-add" method="post" action="/admin/policies/{{$policy.ID}}/members"><input type="hidden" name="action" value="add"><label for="admin-authentication-policy-group-{{$policy.ID}}">Add a group</label><select id="admin-authentication-policy-group-{{$policy.ID}}" name="groupId">{{range $.Data.Groups}}<option value="{{.Group.ID}}">{{.Group.Name}}</option>{{end}}</select><button class="btn" type="submit">Add group</button></form><small>Somebody named on a policy keeps it; otherwise the policy covering a group they are in applies.</small></div><form class="admin-policy-actions" method="post" action="/admin/policies/{{$policy.ID}}">{{if eq $policy.Status "enabled"}}<button class="btn" name="action" value="disable" type="submit">Disable</button>{{else}}<button class="btn" name="action" value="enable" type="submit">Enable</button>{{end}}<button class="btn btn-danger" name="action" value="delete" type="submit">Delete policy</button></form></article>{{else}}<div class="empty-state"><strong>No authentication policies</strong><small>Everyone signs in with a password and keeps the site's own session length until a policy says otherwise.</small></div>{{end}}</div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-products-title">
    <header><div><span class="eyebrow">Access</span><h2 id="admin-products-title">Products</h2></div><p>Existing workspace memberships are mapped into explicit site and product roles.</p></header>
    <div class="table-scroll"><table><thead><tr><th scope="col">Product</th><th scope="col">Key</th><th scope="col">State</th><th scope="col">Plan</th></tr></thead><tbody>{{range .Data.Products}}<tr><th scope="row">{{.Name}}</th><td><code>{{.Key}}</code></td><td><span class="lozenge {{if .Enabled}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</span></td><td>{{$plan := .Plan}}<form class="admin-product-plan" method="post" action="/admin/products/{{.ID}}/plan"><label class="sr-only" for="product-plan-{{.ID}}">{{.Name}} plan</label><select id="product-plan-{{.ID}}" name="plan"><option value="free" {{if eq $plan "free"}}selected{{end}}>Free</option><option value="standard" {{if eq $plan "standard"}}selected{{end}}>Standard</option><option value="premium" {{if eq $plan "premium"}}selected{{end}}>Premium</option><option value="enterprise" {{if eq $plan "enterprise"}}selected{{end}}>Enterprise</option></select><button class="btn" type="submit">Save plan<span class="sr-only"> for {{.Name}}</span></button></form></td></tr>{{end}}</tbody></table></div>
  </section>

  <section class="surface-card admin-section" aria-labelledby="admin-users-title">
    <header><div><span class="eyebrow">Managed accounts</span><h2 id="admin-users-title">People</h2></div><p>Invitations provision an account for provider sign-in. Suspension removes access in this directory; credentials remain valid when another directory is active.</p></header>
    {{with .Data.Directory}}<form class="admin-user-invite" method="post" action="/admin/users/invite">
      <label for="admin-user-name">Display name</label><input id="admin-user-name" name="displayName" required maxlength="255">
      <label for="admin-user-email">Email</label><input id="admin-user-email" name="email" type="email" required maxlength="320">
      <button class="btn btn-primary" type="submit">Invite user</button>
      <div class="admin-invite-options">
        <fieldset><legend>Product access</legend>{{range $.Data.Products}}<label><input type="checkbox" name="productId" value="{{.ID}}"> {{.Name}}</label>{{end}}</fieldset>
        <fieldset><legend>Group membership</legend>{{range $.Data.Groups}}<label><input type="checkbox" name="groupId" value="{{.Group.ID}}"> {{.Group.Name}}</label>{{else}}<small>Create a group to assign it during invitation.</small>{{end}}</fieldset>
        <fieldset><legend>Invitation email</legend>{{if $.Data.InvitationNotificationsConfigured}}<label><input type="checkbox" name="sendNotification" value="true"> Send invitation email</label><label for="admin-invite-message">Personal message</label><textarea id="admin-invite-message" name="notificationText" maxlength="4000" rows="2"></textarea>{{else}}<small>Email delivery is unavailable until SMTP is configured.</small>{{end}}</fieldset>
      </div>
    </form>{{end}}
    {{if .Data.SignInLink}}<div class="admin-sign-in-link" role="status"><strong>Sign-in link for {{.Data.SignInLinkPerson}}</strong><p>It works once and expires on {{.Data.SignInLinkExpires}}. {{if .Data.SignInLinkEmailed}}It has been emailed to them as well.{{else if not .Data.SignInLinkAbsolute}}Set ZZIRA_EXTERNAL_URL for the site to write its own address; prefix it yourself for now.{{else}}Pass it to them yourself: this site cannot send email.{{end}}</p><code>{{.Data.SignInLink}}</code></div>{{end}}
    <div class="table-scroll"><table><thead><tr><th scope="col">Person</th><th scope="col">Email</th><th scope="col">Profile</th><th scope="col">Status</th><th scope="col">Account actions</th></tr></thead><tbody>{{range .Data.Users}}<tr><th scope="row">{{.DisplayName}}{{if .Nickname}}<small>{{.Nickname}}</small>{{end}}</th><td>{{.Email}}</td><td><span>{{if .JobTitle}}{{.JobTitle}}{{else}}No job title{{end}}{{if .Department}} · {{.Department}}{{end}}</span><details class="admin-profile-editor"><summary>Edit profile</summary><form method="post" action="/admin/users/{{.ID}}/profile"><label for="profile-name-{{.ID}}">Display name</label><input id="profile-name-{{.ID}}" name="displayName" value="{{.DisplayName}}" maxlength="255" required><label for="profile-nickname-{{.ID}}">Nickname</label><input id="profile-nickname-{{.ID}}" name="nickname" value="{{.Nickname}}" maxlength="255"><label for="profile-title-{{.ID}}">Job title</label><input id="profile-title-{{.ID}}" name="jobTitle" value="{{.JobTitle}}" maxlength="255"><label for="profile-department-{{.ID}}">Department</label><input id="profile-department-{{.ID}}" name="department" value="{{.Department}}" maxlength="255"><label for="profile-organization-{{.ID}}">Organization</label><input id="profile-organization-{{.ID}}" name="organization" value="{{.OrganizationName}}" maxlength="255"><label for="profile-location-{{.ID}}">Location</label><input id="profile-location-{{.ID}}" name="location" value="{{.Location}}" maxlength="255"><label for="profile-timezone-{{.ID}}">Time zone</label><input id="profile-timezone-{{.ID}}" name="timeZone" value="{{.TimeZone}}" maxlength="100" required><button class="btn" type="submit">Save profile</button></form></details></td><td><span class="lozenge {{if .Active}}lozenge-success{{else}}lozenge-default{{end}}">{{if .Active}}Active{{else}}Suspended{{end}}</span></td><td>{{if eq .ID $.Data.CurrentUserID}}Current administrator{{else}}<form class="admin-user-actions" method="post" action="/admin/users/{{.ID}}">{{if .Active}}<button class="btn" name="action" value="sign-in-link" type="submit">Sign-in link</button>{{if .MFAEnabled}}<button class="btn" name="action" value="two-step-reset" type="submit">Reset two-step</button>{{end}}<button class="btn" name="action" value="suspend" type="submit">Suspend</button>{{else}}<button class="btn" name="action" value="restore" type="submit">Restore</button>{{end}}<button class="btn" name="action" value="remove" type="submit">Remove</button></form>{{end}}</td></tr>{{end}}</tbody></table></div>
  </section>

  <div class="admin-directory-layout">
    <section class="surface-card admin-section" aria-labelledby="admin-groups-title">
      <header><div><span class="eyebrow">Directory</span><h2 id="admin-groups-title">Groups</h2></div><p>Groups can receive organization, site, product, project, or space roles.</p></header>
      {{with .Data.Directory}}
      <form class="admin-group-create" method="post" action="/admin/groups">
        <label for="admin-group-name">Group name</label><input id="admin-group-name" name="name" maxlength="255" required placeholder="For example: delivery-managers" value="{{$.Data.GroupName}}">
        <label for="admin-group-description">Description</label><textarea id="admin-group-description" name="description" maxlength="1000" rows="2">{{$.Data.GroupDescription}}</textarea>
        <button class="btn btn-primary" type="submit">Create group</button>
      </form>
      {{else}}<p>No active directory is available.</p>{{end}}
      <div class="admin-groups">
      {{$users := .Data.Users}}
      {{$products := .Data.Products}}
      {{range .Data.Groups}}{{$row := .}}<article class="admin-group">
        <header><div><h3>{{.Group.Name}}</h3><p>{{.Group.Description}}</p></div><div class="admin-group-summary"><span>{{.Group.MemberCount}} member{{if ne .Group.MemberCount 1}}s{{end}}</span><form method="post" action="/admin/groups/{{.Group.ID}}/delete"><button class="btn btn-danger" type="submit">Delete group</button></form></div></header>
        <div class="admin-product-access" aria-label="Product access for {{.Group.Name}}">
          {{range $products}}<div><span><strong>{{.Name}}</strong><small>{{if index $row.ProductAccess .ID}}Access granted{{else}}No group access{{end}}</small></span><form method="post" action="/admin/groups/{{$row.Group.ID}}/roles"><input type="hidden" name="productId" value="{{.ID}}">{{if index $row.ProductAccess .ID}}<input type="hidden" name="action" value="revoke"><button class="btn" type="submit">Revoke access</button>{{else}}<input type="hidden" name="action" value="assign"><button class="btn" type="submit">Grant access</button>{{end}}</form></div>{{end}}
        </div>
        <ul>{{range $users}}<li><span>{{template "avatar" .}}<span><strong>{{.DisplayName}}</strong><small>{{.Email}}</small></span></span>{{if index $row.MemberIDs .ID}}<form method="post" action="/admin/groups/{{$row.Group.ID}}/members"><input type="hidden" name="accountId" value="{{.ID}}"><input type="hidden" name="action" value="remove"><button class="btn" type="submit">Remove</button></form>{{else}}<form method="post" action="/admin/groups/{{$row.Group.ID}}/members"><input type="hidden" name="accountId" value="{{.ID}}"><input type="hidden" name="action" value="add"><button class="btn" type="submit">Add</button></form>{{end}}</li>{{end}}</ul>
      </article>{{else}}<div class="empty-state"><strong>No groups yet</strong><p>Create a group to manage access for several people together.</p></div>{{end}}
      </div>
    </section>

    <section class="surface-card admin-section" aria-labelledby="admin-provisioning-title">
      <header><div><span class="eyebrow">Directory</span><h2 id="admin-provisioning-title">User provisioning</h2></div><p>An identity provider can create, change and deactivate people and groups here over SCIM 2.0. Product access is not provisioned: a person it creates joins the groups it puts them in, and those groups carry whatever access this site gave them.</p></header>
      {{with .Data.Provisioning}}
      <dl class="admin-provisioning-facts">
        <div><dt>Where to point the provider</dt><dd><code>{{.BaseURL}}</code></dd></div>
        <div><dt>Directory</dt><dd><code>{{.DirectoryID}}</code></dd></div>
        <div><dt>Status</dt><dd>{{if .Connected}}Connected{{if .LastWritten}} · last write {{.LastWritten}}{{end}}{{else}}No provider has written yet{{end}}</dd></div>
        <div><dt>Provisioned</dt><dd>{{len .People}} {{if eq (len .People) 1}}person{{else}}people{{end}} · {{len .Groups}} {{if eq (len .Groups) 1}}group{{else}}groups{{end}}</dd></div>
      </dl>
      <p class="muted">A provider holds a key issued for this directory. The full conversation it can have is in the SCIM documentation.</p>
      <div class="admin-provisioning-keys">
        <h3>Provisioning keys</h3>
        {{if $.Data.Provisioning.Issued}}<p class="form-success" role="status">Copy this key now: it is shown once and only its hash is kept.<br><code class="admin-provisioning-key">{{$.Data.Provisioning.Issued}}</code></p>{{end}}
        {{if .Keys}}<ul class="admin-provisioning-key-list">{{range .Keys}}<li><div><strong>{{.Name}}</strong><small>Issued {{.Created}}{{if .LastUsed}} · last used {{.LastUsed}}{{else}} · never used{{end}}</small></div>{{if .Revoked}}<span class="lozenge lozenge-default">Revoked</span>{{else}}<form method="post" action="/admin/provisioning-keys"><input type="hidden" name="action" value="revoke"><input type="hidden" name="key" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Revoke<span class="sr-only"> {{.Name}}</span></button></form>{{end}}</li>{{end}}</ul>{{else}}<p class="muted">No key has been issued, so no provider can write here yet.</p>{{end}}
        <form class="project-details-form" method="post" action="/admin/provisioning-keys"><input type="hidden" name="action" value="issue"><label for="provisioning-key-name">Name this key</label><input id="provisioning-key-name" name="name" maxlength="255" placeholder="Okta, Entra ID" required><button class="btn btn-primary" type="submit">Issue a provisioning key</button></form>
      </div>
      {{if .People}}<div class="table-scroll" tabindex="0" aria-label="People a provider manages"><table><caption class="sr-only">People a provider manages</caption><thead><tr><th scope="col">Person</th><th scope="col">External id</th><th scope="col">Groups</th><th scope="col">State</th><th scope="col">Last written</th></tr></thead><tbody>{{range .People}}<tr><th scope="row">{{.DisplayName}}<small>{{.Email}}</small></th><td><code>{{.ExternalID}}</code></td><td>{{if .Groups}}{{.Groups}}{{else}}<span class="muted">None</span>{{end}}</td><td>{{if .Active}}Active{{else}}Deactivated{{end}}</td><td>{{.Updated}}</td></tr>{{end}}</tbody></table></div>{{else}}<div class="empty-state"><strong>Nobody is provisioned yet</strong><p>Point a provider at the address above; the people it creates appear here.</p></div>{{end}}
      {{if .Groups}}<div class="table-scroll" tabindex="0" aria-label="Groups a provider manages"><table><caption class="sr-only">Groups a provider manages</caption><thead><tr><th scope="col">Group</th><th scope="col">External id</th><th scope="col">Members</th><th scope="col">Last written</th></tr></thead><tbody>{{range .Groups}}<tr><th scope="row">{{.Name}}</th><td><code>{{.ExternalID}}</code></td><td>{{.Members}}</td><td>{{.Updated}}</td></tr>{{end}}</tbody></table></div>{{end}}
      {{else}}<p>No active directory is available.</p>{{end}}
    </section>

    <section class="surface-card admin-section" aria-labelledby="admin-audit-title">
      <header><div><span class="eyebrow">Evidence</span><h2 id="admin-audit-title">Audit log</h2></div><p>Directory changes are recorded with their actor and target.</p></header>
      <form class="admin-audit-filters" method="get" action="/admin" role="search"><label for="admin-audit-query">Search audit log</label><input id="admin-audit-query" name="auditQuery" value="{{.Data.AuditQuery}}" placeholder="Actor, action, target, or detail"><label for="admin-audit-action">Action</label><select id="admin-audit-action" name="auditAction"><option value="">All actions</option>{{range .Data.AuditActions}}<option value="{{.Value}}" {{if eq .Value $.Data.AuditAction}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Filter events</button>{{if or .Data.AuditQuery .Data.AuditAction}}<a href="/admin">Clear filters</a>{{end}}</form>
      <ol class="admin-audit">{{range .Data.Audit}}<li><span class="admin-audit-mark" aria-hidden="true"></span><div><strong>{{.Action}}</strong><p>{{.TargetType}} · <code>{{.TargetID}}</code></p><small>{{.CreatedAt}} · {{if .ActorName}}{{.ActorName}}{{else}}actor {{.ActorID}}{{end}}</small></div></li>{{else}}<li class="empty-state"><strong>No administration changes match these filters</strong></li>{{end}}</ol>
    </section>
  </div>
</main>
</div>
<div id="modal-root"></div>
</body>
</html>
{{end}}
