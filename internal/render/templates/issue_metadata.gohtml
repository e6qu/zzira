{{define "metadata_translations"}}
<details class="metadata-translations"><summary class="quiet-action">Translations · {{len .Translations}}</summary>
<p class="muted">Each person reads {{.Name}} in their own language. The site's own name is what the API reports beside theirs.</p>
{{if .Translations}}<ul class="metadata-translation-list">{{$card := .}}{{range .Translations}}<li><div><strong>{{.Name}}</strong><small>{{.Locale}}{{if .Description}} · {{.Description}}{{end}}</small></div>
<form method="post" action="{{$card.Path}}"><input type="hidden" name="action" value="remove-translation"><input type="hidden" name="entityId" value="{{$card.EntityID}}"><input type="hidden" name="locale" value="{{.Locale}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> the {{.Locale}} name for {{$card.Name}}</span></button></form></li>{{end}}</ul>{{end}}
<form class="project-details-form" method="post" action="{{.Path}}"><input type="hidden" name="action" value="translate"><input type="hidden" name="entityId" value="{{.EntityID}}">
<label for="translation-locale-{{.Kind}}-{{.EntityID}}">Language</label><input id="translation-locale-{{.Kind}}-{{.EntityID}}" name="locale" placeholder="es, pt-br" maxlength="12" required>
<label for="translation-name-{{.Kind}}-{{.EntityID}}">Name in that language</label><input id="translation-name-{{.Kind}}-{{.EntityID}}" name="translatedName" maxlength="255" required>
<label for="translation-description-{{.Kind}}-{{.EntityID}}">Description in that language</label><input id="translation-description-{{.Kind}}-{{.EntityID}}" name="translatedDescription" maxlength="1000">
<button class="btn" type="submit">Save translation<span class="sr-only"> for {{.Name}}</span></button></form></details>
{{end}}
{{define "page_work_types"}}
<!doctype html><html lang="en"><head><title>Work types · {{(site $).Title}}</title>{{template "head" .}}</head>
<body class="page-work-types"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Work types</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Work types</h1><p>Work types describe the kind of work. A scheme decides which of them a project offers.</p></div><a class="btn" href="/settings/hierarchy">Work type hierarchy</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card" aria-labelledby="work-type-create-heading"><div><h2 id="work-type-create-heading">Create work type</h2><p>A standard type sits at the base level; a sub-task type sits below it.</p></div>
<form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="create"><label for="work-type-name-new">Name</label><input id="work-type-name-new" name="name" maxlength="60" required><label for="work-type-description-new">Description</label><textarea id="work-type-description-new" name="description" rows="2" maxlength="4000"></textarea><label for="work-type-kind-new">Kind</label><select id="work-type-kind-new" name="kind"><option value="standard">Standard</option><option value="subtask">Sub-task</option></select><button class="btn btn-primary" type="submit">Create work type</button></form></section>
<div class="metadata-list">{{$page := .}}{{range .Data.WorkTypes}}{{$item := .}}<article class="surface-card metadata-card" data-work-type-id="{{.ID}}"><header><div><span class="issue-type-mini" aria-hidden="true">✓</span><div><h2>{{.Name}}</h2><p>{{if .Subtask}}Sub-task{{else}}Standard{{end}} · level {{.HierarchyLevel}}</p></div></div><span class="lozenge">{{.Icon}}</span></header>
<form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="update"><input type="hidden" name="workType" value="{{.ID}}"><label for="work-type-name-{{.ID}}">Name</label><input id="work-type-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="60" required><label for="work-type-description-{{.ID}}">Description</label><textarea id="work-type-description-{{.ID}}" name="description" rows="2" maxlength="4000">{{.Description}}</textarea><button class="btn" type="submit">Save work type</button></form>
<details class="metadata-delete"><summary class="quiet-action">Delete {{.Name}}</summary><form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="delete"><input type="hidden" name="workType" value="{{.ID}}"><p>Work items of this type move to the type you choose.</p><label for="work-type-alternative-{{.ID}}">Move work items to</label><select id="work-type-alternative-{{.ID}}" name="alternative"><option value="">Delete only if unused</option>{{range $page.Data.WorkTypes}}{{if ne .ID $item.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select><button class="btn btn-danger" type="submit">Delete work type</button></form></details>{{template "metadata_translations" (index $page.Data.Translations $item.ID)}}</article>{{end}}</div>
<section class="surface-card" aria-labelledby="work-type-scheme-heading"><div><h2 id="work-type-scheme-heading">Work type schemes</h2><p>A project offers the work types of the scheme assigned to it.</p></div>
<form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="create-scheme"><label for="scheme-name-new">Scheme name</label><input id="scheme-name-new" name="name" maxlength="255" required><label for="scheme-description-new">Description</label><input id="scheme-description-new" name="description" maxlength="4000"><fieldset><legend>Work types in the scheme</legend>{{range .Data.WorkTypes}}<label><input type="checkbox" name="workType" value="{{.ID}}"> {{.Name}}</label>{{end}}</fieldset><label for="scheme-default-new">Default work type</label><select id="scheme-default-new" name="defaultWorkType"><option value="">None</option>{{range .Data.WorkTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create scheme</button></form>
<div class="metadata-scheme-list">{{range .Data.Schemes}}<article class="surface-card metadata-scheme-card" data-scheme-id="{{.ID}}"><header><div><h3>{{.Name}}</h3><p>{{.Description}}</p></div><span class="lozenge">{{if .IsDefault}}Default · {{end}}{{len .IssueTypeIDs}} work types</span></header>
<form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="assign-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><label for="scheme-project-{{.ID}}">Assign to project</label><select id="scheme-project-{{.ID}}" name="project">{{range $page.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><button class="btn" type="submit">Assign scheme</button></form>
<form class="project-details-form" method="post" action="/settings/work-types"><input type="hidden" name="action" value="add-to-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><label for="scheme-add-{{.ID}}">Add work type</label><select id="scheme-add-{{.ID}}" name="workType">{{range $page.Data.WorkTypes}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add to scheme</button></form>
{{if not .IsDefault}}<form method="post" action="/settings/work-types"><input type="hidden" name="action" value="delete-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><button class="btn btn-danger" type="submit">Delete scheme<span class="sr-only"> {{.Name}}</span></button></form>{{end}}</article>{{end}}</div></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_priorities"}}
<!doctype html><html lang="en"><head><title>Priorities · {{(site $).Title}}</title>{{template "head" .}}</head>
<body class="page-priorities"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Priorities</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Priorities</h1><p>Priorities are listed most important first. A scheme decides which of them a project offers.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card" aria-labelledby="priority-create-heading"><div><h2 id="priority-create-heading">Create priority</h2><p>New priorities go to the bottom of the list.</p></div>
<form class="project-details-form" method="post" action="/settings/priorities"><input type="hidden" name="action" value="create"><label for="priority-name-new">Name</label><input id="priority-name-new" name="name" maxlength="60" required><label for="priority-color-new">Status colour</label><input id="priority-color-new" name="statusColor" value="#2684ff" maxlength="7" required><label for="priority-description-new">Description</label><input id="priority-description-new" name="description" maxlength="4000"><label for="priority-icon-new">Icon</label><select id="priority-icon-new" name="iconUrl">{{range .Data.Icons}}<option value="{{.URL}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create priority</button></form></section>
<div class="metadata-list">{{$page := .}}{{range .Data.Priorities}}<article class="surface-card metadata-card" data-priority-id="{{.ID}}"><header><div><span class="priority-swatch" style="background:{{.StatusColor}}" aria-hidden="true"></span><img class="priority-icon" src="{{.IconURL}}" alt="" width="16" height="16"><div><h2>{{.Name}}</h2><p>Position {{.Position}}</p></div></div>{{if .IsDefault}}<span class="lozenge lozenge-success">Default</span>{{end}}</header>
<form class="project-details-form" method="post" action="/settings/priorities"><input type="hidden" name="action" value="update"><input type="hidden" name="priority" value="{{.ID}}"><label for="priority-name-{{.ID}}">Name</label><input id="priority-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="60" required><label for="priority-color-{{.ID}}">Status colour</label><input id="priority-color-{{.ID}}" name="statusColor" value="{{.StatusColor}}" maxlength="7" required><label for="priority-description-{{.ID}}">Description</label><input id="priority-description-{{.ID}}" name="description" value="{{.Description}}" maxlength="4000"><label for="priority-icon-{{.ID}}">Icon</label><select id="priority-icon-{{.ID}}" name="iconUrl">{{$current := .IconURL}}{{range $page.Data.Icons}}<option value="{{.URL}}" {{if eq .URL $current}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Save priority</button></form>
<div class="metadata-card-actions">{{if not .IsDefault}}<form method="post" action="/settings/priorities"><input type="hidden" name="action" value="default"><input type="hidden" name="priority" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Make default<span class="sr-only"> {{.Name}}</span></button></form>{{end}}
<form method="post" action="/settings/priorities"><input type="hidden" name="action" value="move"><input type="hidden" name="priority" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Move to top<span class="sr-only"> {{.Name}}</span></button></form>
{{if not .IsDefault}}<form method="post" action="/settings/priorities"><input type="hidden" name="action" value="delete"><input type="hidden" name="priority" value="{{.ID}}"><button class="btn btn-danger" type="submit">Delete<span class="sr-only"> {{.Name}}</span></button></form>{{end}}</div>{{template "metadata_translations" (index $page.Data.Translations .ID)}}</article>{{end}}</div>
<section class="surface-card" aria-labelledby="priority-scheme-heading"><div><h2 id="priority-scheme-heading">Priority schemes</h2><p>Each project uses one scheme; its priorities are the ones the project offers.</p></div>
<form class="project-details-form" method="post" action="/settings/priorities"><input type="hidden" name="action" value="create-scheme"><label for="priority-scheme-name-new">Scheme name</label><input id="priority-scheme-name-new" name="name" maxlength="255" required><label for="priority-scheme-description-new">Description</label><input id="priority-scheme-description-new" name="description" maxlength="4000"><fieldset><legend>Priorities in the scheme</legend>{{range .Data.Priorities}}<label><input type="checkbox" name="priority" value="{{.ID}}"> {{.Name}}</label>{{end}}</fieldset><label for="priority-scheme-default-new">Default priority</label><select id="priority-scheme-default-new" name="defaultPriority" required>{{range .Data.Priorities}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn btn-primary" type="submit">Create priority scheme</button></form>
<div class="metadata-scheme-list">{{range .Data.Schemes}}{{$scheme := .}}<article class="surface-card metadata-scheme-card" data-priority-scheme-id="{{.ID}}"><header><div><h3>{{.Name}}</h3><p>{{.Description}}</p></div><span class="lozenge">{{if .IsDefault}}Default · {{end}}{{len .PriorityIDs}} priorities · {{len .ProjectIDs}} projects</span></header>
<form class="project-details-form" method="post" action="/settings/priorities"><input type="hidden" name="action" value="update-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><label for="priority-scheme-name-{{.ID}}">Scheme name</label><input id="priority-scheme-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="255" required><label for="priority-scheme-description-{{.ID}}">Description</label><input id="priority-scheme-description-{{.ID}}" name="description" value="{{.Description}}" maxlength="4000"><fieldset><legend>Priorities in the scheme</legend>{{range $page.Data.Priorities}}<label><input type="checkbox" name="priority" value="{{.ID}}" {{if holds $scheme.PriorityIDs .ID}}checked{{end}}> {{.Name}}</label>{{end}}</fieldset><label for="priority-scheme-default-{{.ID}}">Default priority</label><select id="priority-scheme-default-{{.ID}}" name="defaultPriority" required>{{range $page.Data.Priorities}}<option value="{{.ID}}" {{if eq .ID $scheme.DefaultPriorityID}}selected{{end}}>{{.Name}}</option>{{end}}</select><details class="metadata-delete"><summary class="quiet-action">Move work items off a priority</summary><p>A change that leaves work items with a priority the scheme no longer offers needs somewhere for them to go.</p>{{range $page.Data.Priorities}}{{$from := .}}<label for="priority-map-{{$scheme.ID}}-{{.ID}}">Work items using {{.Name}}</label><select id="priority-map-{{$scheme.ID}}-{{.ID}}" name="map.{{.ID}}"><option value="">Leave them alone</option>{{range $page.Data.Priorities}}{{if ne .ID $from.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select>{{end}}</details><button class="btn" type="submit">Save priority scheme</button></form>
{{if not .IsDefault}}<form class="project-details-form" method="post" action="/settings/priorities"><input type="hidden" name="action" value="assign-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><label for="priority-scheme-project-{{.ID}}">Assign to project</label><select id="priority-scheme-project-{{.ID}}" name="project">{{range $page.Data.Projects}}<option value="{{.ID}}">{{.Name}} ({{.Key}})</option>{{end}}</select><details class="metadata-delete"><summary class="quiet-action">Move work items off a priority</summary><p>A change that leaves work items with a priority the scheme no longer offers needs somewhere for them to go.</p>{{range $page.Data.Priorities}}{{$from := .}}<label for="priority-map-{{$scheme.ID}}-{{.ID}}">Work items using {{.Name}}</label><select id="priority-map-{{$scheme.ID}}-{{.ID}}" name="map.{{.ID}}"><option value="">Leave them alone</option>{{range $page.Data.Priorities}}{{if ne .ID $from.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select>{{end}}</details><button class="btn" type="submit">Assign project</button></form>
<ul class="metadata-scheme-summary">{{range index $page.Data.Assigned $scheme.ID}}<li><strong>{{.Name}} ({{.Key}})</strong><form method="post" action="/settings/priorities"><input type="hidden" name="action" value="unassign-scheme"><input type="hidden" name="scheme" value="{{$scheme.ID}}"><input type="hidden" name="project" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.Name}} from {{$scheme.Name}}</span></button></form></li>{{else}}<li class="empty-state"><small>No projects use this scheme.</small></li>{{end}}</ul>
<form method="post" action="/settings/priorities"><input type="hidden" name="action" value="delete-scheme"><input type="hidden" name="scheme" value="{{.ID}}"><button class="btn btn-danger" type="submit">Delete scheme<span class="sr-only"> {{.Name}}</span></button></form>{{end}}</article>{{else}}<p class="empty-state"><strong>No schemes</strong><small>Every project uses the site's priorities.</small></p>{{end}}</div></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_resolutions"}}
<!doctype html><html lang="en"><head><title>Resolutions · {{(site $).Title}}</title>{{template "head" .}}</head>
<body class="page-resolutions"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Resolutions</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Resolutions</h1><p>A work item is resolved when it has a resolution. The default is applied when work reaches a done status.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card" aria-labelledby="resolution-create-heading"><div><h2 id="resolution-create-heading">Create resolution</h2><p>New resolutions go to the bottom of the list.</p></div>
<form class="project-details-form" method="post" action="/settings/resolutions"><input type="hidden" name="action" value="create"><label for="resolution-name-new">Name</label><input id="resolution-name-new" name="name" maxlength="60" required><label for="resolution-description-new">Description</label><input id="resolution-description-new" name="description" maxlength="4000"><button class="btn btn-primary" type="submit">Create resolution</button></form></section>
<div class="metadata-list">{{$page := .}}{{range .Data.Resolutions}}{{$item := .}}<article class="surface-card metadata-card" data-resolution-id="{{.ID}}"><header><div><div><h2>{{.Name}}</h2><p>Position {{.Position}}</p></div></div>{{if .IsDefault}}<span class="lozenge lozenge-success">Default</span>{{end}}</header>
<form class="project-details-form" method="post" action="/settings/resolutions"><input type="hidden" name="action" value="update"><input type="hidden" name="resolution" value="{{.ID}}"><label for="resolution-name-{{.ID}}">Name</label><input id="resolution-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="60" required><label for="resolution-description-{{.ID}}">Description</label><input id="resolution-description-{{.ID}}" name="description" value="{{.Description}}" maxlength="4000"><button class="btn" type="submit">Save resolution</button></form>
<div class="metadata-card-actions">{{if not .IsDefault}}<form method="post" action="/settings/resolutions"><input type="hidden" name="action" value="default"><input type="hidden" name="resolution" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Make default<span class="sr-only"> {{.Name}}</span></button></form>{{end}}
<form method="post" action="/settings/resolutions"><input type="hidden" name="action" value="move"><input type="hidden" name="resolution" value="{{.ID}}"><button class="btn btn-subtle" type="submit">Move to top<span class="sr-only"> {{.Name}}</span></button></form></div>
{{if not .IsDefault}}<details class="metadata-delete"><summary class="quiet-action">Delete {{.Name}}</summary><form class="project-details-form" method="post" action="/settings/resolutions"><input type="hidden" name="action" value="delete"><input type="hidden" name="resolution" value="{{.ID}}"><p>Work items resolved this way take the resolution you choose.</p><label for="resolution-replacement-{{.ID}}">Move work items to</label><select id="resolution-replacement-{{.ID}}" name="replacement">{{range $page.Data.Resolutions}}{{if ne .ID $item.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select><button class="btn btn-danger" type="submit">Delete resolution</button></form></details>{{end}}{{template "metadata_translations" (index $page.Data.Translations $item.ID)}}</article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
