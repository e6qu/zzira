{{define "page_app_module"}}
<!doctype html><html lang="en"><head><title>{{.Data.Module.Title}} · {{.Data.Module.AppName}} · ZZIRA</title>{{template "head" .}}</head>
<body><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}
<main class="page app-module-page" id="main-content" tabindex="-1"><nav class="issue-breadcrumbs" aria-label="Breadcrumb"><span>Apps</span><span aria-hidden="true">/</span><span>{{.Data.Module.AppName}}</span><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Module.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Module.AppName}} · {{.Data.Module.Type}}</span><h1>{{.Data.Module.Title}}</h1><p>{{if .Data.FrameURL}}Remote Connect module with signed workspace context.{{else}}Host-rendered app module with workspace identity and navigation.{{end}}</p></div></header>
<section class="surface-card app-module-content" aria-labelledby="app-module-content-heading"><h2 class="sr-only" id="app-module-content-heading">Module content</h2>{{if .Data.FrameURL}}<iframe class="app-module-frame" src="{{.Data.FrameURL}}" title="{{.Data.Module.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe>{{else}}<p>{{.Data.Module.Body}}</p>{{end}}<dl><div><dt>App key</dt><dd><code>{{.Data.Module.AppKey}}</code></dd></div><div><dt>Module key</dt><dd><code>{{.Data.Module.Key}}</code></dd></div><div><dt>Location</dt><dd><code>{{.Data.Module.Location}}</code></dd></div></dl></section>
</main></div></body></html>
{{end}}

{{define "page_project_admin_app_module"}}
<!doctype html><html lang="en"><head><title>{{.Data.Module.Title}} · Project settings · ZZIRA</title>{{template "head" .}}</head>
<body class="page-project-settings"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}/settings">Project settings</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Module.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Module.AppName}} · Project administration</span><h1>{{.Data.Module.Title}}</h1><p>App settings for {{.Data.Project.Name}} ({{.Data.Project.Key}}).</p></div></header>
<section class="surface-card app-module-content" aria-labelledby="project-admin-app-content-heading"><h2 class="sr-only" id="project-admin-app-content-heading">Module content</h2><iframe class="app-module-frame" src="{{.Data.FrameURL}}" title="{{.Data.Module.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_app_module"}}
<!doctype html><html lang="en"><head><title>{{.Data.Module.Title}} · {{.Data.Project.Name}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-app-module"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="project-tabs" aria-label="{{.Data.Project.Name}} project"><a href="/projects/{{.Data.Project.Key}}">Overview</a><a href="/issues/{{.Data.Project.Key}}">Work items</a><a href="/projects/{{.Data.Project.Key}}/releases">Releases</a><a href="/projects/{{.Data.Project.Key}}/apps/{{.Data.Module.ID}}" aria-current="page">{{.Data.Module.Title}}</a></nav>
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">{{.Data.Module.Title}}</span></nav>
<header class="page-header"><div><span class="eyebrow">{{.Data.Module.AppName}} · Project app</span><h1>{{.Data.Module.Title}}</h1><p>App content for {{.Data.Project.Name}} ({{.Data.Project.Key}}).</p></div></header>
<section class="surface-card app-module-content" aria-labelledby="project-app-module-content-heading"><h2 class="sr-only" id="project-app-module-content-heading">Module content</h2><iframe class="app-module-frame" src="{{.Data.FrameURL}}" title="{{.Data.Module.Title}}" sandbox="allow-forms allow-modals allow-popups allow-same-origin allow-scripts"></iframe></section>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
