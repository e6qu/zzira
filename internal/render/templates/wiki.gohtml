{{define "wiki_start"}}
<!doctype html><html lang="en"><head><title>Wiki · ZZIRA</title>{{template "head" .}}<script src="/static/wiki.js?v=1" defer></script></head><body class="page-wiki"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
{{end}}
{{define "wiki_end"}}</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>{{end}}
{{define "wiki_breadcrumbs"}}<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/wiki">Wiki</a>{{with .Data.Space}}<span aria-hidden="true">/</span><a href="/wiki/spaces/{{.ID}}">{{.Name}}</a>{{end}}{{with .Data.Page}}<span aria-hidden="true">/</span><span aria-current="page">{{if .Title}}{{.Title}}{{else}}New page{{end}}</span>{{end}}</nav>{{end}}

{{define "page_wiki_spaces"}}{{template "wiki_start" .}}
<header class="page-header"><div><h1>Wiki</h1><p>Keep team knowledge, decisions, and project documentation together.</p></div></header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.CanAdmin}}<details class="surface-card wiki-create-space" {{if .Data.Error}}open{{end}}><summary class="btn">Create space</summary><form class="project-details-form" method="post" action="/wiki/spaces">
<label for="space-name">Space name</label><input id="space-name" name="name" value="{{.Data.SpaceName}}" maxlength="255" required>
<label for="space-key">Space key</label><input id="space-key" name="key" value="{{.Data.SpaceKey}}" pattern="[A-Za-z0-9]+" maxlength="255" required>
<label for="space-description">Description</label><textarea id="space-description" name="description" rows="3">{{.Data.SpaceDescription}}</textarea>
<label for="space-private"><input id="space-private" type="checkbox" name="private" value="true" {{if .Data.Private}}checked{{end}}> Private space — only you can access it</label>
<button class="btn btn-primary" type="submit">Create space</button></form></details>{{end}}
<div class="directory-grid">{{range .Data.Spaces}}<article class="directory-card"><header><div><h2><a href="/wiki/spaces/{{.ID}}">{{.Name}}</a></h2><p>{{.Key}} · {{if .Private}}Private{{else}}Workspace{{end}}</p></div></header><p>{{.Description}}</p><footer><a href="/wiki/spaces/{{.ID}}">Browse pages</a></footer></article>{{else}}<div class="empty-state"><strong>No spaces yet</strong><small>{{if .Data.CanAdmin}}Create a space to start writing.{{else}}Ask a workspace administrator to create your team's first space.{{end}}</small></div>{{end}}</div>
{{template "wiki_end" .}}{{end}}

{{define "page_wiki_space"}}{{template "wiki_start" .}}{{template "wiki_breadcrumbs" .}}
<header class="page-header"><div><h1>{{.Data.Space.Name}}</h1><p>{{.Data.Space.Description}}</p></div><div class="page-header-actions"><form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/watch"><input type="hidden" name="watching" value="{{if .Data.WatchingSpace}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.WatchingSpace}}Stop watching space{{else}}Watch space{{end}}</button></form><a class="btn btn-primary" href="/wiki/spaces/{{.Data.Space.ID}}/pages/new">Create page</a></div></header>
<nav class="project-tabs" aria-label="Space pages"><a href="/wiki/spaces/{{.Data.Space.ID}}" {{if eq .Data.Status "current"}}aria-current="page"{{end}}>Published</a><a href="/wiki/spaces/{{.Data.Space.ID}}?status=draft" {{if eq .Data.Status "draft"}}aria-current="page"{{end}}>Your drafts</a><a href="/wiki/spaces/{{.Data.Space.ID}}?status=trashed" {{if eq .Data.Status "trashed"}}aria-current="page"{{end}}>Trash</a></nav>
<form class="wiki-search" method="get" role="search"><label for="wiki-search">Find a page</label><input type="search" id="wiki-search" name="q" value="{{.Data.Query}}"><input type="hidden" name="status" value="{{.Data.Status}}"><button class="btn" type="submit">Search</button></form>
<section class="surface-card" aria-label="Page tree">{{if .Data.Tree}}{{template "wiki_tree" .Data.Tree}}{{else}}<div class="empty-state"><strong>No pages found</strong><small>{{if .Data.Query}}Try another page title.{{else}}Create a page to share knowledge with your team.{{end}}</small></div>{{end}}</section>
{{template "wiki_end" .}}{{end}}

{{define "page_wiki_page"}}{{template "wiki_start" .}}{{template "wiki_breadcrumbs" .}}
{{if .Data.Error}}<div class="form-error" role="alert"><strong>Page was not saved.</strong><p>{{.Data.Error}}</p><p>Your changes are still in the editor. Copy them before reloading the page.</p></div>{{end}}
{{if .Data.Editing}}
<header class="page-header"><h1>{{if .Data.Page.ID}}Edit page{{else}}Create page{{end}}</h1></header>
<form class="surface-card project-details-form wiki-edit-form" method="post" action="{{if .Data.Page.ID}}/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/edit{{else}}/wiki/spaces/{{.Data.Space.ID}}/pages/new{{end}}">
<input type="hidden" name="version" value="{{.Data.Page.Version.Number}}">
<label for="wiki-title">Page title</label><input id="wiki-title" name="title" value="{{.Data.Page.Title}}" maxlength="255" required>
<label for="wiki-parent">Parent page</label><select id="wiki-parent" name="parentId"><option value="">Space root</option>{{range .Data.Pages}}{{if ne .ID $.Data.Page.ID}}<option value="{{.ID}}" {{if eq .ID $.Data.Page.ParentID}}selected{{end}}>{{.Title}}</option>{{end}}{{end}}</select>
<label id="wiki-body-label" for="wiki-body">Page content</label>
{{if not .Data.SourceMode}}<div class="wiki-editor-toolbar" data-wiki-toolbar hidden role="group" aria-label="Format page content"><button type="button" class="btn" data-wiki-command="bold">Bold</button><button type="button" class="btn" data-wiki-command="italic">Italic</button><button type="button" class="btn" data-wiki-command="insertUnorderedList">Bullet list</button><button type="button" class="btn" data-wiki-command="insertOrderedList">Numbered list</button></div><div class="wiki-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="wiki-body-label" data-wiki-editor hidden>{{wikiHTML .Data.Page.Body.Value}}</div>{{end}}
<textarea id="wiki-body" name="body" rows="16" spellcheck="false">{{.Data.Page.Body.Value}}</textarea>
<label for="wiki-status">Publish status</label><select id="wiki-status" name="status"><option value="current" {{if eq .Data.Page.Status "current"}}selected{{end}}>Published — visible to everyone with space access</option>{{if or (not .Data.Page.ID) (eq .Data.Page.Status "draft")}}<option value="draft" {{if eq .Data.Page.Status "draft"}}selected{{end}}>Draft — only you can view it</option>{{end}}</select>
<label for="wiki-message">What changed?</label><input id="wiki-message" name="message" value="{{.Data.Page.Version.Message}}" maxlength="2000">
<div class="project-form-actions"><button class="btn btn-primary" type="submit">Save page</button><a class="btn" href="{{if .Data.Page.ID}}/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}{{else}}/wiki/spaces/{{.Data.Space.ID}}{{end}}">Cancel</a></div>
</form>
{{else}}
<header class="page-header"><div><h1>{{.Data.Page.Title}}</h1><p>{{.Data.Page.Status}} · Version {{.Data.Page.Version.Number}} · <time datetime="{{.Data.Page.Version.CreatedAt}}">{{.Data.Page.Version.CreatedAt}}</time></p></div><div class="page-header-actions">{{if eq .Data.Page.Status "current"}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/watch"><input type="hidden" name="watching" value="{{if .Data.WatchingPage}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.WatchingPage}}Stop watching page{{else}}Watch page{{end}}</button></form>{{end}}{{if and .Data.CanEdit (ne .Data.Page.Status "trashed")}}<a class="btn btn-primary" href="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/edit">Edit page</a>{{end}}</div></header>
{{if eq .Data.Page.Status "current"}}<section class="wiki-labels" id="wiki-labels" aria-labelledby="wiki-labels-heading"><h2 id="wiki-labels-heading">Labels</h2><div class="wiki-label-list">{{range .Data.Labels}}<div class="wiki-label-chip"><span>{{.Name}}</span><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/labels/{{.Name}}/watch"><input type="hidden" name="watching" value="{{if index $.Data.WatchedLabels .Name}}false{{else}}true{{end}}"><button type="submit" aria-label="{{if index $.Data.WatchedLabels .Name}}Stop watching{{else}}Watch{{end}} label {{.Name}}" title="{{if index $.Data.WatchedLabels .Name}}Stop watching label{{else}}Watch label{{end}}">{{if index $.Data.WatchedLabels .Name}}●{{else}}○{{end}}</button></form>{{if $.Data.CanEdit}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/labels"><input type="hidden" name="action" value="remove"><input type="hidden" name="prefix" value="{{.Prefix}}"><input type="hidden" name="name" value="{{.Name}}"><button type="submit" aria-label="Remove label {{.Name}}">×</button></form>{{end}}</div>{{else}}<small>No labels</small>{{end}}</div>{{if .Data.CanEdit}}<details><summary class="btn">Add labels</summary><form class="wiki-label-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/labels"><input type="hidden" name="action" value="add"><label for="wiki-label-input">Label names</label><input id="wiki-label-input" name="labels" placeholder="release-ready, handbook" required><small>Separate labels with commas. Use lowercase letters, numbers, dots, underscores, or hyphens.</small><button class="btn btn-primary" type="submit">Add labels</button></form></details>{{end}}</section>{{end}}
<article class="wiki-document surface-card" aria-label="Page content">{{wikiHTML .Data.Page.Body.Value}}</article>
<section class="surface-card wiki-attachments" id="wiki-attachments" aria-labelledby="wiki-attachments-heading"><header><div><span class="eyebrow">Page files</span><h2 id="wiki-attachments-heading">Attachments</h2></div><span class="lozenge lozenge-default">{{len .Data.Attachments}} files</span></header>
{{if .Data.Attachments}}<ul>{{range .Data.Attachments}}{{$attachment := .}}<li id="attachment-{{.ID}}"><div class="wiki-attachment-summary"><a href="/wiki/download/attachments/{{.PageID}}/{{.ID}}/{{.Filename}}">{{.Filename}}</a>{{if or (eq .MediaType "image/png") (eq .MediaType "image/jpeg") (eq .MediaType "image/gif")}}<img class="wiki-attachment-thumbnail" src="/wiki/api/v2/attachments/{{.ID}}/thumbnail/download?width=320&height=180" alt="Preview of {{.Filename}}">{{end}}<small>{{.MediaType}} · {{.Size}} bytes · Version {{.Version.Number}}{{if .Comment}} · {{.Comment}}{{end}}</small>
{{if .Labels}}<div class="wiki-attachment-labels" aria-label="Labels for {{.Filename}}">{{range .Labels}}{{if $.Data.CanEdit}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="remove-label"><input type="hidden" name="prefix" value="{{.Prefix}}"><input type="hidden" name="name" value="{{.Name}}"><span>{{.Name}}</span><button type="submit" aria-label="Remove attachment label {{.Name}}">×</button></form>{{else}}<span>{{.Name}}</span>{{end}}{{end}}</div>{{end}}
{{if .Properties}}<dl class="wiki-attachment-properties">{{range .Properties}}<div><dt>{{.Key}}</dt><dd><code>{{printf "%s" .Value}}</code> · v{{.Version.Number}}{{if $.Data.CanEdit}} <details><summary>Edit property {{.Key}}</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="update-property"><input type="hidden" name="propertyId" value="{{.ID}}"><input type="hidden" name="version" value="{{.NextVersion}}"><label for="wiki-property-key-{{.ID}}">Property key</label><input id="wiki-property-key-{{.ID}}" name="key" value="{{.Key}}" maxlength="255" required><label for="wiki-property-value-{{.ID}}">JSON value</label><textarea id="wiki-property-value-{{.ID}}" name="value" rows="3" required>{{printf "%s" .Value}}</textarea><label for="wiki-property-message-{{.ID}}">What changed?</label><input id="wiki-property-message-{{.ID}}" name="message" maxlength="2000"><button class="btn btn-primary" type="submit">Save property</button></form><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="delete-property"><input type="hidden" name="propertyId" value="{{.ID}}"><button class="btn" type="submit">Delete property {{.Key}}</button></form></details>{{end}}</dd></div>{{end}}</dl>{{end}}
{{$attachmentComments := index $.Data.AttachmentComments .ID}}<details class="wiki-attachment-comments"><summary>Comments · {{len $attachmentComments}}</summary>{{if $attachmentComments}}{{template "wiki_comments" $attachmentComments}}{{else}}<small>No attachment comments yet.</small>{{end}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/comments"><input type="hidden" name="attachmentId" value="{{.ID}}"><label for="wiki-attachment-comment-{{.ID}}">Comment on {{.Filename}}</label><textarea id="wiki-attachment-comment-{{.ID}}" name="body" rows="3" maxlength="1048576" required></textarea><button class="btn" type="submit">Add attachment comment</button></form></details></div>
{{if $.Data.CanEdit}}<div class="wiki-attachment-actions"><details><summary class="btn">Metadata</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/metadata"><input type="hidden" name="action" value="add-labels"><label for="wiki-attachment-labels-{{.ID}}">Add attachment labels</label><input id="wiki-attachment-labels-{{.ID}}" name="labels" placeholder="release-ready, source" required><button class="btn" type="submit">Add attachment labels</button></form><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/metadata"><input type="hidden" name="action" value="create-property"><label for="wiki-new-property-key-{{.ID}}">New property key</label><input id="wiki-new-property-key-{{.ID}}" name="key" maxlength="255" required><label for="wiki-new-property-value-{{.ID}}">JSON value</label><textarea id="wiki-new-property-value-{{.ID}}" name="value" rows="3" placeholder='{"state":"ready"}' required></textarea><button class="btn" type="submit">Add property</button></form></details><details><summary class="btn">Replace</summary><form method="post" enctype="multipart/form-data" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments"><input type="hidden" name="attachmentId" value="{{.ID}}"><label for="wiki-replace-{{.ID}}">Replacement file for {{.Filename}}</label><input id="wiki-replace-{{.ID}}" type="file" name="file" required><label for="wiki-replace-comment-{{.ID}}">Version comment</label><input id="wiki-replace-comment-{{.ID}}" name="comment" maxlength="2000"><button class="btn btn-primary" type="submit">Replace file</button></form></details><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/delete"><button class="btn" type="submit">Delete {{.Filename}}</button></form></div>{{end}}</li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No files attached</strong><small>Add plans, images, exports, or supporting documents to this page.</small></div>{{end}}
{{if and .Data.CanEdit (eq .Data.Page.Status "current")}}<details><summary class="btn">Attach a file</summary><form method="post" enctype="multipart/form-data" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/attachments"><label for="wiki-attachment-file">File</label><input id="wiki-attachment-file" type="file" name="file" required><label for="wiki-attachment-comment">Comment</label><input id="wiki-attachment-comment" name="comment" maxlength="2000"><button class="btn btn-primary" type="submit">Upload file</button></form></details>{{end}}</section>
<details class="surface-card wiki-access" id="wiki-access"><summary><span>Page access</span><small>Control who can view and edit this page</small></summary>{{if .Data.CanRestrict}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/restrictions"><p>Leave a column empty to allow everyone with space access. Page authors and workspace administrators always retain access.</p><div class="wiki-access-table" role="group" aria-label="Page access choices"><div class="wiki-access-heading">Person or group</div><div class="wiki-access-heading">Can view</div><div class="wiki-access-heading">Can edit</div>{{range .Data.RestrictionUsers}}<div><strong>{{.Name}}</strong><small>Person</small></div><label><input type="checkbox" name="readUsers" value="{{.ID}}" {{if .Read}}checked{{end}}><span>Allow {{.Name}} to view</span></label><label><input type="checkbox" name="updateUsers" value="{{.ID}}" {{if .Update}}checked{{end}}><span>Allow {{.Name}} to edit</span></label>{{end}}{{range .Data.RestrictionGroups}}<div><strong>{{.Name}}</strong><small>Group</small></div><label><input type="checkbox" name="readGroups" value="{{.ID}}" {{if .Read}}checked{{end}}><span>Allow {{.Name}} to view</span></label><label><input type="checkbox" name="updateGroups" value="{{.ID}}" {{if .Update}}checked{{end}}><span>Allow {{.Name}} to edit</span></label>{{end}}</div><button class="btn btn-primary" type="submit">Save page access</button></form>{{else}}<div class="wiki-access-summary">{{range .Data.Restrictions}}<div><strong>{{if eq .Operation "read"}}View access{{else}}Edit access{{end}}</strong>{{if or .Users .Groups}}<ul>{{range .Users}}<li>{{.DisplayName}}</li>{{end}}{{range .Groups}}<li>{{.Name}} <small>group</small></li>{{end}}</ul>{{else}}<p>Everyone with space access</p>{{end}}</div>{{end}}</div>{{end}}</details>
<div class="project-form-actions">{{if eq .Data.Page.Status "current"}}<a class="btn" href="/wiki/spaces/{{.Data.Space.ID}}/pages/new?parent={{.Data.Page.ID}}">Create child page</a>{{end}}{{if .Data.CanEdit}}<details class="wiki-trash"><summary class="btn">{{if eq .Data.Page.Status "trashed"}}Restore page{{else}}Move to trash{{end}}</summary><form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/trash"><p>{{if eq .Data.Page.Status "trashed"}}Restore this page with its existing content and history.{{else}}This page will move to the space trash. You can restore it later.{{end}}</p><button class="btn" type="submit">{{if eq .Data.Page.Status "trashed"}}Confirm restore{{else}}Confirm move to trash{{end}}</button></form></details>{{end}}</div>
<section class="surface-card wiki-discussion" id="wiki-discussion" aria-labelledby="wiki-discussion-heading"><header><div><span class="eyebrow">Page discussion</span><h2 id="wiki-discussion-heading">Comments</h2><p>Ask questions, record feedback, and keep decisions with the page.</p></div><span class="lozenge lozenge-default">{{len .Data.Comments}} threads</span></header>
{{if .Data.Comments}}{{template "wiki_comments" .Data.Comments}}{{else}}<div class="empty-state"><strong>No comments yet</strong><small>Start the discussion for this page.</small></div>{{end}}
{{if eq .Data.Page.Status "current"}}<form class="project-details-form wiki-new-comment" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/comments"><label for="wiki-new-comment">Add a comment</label><textarea id="wiki-new-comment" name="body" rows="4" maxlength="1048576" required></textarea><button class="btn btn-primary" type="submit">Comment</button></form>{{end}}</section>
<details class="surface-card wiki-history"><summary>Page history</summary><ol>{{range .Data.Versions}}<li><strong>Version {{.Number}}</strong> · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>{{if .Message}}<p>{{.Message}}</p>{{end}}</li>{{end}}</ol></details>
{{end}}{{template "wiki_end" .}}{{end}}

{{define "wiki_tree"}}<ul class="wiki-page-tree">{{range .}}<li><div><a href="/wiki/spaces/{{.Page.SpaceID}}/pages/{{.Page.ID}}">{{.Page.Title}}</a><small>Version {{.Page.Version.Number}} · <time datetime="{{.Page.Version.CreatedAt}}">{{.Page.Version.CreatedAt}}</time></small></div>{{if .Children}}{{template "wiki_tree" .Children}}{{end}}</li>{{end}}</ul>{{end}}

{{define "wiki_comments"}}<div class="wiki-comment-list" role="list">{{range .}}<article class="wiki-comment" id="comment-{{.Comment.ID}}" role="listitem" aria-labelledby="comment-author-{{.Comment.ID}}"><header><strong id="comment-author-{{.Comment.ID}}">{{.Comment.AuthorName}}</strong><span><time datetime="{{.Comment.CreatedAt}}">{{.Comment.CreatedAt}}</time>{{if ne .Comment.CreatedAt .Comment.UpdatedAt}} · edited{{end}}</span></header><div class="wiki-comment-body">{{wikiHTML .Comment.Body.Value}}</div>{{if gt (len .Versions) 1}}<details class="wiki-comment-history"><summary>Version history</summary><ol>{{range .Versions}}<li><strong>Version {{.Number}}</strong> · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>{{if .Message}}<p>{{.Message}}</p>{{end}}</li>{{end}}</ol></details>{{end}}<div class="wiki-comment-actions"><form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}/like"><input type="hidden" name="liked" value="{{if .Liked}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Liked}}Unlike{{else}}Like{{end}}{{if .LikeCount}} · {{.LikeCount}}{{end}}</button></form><details><summary class="btn">Reply</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments"><input type="hidden" name="parentId" value="{{.Comment.ID}}"><label for="wiki-reply-{{.Comment.ID}}">Reply to {{.Comment.AuthorName}}</label><textarea id="wiki-reply-{{.Comment.ID}}" name="body" rows="3" maxlength="1048576" required></textarea><button class="btn btn-primary" type="submit">Reply</button></form></details>{{if .CanManage}}<details><summary class="btn">Edit</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}"><input type="hidden" name="version" value="{{.NextVersion}}"><label for="wiki-edit-comment-{{.Comment.ID}}">Edit comment</label><textarea id="wiki-edit-comment-{{.Comment.ID}}" name="body" rows="3" maxlength="1048576" required>{{.Comment.Body.Value}}</textarea><label for="wiki-comment-message-{{.Comment.ID}}">What changed?</label><input id="wiki-comment-message-{{.Comment.ID}}" name="message" maxlength="2000"><button class="btn btn-primary" type="submit">Save comment</button></form></details><details><summary class="btn">Delete</summary><form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}/delete"><p>This removes the comment and all of its replies.</p><button class="btn" type="submit">Confirm delete</button></form></details>{{end}}</div>{{if .Replies}}<div class="wiki-comment-replies" aria-label="Replies to {{.Comment.AuthorName}}">{{template "wiki_comments" .Replies}}</div>{{end}}</article>{{end}}</div>{{end}}
