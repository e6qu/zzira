{{define "wiki_start"}}
<!doctype html><html lang="en"><head><title>Wiki · ZZIRA</title>{{template "head" .}}<script src="/static/wiki.js?v=1" defer></script></head><body class="page-wiki"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
{{end}}
{{define "wiki_end"}}</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>{{end}}
{{define "wiki_breadcrumbs"}}<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/wiki">Wiki</a>{{with .Data.Space}}<span aria-hidden="true">/</span><a href="/wiki/spaces/{{.ID}}">{{.Name}}</a>{{end}}{{with .Data.Page}}<span aria-hidden="true">/</span><span aria-current="page">{{if .Title}}{{.Title}}{{else}}New page{{end}}</span>{{end}}{{with .Data.BlogPost}}<span aria-hidden="true">/</span><span aria-current="page">{{if .Title}}{{.Title}}{{else}}New blog post{{end}}</span>{{end}}</nav>{{end}}

{{define "page_wiki_spaces"}}{{template "wiki_start" .}}
<header class="page-header"><div><h1>Wiki</h1><p>Keep team knowledge, decisions, and project documentation together.</p></div></header>
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.CanAdmin}}<details class="surface-card wiki-create-space" {{if .Data.Error}}open{{end}}><summary class="btn">Create space</summary><form class="project-details-form" method="post" action="/wiki/spaces">
<label for="space-name">Space name</label><input id="space-name" name="name" value="{{.Data.SpaceName}}" maxlength="255" required>
<label for="space-key">Space key</label><input id="space-key" name="key" value="{{.Data.SpaceKey}}" pattern="[A-Za-z0-9]+" maxlength="255" required>
<label for="space-description">Description</label><textarea id="space-description" name="description" rows="3">{{.Data.SpaceDescription}}</textarea>
<label for="space-private"><input id="space-private" type="checkbox" name="private" value="true" {{if .Data.Private}}checked{{end}}> Private space — only you can access it</label>
<button class="btn btn-primary" type="submit">Create space</button></form></details>{{end}}
<div class="directory-grid">{{range .Data.Spaces}}<article class="directory-card"><header><div><h2><a href="/wiki/spaces/{{.ID}}">{{.Name}}</a></h2><p>{{.Key}} · {{if .Private}}Private{{else}}Workspace{{end}}</p></div></header><p>{{.Description}}</p><footer><a href="/wiki/spaces/{{.ID}}">Browse pages</a></footer></article>{{else}}<div class="empty-state"><strong>No spaces yet</strong><small>{{if .Data.CanAdmin}}Create a space to start writing.{{else}}Ask a workspace administrator to create your team's first space.{{end}}</small></div>{{end}}</div>
{{template "wiki_end" .}}{{end}}

{{define "page_wiki_space"}}{{template "wiki_start" .}}{{template "wiki_breadcrumbs" .}}
<header class="page-header"><div><h1>{{.Data.Space.Name}}</h1><p>{{.Data.Space.Description}}</p></div><div class="page-header-actions"><form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/watch"><input type="hidden" name="watching" value="{{if .Data.WatchingSpace}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.WatchingSpace}}Stop watching space{{else}}Watch space{{end}}</button></form><a class="btn" href="/wiki/spaces/{{.Data.Space.ID}}/blogposts/new">Write blog post</a><a class="btn btn-primary" href="/wiki/spaces/{{.Data.Space.ID}}/pages/new">Create page</a></div></header>
<nav class="project-tabs" aria-label="Space pages"><a href="/wiki/spaces/{{.Data.Space.ID}}" {{if eq .Data.Status "current"}}aria-current="page"{{end}}>Published</a><a href="/wiki/spaces/{{.Data.Space.ID}}?status=draft" {{if eq .Data.Status "draft"}}aria-current="page"{{end}}>Your drafts</a><a href="/wiki/spaces/{{.Data.Space.ID}}?status=trashed" {{if eq .Data.Status "trashed"}}aria-current="page"{{end}}>Trash</a></nav>
<form class="wiki-search" method="get" role="search"><label for="wiki-search">Find content</label><input type="search" id="wiki-search" name="q" value="{{.Data.Query}}"><input type="hidden" name="status" value="{{.Data.Status}}"><button class="btn" type="submit">Search</button></form>
<section class="surface-card wiki-blogposts" aria-labelledby="wiki-blogposts-heading"><header><div><span class="eyebrow">Updates</span><h2 id="wiki-blogposts-heading">Blog posts</h2><p>Publish dated announcements and keep their revision history with this space.</p></div><span class="lozenge lozenge-default">{{len .Data.BlogPosts}} posts</span></header>{{if .Data.BlogPosts}}<ol class="wiki-blogpost-list">{{range .Data.BlogPosts}}<li><a href="/wiki/spaces/{{.SpaceID}}/blogposts/{{.ID}}"><strong>{{if .Title}}{{.Title}}{{else}}Untitled draft{{end}}</strong></a><small>{{if .Private}}Private · {{end}}Version {{.Version.Number}} · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time></small></li>{{end}}</ol>{{else}}<div class="empty-state"><strong>No blog posts found</strong><small>{{if .Data.Query}}Try another title.{{else}}Share an announcement or a dated team update.{{end}}</small></div>{{end}}</section>
{{if eq .Data.Status "current"}}<section class="surface-card wiki-folders" aria-labelledby="wiki-folders-heading"><header><div><span class="eyebrow">Content tree</span><h2 id="wiki-folders-heading">Folders</h2><p>Group related pages and future canvases under a shared place.</p></div><span class="lozenge lozenge-default">{{len .Data.Folders}} folders</span></header>
{{if .Data.Folders}}<ul class="wiki-page-tree">{{range .Data.Folders}}<li id="folder-{{.ID}}"><div><strong>📁 {{.Title}}</strong><small>{{if .ParentID}}Inside {{.ParentType}} {{.ParentID}}{{else}}Space root{{end}} · Created <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time></small></div><details><summary class="btn">Delete folder</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/folders/{{.ID}}/delete"><p>The folder must be empty before it can be deleted.</p><button class="btn" type="submit">Confirm delete</button></form></details></li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No folders yet</strong><small>Create one to organize this space.</small></div>{{end}}
<details><summary class="btn">Create folder</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/folders"><label for="wiki-folder-title">Folder name</label><input id="wiki-folder-title" name="title" maxlength="255" required><label for="wiki-folder-parent">Parent content</label><select id="wiki-folder-parent" name="parentId"><option value="">Space root</option><optgroup label="Pages">{{range .Data.Pages}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Folders">{{range .Data.Folders}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Smart Links">{{range .Data.SmartLinks}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Databases">{{range .Data.Databases}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Whiteboards">{{range .Data.Whiteboards}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup></select><button class="btn btn-primary" type="submit">Create folder</button></form></details></section>
<section class="surface-card wiki-databases" aria-labelledby="wiki-databases-heading"><header><div><span class="eyebrow">Structured knowledge</span><h2 id="wiki-databases-heading">Databases</h2><p>Collect structured team information in the space tree and label its handling level.</p></div><span class="lozenge lozenge-default">{{len .Data.Databases}} databases</span></header>
{{if .Data.Databases}}<ul class="wiki-page-tree">{{range .Data.Databases}}<li id="database-{{.ID}}"><div><strong>▦ {{.Title}}</strong><small>{{if .Private}}Private · {{end}}{{if .ClassificationLevel}}Classification: {{.ClassificationName}} · {{end}}{{if .ParentID}}Inside {{.ParentType}} {{.ParentID}}{{else}}Space root{{end}}</small></div><div class="wiki-content-actions"><details><summary class="btn">Set classification</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/databases/{{.ID}}/classification"><label for="wiki-database-classification-{{.ID}}">Classification level</label><select id="wiki-database-classification-{{.ID}}" name="level"><option value="" {{if not .ClassificationLevel}}selected{{end}}>None</option><option value="public" {{if eq .ClassificationLevel "public"}}selected{{end}}>Public</option><option value="internal" {{if eq .ClassificationLevel "internal"}}selected{{end}}>Internal</option><option value="confidential" {{if eq .ClassificationLevel "confidential"}}selected{{end}}>Confidential</option><option value="restricted" {{if eq .ClassificationLevel "restricted"}}selected{{end}}>Restricted</option></select><button class="btn btn-primary" type="submit">Save classification</button></form></details><details><summary class="btn">Delete database</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/databases/{{.ID}}/delete"><p>Child content must be moved or deleted first.</p><button class="btn" type="submit">Confirm delete</button></form></details></div></li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No databases yet</strong><small>Create a database container for structured team knowledge.</small></div>{{end}}
<details><summary class="btn">Create database</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/databases"><label for="wiki-database-title">Database name</label><input id="wiki-database-title" name="title" maxlength="255" required><label for="wiki-database-private"><input id="wiki-database-private" type="checkbox" name="private" value="true"> Private database — only you can access it</label><label for="wiki-database-parent">Parent content</label><select id="wiki-database-parent" name="parentId"><option value="">Space root</option><optgroup label="Pages">{{range .Data.Pages}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Folders">{{range .Data.Folders}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Smart Links">{{range .Data.SmartLinks}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Databases">{{range .Data.Databases}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Whiteboards">{{range .Data.Whiteboards}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup></select><button class="btn btn-primary" type="submit">Create database</button></form></details></section>
<section class="surface-card wiki-whiteboards" aria-labelledby="wiki-whiteboards-heading"><header><div><span class="eyebrow">Visual collaboration</span><h2 id="wiki-whiteboards-heading">Whiteboards</h2><p>Start a shared visual workspace from a blank canvas or a team template.</p></div><span class="lozenge lozenge-default">{{len .Data.Whiteboards}} whiteboards</span></header>
{{if .Data.Whiteboards}}<ul class="wiki-page-tree">{{range .Data.Whiteboards}}<li id="whiteboard-{{.ID}}"><div><strong>◇ {{.Title}}</strong><small>{{if .Private}}Private · {{end}}{{if .TemplateKey}}Template: {{.TemplateKey}}{{if .Locale}} ({{.Locale}}){{end}} · {{end}}{{if .ClassificationLevel}}Classification: {{.ClassificationName}} · {{end}}{{if .ParentID}}Inside {{.ParentType}} {{.ParentID}}{{else}}Space root{{end}}</small></div><div class="wiki-content-actions"><details><summary class="btn">Set classification</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/whiteboards/{{.ID}}/classification"><label for="wiki-whiteboard-classification-{{.ID}}">Classification level</label><select id="wiki-whiteboard-classification-{{.ID}}" name="level"><option value="" {{if not .ClassificationLevel}}selected{{end}}>None</option><option value="public" {{if eq .ClassificationLevel "public"}}selected{{end}}>Public</option><option value="internal" {{if eq .ClassificationLevel "internal"}}selected{{end}}>Internal</option><option value="confidential" {{if eq .ClassificationLevel "confidential"}}selected{{end}}>Confidential</option><option value="restricted" {{if eq .ClassificationLevel "restricted"}}selected{{end}}>Restricted</option></select><button class="btn btn-primary" type="submit">Save classification</button></form></details><details><summary class="btn">Delete whiteboard</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/whiteboards/{{.ID}}/delete"><p>Child content must be moved or deleted first.</p><button class="btn" type="submit">Confirm delete</button></form></details></div></li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No whiteboards yet</strong><small>Create a canvas for planning, mapping, or retrospectives.</small></div>{{end}}
<details><summary class="btn">Create whiteboard</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/whiteboards"><label for="wiki-whiteboard-title">Whiteboard name</label><input id="wiki-whiteboard-title" name="title" maxlength="255" required><label for="wiki-whiteboard-template">Template</label><select id="wiki-whiteboard-template" name="templateKey"><option value="">Blank canvas</option><option value="incident-postmortem">Incident postmortem</option><option value="workflow">Workflow</option><option value="flow-chart">Flow chart</option><option value="kanban-board">Kanban board</option><option value="journey-mapping-kit">Journey mapping</option><option value="service-blueprint">Service blueprint</option><option value="sprint-planning">Sprint planning</option><option value="product-roadmap">Product roadmap</option><option value="org-chart">Organization chart</option></select><label for="wiki-whiteboard-locale">Template language</label><select id="wiki-whiteboard-locale" name="locale"><option value="">Use my language</option><option value="cs-CZ">Čeština</option><option value="da-DK">Dansk</option><option value="de-DE">Deutsch</option><option value="en-GB">English (UK)</option><option value="en-US">English (US)</option><option value="es-ES">Español</option><option value="fi-FI">Suomi</option><option value="fr-FR">Français</option><option value="hu-HU">Magyar</option><option value="it-IT">Italiano</option><option value="ja-JP">日本語</option><option value="ko-KR">한국어</option><option value="nb-NO">Norsk</option><option value="nl-NL">Nederlands</option><option value="pl-PL">Polski</option><option value="pt-BR">Português (Brasil)</option><option value="ru-RU">Русский</option><option value="sv-SE">Svenska</option><option value="tr-TR">Türkçe</option><option value="zh-CN">简体中文</option><option value="zh-TW">繁體中文</option></select><small>Choose a language only when using a template.</small><label for="wiki-whiteboard-private"><input id="wiki-whiteboard-private" type="checkbox" name="private" value="true"> Private whiteboard — only you can access it</label><label for="wiki-whiteboard-parent">Parent content</label><select id="wiki-whiteboard-parent" name="parentId"><option value="">Space root</option><optgroup label="Pages">{{range .Data.Pages}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Folders">{{range .Data.Folders}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Smart Links">{{range .Data.SmartLinks}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Databases">{{range .Data.Databases}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Whiteboards">{{range .Data.Whiteboards}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup></select><button class="btn btn-primary" type="submit">Create whiteboard</button></form></details></section>
<section class="surface-card wiki-smart-links" aria-labelledby="wiki-smart-links-heading"><header><div><span class="eyebrow">Connected knowledge</span><h2 id="wiki-smart-links-heading">Smart Links</h2><p>Keep external dashboards, documents, and tools in the space tree.</p></div><span class="lozenge lozenge-default">{{len .Data.SmartLinks}} links</span></header>{{if .Data.SmartLinks}}<ul class="wiki-page-tree">{{range .Data.SmartLinks}}<li id="embed-{{.ID}}"><div><a href="{{.EmbedURL}}" target="_blank" rel="noopener noreferrer"><strong>{{.Title}}</strong></a><small>{{.EmbedURL}}{{if .ParentID}} · Inside {{.ParentType}} {{.ParentID}}{{else}} · Space root{{end}}</small></div><details><summary class="btn">Delete Smart Link</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/embeds/{{.ID}}/delete"><p>Child content must be moved or deleted first.</p><button class="btn" type="submit">Confirm delete</button></form></details></li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No Smart Links yet</strong><small>Add a trusted HTTP or HTTPS destination to this space.</small></div>{{end}}<details><summary class="btn">Add Smart Link</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/embeds"><label for="wiki-smart-link-title">Link title</label><input id="wiki-smart-link-title" name="title" maxlength="255" required><label for="wiki-smart-link-url">HTTP or HTTPS URL</label><input id="wiki-smart-link-url" name="embedUrl" type="url" maxlength="8192" required><label for="wiki-smart-link-parent">Parent content</label><select id="wiki-smart-link-parent" name="parentId"><option value="">Space root</option><optgroup label="Pages">{{range .Data.Pages}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Folders">{{range .Data.Folders}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Smart Links">{{range .Data.SmartLinks}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Databases">{{range .Data.Databases}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup><optgroup label="Whiteboards">{{range .Data.Whiteboards}}<option value="{{.ID}}">{{.Title}}</option>{{end}}</optgroup></select><button class="btn btn-primary" type="submit">Add Smart Link</button></form></details></section>{{end}}
<section class="surface-card" aria-label="Page tree">{{if .Data.Tree}}{{template "wiki_tree" .Data.Tree}}{{else}}<div class="empty-state"><strong>No pages found</strong><small>{{if .Data.Query}}Try another page title.{{else}}Create a page to share knowledge with your team.{{end}}</small></div>{{end}}</section>
{{template "wiki_end" .}}{{end}}

{{define "page_wiki_blogpost"}}{{template "wiki_start" .}}{{template "wiki_breadcrumbs" .}}
{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
{{if .Data.Editing}}
<header class="page-header"><div><span class="eyebrow">{{if .Data.BlogPost.ID}}Edit blog post{{else}}New blog post{{end}}</span><h1>{{if .Data.BlogPost.Title}}{{.Data.BlogPost.Title}}{{else}}Share an update{{end}}</h1><p>Publish a dated update in {{.Data.Space.Name}}.</p></div></header>
<form class="surface-card project-details-form wiki-blogpost-form" method="post"><label for="wiki-blog-title">Title</label><input id="wiki-blog-title" name="title" value="{{.Data.BlogPost.Title}}" maxlength="255" required><label for="wiki-blog-body">Content</label><textarea id="wiki-blog-body" name="body" rows="16" maxlength="1048576" required>{{.Data.BlogPost.Body.Value}}</textarea><label for="wiki-blog-status">Status</label><select id="wiki-blog-status" name="status"><option value="current" {{if eq .Data.BlogPost.Status "current"}}selected{{end}}>Published</option><option value="draft" {{if eq .Data.BlogPost.Status "draft"}}selected{{end}}>Draft</option></select>{{if not .Data.BlogPost.ID}}<label><input type="checkbox" name="private" value="true" {{if .Data.BlogPost.Private}}checked{{end}}> Private post — only you can access it</label>{{end}}{{if .Data.BlogPost.ID}}<label for="wiki-blog-message">What changed?</label><input id="wiki-blog-message" name="message" maxlength="2000"><label><input type="checkbox" name="minorEdit" value="true"> Minor edit</label>{{end}}<div class="project-form-actions"><button class="btn btn-primary" type="submit">{{if .Data.BlogPost.ID}}Save blog post{{else}}Create blog post{{end}}</button>{{if .Data.BlogPost.ID}}<a class="btn" href="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}">Cancel</a>{{else}}<a class="btn" href="/wiki/spaces/{{.Data.Space.ID}}">Cancel</a>{{end}}</div></form>
{{else}}
<header class="page-header"><div><span class="eyebrow">Blog post{{if .Data.BlogPost.Private}} · Private{{end}}{{if .Data.BlogPost.ClassificationLevel}} · {{.Data.BlogPost.ClassificationName}}{{end}}</span><h1>{{.Data.BlogPost.Title}}</h1><p>Published <time datetime="{{.Data.BlogPost.CreatedAt}}">{{.Data.BlogPost.CreatedAt}}</time> · Version {{.Data.BlogPost.Version.Number}}</p></div><div class="page-header-actions">{{if eq .Data.BlogPost.Status "current"}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="like"><input type="hidden" name="liked" value="{{if .Data.BlogLiked}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.BlogLiked}}Unlike{{else}}Like{{end}}{{if .Data.BlogLikeCount}} · {{.Data.BlogLikeCount}}{{end}}</button></form>{{end}}{{if .Data.CanEdit}}<a class="btn btn-primary" href="?edit=true">Edit post</a>{{end}}</div></header>
<article class="wiki-document surface-card" aria-label="Blog post content">{{wikiHTML .Data.BlogPost.Body.Value}}</article>
{{if eq .Data.BlogPost.Status "current"}}<section class="surface-card wiki-blog-metadata" aria-labelledby="wiki-blog-details-heading"><header><div><span class="eyebrow">Governance</span><h2 id="wiki-blog-details-heading">Blog post details</h2><p>Organize this update for discovery and downstream apps.</p></div><span class="lozenge lozenge-default">{{len .Data.Labels}} labels</span></header>
<div class="wiki-blog-metadata-grid"><div><h3>Classification</h3><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="classify"><label for="wiki-blog-classification">Data classification</label><select id="wiki-blog-classification" name="level"><option value="" {{if not .Data.BlogPost.ClassificationLevel}}selected{{end}}>None</option><option value="public" {{if eq .Data.BlogPost.ClassificationLevel "public"}}selected{{end}}>Public</option><option value="internal" {{if eq .Data.BlogPost.ClassificationLevel "internal"}}selected{{end}}>Internal</option><option value="confidential" {{if eq .Data.BlogPost.ClassificationLevel "confidential"}}selected{{end}}>Confidential</option><option value="restricted" {{if eq .Data.BlogPost.ClassificationLevel "restricted"}}selected{{end}}>Restricted</option></select><button class="btn" type="submit">Save classification</button></form></div>
<div><h3>Labels</h3>{{if .Data.Labels}}<ul class="wiki-label-list">{{range .Data.Labels}}<li><span class="lozenge lozenge-default">{{.Prefix}}:{{.Name}}</span><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/blogposts/{{$.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="remove-label"><input type="hidden" name="prefix" value="{{.Prefix}}"><input type="hidden" name="label" value="{{.Name}}"><button class="btn btn-small" type="submit">Remove {{.Name}}</button></form></li>{{end}}</ul>{{else}}<p class="muted">No labels yet.</p>{{end}}<form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="add-label"><label for="wiki-blog-label">Add label</label><input id="wiki-blog-label" name="label" maxlength="255" pattern="[a-z0-9._-]+" required><button class="btn" type="submit">Add label</button></form></div></div>
<details class="wiki-blog-properties"><summary>App properties · {{len .Data.BlogProperties}}</summary>{{if .Data.BlogProperties}}<dl>{{range .Data.BlogProperties}}<div><dt>{{.Key}}</dt><dd><code>{{printf "%s" .Value}}</code> · v{{.Version.Number}}<details><summary>Edit {{.Key}}</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/blogposts/{{$.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="update-property"><input type="hidden" name="propertyId" value="{{.ID}}"><input type="hidden" name="version" value="{{.NextVersion}}"><label for="wiki-blog-property-key-{{.ID}}">Property key</label><input id="wiki-blog-property-key-{{.ID}}" name="key" value="{{.Key}}" maxlength="255" required><label for="wiki-blog-property-value-{{.ID}}">JSON value</label><textarea id="wiki-blog-property-value-{{.ID}}" name="value" rows="3" required>{{printf "%s" .Value}}</textarea><label for="wiki-blog-property-message-{{.ID}}">What changed?</label><input id="wiki-blog-property-message-{{.ID}}" name="message" maxlength="2000"><button class="btn" type="submit">Save property</button></form><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/blogposts/{{$.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="delete-property"><input type="hidden" name="propertyId" value="{{.ID}}"><button class="btn" type="submit">Delete property {{.Key}}</button></form></details></dd></div>{{end}}</dl>{{end}}<form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}/metadata"><input type="hidden" name="action" value="create-property"><label for="wiki-blog-new-property-key">New property key</label><input id="wiki-blog-new-property-key" name="key" maxlength="255" required><label for="wiki-blog-new-property-value">JSON value</label><textarea id="wiki-blog-new-property-value" name="value" rows="3" required>{}</textarea><button class="btn" type="submit">Create property</button></form></details></section>{{end}}
{{if .Data.CanEdit}}<div class="project-form-actions"><details class="wiki-trash"><summary class="btn">{{if eq .Data.BlogPost.Status "trashed"}}Restore or purge{{else}}Move to trash{{end}}</summary><form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/blogposts/{{.Data.BlogPost.ID}}/lifecycle"><p>{{if eq .Data.BlogPost.Status "trashed"}}Restore this post or permanently purge it.{{else}}The post will remain available in the space trash.{{end}}</p>{{if eq .Data.BlogPost.Status "trashed"}}<button class="btn btn-primary" name="action" value="restore" type="submit">Restore post</button><button class="btn" name="action" value="purge" type="submit">Purge permanently</button>{{else}}<button class="btn" name="action" value="trash" type="submit">Confirm move to trash</button>{{end}}</form></details></div>{{end}}
<details class="surface-card wiki-history"><summary>Blog post history</summary><ol>{{range .Data.Versions}}<li><strong>Version {{.Number}}</strong> · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>{{if .Message}}<p>{{.Message}}</p>{{end}}</li>{{end}}</ol></details>{{end}}
{{template "wiki_end" .}}{{end}}

{{define "page_wiki_page"}}{{template "wiki_start" .}}{{template "wiki_breadcrumbs" .}}
{{if .Data.Error}}<div class="form-error" role="alert"><strong>Page was not saved.</strong><p>{{.Data.Error}}</p><p>Your changes are still in the editor. Copy them before reloading the page.</p></div>{{end}}
{{if .Data.Editing}}
<header class="page-header"><h1>{{if .Data.Page.ID}}Edit page{{else}}Create page{{end}}</h1></header>
<form class="surface-card project-details-form wiki-edit-form" method="post" action="{{if .Data.Page.ID}}/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/edit{{else}}/wiki/spaces/{{.Data.Space.ID}}/pages/new{{end}}">
<input type="hidden" name="version" value="{{.Data.Page.Version.Number}}">
<label for="wiki-title">Page title</label><input id="wiki-title" name="title" value="{{.Data.Page.Title}}" maxlength="255" required>
<label for="wiki-parent">Parent page</label><select id="wiki-parent" name="parentId"><option value="">Space root</option>{{range .Data.Pages}}{{if ne .ID $.Data.Page.ID}}<option value="{{.ID}}" {{if eq .ID $.Data.Page.ParentID}}selected{{end}}>{{.Title}}</option>{{end}}{{end}}</select>
<label id="wiki-body-label" for="wiki-body">Page content</label>
{{if not .Data.SourceMode}}<div class="wiki-editor-toolbar" data-wiki-toolbar hidden role="group" aria-label="Format page content"><button type="button" class="btn" data-wiki-command="bold">Bold</button><button type="button" class="btn" data-wiki-command="italic">Italic</button><button type="button" class="btn" data-wiki-command="insertUnorderedList">Bullet list</button><button type="button" class="btn" data-wiki-command="insertOrderedList">Numbered list</button></div><div class="wiki-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="wiki-body-label" data-wiki-editor hidden>{{wikiHTML .Data.Page.Body.Value}}</div>{{end}}
<textarea id="wiki-body" name="body" rows="16" spellcheck="false">{{.Data.Page.Body.Value}}</textarea>
<label for="wiki-status">Publish status</label><select id="wiki-status" name="status"><option value="current" {{if eq .Data.Page.Status "current"}}selected{{end}}>Published — visible to everyone with space access</option>{{if or (not .Data.Page.ID) (eq .Data.Page.Status "draft")}}<option value="draft" {{if eq .Data.Page.Status "draft"}}selected{{end}}>Draft — only you can view it</option>{{end}}</select>
<label for="wiki-message">What changed?</label><input id="wiki-message" name="message" value="{{.Data.Page.Version.Message}}" maxlength="2000">
<div class="project-form-actions"><button class="btn btn-primary" type="submit">Save page</button><a class="btn" href="{{if .Data.Page.ID}}/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}{{else}}/wiki/spaces/{{.Data.Space.ID}}{{end}}">Cancel</a></div>
</form>
{{else}}
<header class="page-header"><div><h1>{{.Data.Page.Title}}</h1><p>{{.Data.Page.Status}} · Version {{.Data.Page.Version.Number}} · <time datetime="{{.Data.Page.Version.CreatedAt}}">{{.Data.Page.Version.CreatedAt}}</time></p></div><div class="page-header-actions">{{if eq .Data.Page.Status "current"}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/watch"><input type="hidden" name="watching" value="{{if .Data.WatchingPage}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Data.WatchingPage}}Stop watching page{{else}}Watch page{{end}}</button></form>{{end}}{{if and .Data.CanEdit (ne .Data.Page.Status "trashed")}}<a class="btn btn-primary" href="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/edit">Edit page</a>{{end}}</div></header>
{{if eq .Data.Page.Status "current"}}<section class="wiki-labels" id="wiki-labels" aria-labelledby="wiki-labels-heading"><h2 id="wiki-labels-heading">Labels</h2><div class="wiki-label-list">{{range .Data.Labels}}<div class="wiki-label-chip"><span>{{.Name}}</span><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/labels/{{.Name}}/watch"><input type="hidden" name="watching" value="{{if index $.Data.WatchedLabels .Name}}false{{else}}true{{end}}"><button type="submit" aria-label="{{if index $.Data.WatchedLabels .Name}}Stop watching{{else}}Watch{{end}} label {{.Name}}" title="{{if index $.Data.WatchedLabels .Name}}Stop watching label{{else}}Watch label{{end}}">{{if index $.Data.WatchedLabels .Name}}●{{else}}○{{end}}</button></form>{{if $.Data.CanEdit}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/labels"><input type="hidden" name="action" value="remove"><input type="hidden" name="prefix" value="{{.Prefix}}"><input type="hidden" name="name" value="{{.Name}}"><button type="submit" aria-label="Remove label {{.Name}}">×</button></form>{{end}}</div>{{else}}<small>No labels</small>{{end}}</div>{{if .Data.CanEdit}}<details><summary class="btn">Add labels</summary><form class="wiki-label-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/labels"><input type="hidden" name="action" value="add"><label for="wiki-label-input">Label names</label><input id="wiki-label-input" name="labels" placeholder="release-ready, handbook" required><small>Separate labels with commas. Use lowercase letters, numbers, dots, underscores, or hyphens.</small><button class="btn btn-primary" type="submit">Add labels</button></form></details>{{end}}</section>{{end}}
<article class="wiki-document surface-card" aria-label="Page content">{{wikiHTML .Data.Page.Body.Value}}</article>
<section class="surface-card wiki-inline-comments" id="wiki-inline-comments" aria-labelledby="wiki-inline-heading"><header><div><span class="eyebrow">In context</span><h2 id="wiki-inline-heading">Inline comments</h2><p>Discuss an exact passage and resolve the thread when it is settled.</p></div><span class="lozenge lozenge-default">{{len .Data.InlineComments}} threads</span></header>{{if .Data.InlineComments}}{{template "wiki_inline_comments" .Data.InlineComments}}{{else}}<div class="empty-state"><strong>No inline comments</strong><small>Select an exact passage from the page to start a focused discussion.</small></div>{{end}}{{if eq .Data.Page.Status "current"}}<details><summary class="btn">Comment on a passage</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/inline-comments"><label for="wiki-inline-selection">Exact passage</label><input id="wiki-inline-selection" name="selection" maxlength="10000" required><small>Paste text exactly as it appears in the page source.</small><label for="wiki-inline-body">Inline comment</label><textarea id="wiki-inline-body" name="body" rows="3" maxlength="1048576" required></textarea><button class="btn btn-primary" type="submit">Add inline comment</button></form></details>{{end}}</section>
<section class="surface-card wiki-tasks" id="wiki-tasks" aria-labelledby="wiki-tasks-heading"><header><div><span class="eyebrow">Action items</span><h2 id="wiki-tasks-heading">Tasks</h2><p>Track owners, due dates, and completion with the page.</p></div><span class="lozenge lozenge-default">{{len .Data.Tasks}} tasks</span></header>{{if .Data.Tasks}}<ul class="wiki-task-list">{{range .Data.Tasks}}<li id="wiki-task-{{.ID}}" class="{{if eq .Status "complete"}}wiki-task-complete{{end}}"><div class="wiki-task-main">{{wikiHTML .Body.Value}}<small>Created by {{.CreatedName}}{{if .AssignedTo}} · Assigned to {{.AssignedName}}{{else}} · Unassigned{{end}}{{if .DueAt}} · Due <time datetime="{{.DueAt}}">{{.DueAt}}</time>{{end}}{{if .CompletedAt}} · Completed by {{.CompletedName}} at <time datetime="{{.CompletedAt}}">{{.CompletedAt}}</time>{{end}}</small></div><div class="wiki-task-actions"><span class="lozenge {{if eq .Status "complete"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Status}}</span>{{if $.Data.CanEdit}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/tasks/{{.ID}}"><input type="hidden" name="status" value="{{if eq .Status "complete"}}incomplete{{else}}complete{{end}}"><button class="btn" type="submit">{{if eq .Status "complete"}}Reopen{{else}}Complete{{end}} task</button></form>{{end}}</div></li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No tasks yet</strong><small>Add a clear action item and assign its owner.</small></div>{{end}}{{if and .Data.CanEdit (eq .Data.Page.Status "current")}}<details><summary class="btn">Add a task</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/tasks"><label for="wiki-task-body">Task</label><textarea id="wiki-task-body" name="body" rows="2" maxlength="1000000" required></textarea><label for="wiki-task-assignee">Assignee</label><select id="wiki-task-assignee" name="assignedTo"><option value="">Unassigned</option>{{range .Data.TaskAssignees}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}</select><label for="wiki-task-due">Due date</label><input id="wiki-task-due" type="date" name="dueAt"><button class="btn btn-primary" type="submit">Add task</button></form></details>{{end}}</section>
<section class="surface-card wiki-attachments" id="wiki-attachments" aria-labelledby="wiki-attachments-heading"><header><div><span class="eyebrow">Page files</span><h2 id="wiki-attachments-heading">Attachments</h2></div><span class="lozenge lozenge-default">{{len .Data.Attachments}} files</span></header>
{{if .Data.Attachments}}<ul>{{range .Data.Attachments}}{{$attachment := .}}<li id="attachment-{{.ID}}"><div class="wiki-attachment-summary"><a href="/wiki/download/attachments/{{.PageID}}/{{.ID}}/{{.Filename}}">{{.Filename}}</a>{{if or (eq .MediaType "image/png") (eq .MediaType "image/jpeg") (eq .MediaType "image/gif")}}<img class="wiki-attachment-thumbnail" src="/wiki/api/v2/attachments/{{.ID}}/thumbnail/download?width=320&height=180" alt="Preview of {{.Filename}}">{{end}}<small>{{.MediaType}} · {{.Size}} bytes · Version {{.Version.Number}}{{if .Comment}} · {{.Comment}}{{end}}</small>
{{if .Labels}}<div class="wiki-attachment-labels" aria-label="Labels for {{.Filename}}">{{range .Labels}}{{if $.Data.CanEdit}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="remove-label"><input type="hidden" name="prefix" value="{{.Prefix}}"><input type="hidden" name="name" value="{{.Name}}"><span>{{.Name}}</span><button type="submit" aria-label="Remove attachment label {{.Name}}">×</button></form>{{else}}<span>{{.Name}}</span>{{end}}{{end}}</div>{{end}}
{{if .Properties}}<dl class="wiki-attachment-properties">{{range .Properties}}<div><dt>{{.Key}}</dt><dd><code>{{printf "%s" .Value}}</code> · v{{.Version.Number}}{{if $.Data.CanEdit}} <details><summary>Edit property {{.Key}}</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="update-property"><input type="hidden" name="propertyId" value="{{.ID}}"><input type="hidden" name="version" value="{{.NextVersion}}"><label for="wiki-property-key-{{.ID}}">Property key</label><input id="wiki-property-key-{{.ID}}" name="key" value="{{.Key}}" maxlength="255" required><label for="wiki-property-value-{{.ID}}">JSON value</label><textarea id="wiki-property-value-{{.ID}}" name="value" rows="3" required>{{printf "%s" .Value}}</textarea><label for="wiki-property-message-{{.ID}}">What changed?</label><input id="wiki-property-message-{{.ID}}" name="message" maxlength="2000"><button class="btn btn-primary" type="submit">Save property</button></form><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{$attachment.ID}}/metadata"><input type="hidden" name="action" value="delete-property"><input type="hidden" name="propertyId" value="{{.ID}}"><button class="btn" type="submit">Delete property {{.Key}}</button></form></details>{{end}}</dd></div>{{end}}</dl>{{end}}
{{$attachmentComments := index $.Data.AttachmentComments .ID}}<details class="wiki-attachment-comments"><summary>Comments · {{len $attachmentComments}}</summary>{{if $attachmentComments}}{{template "wiki_comments" $attachmentComments}}{{else}}<small>No attachment comments yet.</small>{{end}}<form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/comments"><input type="hidden" name="attachmentId" value="{{.ID}}"><label for="wiki-attachment-comment-{{.ID}}">Comment on {{.Filename}}</label><textarea id="wiki-attachment-comment-{{.ID}}" name="body" rows="3" maxlength="1048576" required></textarea><button class="btn" type="submit">Add attachment comment</button></form></details></div>
{{if $.Data.CanEdit}}<div class="wiki-attachment-actions"><details><summary class="btn">Metadata</summary><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/metadata"><input type="hidden" name="action" value="add-labels"><label for="wiki-attachment-labels-{{.ID}}">Add attachment labels</label><input id="wiki-attachment-labels-{{.ID}}" name="labels" placeholder="release-ready, source" required><button class="btn" type="submit">Add attachment labels</button></form><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/metadata"><input type="hidden" name="action" value="create-property"><label for="wiki-new-property-key-{{.ID}}">New property key</label><input id="wiki-new-property-key-{{.ID}}" name="key" maxlength="255" required><label for="wiki-new-property-value-{{.ID}}">JSON value</label><textarea id="wiki-new-property-value-{{.ID}}" name="value" rows="3" placeholder='{"state":"ready"}' required></textarea><button class="btn" type="submit">Add property</button></form></details><details><summary class="btn">Replace</summary><form method="post" enctype="multipart/form-data" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments"><input type="hidden" name="attachmentId" value="{{.ID}}"><label for="wiki-replace-{{.ID}}">Replacement file for {{.Filename}}</label><input id="wiki-replace-{{.ID}}" type="file" name="file" required><label for="wiki-replace-comment-{{.ID}}">Version comment</label><input id="wiki-replace-comment-{{.ID}}" name="comment" maxlength="2000"><button class="btn btn-primary" type="submit">Replace file</button></form></details><form method="post" action="/wiki/spaces/{{$.Data.Space.ID}}/pages/{{$.Data.Page.ID}}/attachments/{{.ID}}/delete"><button class="btn" type="submit">Delete {{.Filename}}</button></form></div>{{end}}</li>{{end}}</ul>{{else}}<div class="empty-state"><strong>No files attached</strong><small>Add plans, images, exports, or supporting documents to this page.</small></div>{{end}}
{{if and .Data.CanEdit (eq .Data.Page.Status "current")}}<details><summary class="btn">Attach a file</summary><form method="post" enctype="multipart/form-data" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/attachments"><label for="wiki-attachment-file">File</label><input id="wiki-attachment-file" type="file" name="file" required><label for="wiki-attachment-comment">Comment</label><input id="wiki-attachment-comment" name="comment" maxlength="2000"><button class="btn btn-primary" type="submit">Upload file</button></form></details>{{end}}</section>
<details class="surface-card wiki-access" id="wiki-access"><summary><span>Page access</span><small>Control who can view and edit this page</small></summary>{{if .Data.CanRestrict}}<form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/restrictions"><p>Leave a column empty to allow everyone with space access. Page authors and workspace administrators always retain access.</p><div class="wiki-access-table" role="group" aria-label="Page access choices"><div class="wiki-access-heading">Person or group</div><div class="wiki-access-heading">Can view</div><div class="wiki-access-heading">Can edit</div>{{range .Data.RestrictionUsers}}<div><strong>{{.Name}}</strong><small>Person</small></div><label><input type="checkbox" name="readUsers" value="{{.ID}}" {{if .Read}}checked{{end}}><span>Allow {{.Name}} to view</span></label><label><input type="checkbox" name="updateUsers" value="{{.ID}}" {{if .Update}}checked{{end}}><span>Allow {{.Name}} to edit</span></label>{{end}}{{range .Data.RestrictionGroups}}<div><strong>{{.Name}}</strong><small>Group</small></div><label><input type="checkbox" name="readGroups" value="{{.ID}}" {{if .Read}}checked{{end}}><span>Allow {{.Name}} to view</span></label><label><input type="checkbox" name="updateGroups" value="{{.ID}}" {{if .Update}}checked{{end}}><span>Allow {{.Name}} to edit</span></label>{{end}}</div><button class="btn btn-primary" type="submit">Save page access</button></form>{{else}}<div class="wiki-access-summary">{{range .Data.Restrictions}}<div><strong>{{if eq .Operation "read"}}View access{{else}}Edit access{{end}}</strong>{{if or .Users .Groups}}<ul>{{range .Users}}<li>{{.DisplayName}}</li>{{end}}{{range .Groups}}<li>{{.Name}} <small>group</small></li>{{end}}</ul>{{else}}<p>Everyone with space access</p>{{end}}</div>{{end}}</div>{{end}}</details>
<div class="project-form-actions">{{if eq .Data.Page.Status "current"}}<a class="btn" href="/wiki/spaces/{{.Data.Space.ID}}/pages/new?parent={{.Data.Page.ID}}">Create child page</a>{{end}}{{if .Data.CanEdit}}<details class="wiki-trash"><summary class="btn">{{if eq .Data.Page.Status "trashed"}}Restore page{{else}}Move to trash{{end}}</summary><form method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/trash"><p>{{if eq .Data.Page.Status "trashed"}}Restore this page with its existing content and history.{{else}}This page will move to the space trash. You can restore it later.{{end}}</p><button class="btn" type="submit">{{if eq .Data.Page.Status "trashed"}}Confirm restore{{else}}Confirm move to trash{{end}}</button></form></details>{{end}}</div>
<section class="surface-card wiki-discussion" id="wiki-discussion" aria-labelledby="wiki-discussion-heading"><header><div><span class="eyebrow">Page discussion</span><h2 id="wiki-discussion-heading">Comments</h2><p>Ask questions, record feedback, and keep decisions with the page.</p></div><span class="lozenge lozenge-default">{{len .Data.Comments}} threads</span></header>
{{if .Data.Comments}}{{template "wiki_comments" .Data.Comments}}{{else}}<div class="empty-state"><strong>No comments yet</strong><small>Start the discussion for this page.</small></div>{{end}}
{{if eq .Data.Page.Status "current"}}<form class="project-details-form wiki-new-comment" method="post" action="/wiki/spaces/{{.Data.Space.ID}}/pages/{{.Data.Page.ID}}/comments"><label for="wiki-new-comment">Add a comment</label><textarea id="wiki-new-comment" name="body" rows="4" maxlength="1048576" required></textarea><button class="btn btn-primary" type="submit">Comment</button></form>{{end}}</section>
<details class="surface-card wiki-history"><summary>Page history</summary><ol>{{range .Data.Versions}}<li><strong>Version {{.Number}}</strong> · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>{{if .Message}}<p>{{.Message}}</p>{{end}}</li>{{end}}</ol></details>
{{end}}{{template "wiki_end" .}}{{end}}

{{define "wiki_tree"}}<ul class="wiki-page-tree">{{range .}}<li><div><a href="/wiki/spaces/{{.Page.SpaceID}}/pages/{{.Page.ID}}">{{.Page.Title}}</a><small>Version {{.Page.Version.Number}} · <time datetime="{{.Page.Version.CreatedAt}}">{{.Page.Version.CreatedAt}}</time></small></div>{{if .Children}}{{template "wiki_tree" .Children}}{{end}}</li>{{end}}</ul>{{end}}

{{define "wiki_comments"}}<div class="wiki-comment-list" role="list">{{range .}}<article class="wiki-comment" id="comment-{{.Comment.ID}}" role="listitem" aria-labelledby="comment-author-{{.Comment.ID}}"><header><strong id="comment-author-{{.Comment.ID}}">{{.Comment.AuthorName}}</strong><span><time datetime="{{.Comment.CreatedAt}}">{{.Comment.CreatedAt}}</time>{{if ne .Comment.CreatedAt .Comment.UpdatedAt}} · edited{{end}}</span></header><div class="wiki-comment-body">{{wikiHTML .Comment.Body.Value}}</div>{{if gt (len .Versions) 1}}<details class="wiki-comment-history"><summary>Version history</summary><ol>{{range .Versions}}<li><strong>Version {{.Number}}</strong> · <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>{{if .Message}}<p>{{.Message}}</p>{{end}}</li>{{end}}</ol></details>{{end}}<div class="wiki-comment-actions"><form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}/like"><input type="hidden" name="liked" value="{{if .Liked}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if .Liked}}Unlike{{else}}Like{{end}}{{if .LikeCount}} · {{.LikeCount}}{{end}}</button></form><details><summary class="btn">Reply</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments"><input type="hidden" name="parentId" value="{{.Comment.ID}}"><label for="wiki-reply-{{.Comment.ID}}">Reply to {{.Comment.AuthorName}}</label><textarea id="wiki-reply-{{.Comment.ID}}" name="body" rows="3" maxlength="1048576" required></textarea><button class="btn btn-primary" type="submit">Reply</button></form></details>{{if .CanManage}}<details><summary class="btn">Edit</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}"><input type="hidden" name="version" value="{{.NextVersion}}"><label for="wiki-edit-comment-{{.Comment.ID}}">Edit comment</label><textarea id="wiki-edit-comment-{{.Comment.ID}}" name="body" rows="3" maxlength="1048576" required>{{.Comment.Body.Value}}</textarea><label for="wiki-comment-message-{{.Comment.ID}}">What changed?</label><input id="wiki-comment-message-{{.Comment.ID}}" name="message" maxlength="2000"><button class="btn btn-primary" type="submit">Save comment</button></form></details><details><summary class="btn">Delete</summary><form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/comments/{{.Comment.ID}}/delete"><p>This removes the comment and all of its replies.</p><button class="btn" type="submit">Confirm delete</button></form></details>{{end}}</div>{{if .Replies}}<div class="wiki-comment-replies" aria-label="Replies to {{.Comment.AuthorName}}">{{template "wiki_comments" .Replies}}</div>{{end}}</article>{{end}}</div>{{end}}

{{define "wiki_inline_comments"}}<div class="wiki-comment-list" role="list">{{range .}}<article class="wiki-comment wiki-inline-comment" id="inline-comment-{{.Comment.ID}}" role="listitem"><header><strong>{{.Comment.AuthorName}}</strong><span class="lozenge {{if eq .Comment.ResolutionStatus "resolved"}}lozenge-success{{else}}lozenge-default{{end}}">{{.Comment.ResolutionStatus}}</span></header>{{if not .Comment.ParentCommentID}}<blockquote>{{.Comment.InlineSelection}}</blockquote>{{end}}<div class="wiki-comment-body">{{wikiHTML .Comment.Body.Value}}</div><div class="wiki-comment-actions"><details><summary class="btn">Reply</summary><form class="project-details-form" method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/inline-comments"><input type="hidden" name="parentId" value="{{.Comment.ID}}"><label for="wiki-inline-reply-{{.Comment.ID}}">Reply to {{.Comment.AuthorName}}</label><textarea id="wiki-inline-reply-{{.Comment.ID}}" name="body" rows="3" required></textarea><button class="btn btn-primary" type="submit">Reply</button></form></details>{{if .CanManage}}<form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/inline-comments/{{.Comment.ID}}"><input type="hidden" name="resolved" value="{{if eq .Comment.ResolutionStatus "resolved"}}false{{else}}true{{end}}"><button class="btn" type="submit">{{if eq .Comment.ResolutionStatus "resolved"}}Reopen{{else}}Resolve{{end}}</button></form><form method="post" action="/wiki/spaces/{{.Comment.SpaceID}}/pages/{{.Comment.PageID}}/inline-comments/{{.Comment.ID}}/delete"><button class="btn" type="submit">Delete</button></form>{{end}}</div>{{if .Replies}}<div class="wiki-comment-replies">{{template "wiki_inline_comments" .Replies}}</div>{{end}}</article>{{end}}</div>{{end}}
