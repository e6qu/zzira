{{define "page_project_roles_admin"}}
<!doctype html><html lang="en"><head><title>Project roles · ZZIRA</title>{{template "head" .}}</head>
<body class="page-project-roles"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span aria-current="page">Project roles</span></nav>
<header class="page-header"><div><span class="eyebrow">Jira settings</span><h1>Project roles</h1><p>Define reusable responsibilities and the users or groups copied into every new project.</p></div></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<section class="surface-card project-role-create" aria-labelledby="project-role-create-heading"><div><h2 id="project-role-create-heading">Create role</h2><p>New roles become available in every project. Add default actors after creating the role.</p></div><form class="project-details-form" method="post" action="/settings/project-roles"><label for="project-role-name-new">Role name</label><input id="project-role-name-new" name="name" maxlength="255" required><label for="project-role-description-new">Description</label><textarea id="project-role-description-new" name="description" rows="2" maxlength="2000"></textarea><button class="btn btn-primary" type="submit">Create role</button></form></section>
<div class="project-role-admin-list">{{range .Data.Roles}}{{$card := .}}<article class="surface-card project-role-admin-card" data-role-id="{{.Role.ID}}"><header><div><span class="role-mark" aria-hidden="true">{{initials .Role.Name}}</span><div><h2>{{.Role.Name}}</h2><p>{{if .Role.Admin}}Project administration role · {{end}}ID {{.Role.ID}}</p></div></div><span class="lozenge">{{len .Actors}} default actor{{if ne (len .Actors) 1}}s{{end}}</span></header>
<div class="project-role-admin-grid"><section><h3>Role details</h3><form class="project-details-form" method="post" action="/settings/project-roles/{{.Role.ID}}"><input type="hidden" name="action" value="update"><label for="project-role-name-{{.Role.ID}}">Role name</label><input id="project-role-name-{{.Role.ID}}" name="name" value="{{.Role.Name}}" maxlength="255" required><label for="project-role-description-{{.Role.ID}}">Description</label><textarea id="project-role-description-{{.Role.ID}}" name="description" rows="3" maxlength="2000">{{.Role.Description}}</textarea><button class="btn" type="submit">Save role</button></form></section>
<section><h3>Default actors</h3><p class="muted">These assignments are copied when a project is created.</p><ul class="project-role-actor-list">{{range .Actors}}<li><span class="actor-avatar" aria-hidden="true">{{initials .DisplayName}}</span><span><strong>{{.DisplayName}}</strong><small>{{.PrincipalType}}{{if not .Active}} · deactivated{{end}}</small></span><form method="post" action="/settings/project-roles/{{$card.Role.ID}}"><input type="hidden" name="action" value="remove-default"><input type="hidden" name="principalType" value="{{.PrincipalType}}"><input type="hidden" name="principalId" value="{{.PrincipalID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.DisplayName}} from {{$card.Role.Name}}</span></button></form></li>{{else}}<li class="empty-state"><strong>No default actors</strong><small>New projects start with this role empty.</small></li>{{end}}</ul>
<div class="project-role-add-forms">{{if $.Data.Members}}<form class="project-details-form" method="post" action="/settings/project-roles/{{.Role.ID}}"><input type="hidden" name="action" value="add-default"><input type="hidden" name="principalType" value="user"><label for="default-role-user-{{.Role.ID}}">Add default user</label><select id="default-role-user-{{.Role.ID}}" name="principalId">{{range $.Data.Members}}{{if .Active}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{end}}</select><button class="btn" type="submit">Add user</button></form>{{end}}{{if $.Data.Groups}}<form class="project-details-form" method="post" action="/settings/project-roles/{{.Role.ID}}"><input type="hidden" name="action" value="add-default"><input type="hidden" name="principalType" value="group"><label for="default-role-group-{{.Role.ID}}">Add default group</label><select id="default-role-group-{{.Role.ID}}" name="principalId">{{range $.Data.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add group</button></form>{{end}}</div></section></div>
<details class="project-role-delete"><summary class="quiet-action">Delete role</summary><form class="project-details-form" method="post" action="/settings/project-roles/{{.Role.ID}}"><input type="hidden" name="action" value="delete"><p>Choose a replacement to preserve project assignments, filter shares, and defaults. Leave it blank only when the role is unused.</p><label for="project-role-swap-{{.Role.ID}}">Replacement role</label><select id="project-role-swap-{{.Role.ID}}" name="swap"><option value="">Delete only if unused</option>{{range $.Data.Roles}}{{if ne .Role.ID $card.Role.ID}}<option value="{{.Role.ID}}">{{.Role.Name}}</option>{{end}}{{end}}</select><button class="btn btn-danger" type="submit">Delete role</button></form></details></article>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}

{{define "page_project_role_assignments"}}
<!doctype html><html lang="en"><head><title>People and access · {{.Data.Project.Name}} · ZZIRA</title>{{template "head" .}}</head>
<body class="page-project-roles"><a class="skip-link" href="#main-content">Skip to content</a>{{template "header" .}}
<div class="app-shell">{{template "workspace_nav" .}}<main class="page page-fluid" id="main-content" tabindex="-1">
<nav class="issue-breadcrumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects/{{.Data.Project.Key}}">{{.Data.Project.Name}}</a><span aria-hidden="true">/</span><span aria-current="page">People and access</span></nav>
<header class="page-header"><div><span class="eyebrow">Project settings</span><h1>People and access</h1><p>Assign users and groups to roles in {{.Data.Project.Name}}. Administration roles can manage this page.</p></div><a class="btn" href="/rest/api/3/project/{{.Data.Project.Key}}/roledetails">View role API</a></header>
{{if .Data.Notice}}<p class="form-success" role="status">{{.Data.Notice}}</p>{{end}}{{if .Data.Error}}<p class="form-error" role="alert">{{.Data.Error}}</p>{{end}}
<div class="project-role-assignment-list">{{range .Data.Roles}}{{$card := .}}<section class="surface-card project-role-assignment-card" data-role-id="{{.Role.ID}}"><header><div><span class="role-mark" aria-hidden="true">{{initials .Role.Name}}</span><div><h2>{{.Role.Name}}</h2><p>{{.Role.Description}}</p></div></div>{{if .Role.Admin}}<span class="lozenge lozenge-current">Can administer project</span>{{else}}<span class="lozenge">Role {{.Role.ID}}</span>{{end}}</header>
<ul class="project-role-actor-list">{{range .Actors}}<li><span class="actor-avatar" aria-hidden="true">{{initials .DisplayName}}</span><span><strong>{{.DisplayName}}</strong><small>{{.PrincipalType}}{{if not .Active}} · deactivated{{end}}</small></span><form method="post" action="/projects/{{$.Data.Project.Key}}/settings/roles/{{$card.Role.ID}}"><input type="hidden" name="action" value="remove"><input type="hidden" name="principalType" value="{{.PrincipalType}}"><input type="hidden" name="principalId" value="{{.PrincipalID}}"><button class="btn btn-subtle" type="submit">Remove<span class="sr-only"> {{.DisplayName}} from {{$card.Role.Name}}</span></button></form></li>{{else}}<li class="empty-state"><strong>No actors assigned</strong><small>Add a person or group to this role.</small></li>{{end}}</ul>
<div class="project-role-add-forms">{{if $.Data.Members}}<form class="project-details-form" method="post" action="/projects/{{$.Data.Project.Key}}/settings/roles/{{.Role.ID}}"><input type="hidden" name="action" value="add"><input type="hidden" name="principalType" value="user"><label for="project-role-user-{{.Role.ID}}">Add user</label><select id="project-role-user-{{.Role.ID}}" name="principalId">{{range $.Data.Members}}{{if .Active}}<option value="{{.ID}}">{{.DisplayName}}</option>{{end}}{{end}}</select><button class="btn" type="submit">Add user</button></form>{{end}}{{if $.Data.Groups}}<form class="project-details-form" method="post" action="/projects/{{$.Data.Project.Key}}/settings/roles/{{.Role.ID}}"><input type="hidden" name="action" value="add"><input type="hidden" name="principalType" value="group"><label for="project-role-group-{{.Role.ID}}">Add group</label><select id="project-role-group-{{.Role.ID}}" name="principalId">{{range $.Data.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button class="btn" type="submit">Add group</button></form>{{end}}</div></section>{{end}}</div>
</main></div><div id="modal-root"></div><div id="sync-banner" class="sync-banner" role="status" aria-live="polite" aria-atomic="true" hidden></div></body></html>
{{end}}
